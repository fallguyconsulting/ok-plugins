#!/usr/bin/env bash
# Plugin-root shim — behavior deliberately lives elsewhere.
#
# The harness resolves hook commands against ${CLAUDE_PLUGIN_ROOT}, so this
# file has to sit in the installed plugin copy. Nothing else does: the shim
# locates the project's own materialized hook under .ok-planner/hooks/ and
# hands off. Consequences that matter:
#
#   - Every project runs the hook it was trued up to, not whatever version
#     happens to be installed on the machine today.
#   - Editing this plugin cannot disturb a session running in another
#     project, because that session is not executing anything from here.
#   - A project with no .ok-planner/ estate is silently skipped, which is
#     the same discovery rule the rest of the suite uses.
set -euo pipefail

resolve_root() {
    local dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    while [ "$dir" != "/" ] && [ -n "$dir" ]; do
        if [ -e "$dir/.git" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    printf '%s\n' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

IMPL="$(resolve_root)/.ok-planner/hooks/session-start"
[ -x "$IMPL" ] || exit 0
exec "$IMPL"
