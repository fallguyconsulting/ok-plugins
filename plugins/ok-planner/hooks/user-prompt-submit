#!/usr/bin/env bash
# Plugin-root shim — see hooks/session-start for why this file does nothing
# but hand off to the project's own materialized copy.
set -euo pipefail

resolve_root() {
    local dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    while [ "$dir" != "/" ] && [ -n "$dir" ]; do
        if [ -e "$dir/.git" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    printf '%s\n' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

IMPL="$(resolve_root)/.ok-planner/hooks/user-prompt-submit"
[ -x "$IMPL" ] || exit 0
exec "$IMPL"
