#!/usr/bin/env bash
# Materialized by ok-workspaces v{{OK_WORKSPACES_VERSION}}. Plugin-owned:
# overwritten wholesale by /ok-workspaces:true-up; do not hand-edit.
#
# The real SessionStart hook, running from the project's own estate so it
# reflects the version this project was trued up to — not whatever is
# installed machine-wide, and not a plugin checkout mid-edit.
set -euo pipefail

OK_DIR="$(cd "$(dirname "$0")/.." && pwd)"

skill_content=$(cat "${OK_DIR}/context/skills-index.md" 2>&1 || echo "Error reading ok-workspaces skill index")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$skill_content")
context="ok-workspaces v{{OK_WORKSPACES_VERSION}} is materialized in this project. Skills are invoked only when the user types a slash command.\n\n${escaped}"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
