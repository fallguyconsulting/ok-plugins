#!/usr/bin/env bash
# Plugin-root shim — behavior deliberately lives elsewhere.
#
# The harness resolves hook commands against ${CLAUDE_PLUGIN_ROOT}, so this
# file has to sit in the installed plugin copy. Nothing else does: the shim
# locates the project's own materialized hook under .ok-workspaces/hooks/ and
# hands off, so every project runs the hook version it was trued up to and an
# active session is never disturbed by edits to the installed plugin. A
# project with no .ok-workspaces/ estate is silently skipped.
set -euo pipefail

resolve_root() {
    local dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    while [ "$dir" != "/" ] && [ -n "$dir" ]; do
        if [ -e "$dir/.git" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    printf '%s\n' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

IMPL="$(resolve_root)/.ok-workspaces/hooks/session-start"
[ -x "$IMPL" ] || exit 0
exec "$IMPL"
