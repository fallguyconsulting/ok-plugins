#!/usr/bin/env bash

set -euo pipefail

REMINDER_EVERY=1

if ! command -v jq >/dev/null 2>&1; then
  exit 0
fi

input=$(cat)

transcript_path=$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null || true)

if [[ -z "$transcript_path" || ! -f "$transcript_path" ]]; then
  exit 0
fi

count_typed_top_level_user_prompts='[.[] | select(.type == "user" and (.toolUseResult // null) == null and (.isSidechain // false) == false)] | length'

user_count=$(jq -s "$count_typed_top_level_user_prompts" "$transcript_path" 2>/dev/null || echo 0)

if ! [[ "$user_count" =~ ^[0-9]+$ ]]; then
  exit 0
fi

if (( user_count == 0 || user_count % REMINDER_EVERY != 0 )); then
  exit 0
fi

reminder="The user wants every response to follow the rules of the active output style. Draft your response in full. Then reread the whole draft as one message against all guidance the output style gives, and rewrite it as a whole before sending it to the user."

jq -n --arg ctx "$reminder" '{
  hookSpecificOutput: {
    hookEventName: "UserPromptSubmit",
    additionalContext: $ctx
  }
}'

exit 0
