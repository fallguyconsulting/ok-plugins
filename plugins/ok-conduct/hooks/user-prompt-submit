#!/usr/bin/env bash
set -euo pipefail

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
rewriter="${ROOT}/bin/rewrite-draft"

input=$(cat)
session_id=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
CLAUDE_CODE_SESSION_ID="${session_id:-${CLAUDE_CODE_SESSION_ID:-default}}" nohup "${ROOT}/bin/warm-rewriter" >/dev/null 2>&1 </dev/null &

cat <<JSON
{
  "hookSpecificOutput": {
    "hookEventName": "UserPromptSubmit",
    "additionalContext": "The user wants every response to carry one topic. Write your response once, in full. Then reread it and cut at the point where a second developed topic begins. Send only what precedes the cut; hold the rest for the next turn. Then write the cut draft to a file under your scratchpad directory and run: ${rewriter} < <that file>. It prints the draft rewritten for plain language and brevity. Send the rewritten text as your message. Keep the rewrite out of the message you send."
  }
}
JSON

exit 0
