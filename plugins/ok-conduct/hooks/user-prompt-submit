#!/usr/bin/env bash
set -euo pipefail

cat > /dev/null

read_output_style() {
  for settings_file in \
    "${CLAUDE_PROJECT_DIR:-$PWD}/.claude/settings.local.json" \
    "${CLAUDE_PROJECT_DIR:-$PWD}/.claude/settings.json" \
    "${HOME}/.claude/settings.json"
  do
    [ -f "$settings_file" ] || continue
    style=$(sed -n 's/.*"outputStyle"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$settings_file" | head -1)
    if [ -n "$style" ]; then
      printf '%s' "$style"
      return 0
    fi
  done
  printf 'default'
}

case "$(read_output_style)" in
  ok-conduct:ok-conduct|ok-conduct) ;;
  *) exit 0 ;;
esac

STYLE="${CLAUDE_PLUGIN_ROOT%/}/output-styles/ok-conduct.md"
PROMPT="${CLAUDE_PLUGIN_ROOT%/}/hooks/user-prompt-submit.md"

standard=$(awk '/^## /{in_section = ($0 ~ /^## 1\./); next} in_section && /^- /' "$STYLE")
if [ -z "$standard" ]; then
  printf 'ok-conduct: no "- " lines under the "## 1." section of %s; the writing standard cannot be restated\n' "$STYLE" >&2
  exit 1
fi

context="### The Writing Standard for Everything You Write and Say ###

${standard}

$(cat "$PROMPT")"

escaped="${context//\\/\\\\}"
escaped="${escaped//\"/\\\"}"
escaped="${escaped//$'\t'/\\t}"
escaped="${escaped//$'\n'/\\n}"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
