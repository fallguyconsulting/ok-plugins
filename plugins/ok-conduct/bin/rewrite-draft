#!/usr/bin/env bash
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/rewriter-env"

draft=$(cat)
if [ -z "$draft" ]; then
  echo "rewrite-draft: empty draft on stdin" >&2
  exit 1
fi

strip_markers() { grep -v -x -e "<draft>" -e "</draft>"; }

build_message() {
  local delta
  delta=$(cat "$REWRITER_DIR/delta.txt" 2>/dev/null || true)
  if [ -n "$delta" ]; then
    printf '<conversation>\n%s\n</conversation>\n\n' "$delta"
  fi
  printf '<draft>\n%s\n</draft>' "$draft"
}

emit() {
  if [ -f "$NOTICE" ]; then
    cat "$NOTICE"
    rm -f "$NOTICE"
  fi
  printf '%s\n' "$1" | strip_markers
}

if rewriter_alive && [ "$(build_message | wc -c)" -gt "$PIPE_LIMIT" ]; then
  kill "$(cat "$PROC_DIR/claude.pid")" "$(cat "$PROC_DIR/holder.pid")" 2>/dev/null || true
  rm -rf "$PROC_DIR"
fi

if rewriter_alive; then
  message=$(build_message)
  printf '%s' "$message" | python3 -c 'import json,sys; print(json.dumps({"type":"user","message":{"role":"user","content":sys.stdin.read()}}))' > "$PROC_DIR/in"
  kill "$(cat "$PROC_DIR/holder.pid")" 2>/dev/null || true
  claude_pid=$(cat "$PROC_DIR/claude.pid")
  while ! grep -q '"type":"result"' "$PROC_DIR/out" && kill -0 "$claude_pid" 2>/dev/null; do sleep 0.05; done
  kill "$claude_pid" 2>/dev/null || true
  result=$(grep '"type":"result"' "$PROC_DIR/out" | tail -1 | "$REWRITER_BIN/record-usage" "$REWRITER_DIR/usage.log" warm || true)
  rm -rf "$PROC_DIR"
  if [ -n "$result" ]; then
    commit_state
    emit "$result"
    exit 0
  fi
  note "pre-started reviewer returned nothing; retrying cold"
fi

compute_delta
message=$(build_message)
if ! result=$(printf '%s' "$message" | run_claude --output-format json | "$REWRITER_BIN/record-usage" "$REWRITER_DIR/usage.log" cold) || [ -z "$result" ]; then
  note "could not resume the reviewer session; starting a fresh one at full context cost"
  forget_session
  rm -f "$REWRITER_DIR/next-session-id"
  compute_delta
  message=$(build_message)
  result=$(printf '%s' "$message" | run_claude --output-format json | "$REWRITER_BIN/record-usage" "$REWRITER_DIR/usage.log" fresh)
fi
commit_state
emit "$result"
