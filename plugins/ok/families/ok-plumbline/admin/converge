#!/usr/bin/env bash

# @decision: vendored-skills

set -euo pipefail

MODE="converge"
case "${1:-}" in
    diagnose) MODE="diagnose" ;;
    wire-hooks) MODE="wire-hooks" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FAMILY="${SCRIPT_DIR}/.."
BIN="${FAMILY}/bin/plumbline"
SUITE_MANIFEST="${SCRIPT_DIR}/../../../.claude-plugin/plugin.json"

SUITE_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SUITE_MANIFEST" 2>/dev/null | head -1)
[ -n "$SUITE_VERSION" ] || SUITE_VERSION="unknown"

# @decision: filesystem-discovery-markers
resolve_root() {
    local dir
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.ok-planner" ] || [ -e "$dir/.ok-plumbline" ] \
            || [ -e "$dir/.ok-workspaces" ] || [ -e "$dir/.plumbline.json" ] \
            || [ -e "$dir/.claude/rules/plumbline-cheatsheet.md" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    pwd
}

ROOT="$(resolve_root)"
cd "$ROOT"

if [ "$MODE" = "diagnose" ]; then
    exec node "$BIN" diagnose "$ROOT"
fi

if [ "$MODE" = "wire-hooks" ]; then
    exec node "$BIN" wire-hooks "$ROOT"
fi

mkdir -p .ok-plumbline

if [ -f .plumbline.json ] && [ ! -f .ok-plumbline/config.json ]; then
    git mv .plumbline.json .ok-plumbline/config.json 2>/dev/null || mv .plumbline.json .ok-plumbline/config.json
    echo "config migrated: .plumbline.json -> .ok-plumbline/config.json"
elif [ -f .plumbline.json ] && [ -f .ok-plumbline/config.json ]; then
    echo "CONFLICT: both .ok-plumbline/config.json and root .plumbline.json exist — ask the owner which is authoritative"
fi

if [ -f .plumbline-budget.json ] && [ ! -f .ok-plumbline/budget.json ]; then
    git mv .plumbline-budget.json .ok-plumbline/budget.json 2>/dev/null || mv .plumbline-budget.json .ok-plumbline/budget.json
    echo "budget baseline migrated: .plumbline-budget.json -> .ok-plumbline/budget.json"
elif [ -f .plumbline-budget.json ] && [ -f .ok-plumbline/budget.json ]; then
    echo "CONFLICT: both .ok-plumbline/budget.json and root .plumbline-budget.json exist — ask the owner which is authoritative"
fi

canonical="${FAMILY}/docs/plumbline-cheatsheet.md"
if [ ! -f "$canonical" ]; then
    echo "error: canonical cheatsheet not found at $canonical" >&2
    exit 1
fi
mkdir -p .claude/rules
sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" "$canonical" > .claude/rules/plumbline-cheatsheet.md
echo "materialized: .claude/rules/plumbline-cheatsheet.md (v${SUITE_VERSION})"

mkdir -p .ok-plumbline/bin .ok-plumbline/hooks .ok-plumbline/ceremony \
         .ok-plumbline/docs \
         .ok-plumbline/subjects .ok-plumbline/practices .ok-plumbline/audits/subjects

stamp_markdown() {
    sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" "$1"
    printf '\n<!-- Materialized by ok-plumbline v%s — suite-owned; overwritten on converge; do not hand-edit. -->\n' "$SUITE_VERSION"
}

stamp_markdown "${FAMILY}/docs/practice-definitions.md" > .ok-plumbline/practice-definitions.md
echo "materialized: .ok-plumbline/practice-definitions.md (the subject and practice authoring rules)"

# @story: write-time-prose-steering
stamp_markdown "${FAMILY}/docs/technical-writing.md" > .ok-plumbline/docs/technical-writing.md
echo "materialized: .ok-plumbline/docs/technical-writing.md (the writing standard)"

# @decision: test-quality-by-review
stamp_markdown "${FAMILY}/docs/testing.md" > .ok-plumbline/docs/testing.md
echo "materialized: .ok-plumbline/docs/testing.md (the testing standard)"

# @decision: event-kinds-as-conventioned-strings
stamp_markdown "${FAMILY}/docs/events.md" > .ok-plumbline/docs/events.md
echo "materialized: .ok-plumbline/docs/events.md (the events standard)"

for verb in plan-sprint certify-work audit document; do
    stamp_markdown "${FAMILY}/ceremony/${verb}.md" > ".ok-plumbline/ceremony/${verb}.md"
done
echo "materialized: .ok-plumbline/ceremony/ (the contributions the suite's ceremonies drive)"

sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" \
    "${FAMILY}/scripts/catalog-toc" > .ok-plumbline/bin/catalog-toc
chmod 755 .ok-plumbline/bin/catalog-toc
python3 .ok-plumbline/bin/catalog-toc "$ROOT" >/dev/null
echo "materialized: .ok-plumbline/bin/catalog-toc (+ the subject and practice catalog TOCs)"

# @concept: integration-contract
# @concept: materialized-artifact
node "$BIN" module-marker > .ok-plumbline/package.json
echo "materialized: .ok-plumbline/package.json (scopes the estate to CommonJS)"

sed "s/^const VERSION = '0\.0\.0-unvendored';\$/const VERSION = '${SUITE_VERSION}';/" \
    "$BIN" > .ok-plumbline/bin/plumbline
chmod 755 .ok-plumbline/bin/plumbline

sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" \
    "${FAMILY}/scripts/hooks/post-edit.js" > .ok-plumbline/hooks/post-edit.js
chmod 755 .ok-plumbline/hooks/post-edit.js

# @story: write-time-prose-steering
sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" \
    "${FAMILY}/scripts/hooks/pre-write.js" > .ok-plumbline/hooks/pre-write.js
chmod 755 .ok-plumbline/hooks/pre-write.js

sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" \
    "${FAMILY}/scripts/hooks/stop-review.js" > .ok-plumbline/hooks/stop-review.js
chmod 755 .ok-plumbline/hooks/stop-review.js

sed "s/{{OK_PLUMBLINE_VERSION}}/${SUITE_VERSION}/g" \
    "${FAMILY}/scripts/hooks/stop-instructions.js" > .ok-plumbline/hooks/stop-instructions.js
chmod 755 .ok-plumbline/hooks/stop-instructions.js

node .ok-plumbline/bin/plumbline version >/dev/null
echo "vendored: .ok-plumbline/bin/plumbline + .ok-plumbline/hooks/{post-edit,pre-write,stop-review,stop-instructions}.js (v${SUITE_VERSION})"

# @concept: integration-contract
if [ -f "${FAMILY}/LICENSE" ]; then
    {
        cat <<'PREAMBLE'
ok-plumbline, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the ok-plumbline files the suite's
administration materialized into this directory: this file, the
package marker, the binaries under bin/, the hooks under hooks/, the
practice definitions, the writing, testing, and events standards
under docs/, and the ceremony contributions under ceremony/. It
does not cover this project's own work — config.json, the budget
baseline, the subjects and practices this project authored, their
generated catalog tables of contents, their audits, and anything else
the project wrote here are the project's own, licensed however the
project licenses itself.

======================================================================

PREAMBLE
        cat "${FAMILY}/LICENSE"
    } > .ok-plumbline/LICENSE
    echo "materialized: .ok-plumbline/LICENSE"
fi

node "$BIN" vendor-skills "$ROOT"

if [ -d .claude/skills/true-up ]; then
    rm -rf .claude/skills/true-up
    echo "retired vendored payload removed: .claude/skills/true-up/"
fi

echo "Converged ok-plumbline at ${ROOT} (v${SUITE_VERSION})."
