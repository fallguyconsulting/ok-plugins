COVERED_RULES = {
    "defect-issues.md": {
        "covered": 'the "Defect issues" section of .claude/rules/ok-planner-cheatsheet.md',
        "suite": os.path.join(family_dir, "scripts", "ok-planner-cheatsheet.md"),
        "replacement": "project-defect-issues.md",
