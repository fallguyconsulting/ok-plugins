        return text == MODULE_MARKER
    if name == "LICENSE":
        return text.startswith(RETIRED_LICENSE_HEADS)
    if name in PLUMBLINE_TOCS:
        return "(auto-generated)" in text.split("\n", 1)[0]
    return suite_stamped(path) or (name == "plumbline" and LINT_VERSION_LINE.search(text) is not None)


def move_conflict_offer(src, dst):
    return {
        "id": "move-conflict:%s" % rel(src),
        "what": ["%s belongs at %s, which already holds content; converge moves neither." % (rel(src), rel(dst))],
        "choices": [
            ("keep-new", "delete %s; %s stays." % (rel(src), rel(dst))),
            ("keep-old", "replace %s with %s." % (rel(dst), rel(src))),
        ],
        "recommended": "keep-new",
        "touches": files_under(src) + files_under(dst),
        "pair": (src, dst),
    }


def estate_edits_offer(path, counterpart, where):
    if uncommitted([path]):
        state = "carries uncommitted changes"
        show = "git -C %s diff HEAD -- %s" % (shlex.quote(root), shlex.quote(rel(path)))
    elif symlinked([path]):
        state = "sits behind a symbolic link"
        show = "cat %s" % shlex.quote(path)
    else:
        state = "carries no suite stamp, so it may hold the project's edits"
        show = ("diff -u %s %s" % (shlex.quote(counterpart), shlex.quote(path))
                if counterpart is not None and os.path.isfile(counterpart) else "cat %s" % shlex.quote(path))
    return {
        "id": "estate-edits:%s" % rel(path),
        "what": ["%s is a suite file of %s, and it %s; converge removes the rest and leaves this one to the "
                 "owner." % (rel(path), where, state)],
        "show": show,
        "fix": "delete %s; nothing reads it now." % rel(path),
        "remove": [path],
    }


def leftover_offer(path, target, where):
    choices = [("delete", "delete %s." % rel(path))]
    if target is not None and not os.path.lexists(target):
        choices.insert(0, ("move", "move it to %s." % rel(target)))
    return {
        "id": "estate-leftover:%s" % rel(path),
        "what": ["%s is left in %s, which nothing reads now; converge moves and removes nothing the project "
                 "wrote there." % (rel(path), where)],
        "choices": choices,
        "recommended": choices[0][0],
        "touches": files_under(path),
        "pair": (path, target),
    }


