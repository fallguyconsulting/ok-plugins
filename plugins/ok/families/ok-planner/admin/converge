def config_defects(path):
    try:
        with open(path, encoding="utf-8") as f:
            parsed = json.load(f)
    except ValueError as err:
        return None, [str(err)]
    if not isinstance(parsed, dict):
        return None, ["top level must be an object"]
    if NODE is None:
        return parsed, []
    result = subprocess.run([NODE, PLUMBLINE_SRC, "config-check", "--config", path],
                            cwd=root, capture_output=True, text=True)
    if result.returncode == 0:
        return parsed, []
    if result.returncode == 2:
        return parsed, [line for line in result.stdout.split("\n") if line.strip()]
    detail = (result.stderr or result.stdout).strip()
    sys.exit("converge: plumbline config-check could not read %s (exit %d)%s"
             % (rel(path), result.returncode, ": " + detail if detail else ""))


