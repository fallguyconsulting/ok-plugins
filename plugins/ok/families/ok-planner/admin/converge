def plumbline_plan():
    plan = {"moves": [], "removes": [], "blocked": [], "offers": []}
    estate = os.path.isdir(plumbline_dir) and not os.path.islink(plumbline_dir)
    loose = [p for p in (OLD_CONFIGS[1], BUDGET_FILES[1]) if os.path.isfile(p)]
    if not estate and not loose:
        return plan
    plan["blocked"] = estate_blocked(([plumbline_dir] if estate else []) + loose)
    configs = [p for p in OLD_CONFIGS if os.path.isfile(p)]
    handled = set(configs)
    if configs and not os.path.lexists(planner_config):
        plan["moves"].append((configs[0], planner_config))
    else:
        for old in configs:
            plan["offers"].append({
                "id": "config-conflict:%s" % rel(old),
                "what": ["%s and %s both hold a lint config; converge moves neither, and the lint reads %s."
                         % (rel(old), rel(planner_config), rel(planner_config))],
                "choices": [
                    ("keep-new", "delete %s; %s stays." % (rel(old), rel(planner_config))),
                    ("keep-old", "replace %s with %s." % (rel(planner_config), rel(old))),
                ],
                "recommended": "keep-new",
                "touches": [old, planner_config],
                "pair": (old, planner_config),
            })
    for budget in BUDGET_FILES:
        if os.path.isfile(budget):
            handled.add(budget)
            plan["offers"].append({
                "id": "retired-file:%s" % rel(budget),
                "what": ["%s is the baseline of the retired /budget ratchet; nothing reads it now. A project turns "
                         "a lint check off with lint_checks in .ok-planner/config.json." % rel(budget)],
                "fix": "delete %s." % rel(budget),
                "remove": [budget],
            })
    if not estate:
        return plan
    for sub in PLUMBLINE_OWNER_DIRS:
        folder = os.path.join(plumbline_dir, sub)
        if os.path.islink(folder) or not os.path.isdir(folder):
            continue
        for name in sorted(os.listdir(folder)):
            src = os.path.join(folder, name)
            if name == ".DS_Store":
                continue
            dst = os.path.join(ok_dir, sub, name)
            handled.update(files_under(src))
            if os.path.lexists(dst):
                plan["offers"].append(move_conflict_offer(src, dst))
            else:
                plan["moves"].append((src, dst))
    for toc in PLUMBLINE_TOCS:
        src = os.path.join(plumbline_dir, toc)
        if os.path.isfile(src) and not os.path.lexists(os.path.join(ok_dir, toc)):
            handled.add(src)
            plan["moves"].append((src, os.path.join(ok_dir, toc)))
    rest = [f for f in files_under(plumbline_dir) if f not in handled]
    dirty = set(uncommitted(rest))
    for f in rest:
        relf = os.path.relpath(f, plumbline_dir)
        if not (os.path.basename(f) == ".DS_Store" or relf.split(os.sep)[0] in PLUMBLINE_SUITE
                or relf in PLUMBLINE_TOCS):
            plan["offers"].append(leftover_offer(f, os.path.join(ok_dir, relf), "the retired .ok-plumbline/ estate"))
        elif retired_estate_marked(f) and rel(f) not in dirty and not symlinked([f]):
            plan["removes"].append(f)
        else:
            plan["offers"].append(estate_edits_offer(f, plumbline_counterpart(relf),
                                                     "the retired .ok-plumbline/ estate"))
    return plan


