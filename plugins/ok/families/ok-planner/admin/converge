def excludes(patterns, path):
    for pattern in patterns:
        if not isinstance(pattern, str):
            continue
        if pattern.endswith("/"):
            if path.startswith(pattern) or ("/" + pattern) in ("/" + path):
                return True
        elif fnmatch.fnmatch(path, pattern):
            return True
    return False


