        write_text(target_path, dumped(config, text))
    elif kind == "review-wording":
        text = draft_file(draft)
        defects = rewrite_defects(read_text(target_path), text, stale_wording_lines, "a retired estate path")
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "script-path":
        text = draft_file(draft)
        defects = rewrite_defects(read_text(target_path), text, script_path_lines, "a script under .ok-plumbline/bin/")
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "worktrees":
        refused = worktree_refusals(o)
        if refused:
            sys.exit("resolve: %s; nothing changed. Settle each one, then run /ok again." % "; ".join(refused))
        for tree in o["trees"]:
            print("removing worktree: %s" % tree, flush=True)
            subprocess.run(["git", "-C", root, "worktree", "remove", tree], check=True)
        for branch in o["branches"]:
            print("deleting branch: %s" % branch, flush=True)
            subprocess.run(["git", "-C", root, "branch", "-d", branch], check=True)
    elif kind == "review-facts":
        text = draft_file(draft)
        if seeded_project_md(draft) or not text.strip():
            sys.exit("resolve: the draft states no facts beyond the seed; nothing written")
        write_text(target_path, text)
    elif kind == "legacy-intake":
        files = drafted_issues(draft)
        for name in files:
            write_text(os.path.join(ok_dir, "issues", name), read_text(os.path.join(draft, name)))
        remove_files(o["remove"], ok_dir)
    elif kind == "tensions":
        files = drafted_issues(draft)
        history = os.path.join(ok_dir, "history", "tensions")
        taken = [n for n in os.listdir(target_path) if os.path.exists(os.path.join(history, n))]
        if taken:
            sys.exit("resolve: history/tensions/ already holds %s; nothing written" % ", ".join(taken))
        for name in files:
            write_text(os.path.join(ok_dir, "issues", name), read_text(os.path.join(draft, name)))
        for name in sorted(os.listdir(target_path)):
            move_path(os.path.join(target_path, name), os.path.join(history, name))
        os.rmdir(target_path)
    elif kind == "intake":
        text = draft_file(draft)
        defects = issue_defects(text)
        if issue_body(text) != issue_body(read_text(target_path)):
            defects.append("the draft changes the issue body, which the offer keeps")
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "intake-closed":
        archived = os.path.join(ok_dir, "history", "issues", os.path.basename(target))
        if os.path.exists(archived):
            sys.exit("resolve: %s already exists; nothing moved" % rel(archived))
        move_path(target_path, archived)
    elif kind == "settings":
        text = draft_file(draft)
        draft_settings, draft_error = read_settings(draft)
        still = unusable_findings(draft_settings, draft_error)
        if still:
            sys.exit("resolve: the draft is unusable too: %s; nothing written" % "; ".join(still))
        settings, error = read_settings(settings_path())
        dropped = dropped_entries(settings or {}, draft_settings, unusable_entries(settings, error))
        if dropped:
            sys.exit("resolve: the draft changes entries the offer does not name: %s; nothing written"
                     % ", ".join(dropped))
        write_text(settings_path(), text)
    elif kind == "config":
        text = draft_file(draft)
        parsed, defects = config_defects(draft)
        if parsed is None or defects:
            sys.exit("resolve: the draft is malformed: %s; nothing written" % "; ".join(defects))
        if "checks" in parsed:
            sys.exit('resolve: the draft carries the retired "checks" key; nothing written')
        if o["keep"] is not None:
            changed = changed_keys(o["keep"][0], parsed, o["keep"][1])
            if changed:
                sys.exit("resolve: the draft changes keys the offer does not name: %s; nothing written"
                         % ", ".join(changed))
        write_text(target_path, text)
    elif kind == "config-key":
        parsed, _ = config_defects(target_path)
        del parsed["checks"]
        write_json(target_path, parsed)
    elif kind == "citation-tags":
        parsed = config_defects(target_path)[0] if os.path.isfile(target_path) else {}
        citations = parsed.get("citations") if isinstance(parsed.get("citations"), list) else []
        for tag, template in undeclared_citations(parsed):
            citations.append({"tag": tag, "file_template": template})
        parsed["citations"] = citations
        write_json(target_path, parsed)
    prune_tree(legacy_review)
    print("Resolved %s. Run converge to bring the estate current." % wanted)
    sys.exit(0)


def write_file(path, body, executable=False):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(body)
    if executable:
        os.chmod(path, 0o755)


def probe(path, interpreter, args):
    if interpreter == "node" and NODE is None:
        return
    argv = ([NODE] if interpreter == "node" else []) + [path] + list(args)
    try:
        result = subprocess.run(argv, cwd=root, capture_output=True, text=True)
    except OSError as err:
        sys.exit("converge: %s does not run: %s; converge wrote nothing further" % (rel(path), err))
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        sys.exit("converge: %s does not run (exit %d)%s; converge wrote nothing further"
                 % (rel(path), result.returncode, ": " + detail if detail else ""))


