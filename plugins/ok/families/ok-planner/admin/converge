# The skill-vendoring, settings-wiring, and cleanup-offer layer lives in
# one python pass so diagnose, converge, and resolve share a single
# deterministic rendering and a single reading of what is offered.
# Subcommands: diagnose | converge | wire-hooks | resolve <id> [...].
vendor_layer() {
    python3 - "$1" "$ROOT" "$SCRIPT_DIR" "$SUITE_VERSION" "$REVIEW_ESTATE_SRC" "${@:2}" <<'PY'
import json, os, re, shlex, shutil, subprocess, sys

mode, root, script_dir, version, review_src = sys.argv[1:6]
review_src = os.path.normpath(review_src)
extra = sys.argv[6:]
family_dir = os.path.dirname(script_dir)
skills_src = os.path.join(family_dir, "skills")
dest = os.path.join(root, ".claude", "skills")
agents_src = os.path.join(family_dir, "agents")
agents_dest = os.path.join(root, ".claude", "agents")

STAMP = (
    "\n<!-- Materialized by ok-planner v%s — suite-owned; overwritten on"
    " converge; do not hand-edit. -->\n" % version
)

# This family's own verbs. The audit and documentation verbs are not
# among them: they are suite-owned ceremonies, vendored by the suite's
# own converge core and covering whichever estates a project has, so no
# name here collides with another family's and none is prefixed.
SKILLS = {
    "converge": "converge",
    "discover-design": "discover-design",
    "execute-tasks": "execute-tasks",
    "ok-planner": "ok-planner",
    "ok-version": "ok-version",
    "plan-sprint": "plan-sprint",
    "sketch": "sketch",
    "triage-issues": "triage-issues",
}
UNPREFIXED = "sketch|discover-design|ok-version|execute-tasks|plan-sprint|converge|triage-issues"

# The shared folders the skills read beside their own: vendored whole,
# each carrying LICENSE.
SHARED = ("_shared", "_sprint", "_converge")

# Verbs retired from this family's vendored surface: the merged
# lifecycle verb retired when the front door became the suite's sole
# administrator, the retired prove and browse verbs, certify-all, which
# the periodic audit run replaced, verify-issues, which triage-issues
# replaced, and the project trial skills plan-sprint and converge
# replaced. A retired folder whose SKILL.md carries no suite stamp is
# the project's own: reported, never removed.
RETIRED_VENDORED = ("true-up", "prove", "browse", "certify-all", "verify-issues",
                    "plan-sprint-code", "converge-local", "converge-cascade")

# Shared files retired with the certification gate and the suite's
# planning ceremony. Removed only while they carry the suite stamp.
RETIRED_SHARED = ("_shared/certification-core.md", "_shared/sprint-document.md")


def render(text):
    text = re.sub(r"ok-planner:(%s)" % UNPREFIXED, r"\1", text)
    text = re.sub(r"(?<!\.claude/)skills/_shared/", "../_shared/", text)
    return text + STAMP


# The license text belongs in the vendored folder, not in SKILL.md — a
# skill body is read by agents, and license boilerplate there is context
# they pay for and never use. The preamble names what the grant covers,
# because .claude/skills/ also holds skills the project wrote itself.
LICENSE_SRC = os.path.join(family_dir, "LICENSE")
LICENSE_PREAMBLE = """Vendored ok-planner files, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the suite-owned files in this directory. Other
skills under .claude/skills/ are not covered by it — they carry their own
license, or the project's.

======================================================================

"""


AGENTS_LICENSE_PREAMBLE = """Vendored ok-planner agent profiles, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the ok-*.md profiles in this directory. Other
agents under .claude/agents/ are not covered by it — they carry their own
license, or the project's.

======================================================================

"""


def vendored_license(preamble=LICENSE_PREAMBLE):
    with open(LICENSE_SRC, encoding="utf-8") as f:
        return preamble + f.read()


def skill_markdown(folder):
    for dirpath, dirnames, files in os.walk(folder):
        dirnames.sort()
        for fn in sorted(files):
            if fn.endswith(".md"):
                path = os.path.join(dirpath, fn)
                yield path, os.path.relpath(path, folder)


def expected():
    out = {}
    licensed = set()
    for src, name in list(SKILLS.items()) + [(n, n) for n in SHARED]:
        for path, rel in skill_markdown(os.path.join(skills_src, src)):
            with open(path, encoding="utf-8") as f:
                out[os.path.join(dest, name, rel)] = render(f.read())
        licensed.add(name)
    if os.path.isdir(agents_src):
        for fn in sorted(os.listdir(agents_src)):
            if fn.endswith(".md"):
                with open(os.path.join(agents_src, fn), encoding="utf-8") as f:
                    out[os.path.join(agents_dest, fn)] = render(f.read())
        if os.path.exists(LICENSE_SRC):
            out[os.path.join(agents_dest, "LICENSE")] = vendored_license(AGENTS_LICENSE_PREAMBLE)
    if os.path.exists(LICENSE_SRC):
        body = vendored_license()
        for name in licensed:
            out[os.path.join(dest, name, "LICENSE")] = body
    return out


ENTRY = {
    "matcher": "startup|clear|compact",
    "hooks": [
        {
            "type": "command",
            "command": 'bash "$CLAUDE_PROJECT_DIR/.ok-planner/hooks/session-start"',
            "async": False,
        }
    ],
}
MARKER = ".ok-planner/hooks/session-start"


def settings_findings():
    path = os.path.join(root, ".claude", "settings.json")
    findings = []
    entry = None
    settings = {}
    if os.path.exists(path):
        try:
            settings = json.load(open(path))
        except ValueError:
            findings.append("unusable: .claude/settings.json does not parse — cannot check hook wiring; "
                            "the ok core offers its repair")
            return findings
    hooks = settings.get("hooks", {}) if isinstance(settings, dict) else None
    session = hooks.get("SessionStart", []) if isinstance(hooks, dict) else None
    if not isinstance(session, list):
        findings.append("unusable: .claude/settings.json holds a shape the harness cannot read — "
                        "cannot check hook wiring; the ok core offers its repair")
        return findings
    for e in session:
        if isinstance(e, dict) and any(isinstance(h, dict) and MARKER in str(h.get("command", ""))
                                       for h in e.get("hooks", []) if isinstance(e.get("hooks"), list)):
            entry = e
            break
    if entry is None:
        findings.append("wiring: .claude/settings.json lacks the ok-planner SessionStart entry")
    elif entry.get("matcher") != ENTRY["matcher"]:
        findings.append(
            "wiring: the ok-planner SessionStart entry's matcher is %r — must be %r"
            % (entry.get("matcher"), ENTRY["matcher"])
        )
    return findings


def print_wiring_block():
    print("WIRING NEEDED (ok-planner): .claude/settings.json needs the SessionStart entry below.")
    print(json.dumps({"hooks": {"SessionStart": [ENTRY]}}, indent=2))
    print("On the owner's consent run: %s" % " ".join(
        shlex.quote(a) for a in ("bash", os.path.join(script_dir, "converge"), "wire-hooks")))


if mode == "wire-hooks":
    path = os.path.join(root, ".claude", "settings.json")
    settings = {}
    if os.path.exists(path):
        settings = json.load(open(path))
    hooks = settings.setdefault("hooks", {})
    session = hooks.setdefault("SessionStart", [])
    wrote = False
    for e in session:
        if any(MARKER in h.get("command", "") for h in e.get("hooks", [])):
            if e.get("matcher") != ENTRY["matcher"]:
                e["matcher"] = ENTRY["matcher"]
                wrote = True
            break
    else:
        session.append(ENTRY)
        wrote = True
    if wrote:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        print("wired: ok-planner SessionStart entry transcribed into .claude/settings.json")
    else:
        print("wiring already in place: .claude/settings.json")
    sys.exit(0)

exp = expected()


ANY_OK_STAMP = "<!-- Materialized by ok"
EXIT_DRIFT = 1
EXIT_OFFERS_ONLY = 3


def read_text(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def stamped(path):
    if not os.path.isfile(path):
        return False
    lines = [l for l in read_text(path).split("\n") if l.strip()]
    return bool(lines) and lines[-1].startswith(ANY_OK_STAMP)


def owned_markdown(path):
    return path.endswith(".md") and os.path.lexists(path) and not stamped(path)


def vendored_folder(path):
    """The folder a vendored skill path belongs to: its top folder under
    .claude/skills/, or None for an agent profile."""
    if not path.startswith(dest + os.sep):
        return None
    return os.path.join(dest, os.path.relpath(path, dest).split(os.sep)[0])


# A vendored path holding a markdown file the project wrote is a
# collision. Keyed by the skill folder, or by the agent profile itself;
# each key lists the colliding paths, the only ones resolve deletes.
COLLIDED = {}
for _p in sorted(exp):
    if owned_markdown(_p):
        COLLIDED.setdefault(vendored_folder(_p) or _p, []).append(_p)


def collision(path):
    """A vendored path converge leaves alone: an agent profile the
    project wrote, or any file of a skill folder holding one."""
    if path.startswith(agents_dest + os.sep):
        return path in COLLIDED
    return vendored_folder(path) in COLLIDED


def collision_label(key):
    return os.path.relpath(key, root) + ("/" if key.startswith(dest + os.sep) else "")


def suite_file(path):
    name = os.path.basename(path)
    if name == ".DS_Store":
        return True
    if name == "LICENSE":
        return read_text(path).startswith("Vendored ok")
    return name.endswith(".md") and stamped(path)


def files_under(path):
    if not os.path.isdir(path) or os.path.islink(path):
        return [path] if os.path.lexists(path) else []
    found = []
    for dirpath, dirnames, files in os.walk(path):
        dirnames.sort()
        found.extend(os.path.join(dirpath, fn) for fn in sorted(files))
    return found


def retirements():
    """Every retired vendored folder present, split into the files a
    suite stamp marks (converge removes them) and the files the project
    wrote (offered). A folder whose SKILL.md carries no suite stamp is
    the project's own whole."""
    out = []
    for name in RETIRED_VENDORED:
        folder = os.path.join(dest, name)
        if os.path.islink(folder) or not os.path.isdir(folder):
            continue
        files = files_under(folder)
        if not stamped(os.path.join(folder, "SKILL.md")):
            out.append((name, [], files))
            continue
        suite = [f for f in files if suite_file(f)]
        out.append((name, suite, [f for f in files if f not in suite]))
    return out


ok_dir = os.path.join(root, ".ok-planner")
legacy_review = os.path.join(root, ".ok-review")
review_dest = os.path.join(ok_dir, "review")
core = os.path.join(script_dir, "converge")


def rel(path):
    return os.path.relpath(path, root)


def git_lines(*args):
    out = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True)
    if out.returncode != 0:
        return None
    return [l for l in out.stdout.split("\0") if l]


def tracked_files(paths):
    rels = [rel(p) for p in paths]
    return (git_lines("ls-files", "-z", "--", *rels) or []) if rels else []


def uncommitted(paths):
    """The paths among these whose working copy or index differs from
    HEAD. An untracked path is not among them: the offer names it, and
    plain removal takes it."""
    rels = [rel(p) for p in paths]
    if not rels:
        return []
    if git_lines("rev-parse", "-q", "--verify", "HEAD") is None:
        return sorted(git_lines("ls-files", "-z", "--", *rels) or [])
    changed = set()
    for cached in ((), ("--cached",)):
        changed.update(git_lines("diff", *cached, "--name-only", "--no-renames", "-z", "--relative",
                                 "HEAD", "--", *rels) or [])
    return sorted(changed)


def symlinked(paths):
    """The symbolic links between the project root and these paths."""
    found = set()
    for path in paths:
        p = os.path.dirname(path)
        while p.startswith(root + os.sep):
            if os.path.islink(p):
                found.add(rel(p))
            p = os.path.dirname(p)
    return sorted(found)


def refuse_unless_removable(paths):
    links = symlinked(paths)
    if links:
        sys.exit("resolve: %s is a symbolic link; nothing changed. Replace the link with the folder it "
                 "points at, or remove the link yourself, then run /ok again." % ", ".join(links))
    changed = uncommitted(paths)
    if changed:
        sys.exit("resolve: %s carry uncommitted changes; nothing changed. Commit those changes first, "
                 "then run /ok again." % ", ".join(changed))


def prune(paths, stop):
    for p in sorted({os.path.dirname(p) for p in paths}, key=len, reverse=True):
        while p != stop and p.startswith(stop + os.sep) and os.path.isdir(p) and not os.listdir(p):
            os.rmdir(p)
            p = os.path.dirname(p)


def stop_for(path):
    for stop in (legacy_review, dest, agents_dest, RULES_DIR, review_dest, ok_dir):
        if path.startswith(stop + os.sep):
            return root if stop == legacy_review else stop
    return root


def prune_legacy_review():
    if not os.path.isdir(legacy_review) or os.path.islink(legacy_review):
        return
    for dirpath, _, _ in sorted(os.walk(legacy_review), key=lambda w: len(w[0]), reverse=True):
        if not os.listdir(dirpath):
            os.rmdir(dirpath)


def remove_files(paths, stop):
    """Removes the named files: plain `git rm` for a tracked file whose
    working copy and index match HEAD, plain removal for an untracked
    one. Refuses the whole set when any carries uncommitted work or sits
    behind a symbolic link."""
    refuse_unless_removable(paths)
    tracked = tracked_files(paths)
    if tracked:
        subprocess.run(["git", "-C", root, "rm", "-q", "--"] + tracked, check=True)
    for p in paths:
        if os.path.lexists(p):
            os.remove(p)
    prune(paths, stop)
    for p in paths:
        print("removed: %s%s" % (rel(p), " (git rm; staged)" if rel(p) in tracked else ""))


def move_path(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if tracked_files([src]):
        subprocess.run(["git", "-C", root, "mv", "--", rel(src), rel(dst)], check=True)
    else:
        shutil.move(src, dst)
    print("moved: %s -> %s" % (rel(src), rel(dst)))


# Project rule files that restate what this family's materialized rules
# now carry, each with the suite text that covers it and the project
