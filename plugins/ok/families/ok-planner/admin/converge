LINT_CHECK_OPEN = re.compile(r"<!-- lint-check: (\S+) -->")
LINT_CHECK_CLOSE = "<!-- /lint-check -->"


def chosen_lint_checks():
    checks = dict.fromkeys(LINT_CHECKS, True)
    path = lint_config_path()
    if not os.path.isfile(path):
        return checks
