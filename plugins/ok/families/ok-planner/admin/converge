WHOLE_FILE = ()


def unusable_entries(settings, error):
    """The entries the settings offer names: each a key path into the
    file, the whole file when it cannot be read as an object."""
    if error is not None:
        return {WHOLE_FILE}
    named = set()
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        named.add(("hooks",))
    else:
        for wiring in WIRINGS:
            entries = hooks.get(wiring["event"], [])
            if not isinstance(entries, list) or marked_entry(entries, wiring)[1] is not None:
                named.add(("hooks", wiring["event"]))
    if not isinstance(settings.get("env", {}), dict):
        named.add(("env",))
    return named


def dropped_entries(current, draft, named, prefix=()):
    """Every entry of `current` the offer does not name that the draft
    drops, changes, or adds beside, as dotted key paths."""
    if WHOLE_FILE in named:
        return []
    found = []
    for key in sorted(set(current) | set(draft)):
        here = prefix + (key,)
        if here in named:
            continue
        label = ".".join(here)
        if any(n[:len(here)] == here for n in named) and isinstance(current.get(key), dict):
            if not isinstance(draft.get(key), dict):
                found.append(label)
            else:
                found.extend(dropped_entries(current[key], draft[key], named, here))
        elif key not in draft:
            found.append(label + " (dropped)")
        elif key not in current:
            found.append(label + " (added)")
        elif json_value(current[key]) != json_value(draft[key]):
            found.append(label + " (changed)")
    return found


