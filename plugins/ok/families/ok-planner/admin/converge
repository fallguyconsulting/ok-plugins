def stamped(path):
    if not os.path.isfile(path):
        return False
    lines = [l for l in read_text(path).split("\n") if l.strip()]
    return bool(lines) and lines[-1].startswith(ANY_OK_STAMP)


def head_stamped(path):
    if not os.path.isfile(path):
        return False
    return any("Materialized by ok" in line for line in read_text(path).split("\n")[:5])


def suite_stamped(path):
    return stamped(path) or head_stamped(path)


def owned(path):
    if not path.startswith(claude_dir + os.sep) or os.path.basename(path) == "LICENSE":
        return False
    if not os.path.lexists(path):
        return False
    if path.startswith(dest + os.sep) or path.startswith(agents_dest + os.sep):
        return path.endswith(".md") and not stamped(path)
    if path in FIXED_RULES:
        return not fixed_content(path, FIXED_RULES[path])
