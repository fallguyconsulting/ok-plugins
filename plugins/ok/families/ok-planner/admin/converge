def suite_file(path):
    name = os.path.basename(path)
    if name == ".DS_Store":
        return True
    if name == "LICENSE":
        return read_text(path).startswith("Vendored ok")
    return name.endswith(".md") and stamped(path)


def files_under(path):
    if not os.path.isdir(path) or os.path.islink(path):
        return [path] if os.path.lexists(path) else []
    found = []
    for dirpath, dirnames, files in os.walk(path):
        dirnames.sort()
        found.extend(os.path.join(dirpath, fn) for fn in sorted(files))
    return found


def retirements():
    """Every retired vendored folder present, split into the files a
    suite stamp marks (converge removes them) and the files the project
    wrote (offered). A folder whose SKILL.md carries no suite stamp is
    the project's own whole: offered at a RETIRED_VENDORED name, and
    left alone at a RETIRED_WHERE_STAMPED name, where the suite may
    never have written it. At a RETIRED_WHERE_STAMPED name converge
    removes the suite-stamped files and offers nothing."""
    out = []
    for name in RETIRED_VENDORED + RETIRED_WHERE_STAMPED:
        folder = os.path.join(dest, name)
        if os.path.islink(folder) or not os.path.isdir(folder):
            continue
        files = files_under(folder)
        if not stamped(os.path.join(folder, "SKILL.md")):
            if name in RETIRED_VENDORED:
                out.append((name, [], files))
            continue
        suite = [f for f in files if suite_file(f)]
        owned = [f for f in files if f not in suite] if name in RETIRED_VENDORED else []
        out.append((name, suite, owned))
    return out


