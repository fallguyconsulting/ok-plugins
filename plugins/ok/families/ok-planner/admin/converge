    },
}
RULES_DIR = os.path.join(root, ".claude", "rules")
SENTENCE_WORDS = 8


def sentences(text):
    flat = re.sub(r"[`*_]", "", re.sub(r"\s+", " ", text)).lower()
    return {s.strip() for s in re.split(r"(?<=[.!?])\s+", flat) if len(s.split()) >= SENTENCE_WORDS}


def rule_draft_defects(draft_text, old_text, suite_text):
    """A replacement rule carries only project facts: it is shorter than
    the file it replaces and repeats no sentence of the suite text."""
    found = []
    if len(draft_text.encode("utf-8")) >= len(old_text.encode("utf-8")):
        found.append("it is not shorter than the file it replaces")
    restated = sorted(sentences(draft_text) & sentences(suite_text))
    if restated:
        found.append("it restates the suite rule: %s" % "; ".join(repr(s) for s in restated[:3]))
    return found


# The retired planning layouts and where their entries live now.
# Converge moves each entry whose new path is free; an entry whose new
# path is taken is offered to the owner.
MIGRATION_DIRS = (
    ("backlogs", "sprints"),
    ("specs", "sprints"),
    ("history/backlogs", "history/sprints"),
    ("history/specs", "history/sprints"),
    ("plans", "history/plans"),
    ("coverage", "history/coverage"),
)


def migration_moves():
    moves = []
    for old, new in MIGRATION_DIRS:
        src = os.path.join(ok_dir, old)
        if os.path.isdir(src):
            for name in sorted(os.listdir(src)):
                if name != ".DS_Store":
                    moves.append((os.path.join(src, name), os.path.join(ok_dir, new, name)))
    design = os.path.join(ok_dir, "design")
    if os.path.isdir(design):
