def stale_review_settings(config):
    found, swaps = [], []
    hunt = config.get("hunt")
    if isinstance(hunt, dict) and hunt.get("rotation") == ".ok-review/rotation.json":
        found.append("hunt.rotation names .ok-review/rotation.json")
        swaps.append((hunt["rotation"], ".ok-planner/review/rotation.json"))
        hunt["rotation"] = ".ok-planner/review/rotation.json"
    exclude = config.get("exclude")
    if isinstance(exclude, list) and ".ok-review/" in exclude:
        found.append("exclude names .ok-review/")
        kept = [e for e in exclude if e != ".ok-review/"]
        if not review_excludes(kept, REVIEW_ESTATE_PROBE):
            kept.append(".ok-planner/")
        config["exclude"] = kept
    sources = config.get("block_sources")
    if isinstance(sources, list) and REVIEW_RETIRED_SOURCE in sources:
        found.append("block_sources names the retired %s" % REVIEW_RETIRED_SOURCE)
        sources = [b for b in sources if b != REVIEW_RETIRED_SOURCE]
        if REVIEW_SPRINT_SOURCE not in sources:
            sources.append(REVIEW_SPRINT_SOURCE)
        config["block_sources"] = sources
    for key in ("standards", "checks"):
        entries = config.get(key)
        if not isinstance(entries, list):
            continue
        stale = [e for e in entries if isinstance(e, str) and planner_path(e) != e]
        if stale:
            found.append("%s names %s" % (key, ", ".join(stale)))
            swaps.extend((e, planner_path(e)) for e in stale)
            config[key] = [planner_path(e) if isinstance(e, str) else e for e in entries]
    return found, swaps


