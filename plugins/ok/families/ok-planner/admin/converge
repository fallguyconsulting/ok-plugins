                moves.append((os.path.join(design, name), os.path.join(ok_dir, "history", name)))
    return moves


# The review loop's owner files the pre-move .ok-review/ estate held,
# with the rotation record and the run ledgers beside them: each moves
# to .ok-planner/review/ whole.
REVIEW_MOVED = ("runs", "config.json", "project.md", "rotation.json")
REVIEW_TOOL_SRC = os.path.join(family_dir, "scripts", "review")


def suite_renderings(src):
    """The forms a suite-owned file took in the old estate: the carried
    text as is, version-rendered, and version-rendered under the stamp."""
    raw = read_text(src)
    rendered = raw.replace("{{OK_PLANNER_VERSION}}", version)
    return {raw, rendered, rendered + STAMP}


def legacy_suite_copy(relf):
    if relf == os.path.join("bin", "review"):
        return REVIEW_TOOL_SRC
    if relf == "CLAUDE.md" or (relf.startswith("catalog" + os.sep) and relf.endswith(".md")):
        return os.path.join(review_src, relf)
    return None


def review_plan():
    """What converge does with a pre-move .ok-review/ estate, settled
    before anything moves: the owner files that move, the suite-owned
    files that go, what stops the move, and what waits for the owner."""
    plan = {"moves": [], "removes": [], "blocked": [], "offers": []}
    if not os.path.isdir(legacy_review) or os.path.islink(legacy_review):
        return plan
    unmerged = git_lines("ls-files", "-u", "-z", "--", rel(legacy_review)) or []
    if unmerged:
        plan["blocked"].append("%s has unmerged paths (%s)" % (rel(legacy_review), ", ".join(
            sorted({l.split("\t", 1)[-1] for l in unmerged}))))
    for item in REVIEW_MOVED:
        src = os.path.join(legacy_review, item)
        if not os.path.lexists(src):
            continue
        dst = os.path.join(review_dest, item)
        if os.path.lexists(dst) and not (os.path.isdir(dst) and not os.listdir(dst)):
            plan["offers"].append({
                "id": "review-conflict:%s" % rel(src),
                "what": ["%s and %s both hold content; converge moves neither." % (rel(src), rel(dst))],
                "choices": [
                    ("keep-new", "delete %s; %s stays." % (rel(src), rel(dst))),
                    ("keep-old", "replace %s with %s." % (rel(dst), rel(src))),
                ],
                "recommended": "keep-new",
                "touches": files_under(src) + files_under(dst),
                "pair": (src, dst),
            })
            continue
        deleted = git_lines("ls-files", "-d", "-z", "--", rel(src)) or []
        if deleted:
            plan["blocked"].append("%s has tracked files missing from the working tree (%s)"
                                   % (rel(src), ", ".join(deleted)))
        plan["moves"].append((src, dst))
    for f in files_under(legacy_review):
        relf = os.path.relpath(f, legacy_review)
        if relf.split(os.sep)[0] in REVIEW_MOVED:
            continue
        if os.path.basename(f) == ".DS_Store" or "__pycache__" in relf.split(os.sep):
            plan["removes"].append(f)
            continue
        suite_copy = legacy_suite_copy(relf)
        if suite_copy is None:
            target = os.path.join(review_dest, relf)
            choices = [("delete", "delete %s." % rel(f))]
            if not os.path.lexists(target):
                choices.insert(0, ("move", "move it to %s." % rel(target)))
            plan["offers"].append({
                "id": "review-leftover:%s" % rel(f),
                "what": ["%s is left in the retired .ok-review/ estate; the review loop reads only "
                         ".ok-planner/review/ now." % rel(f)],
                "choices": choices,
                "recommended": choices[0][0],
                "touches": [f],
                "pair": (f, target),
            })
            continue
        matches = os.path.isfile(suite_copy) and read_text(f) in suite_renderings(suite_copy)
        if matches and not uncommitted([f]) and not symlinked([f]):
            plan["removes"].append(f)
            continue
        kind = "catalog-edits" if relf.startswith("catalog" + os.sep) else "review-edits"
        plan["offers"].append({
            "id": "%s:%s" % (kind, rel(f)),
            "what": ["%s %s; the suite's copy, suite-owned now, stands at %s." % (
                rel(f), "matches the suite's copy but carries uncommitted changes" if matches
                else "differs from the suite's copy", rel(os.path.join(review_dest, relf))
                if relf != os.path.join("bin", "review") else ".ok-planner/bin/review")],
            "show": ("diff -u %s %s" % (shlex.quote(suite_copy), shlex.quote(f))) if os.path.isfile(suite_copy)
                    else "cat %s" % shlex.quote(f),
            "fix": "delete %s; the suite's copy stands." % rel(f),
            "remove": [f],
        })
    return plan


def review_config_path():
    for estate in (review_dest, legacy_review):
        path = os.path.join(estate, "config.json")
        if os.path.isfile(path):
            return path
    return None


REVIEW_CONFIG_KEYS = ("exclude", "prose_suffixes", "test_patterns", "bug_families")


def review_config_defects(path):
    try:
        with open(path, encoding="utf-8") as f:
            config = json.load(f)
    except ValueError as err:
        return ["it does not parse: %s" % err]
    if not isinstance(config, dict):
        return ["its top level is not an object"]
    return ["it declares no %r" % key for key in REVIEW_CONFIG_KEYS if key not in config]


def wording_target():
    for estate in (review_dest, legacy_review):
        path = os.path.join(estate, "project.md")
        if os.path.isfile(path):
            return path
    return None


def stale_wording_lines(text):
    return [n for n, l in enumerate(text.split("\n"))
            if ".ok-review" in l.replace(".ok-review/bin/review", "")]


ISSUE_KINDS = ("audit", "discover", "sprint", "human")
ISSUE_STATUSES = ("open", "verified", "answered", "promoted", "retired", "fixed")
CLOSED_STATUSES = ("answered", "retired", "fixed")
ISSUE_NAME = re.compile(r"^\d{4}-\d{2}-\d{2}-\d{6}-[a-z0-9][a-z0-9-]*\.md$")


def frontmatter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 3)
    if end == -1:
        return None
    fields = {}
    for line in text[4:end].split("\n"):
        m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", line)
        if m:
            fields[m.group(1)] = m.group(2).strip()
    return fields


def issue_body(text):
    if text.startswith("---\n"):
        end = text.find("\n---\n", 3)
        if end != -1:
            return text[end + 5:].lstrip("\n")
    return text.lstrip("\n")


def issue_defects(text):
    fm = frontmatter(text)
    if fm is None:
        return ["no frontmatter block"]
    found = []
    for key in ("issue", "category", "opened"):
        if not fm.get(key):
            found.append("no `%s`" % key)
    if fm.get("kind") not in ISSUE_KINDS:
        found.append("`kind: %s` is not one of %s" % (fm.get("kind", ""), " | ".join(ISSUE_KINDS)))
    if fm.get("status") not in ISSUE_STATUSES:
        found.append("`status: %s` is not one of %s" % (fm.get("status", ""), " | ".join(ISSUE_STATUSES)))
    if fm.get("status") == "promoted":
        sprint = fm.get("sprint", "")
        if not sprint or not any(os.path.isfile(os.path.join(ok_dir, d, sprint))
                                 for d in ("sprints", "history/sprints")):
            found.append("`status: promoted` names no sprint under sprints/ or history/sprints/")
    return found


def issue_status(text):
    return (frontmatter(text) or {}).get("status")


def folder_differs(key):
    """Whether the project's copy at a collided path differs from the
    suite's copy, the suite stamp aside."""
    expected_here = {p: b for p, b in exp.items()
                     if (p == key or p.startswith(key + os.sep))
                     and os.path.basename(p) != "LICENSE"}
    for p, body in expected_here.items():
        if not os.path.isfile(p) or read_text(p) != body[:-len(STAMP)]:
            return True
    if os.path.isdir(key):
        for dirpath, _, files in os.walk(key):
            for fn in files:
                p = os.path.join(dirpath, fn)
                if fn not in ("LICENSE", ".DS_Store") and p not in expected_here:
                    return True
    return False


def seeded_project_md(path):
    seed = os.path.join(review_src, "seed", "project.md")
    return os.path.isfile(seed) and read_text(path) == read_text(seed)


def offers():
    """Every item converge leaves for the owner, each with the one fix
    `resolve` applies. Ids are `<kind>:<path from the project root>`."""
    out = []
    for key, paths in sorted(COLLIDED.items()):
        label = collision_label(key)
        out.append({
            "id": "collision:%s" % label.rstrip("/"),
            "what": ["%s holds the project's own copy (no suite stamp) of %d file(s) at paths the suite "
                     "vendors; it %s:" % (label, len(paths), "differs from the suite's copy"
                                          if folder_differs(key) else "matches the suite's copy apart from the stamp")]
                    + [rel(p) for p in paths],
            "fix": "delete the files listed above; converge then writes the suite's copy, and the folder's "
                   "other files stay.",
            "remove": paths,
        })
    for name, _, owned in retirements():
        if owned:
            out.append({
                "id": "retired-verb:.claude/skills/%s" % name,
                "what": [".claude/skills/%s/ holds files the project wrote at a name the suite retired; "
                         "the vendored skills replace it:" % name] + [rel(f) for f in owned],
                "fix": "delete the files listed above.",
                "remove": owned,
            })
    for name, rule in sorted(COVERED_RULES.items()):
        old = os.path.join(RULES_DIR, name)
        if os.path.isfile(old):
            out.append({
                "id": "rule-file:%s" % rel(old),
                "what": ["%s restates what %s now carries, beside facts only this project holds."
                         % (rel(old), rule["covered"])],
                "draft": "a short project rule holding only %s, or an empty file when it names none; it "
                         "restates no sentence of the suite text and is shorter than %s."
                         % (rule["facts"], rel(old)),
                "fix": "write a non-empty draft as .claude/rules/%s, then delete %s."
                       % (rule["replacement"], rel(old)),
                "remove": [old],
            })
    plan = review_plan()
    out.extend(plan["offers"])
    config_path = review_config_path()
    if config_path is not None and review_config_defects(config_path):
        out.append({
            "id": "review-config:%s" % rel(config_path),
            "what": ["%s cannot be read as the review loop's config, so converge rewrites no stale "
                     "setting in it:" % rel(config_path)] + review_config_defects(config_path),
            "draft": "the whole corrected config.json, each defect above repaired and nothing else changed.",
            "fix": "write the drafted config over %s." % rel(config_path),
        })
    project_md = os.path.join(review_dest, "project.md")
    wording = wording_target()
    if os.path.isfile(project_md) and seeded_project_md(project_md):
        out.append({
            "id": "review-facts:.ok-planner/review/project.md",
            "what": [".ok-planner/review/project.md is still the seeded skeleton; /converge pastes it "
                     "into every prompt, so each section must state this project's facts."],
            "draft": "the whole new text of .ok-planner/review/project.md, each section's instruction "
                     "line replaced with this project's facts read from the tree, a section left empty "
                     "where the project has nothing to say.",
            "fix": "write the drafted text as .ok-planner/review/project.md.",
        })
    elif wording is not None:
        lines = read_text(wording).split("\n")
        named = stale_wording_lines(read_text(wording))
        if named:
            out.append({
                "id": "review-wording:%s" % rel(wording),
                "what": ["%s still names .ok-review, which moved to .ok-planner/review:" % rel(wording)]
                        + ["line %d: %s" % (n + 1, lines[n].strip()) for n in named],
                "draft": "the whole new text of %s, each line above reworded to name the current path "
                         "and every other line unchanged." % rel(wording),
                "fix": "write the drafted text over %s." % rel(wording),
            })
    jsonl = os.path.join(ok_dir, "issues.jsonl")
    if os.path.isfile(jsonl):
        out.append({
            "id": "legacy-intake:.ok-planner/issues.jsonl",
            "what": [".ok-planner/issues.jsonl is the retired intake; nothing reads it."],
            "draft": "a directory holding one issue file per open row, each named and shaped per the "
                     "issue file format in .claude/skills/_shared/artifact-definitions.md.",
            "fix": "write each drafted file into .ok-planner/issues/, then delete .ok-planner/issues.jsonl.",
            "remove": [jsonl],
        })
    tensions = os.path.join(ok_dir, "design", "tensions")
    if os.path.isdir(tensions):
        out.append({
            "id": "tensions:.ok-planner/design/tensions",
            "what": [".ok-planner/design/tensions/ is the pre-4.0 tension layout; its live tensions are "
                     "issues now."],
            "draft": "a directory holding one issue file per live tension (skip _resolved/ and _rejected/), "
                     "per the pre-4.0 migration in the family's admin/ADMINISTRATION.md.",
            "fix": "write each drafted file into .ok-planner/issues/, then move design/tensions/ to "
                   "history/tensions/.",
        })
    for src, dst in migration_moves():
        if os.path.exists(dst):
            out.append({
                "id": "move-conflict:%s" % rel(src),
                "what": ["%s belongs at %s, which already holds content; converge moves neither."
                         % (rel(src), rel(dst))],
                "choices": [
                    ("keep-new", "delete %s; %s stays." % (rel(src), rel(dst))),
                    ("keep-old", "replace %s with %s." % (rel(dst), rel(src))),
                ],
                "recommended": "keep-new",
                "touches": files_under(src) + files_under(dst),
                "pair": (src, dst),
            })
    issues_dir = os.path.join(ok_dir, "issues")
    if os.path.isdir(issues_dir):
        for name in sorted(os.listdir(issues_dir)):
            path = os.path.join(issues_dir, name)
            if not name.endswith(".md") or not os.path.isfile(path):
                continue
            text = read_text(path)
            defects = issue_defects(text)
            if defects:
                out.append({
                    "id": "intake:%s" % rel(path),
                    "what": ["%s is malformed: %s." % (rel(path), "; ".join(defects))],
                    "draft": "the whole corrected issue file, frontmatter per the issue file format in "
                             ".claude/skills/_shared/artifact-definitions.md, body unchanged.",
                    "fix": "write the drafted file over %s." % rel(path),
                })
            elif issue_status(text) in CLOSED_STATUSES:
                out.append({
                    "id": "intake-closed:%s" % rel(path),
                    "what": ["%s is closed (`status: %s`) but still sits in the intake."
                             % (rel(path), issue_status(text))],
                    "fix": "move it to .ok-planner/history/issues/%s." % name,
                })
    for o in out:
        o["uncommitted"] = uncommitted(o.get("remove", []) + o.get("touches", []))
        o["links"] = symlinked(o.get("remove", []) + o.get("touches", []))
    return out


def consent_command(*args):
    return " ".join(shlex.quote(a) for a in ("bash", core) + args)


def print_offer(o):
    print("CLEANUP OFFERED (ok-planner): %s" % o["id"])
    print("  What: %s" % o["what"][0])
    for line in o["what"][1:]:
        print("    %s" % line)
    if "show" in o:
        print("  Show: %s" % o["show"])
    if "draft" in o:
        print("  Draft: %s" % o["draft"])
    if o["uncommitted"]:
        print("  Uncommitted: %s carry uncommitted changes; resolve refuses until they are committed. "
              "Commit those changes first, then run /ok again." % ", ".join(o["uncommitted"]))
    if o["links"]:
        print("  Symbolic link: %s; resolve refuses to change files behind a link. Replace the link with "
              "the folder it points at, or remove the link yourself." % ", ".join(o["links"]))
    if "choices" in o:
        for name, text in o["choices"]:
            print("  Choice %s: %s" % (name, text))
        print("  Recommended: %s" % o["recommended"])
        print("  On the owner's consent run one of:")
        for name, _ in o["choices"]:
            print("    %s" % consent_command("resolve", o["id"], name))
        return
    print("  Fix: %s" % o["fix"])
    print("  Recommended: accept")
    if "draft" in o:
        print("  On the owner's consent run: %s --from <draft>" % consent_command("resolve", o["id"]))
    else:
        print("  On the owner's consent run: %s" % consent_command("resolve", o["id"]))


def drafted_issues(draft_dir):
    """The issue files a drafted directory holds, each checked against
    the intake's own reading; refuses the whole draft on any defect."""
    if not os.path.isdir(draft_dir):
        sys.exit("resolve: --from must name a directory of issue files: %s" % draft_dir)
    files = sorted(n for n in os.listdir(draft_dir) if n.endswith(".md"))
    if not files:
        sys.exit("resolve: %s holds no issue files" % draft_dir)
    for name in files:
        text = read_text(os.path.join(draft_dir, name))
        defects = issue_defects(text)
        if not ISSUE_NAME.match(name):
            defects.append("the name is not <YYYY-MM-DD-HHMMSS>-<slug>.md")
        if issue_status(text) in CLOSED_STATUSES:
            defects.append("a closed issue does not belong in the intake")
        if os.path.exists(os.path.join(ok_dir, "issues", name)):
            defects.append(".ok-planner/issues/%s already exists" % name)
        if defects:
            sys.exit("resolve: drafted %s refused: %s" % (name, "; ".join(defects)))
    return files


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    print("written: %s" % rel(path))


def draft_file(draft):
    if not os.path.isfile(draft):
        sys.exit("resolve: --from must name a file: %s" % draft)
    return read_text(draft)


def wording_defects(old_text, new_text):
    """A reworded project.md changes only the lines the offer lists, and
    each of them stops naming .ok-review."""
    if not new_text.strip():
        return ["the draft is empty"]
    old_lines, new_lines = old_text.split("\n"), new_text.split("\n")
    if len(old_lines) != len(new_lines):
        return ["the draft has %d lines where the file has %d; only the listed lines change"
                % (len(new_lines), len(old_lines))]
    named = set(stale_wording_lines(old_text))
    found = ["line %d changed, which the offer does not list" % (n + 1)
             for n, (a, b) in enumerate(zip(old_lines, new_lines)) if n not in named and a != b]
    found += ["line %d still names .ok-review" % (n + 1) for n in stale_wording_lines(new_text)]
    return found


if mode == "resolve":
    if not extra:
        sys.exit("usage: converge resolve <id> [<choice>|--from <draft>]")
    wanted, args = extra[0], extra[1:]
    current = {o["id"]: o for o in offers()}
    if wanted not in current:
        sys.exit("resolve: ok-planner offers nothing as %s at %s; run diagnose for the current offers"
                 % (wanted, root))
    o = current[wanted]
    kind, target = wanted.split(":", 1)
    target_path = os.path.join(root, target)
    draft = None
    if "draft" in o:
        if len(args) != 2 or args[0] != "--from":
            sys.exit("resolve: %s writes a draft; run it as: resolve %s --from <draft>" % (wanted, wanted))
        draft = os.path.abspath(args[1])
    elif "choices" in o:
        names = [n for n, _ in o["choices"]]
        if len(args) != 1 or args[0] not in names:
            sys.exit("resolve: %s takes one choice: %s" % (wanted, " | ".join(names)))
    elif args:
        sys.exit("resolve: %s takes no further argument" % wanted)
    refuse_unless_removable(o.get("remove", []) + o.get("touches", []))
    if kind in ("collision", "retired-verb", "catalog-edits", "review-edits"):
        remove_files(o["remove"], stop_for(o["remove"][0]))
    elif kind == "rule-file":
        text = draft_file(draft)
        rule = COVERED_RULES[os.path.basename(target)]
        if text.strip():
            defects = rule_draft_defects(text, read_text(target_path), read_text(rule["suite"]))
            replacement = os.path.join(RULES_DIR, rule["replacement"])
            if os.path.lexists(replacement):
                defects.append("%s already exists" % rel(replacement))
            if defects:
                sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
            write_text(replacement, text)
        remove_files(o["remove"], RULES_DIR)
    elif kind in ("review-conflict", "move-conflict", "review-leftover"):
        old, new = o["pair"]
        if args[0] in ("keep-new", "delete"):
            remove_files(files_under(old), stop_for(old))
        else:
            if args[0] == "keep-old":
                remove_files(files_under(new), stop_for(new))
            move_path(old, new)
    elif kind == "review-config":
        text = draft_file(draft)
        defects = review_config_defects(draft)
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "review-wording":
        text = draft_file(draft)
        defects = wording_defects(read_text(target_path), text)
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "review-facts":
        text = draft_file(draft)
        if seeded_project_md(draft) or not text.strip():
            sys.exit("resolve: the draft states no facts beyond the seed; nothing written")
        write_text(target_path, text)
    elif kind == "legacy-intake":
        files = drafted_issues(draft)
        for name in files:
            write_text(os.path.join(ok_dir, "issues", name), read_text(os.path.join(draft, name)))
