        if path.startswith(stop + os.sep):
            return root if stop == legacy_review else stop
    return root


def prune_tree(top, keep=None):
    if not os.path.isdir(top) or os.path.islink(top):
        return
    for dirpath, _, _ in sorted(os.walk(top), key=lambda w: len(w[0]), reverse=True):
        if keep is not None and (dirpath == keep or dirpath.startswith(keep + os.sep)):
            continue
        if not os.listdir(dirpath):
            os.rmdir(dirpath)


def remove_files(paths, stop):
    """Removes the named files: plain `git rm` for a tracked file whose
    working copy and index match HEAD, plain removal for an untracked
    one. Refuses the whole set when any carries uncommitted work or sits
    behind a symbolic link."""
    refuse_unless_removable(paths)
    tracked = tracked_files(paths)
    if tracked:
        subprocess.run(["git", "-C", root, "rm", "-q", "--"] + tracked, check=True)
    for p in paths:
        if os.path.lexists(p):
            os.remove(p)
    prune(paths, stop)
    for p in paths:
        print("removed: %s%s" % (rel(p), " (git rm; staged)" if rel(p) in tracked else ""))


def move_path(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if tracked_files([src]):
        subprocess.run(["git", "-C", root, "mv", "--", rel(src), rel(dst)], check=True)
    else:
        shutil.move(src, dst)
    print("moved: %s -> %s" % (rel(src), rel(dst)))


