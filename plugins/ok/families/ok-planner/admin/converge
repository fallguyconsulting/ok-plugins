#!/usr/bin/env bash
# The ok-planner family's deterministic converge core — the conventional
# administration file the suite's front door (/ok) drives. The judgment
# the modes below cannot encode (retired-layout migration, intake
# integrity, collisions) lives beside this script in ADMINISTRATION.md.
#
# - Resolves the project root: nearest ancestor of $PWD carrying an
#   estate marker (current or pre-migration), else $PWD — never derived
#   from .git.
# - mkdir -p's the .ok-planner/ subdirectory tree (including the
#   issues/ intake and history/issues/ archive; issues are one
#   markdown file each, never touched here).
# - Overwrites .ok-planner/CLAUDE.md and the cheatsheet from the
#   canonical templates in ../scripts (suite-owned boilerplate,
#   no merge, no diff), stamping the suite version into the
#   {{OK_PLANNER_VERSION}} placeholder so diagnose can detect staleness.
# - Materializes the audit-corpus, documentation-corpus, and
#   surface-reconcile checkers into .ok-planner/bin/, and
#   this family's ceremony contributions into
#   .ok-planner/ceremony/ — the conventional contributions the suite's
#   hoisted planning, certification, audit, and documentation verbs
#   drive. Every file the estate carries is tracked content, so the
#   estate needs no ignore file of its own.
# - Materializes the family LICENSE at the estate root and in every
#   vendored skill folder, each under a scope preamble naming Fall Guy
#   LLC and saying which files the grant covers — the estate root and
#   .claude/skills/ both hold project-owned content beside the
#   materialized files, and a bare license there would over-claim.
# - Materializes the session-start hook into .ok-planner/hooks/
#   (version-stamped, executable). The hook executes via a consented
#   entry in .claude/settings.json — see wire-hooks below — never from
#   the carried payload copy.
# - Vendors this family's own user-facing skills into .claude/skills/
#   (version-stamped, sibling references rewritten to the materialized
#   names). The ceremony verbs are not among them: they belong to the
#   suite, and the suite's own converge core vendors them.
# - Retires payloads earlier versions materialized (the skills-index
#   context payload, the user-prompt-submit hook now owned by the
#   ok-conduct plugin, the merged true-up verb the front door's
#   administration replaced, the retired prove and browse verbs, the
#   proof cost recorder with its machine-local record, the retired
#   corpus view — its service, its placed build, the run state it
#   recorded, and the estate ignore file that covered them — and the
#   committed source graph with its extractor).
# - Detects retired layout (pre-4.0 kinds, specs/ from the spec era,
#   backlogs/ from before the backlog -> sprint rename, a legacy
#   issues.jsonl from before the file-per-issue intake, and decision
#   Proof sections from the retired proof-mandate model) and reports
#   it on the last line; ADMINISTRATION.md carries the migration
#   procedures.
# - `converge diagnose` is the read-only mode: it reports missing
#   layout, stale or missing materialized files, retired layout, and
#   missing or drifted hook wiring (with the exact entry to restore),
#   exits non-zero on any finding, and writes nothing.
# - `converge wire-hooks` is the consent-transcription path — the ONLY
#   path that writes .claude/settings.json. Run it exactly when the
#   owner has consented to the entry diagnose reported as needed.
#
# Idempotent. Re-running converge on a project already in compliance
# is a no-op at the git level.
#
# @decision: vendored-skills

set -euo pipefail

MODE="converge"
case "${1:-}" in
    diagnose) MODE="diagnose" ;;
    wire-hooks) MODE="wire-hooks" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPTS="${SCRIPT_DIR}/../scripts"
CEREMONY="${SCRIPT_DIR}/../ceremony"
TEMPLATE="${SCRIPTS}/ok-planner-CLAUDE.md"
CHEATSHEET_TEMPLATE="${SCRIPTS}/ok-planner-cheatsheet.md"
SURFACE_CORPUS="${SCRIPTS}/surface-corpus"
AUDIT_CHECK="${SCRIPTS}/audit-check"
DOCUMENT_CHECK="${SCRIPTS}/document-check"
SURFACE_RECONCILE="${SCRIPTS}/surface-reconcile"
LICENSE_SRC="${SCRIPT_DIR}/../LICENSE"
# The ceremony contributions this family exposes — the conventional
# files the suite's hoisted ceremonies drive, one per ceremony verb —
# plus the goal files: vendored briefs whose paths the owner hands to
# the native goal mechanism to drive the audit and documentation runs.
CEREMONY_VERBS=(plan-sprint certify-work audit document)
CEREMONY_FILES=("${CEREMONY_VERBS[@]}" audit-goal document-goal)
# The suite version comes from the front-door plugin's manifest — the
# family carries no manifest of its own (admin -> family -> families -> ok).
SUITE_MANIFEST="${SCRIPT_DIR}/../../../.claude-plugin/plugin.json"

if [ ! -f "$TEMPLATE" ]; then
    printf 'converge: template not found at %s\n' "$TEMPLATE" >&2
    exit 1
fi

SUITE_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SUITE_MANIFEST" 2>/dev/null | head -1)
[ -n "$SUITE_VERSION" ] || SUITE_VERSION="unknown"

# The estate LICENSE carries a scope preamble above the Apache text. The
# estate root holds the project's own design corpus and records beside
# the materialized ok-planner files, so a bare license there reads as a
# grant over the project's work; the preamble says which files it covers.
estate_license() {
    cat <<'PREAMBLE'
ok-planner, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the ok-planner files the suite's administration
materialized into this directory: CLAUDE.md, this file, the support
scripts under bin/ and scripts/, the ceremony contributions under ceremony/,
and the session hook under hooks/. It does not cover this project's own
work — the design corpus, the issue intake, sprints, sketches, audits,
and history are the project's own, licensed however the project licenses
itself.

======================================================================

PREAMBLE
    cat "$LICENSE_SRC"
}

# A materialized ceremony contribution is prose that moves between releases, so
# it carries the same trailing stamp every other materialized file does —
# that stamp is what lets a later diagnose tell current from stale.
CEREMONY_STAMP="<!-- Materialized by ok-planner v${SUITE_VERSION} — suite-owned; overwritten on converge; do not hand-edit. -->"

render_ceremony() {
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$1"
    printf '\n%s\n' "$CEREMONY_STAMP"
}

# Project root: nearest ancestor carrying an estate marker (current or
# pre-migration), else $PWD — a fresh install roots where the agent is
# operating. Never derived from .git: the estate may live in a
# subfolder, submodule, or subproject of a repo whose own root wants no
# estate.
resolve_root() {
    local dir
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.ok-planner" ] || [ -e "$dir/.ok-plumbline" ] \
            || [ -e "$dir/.ok-workspaces" ] || [ -e "$dir/.plumbline.json" ] \
            || [ -e "$dir/.claude/rules/plumbline-cheatsheet.md" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    pwd
}

ROOT="$(resolve_root)"
OK_DIR="${ROOT}/.ok-planner"

# Estate payloads earlier suite versions materialized and this one no
# longer owns. All suite-owned, so removing them is converge's own act
# and never a consent question. Directories are swept whole.
RETIRED_ESTATE=(
    bin/corpus-delta
    context/skills-index.md
    hooks/user-prompt-submit
    bin/proof-timings
    proof-timings.json
    bin/corpus-view
    bin/browse
    browser
    run
    .gitignore
    audits/inspection.md
    bin/source-graph
    graph
)

# The skill-vendoring and settings-wiring layer lives in one python pass
# so diagnose and converge share a single deterministic rendering.
# Subcommands: diagnose | converge | wire-hooks.
vendor_layer() {
    python3 - "$1" "$ROOT" "$SCRIPT_DIR" "$SUITE_VERSION" <<'PY'
import json, os, re, shutil, sys

mode, root, script_dir, version = sys.argv[1:5]
family_dir = os.path.dirname(script_dir)
skills_src = os.path.join(family_dir, "skills")
dest = os.path.join(root, ".claude", "skills")

STAMP = (
    "\n<!-- Materialized by ok-planner v%s — suite-owned; overwritten on"
    " converge; do not hand-edit. -->\n" % version
)

# This family's own verbs. Planning, certification, audit, and
# documentation are not among them: they are suite-owned ceremonies,
# vendored by the suite's own converge core and covering whichever
# estates a project has, so no name here collides with another family's
# and none is prefixed.
SKILLS = {
    "discover-design": "discover-design",
    "ok-planner": "ok-planner",
    "ok-version": "ok-version",
    "sketch": "sketch",
    "verify-issues": "verify-issues",
}
UNPREFIXED = "sketch|discover-design|verify-issues|ok-version"

# Verbs retired from this family's vendored surface: the merged
# lifecycle verb retired when the front door became the suite's sole
# administrator, the retired prove and browse verbs, and certify-all,
# which the periodic audit run replaced. The hoisted ceremonies are not
# listed — the suite's own converge core writes plan-sprint and
# certify-work under the same names and retires the rest.
RETIRED_VENDORED = ("true-up", "prove", "browse", "certify-all")


def render(text):
    text = re.sub(r"ok-planner:(%s)" % UNPREFIXED, r"\1", text)
    text = text.replace("skills/_shared/", "../_shared/")
    return text + STAMP


# The license text belongs in the vendored folder, not in SKILL.md — a
# skill body is read by agents, and license boilerplate there is context
# they pay for and never use. The preamble names what the grant covers,
# because .claude/skills/ also holds skills the project wrote itself.
LICENSE_SRC = os.path.join(family_dir, "LICENSE")
LICENSE_PREAMBLE = """Vendored ok-planner files, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the suite-owned files in this directory. Other
skills under .claude/skills/ are not covered by it — they carry their own
license, or the project's.

======================================================================

"""


def vendored_license():
    with open(LICENSE_SRC, encoding="utf-8") as f:
        return LICENSE_PREAMBLE + f.read()


def expected():
    out = {}
    licensed = set()
    for src, name in SKILLS.items():
        with open(os.path.join(skills_src, src, "SKILL.md"), encoding="utf-8") as f:
            out[os.path.join(dest, name, "SKILL.md")] = render(f.read())
        licensed.add(name)
    shared_dir = os.path.join(skills_src, "_shared")
    for fn in sorted(os.listdir(shared_dir)):
        if fn.endswith(".md"):
            with open(os.path.join(shared_dir, fn), encoding="utf-8") as f:
                out[os.path.join(dest, "_shared", fn)] = render(f.read())
    licensed.add("_shared")
    if os.path.exists(LICENSE_SRC):
        body = vendored_license()
        for name in licensed:
            out[os.path.join(dest, name, "LICENSE")] = body
    return out


ENTRY = {
    "matcher": "startup|clear|compact",
    "hooks": [
        {
            "type": "command",
            "command": 'bash "$CLAUDE_PROJECT_DIR/.ok-planner/hooks/session-start"',
            "async": False,
        }
    ],
}
MARKER = ".ok-planner/hooks/session-start"


def settings_findings():
    path = os.path.join(root, ".claude", "settings.json")
    findings = []
    entry = None
    settings = {}
    if os.path.exists(path):
        try:
            settings = json.load(open(path))
        except ValueError:
            findings.append("unparseable: .claude/settings.json — cannot check hook wiring")
            return findings
    for e in settings.get("hooks", {}).get("SessionStart", []):
        if any(MARKER in h.get("command", "") for h in e.get("hooks", [])):
            entry = e
            break
    if entry is None:
        findings.append("wiring: .claude/settings.json lacks the ok-planner SessionStart entry")
    elif entry.get("matcher") != ENTRY["matcher"]:
        findings.append(
            "wiring: the ok-planner SessionStart entry's matcher is %r — must be %r"
            % (entry.get("matcher"), ENTRY["matcher"])
        )
    return findings


def print_wiring_block():
    print("WIRING NEEDED (ok-planner): .claude/settings.json needs the SessionStart entry below.")
    print(json.dumps({"hooks": {"SessionStart": [ENTRY]}}, indent=2))
    print('On the owner\'s consent run: bash "%s" wire-hooks' % os.path.join(script_dir, "converge"))


if mode == "wire-hooks":
    path = os.path.join(root, ".claude", "settings.json")
    settings = {}
    if os.path.exists(path):
        settings = json.load(open(path))
    hooks = settings.setdefault("hooks", {})
    session = hooks.setdefault("SessionStart", [])
    wrote = False
    for e in session:
        if any(MARKER in h.get("command", "") for h in e.get("hooks", [])):
            if e.get("matcher") != ENTRY["matcher"]:
                e["matcher"] = ENTRY["matcher"]
                wrote = True
            break
    else:
        session.append(ENTRY)
        wrote = True
    if wrote:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        print("wired: ok-planner SessionStart entry transcribed into .claude/settings.json")
    else:
        print("wiring already in place: .claude/settings.json")
    sys.exit(0)

exp = expected()

if mode == "diagnose":
    findings = []
    for path, body in sorted(exp.items()):
        rel = os.path.relpath(path, root)
        if not os.path.exists(path):
            findings.append("missing: %s" % rel)
        elif open(path, encoding="utf-8").read() != body:
            findings.append("stale: %s differs from the carried v%s rendering" % (rel, version))
    for name in RETIRED_VENDORED:
        if os.path.isdir(os.path.join(dest, name)):
            findings.append("retired payload present: .claude/skills/%s/" % name)
    wiring = settings_findings()
    for f_ in findings + wiring:
        print("DRIFT: %s" % f_)
    if any(f_.startswith("wiring:") for f_ in wiring):
        print_wiring_block()
    sys.exit(1 if (findings or wiring) else 0)

# converge
for path, body in sorted(exp.items()):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(body)
print("vendored: %d files under .claude/skills/ (v%s), each folder carrying LICENSE" % (len(exp), version))

for name in RETIRED_VENDORED:
    retired_dir = os.path.join(dest, name)
    if os.path.isdir(retired_dir):
        shutil.rmtree(retired_dir)
        print("retired vendored payload removed: .claude/skills/%s/" % name)

wiring = settings_findings()
if any(f_.startswith("wiring:") for f_ in wiring):
    print_wiring_block()
PY
}

SUBDIRS=(
    sprints
    sketches
    issues
    ceremony
    history/sprints
    history/sketches
    history/issues
)

# Only fill in the design buckets if design/ has already been
# bootstrapped (by discover-design or by hand). Their presence is the
# "design docs exist for this project" gate that other skills key on,
# so converge must not create design/ itself.
if [ -d "${OK_DIR}/design" ]; then
    SUBDIRS+=(
        design/concepts
        design/stories
        design/decisions
        audits/concepts
        audits/stories
        audits/decisions
    )
fi

detect_premigration() {
    premigration=()
    for l in plans coverage design/tensions specs history/specs backlogs history/backlogs; do
        [ -d "${OK_DIR}/${l}" ] && premigration+=("$l")
    done
    if [ -d "${OK_DIR}/design/decisions" ] && \
            grep -lq '^## Proof' "${OK_DIR}"/design/decisions/*.md 2>/dev/null; then
        premigration+=("decision-proof-sections")
    fi
    for f in "${OK_DIR}"/design/review-notes*.md; do
        [ -e "$f" ] && premigration+=("design/$(basename "$f")")
    done
    [ -f "${OK_DIR}/issues.jsonl" ] && premigration+=(issues.jsonl)
    return 0
}

if [ "$MODE" = "wire-hooks" ]; then
    vendor_layer wire-hooks
    exit 0
fi

if [ "$MODE" = "diagnose" ]; then
    findings=()
    for sub in "${SUBDIRS[@]}"; do
        [ -d "${OK_DIR}/${sub}" ] || findings+=("missing directory: .ok-planner/${sub}")
    done

    check_rendered() {
        local template="$1" target="$2" label="$3"
        if [ ! -f "$target" ]; then
            findings+=("missing: ${label}")
        elif ! sed -e "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" \
                   "$template" | cmp -s - "$target"; then
            findings+=("stale: ${label} differs from the carried v${SUITE_VERSION} rendering")
        fi
    }

    check_rendered "$TEMPLATE" "${OK_DIR}/CLAUDE.md" ".ok-planner/CLAUDE.md"
    [ -f "$CHEATSHEET_TEMPLATE" ] && check_rendered "$CHEATSHEET_TEMPLATE" "${ROOT}/.claude/rules/ok-planner-cheatsheet.md" ".claude/rules/ok-planner-cheatsheet.md"
    [ -f "$SURFACE_CORPUS" ] && check_rendered "$SURFACE_CORPUS" "${OK_DIR}/scripts/surface-corpus" ".ok-planner/scripts/surface-corpus"
    [ -f "$AUDIT_CHECK" ] && check_rendered "$AUDIT_CHECK" "${OK_DIR}/bin/audit-check" ".ok-planner/bin/audit-check"
    [ -f "$DOCUMENT_CHECK" ] && check_rendered "$DOCUMENT_CHECK" "${OK_DIR}/bin/document-check" ".ok-planner/bin/document-check"
    [ -f "$SURFACE_RECONCILE" ] && check_rendered "$SURFACE_RECONCILE" "${OK_DIR}/bin/surface-reconcile" ".ok-planner/bin/surface-reconcile"
    for verb in "${CEREMONY_FILES[@]}"; do
        [ -f "${CEREMONY}/${verb}.md" ] || continue
        if [ ! -f "${OK_DIR}/ceremony/${verb}.md" ]; then
            findings+=("missing: .ok-planner/ceremony/${verb}.md")
        elif ! render_ceremony "${CEREMONY}/${verb}.md" | cmp -s - "${OK_DIR}/ceremony/${verb}.md"; then
            findings+=("stale: .ok-planner/ceremony/${verb}.md differs from the carried v${SUITE_VERSION} rendering")
        fi
    done
    # Composed, not rendered from a template file, so it compares by
    # pipe — nothing is written outside the estate to diagnose it.
    if [ -f "$LICENSE_SRC" ]; then
        if [ ! -f "${OK_DIR}/LICENSE" ]; then
            findings+=("missing: .ok-planner/LICENSE")
        elif ! estate_license | cmp -s - "${OK_DIR}/LICENSE"; then
            findings+=("stale: .ok-planner/LICENSE differs from the carried v${SUITE_VERSION} rendering")
        fi
    fi
    src="${SCRIPTS}/hooks/session-start"
    [ -f "$src" ] && check_rendered "$src" "${OK_DIR}/hooks/session-start" ".ok-planner/hooks/session-start"

    for retired in "${RETIRED_ESTATE[@]}"; do
        [ -e "${OK_DIR}/${retired}" ] && findings+=("retired payload present: .ok-planner/${retired}")
    done

    detect_premigration

    for finding in ${findings[@]+"${findings[@]}"}; do
        printf 'DRIFT: %s\n' "$finding"
    done

    vendor_ok=0
    vendor_layer diagnose || vendor_ok=1

    if [ "${#premigration[@]}" -gt 0 ]; then
        printf 'PRE-MIGRATION LAYOUT PRESENT: %s - run the migration procedures in admin/ADMINISTRATION.md.\n' "${premigration[*]}"
    fi
    if [ "${#findings[@]}" -eq 0 ] && [ "${#premigration[@]}" -eq 0 ] && [ "$vendor_ok" -eq 0 ]; then
        printf 'Diagnosed ok-planner at %s: in agreement with carried v%s.\n' "$ROOT" "$SUITE_VERSION"
        exit 0
    fi
    printf 'Diagnosed ok-planner at %s: findings above; nothing written. Run converge to repair.\n' "$ROOT"
    exit 1
fi

created=()
for sub in "${SUBDIRS[@]}"; do
    target="${OK_DIR}/${sub}"
    if [ ! -d "$target" ]; then
        mkdir -p "$target"
        created+=("$sub")
    fi
done

mkdir -p "$OK_DIR"

sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$TEMPLATE" > "${OK_DIR}/CLAUDE.md"

if [ -f "$CHEATSHEET_TEMPLATE" ]; then
    mkdir -p "${ROOT}/.claude/rules"
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$CHEATSHEET_TEMPLATE" > "${ROOT}/.claude/rules/ok-planner-cheatsheet.md"
fi

# Materialize the session-start hook and the ceremony-time helper
# scripts. The hook runs from the project's own estate via the consented
# settings entry; only the administration process legitimately runs from
# the carried payload, so plan-sprint and verify-issues invoke the
# project-side surface-corpus copy instead.
mkdir -p "${OK_DIR}/hooks" "${OK_DIR}/scripts"

if [ -f "$SURFACE_CORPUS" ]; then
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$SURFACE_CORPUS" > "${OK_DIR}/scripts/surface-corpus"
    chmod 755 "${OK_DIR}/scripts/surface-corpus"
fi

# Materialize the audit-corpus and documentation-corpus checkers,
# version-stamped. Consumer projects run them from .ok-planner/bin/;
# the payload copies are the fallback for un-converged projects.
mkdir -p "${OK_DIR}/bin"
if [ -f "$AUDIT_CHECK" ]; then
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$AUDIT_CHECK" > "${OK_DIR}/bin/audit-check"
    chmod 755 "${OK_DIR}/bin/audit-check"
fi
if [ -f "$DOCUMENT_CHECK" ]; then
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$DOCUMENT_CHECK" > "${OK_DIR}/bin/document-check"
    chmod 755 "${OK_DIR}/bin/document-check"
fi
if [ -f "$SURFACE_RECONCILE" ]; then
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$SURFACE_RECONCILE" > "${OK_DIR}/bin/surface-reconcile"
    chmod 755 "${OK_DIR}/bin/surface-reconcile"
fi

# The ceremony contributions: what the suite's hoisted ceremonies read to
# learn what this family contributes to planning, certification, the
# audit, and documentation. Materialized project-side so a converged
# project keeps working with nothing installed.
mkdir -p "${OK_DIR}/ceremony"
for verb in "${CEREMONY_FILES[@]}"; do
    if [ -f "${CEREMONY}/${verb}.md" ]; then
        render_ceremony "${CEREMONY}/${verb}.md" > "${OK_DIR}/ceremony/${verb}.md"
    fi
done

# The family LICENSE rides at the estate root under its scope preamble:
# a vendored family carries its license text into every consumer
# project, and the preamble keeps the grant off the project's own work.
if [ -f "$LICENSE_SRC" ]; then
    estate_license > "${OK_DIR}/LICENSE"
fi
src="${SCRIPTS}/hooks/session-start"
if [ -f "$src" ]; then
    sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$src" > "${OK_DIR}/hooks/session-start"
    chmod 755 "${OK_DIR}/hooks/session-start"
fi

# Retire estate payloads earlier versions materialized, per
# RETIRED_ESTATE above: the skills-index context payload (session start
# now injects the banner and concepts TOC only), the user-prompt-submit
# reminder (owned by the ok-conduct plugin now), the proof cost
# recorder, and the retired corpus view — its service, its up/down
# helper, its placed build, the run state it recorded, and the estate
# ignore file whose only entries covered those two directories, and the
# inspection registry the retired change inspector wrote, and the
# committed source graph with its extractor — mechanically derived
# state whose only reader was the retired citation machinery. All
# suite-owned, so removal is converge, not consent.
retired_removed=()
for retired in "${RETIRED_ESTATE[@]}"; do
    if [ -e "${OK_DIR}/${retired}" ]; then
        rm -rf "${OK_DIR}/${retired}"
        retired_removed+=("$retired")
    fi
done
rmdir "${OK_DIR}/context" 2>/dev/null || true

# The audit model changed shape, so an estate written by an earlier
# suite version carries audits this one cannot read: a determination of
# `satisfied` or `violated`, an `artifact-hash:` pin, `## Confirmation`
# and `## Citations` sections — and, from the release before the two-axis
# model, a well-formed audit that simply carries no `compliance:` field.
# That last one is the same problem one release closer: the checker now
# requires the field, so every audit an upgrading project holds would
# report malformed. There is no mechanical conversion — a
# citation-bearing multi-section audit does not become a one-paragraph
# determination about a named commit without reading the code, which is
# the periodic audit run's job. So the retired corpus is removed on
# sight and the next `/audit` run writes the whole thing fresh. That is
# the migration that makes the first run clean: without it every audit
# reports malformed, which is a wall of findings about files nobody is
# meant to keep.
audit_reset=$(python3 - "$OK_DIR" <<'PYEOF'
import glob, os, re, sys
ok_dir = sys.argv[1]
removed = 0
for bucket in ("stories", "decisions"):
    for p in glob.glob(os.path.join(ok_dir, "audits", bucket, "*.md")):
        text = open(p).read()
        retired = (re.search(r"^determination:\s*(satisfied|violated)\s*$",
                             text, re.M)
                   or re.search(r"^artifact-hash:", text, re.M)
                   or re.search(r"^## Citations\s*$", text, re.M)
                   or not re.search(r"^compliance:\s*\S", text, re.M))
        if retired:
            os.remove(p)
            removed += 1
if removed:
    print(removed)
PYEOF
)
if [ -n "$audit_reset" ]; then
    printf 'Retired audit corpus removed: %s audit file(s) in the retired shape - the next /audit run writes the corpus fresh.\n' "$audit_reset"
fi

# A sprint still in flight when the audit model changed carries a
# completion contract naming a mechanism this version removed — the
# implementation-audit item, whose `audit-check --inspection` clean bar
# no longer exists. Left alone, that sprint cannot be discharged: its
# executor is held to a term nothing can satisfy. The contract is fixed
# boilerplate the suite owns and the compliant end state is fully
# determined (drop the retired item, renumber the one below it, and fix
# the goal rule's item range), so bringing a live sprint's contract to
# this version is converge's own act. Archived sprints under history/
# are records and keep their old wording.
contract_report=$(python3 - "$OK_DIR" <<'PYEOF'
import glob, os, sys
ok_dir = sys.argv[1]
RETIRED_ITEM = """3. The implementation-audit corpus is current for everything the
   change touched or made stale, with any standing violation linked
   to an intake issue — mechanically: `.ok-planner/bin/audit-check
   --inspection` exits 0 (citations current, and every changed
   source-graph node dispositioned by the change inspection).
"""
updated = 0
for p in glob.glob(os.path.join(ok_dir, "sprints", "*.md")):
    text = open(p).read()
    if RETIRED_ITEM not in text:
        continue
    new = text.replace(RETIRED_ITEM, "")
    new = new.replace("4. The completion report beside this sprint",
                      "3. The completion report beside this sprint")
    new = new.replace("is still at its `sprints/` path and items 1–4 all verify",
                      "is still at its `sprints/` path and items 1–3 all verify")
    open(p, "w").write(new)
    updated += 1
if updated:
    print(updated)
PYEOF
)
if [ -n "$contract_report" ]; then
    printf 'In-flight sprint contracts brought current: %s sprint(s) - the retired implementation-audit term removed and the goal rule renumbered.\n' "$contract_report"
fi

# Falsifiers, story proof sections, and story acceptance sections are
# retired corpus-wide: a story is its `## Story` statement alone — a
# pure expression of business value; verification is the implementation
# audit, citing the project's ordinary end-to-end tests for code and
# the relevant prose for the rest. On upgrade the retired sections are
# eliminated on sight — `## Falsifier`, `## Proof`, and `## Acceptance`
# sections stripped from every story, the falsifier concept file and
# its TOC line removed. Content outside those sections is untouched.
falsifier_report=$(python3 - "$OK_DIR" <<'PYEOF'
import glob, os, re, sys
ok_dir = sys.argv[1]
stripped = 0
for p in glob.glob(os.path.join(ok_dir, "design", "stories", "*.md")):
    s = open(p).read()
    new = re.sub(r"\n## (Falsifier|Proof|Acceptance)\n.*?(?=\n## |\Z)", "\n", s, flags=re.S)
    new = re.sub(r"\n{3,}", "\n\n", new)
    if new != s:
        open(p, "w").write(new)
        stripped += 1
removed = []
concept = os.path.join(ok_dir, "design", "concepts", "falsifier.md")
if os.path.exists(concept):
    os.remove(concept)
    removed.append("concepts/falsifier.md")
toc = os.path.join(ok_dir, "design", "concepts.md")
if os.path.exists(toc):
    s = open(toc).read()
    new = re.sub(r"(?m)^- \[?`?falsifier`?\]?[^\n]*\n", "", s)
    if new != s:
        open(toc, "w").write(new)
        removed.append("concepts.md TOC line")
if stripped or removed:
    parts = []
    if stripped:
        parts.append("%d story file(s) stripped" % stripped)
    parts.extend(removed and ["removed: " + ", ".join(removed)] or [])
    print("; ".join(parts))
PYEOF
)
if [ -n "$falsifier_report" ]; then
    printf 'Retired story sections eliminated: %s\n' "$falsifier_report"
fi

vendor_layer converge

detect_premigration

if [ "${#created[@]}" -eq 0 ]; then
    printf 'Converged ok-planner at %s (already present; CLAUDE.md written from template, v%s).\n' "$ROOT" "$SUITE_VERSION"
else
    printf 'Converged ok-planner at %s (created: %s; CLAUDE.md written from template, v%s).\n' "$ROOT" "${created[*]}" "$SUITE_VERSION"
fi

if [ "${#retired_removed[@]}" -gt 0 ]; then
    printf 'Retired payloads removed: %s\n' "${retired_removed[*]}"
fi

if [ "${#premigration[@]}" -gt 0 ]; then
    printf 'PRE-MIGRATION LAYOUT PRESENT: %s - run the migration procedures in admin/ADMINISTRATION.md.\n' "${premigration[*]}"
fi
