    if path == WS_PORT_BLOCK:
        kind = ("port-block allocator (it computes ports from a job name and reads .ok-workspaces/config.json, "
                "which stays while it does; the suite's .ok-planner/bin/port-block reads ports back by run tag)")
    else:
        kind = "run-tag script (the suite's copy is .ok-planner/bin/run-tag)"
    return {
        "id": "retired-script:%s" % rel(path),
        "what": ["%s is the retired ok-workspaces %s. Nothing materializes it now, and it keeps working where it "
                 "stands. Files that name it literally (git grep -F; a path built in code goes unseen):"
                 % (rel(path), kind)] + (callers or ["none"]),
        "fix": "delete %s." % rel(path),
        "recommended": "decline" if callers else "accept",
        "remove": [path],
    }


def worktrees_offer(prefix, tree_dir, trees, branches, branch_prefix):
    merged = set(local_branches("--merged", "HEAD"))
    return {
        "id": "worktrees:%s" % rel(tree_dir),
        "what": ["%s holds %d live worktree(s), and %d %s* branch(es) remain, from the retired /open; the "
                 ".ok-workspaces/ estate stays until they are settled:" % (prefix, len(trees), len(branches),
                                                                           branch_prefix)]
                + ["worktree: %s (%s)" % (t["path"], t["branch"] or "detached") for t in trees]
                + ["branch: %s (%s)" % (b, "merged into HEAD" if b in merged else "not merged into HEAD")
                   for b in branches],
        "fix": "remove each worktree listed with `git worktree remove` and delete each branch listed with "
               "`git branch -d`; resolve refuses, changing nothing, unless every worktree is clean, unlocked, and "
               "free of populated submodules, and every branch is merged into HEAD and checked out in no other "
               "worktree.",
        "trees": [t["path"] for t in trees],
        "branches": branches,
    }


def worktree_refusals(o):
    found = []
    for tree in o["trees"]:
        if not os.path.isdir(tree):
            found.append("worktree %s is missing (run git worktree prune)" % tree)
            continue
        status = subprocess.run(["git", "-C", tree, "status", "--porcelain"], capture_output=True, text=True)
        if status.returncode != 0 or status.stdout.strip():
            found.append("worktree %s is not clean" % tree)
        elif populated_submodules(tree):
            found.append("worktree %s holds populated submodules, which git worktree remove refuses" % tree)
    listed = registered_worktrees()
    found += ["worktree %s is locked (git worktree unlock releases it)" % t["path"]
              for t in listed if t["path"] in o["trees"] and t["locked"]]
    merged = set(local_branches("--merged", "HEAD"))
    found += ["branch %s is not merged into HEAD" % b for b in o["branches"] if b not in merged]
    elsewhere = {t["branch"]: t["path"] for t in listed if t["path"] not in o["trees"]}
    found += ["branch %s is checked out in %s" % (b, elsewhere[b]) for b in o["branches"] if b in elsewhere]
    return found


def workspaces_plan():
    plan = {"removes": [], "blocked": [], "offers": [], "waiting": False, "keep": None}
    if os.path.islink(ws_dir) or not os.path.isdir(ws_dir):
        return plan
    plan["blocked"] = estate_blocked([ws_dir])
    profile = ws_profile()
    prefix = profile_string(profile, "worktrees", "dirPrefix", WS_DEFAULT_TREES)
    branch_prefix = profile_string(profile, "worktrees", "branchPrefix", WS_DEFAULT_BRANCHES)
    tree_dir = os.path.normpath(os.path.join(root, prefix))
    trees = [t for t in registered_worktrees()[1:] if inside(t["path"], os.path.realpath(tree_dir))]
    branches = [b for b in local_branches() if b.startswith(branch_prefix)]
    scanned = tree_dir.startswith(root + os.sep) and tree_dir != ws_dir and not os.path.islink(tree_dir)
    custom_ignore = os.path.join(tree_dir, ".gitignore")
    custom = scanned and not inside(tree_dir, ws_dir) and head_stamped(custom_ignore)
    content = []
    if scanned and os.path.isdir(tree_dir):
        for name in sorted(os.listdir(tree_dir)):
            entry = os.path.join(tree_dir, name)
            if (custom and entry == custom_ignore) or any(inside(t["path"], os.path.realpath(entry)) for t in trees):
                continue
            if files_under(entry):
                content.append(entry)
    plan["offers"].extend(leftover_offer(entry, None, "the retired worktree directory %s" % prefix)
                          for entry in content)
    if trees or branches:
        plan["waiting"] = True
        plan["offers"].insert(0, worktrees_offer(prefix, tree_dir, trees, branches, branch_prefix))
        return plan
    named = [profile_string(profile, section, "path", "") for section in ("runTag", "srcTag")]
    kept = []
    for path in [os.path.normpath(os.path.join(root, n)) for n in named if n] + list(WS_SCRIPTS):
        if path not in kept and path.startswith(root + os.sep) and os.path.isfile(path):
            kept.append(path)
    plan["offers"].extend(retired_script_offer(path) for path in kept)
    keep_profile = any(path == WS_PORT_BLOCK or not inside(path, ws_dir) for path in kept)
    candidates = []
    for f in files_under(ws_dir):
        if f in kept or (scanned and inside(f, tree_dir)):
            continue
        if (f == WS_PROFILE and keep_profile) or (f == WS_IGNORE and content):
            continue
        relf = os.path.relpath(f, ws_dir)
        if os.path.basename(f) == ".DS_Store" or relf.split(os.sep)[0] in WS_RETIRED_TOPS:
            candidates.append(f)
        else:
            plan["offers"].append(leftover_offer(f, None, "the retired .ok-workspaces/ estate"))
    if custom and not content:
        candidates.append(custom_ignore)
    dirty = set(uncommitted(candidates))
    for f in candidates:
        if rel(f) in dirty or symlinked([f]):
            plan["offers"].append(estate_edits_offer(f, None, "the retired .ok-workspaces/ estate"))
        else:
            plan["removes"].append(f)
    if content:
        plan["keep"] = tree_dir
    return plan


