def registered_worktrees():
    out = subprocess.run(["git", "-C", root, "worktree", "list", "--porcelain"], capture_output=True, text=True)
    if out.returncode != 0:
        return []
    trees = []
    for line in out.stdout.split("\n"):
        if line.startswith("worktree "):
            trees.append({"path": os.path.realpath(line[len("worktree "):]), "branch": None, "locked": False})
        elif line.startswith("branch refs/heads/") and trees:
            trees[-1]["branch"] = line[len("branch refs/heads/"):]
        elif (line == "locked" or line.startswith("locked ")) and trees:
            trees[-1]["locked"] = True
    return trees


def populated_submodules(tree):
    marker = os.path.join(tree, ".git")
    first = read_text(marker).split("\n", 1)[0] if os.path.isfile(marker) else ""
    if first.startswith("gitdir: ") and os.path.isdir(os.path.join(tree, first[len("gitdir: "):].strip(), "modules")):
        return True
    gitmodules = os.path.join(tree, ".gitmodules")
    paths = re.findall(r"^\s*path\s*=\s*(.+?)\s*$", read_text(gitmodules), re.M) if os.path.isfile(gitmodules) else []
    return any(os.path.lexists(os.path.join(tree, p, ".git")) for p in paths)


def local_branches(*args):
    out = subprocess.run(["git", "-C", root, "for-each-ref", "--format=%(refname)"] + list(args) + ["refs/heads/"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        return []
    return [l[len("refs/heads/"):] for l in out.stdout.split("\n") if l.startswith("refs/heads/")]


def script_callers(path):
    found = git_lines("grep", "-l", "-z", "-I", "-F", "-e", rel(path), "--") or []
    return [f for f in found if not f.startswith(ESTATE_PREFIXES) and os.path.join(root, f) != path
            and not suite_stamped(os.path.join(root, f))]


def retired_script_offer(path):
