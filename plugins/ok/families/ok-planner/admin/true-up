def tag_in_single_quotes(command, placeholder):
    quote, at = None, 0
    while at < len(command):
        if command.startswith(placeholder, at):
            if quote == "'":
                return True
            at += len(placeholder)
            continue
        c = command[at]
        if c == "\\" and quote != "'":
            at += 2
            continue
        if c in "'\"" and quote in (None, c):
            quote = None if quote == c else c
        at += 1
    return False


def variables_read(command, names):
    if not names:
        return []
    pattern = r"\$\{?(%s)(?![A-Za-z0-9_])" % "|".join(re.escape(name) for name in names)
    return sorted(set(re.findall(pattern, command)))


