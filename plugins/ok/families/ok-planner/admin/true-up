def indent_of(text):
    found = re.search(r'^([ \t]+)"', text, re.M)
    return found.group(1) if found else 2


def dumped(config, text):
    return json.dumps(config, indent=indent_of(text), ensure_ascii=False) + "\n"


def planner_path(value):
    for suffix in MOVED_TO_PLANNER:
        value = value.replace("%s/%s" % (PLUMBLINE_DIR, suffix), ".ok-planner/" + suffix)
    return value


def swapped_text(text, swaps, config):
    new = text
    for old, value in swaps:
        new = new.replace(json.dumps(old, ensure_ascii=False), json.dumps(value, ensure_ascii=False))
    try:
        if json.loads(new) == config:
            return new
    except ValueError:
        pass
    return dumped(config, text)


def pruned_text(text, keys, config):
    new = text
    for key in keys:
        member = (re.escape(json.dumps(key, ensure_ascii=False))
                  + r'\s*:\s*(?:true|false|null|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|"(?:[^"\\]|\\.)*"|\{\s*\})')
        for shape in (member + r'\s*,\s*', r',\s*' + member, r'\s*' + member + r'\s*'):
            new, count = re.subn(shape, "", new, count=1)
            if count:
                break
    try:
        if json.loads(new) == config:
            return new
    except ValueError:
        pass
    return dumped(config, text)


