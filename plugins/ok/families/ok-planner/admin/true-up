def script_pattern(old):
    if old.split("/")[0] in RETIRED_TOPS:
        lead = "(?<![%s])" % PATH_EDGE
    else:
        starts = ["(?<![%s/])" % PATH_EDGE] + ["(?<=(?<![%s/])%s)" % (PATH_EDGE, re.escape(ref))
                                              for ref in ("./", root + "/")]
        refs = ROOT_REFERENCES + (GIT_TOP_REFERENCES if git_top_is_root() else ())
        lead = "(?:%s)" % "|".join(starts + ["(?<=%s)" % re.escape(ref) for ref in refs])
    return re.compile(r"%s%s(?![%s])" % (lead, re.escape(old), PATH_EDGE))


def may_name_root(before):
    head = re.search(r"[%s/]*\Z" % PATH_EDGE, before).group(0)
    edge = before[:len(before) - len(head)][-1:]
    if edge and edge not in PLAIN_BOUNDARY:
        if edge == "$":
            head = head[len(head.split("/")[0]):]
        return root.endswith(head)
    if head.startswith("/"):
        return False
    return ".." in head.split("/") or root.endswith("/" + head)


def unsure_reference(old, pattern, line):
    if old.split("/")[0] in RETIRED_TOPS:
        return False
    certain = {m.start() for m in pattern.finditer(line)}
    return any(m.start() not in certain and may_name_root(line[:m.start() - 1])
               for m in re.finditer(r"(?<=/)%s(?![%s])" % (re.escape(old), PATH_EDGE), line))


