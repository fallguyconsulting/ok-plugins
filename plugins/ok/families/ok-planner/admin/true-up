def owner_ruling(text):
    section = re.search(r"^## Ruling[ \t]*\n(.*?)(?=^## |\Z)", issue_body(text), re.M | re.S)
    if not section:
        return ""
    kept, quoted_block, marked = [], False, False
    for line in re.sub(r"<!--.*?-->", "", section.group(1), flags=re.S).split("\n"):
        quoted = line.lstrip().startswith(">")
        if quoted and not quoted_block:
            marked = bool(MARKED_RULING.match(line.lstrip()))
        quoted_block = quoted
        if not (quoted and marked):
            kept.append(line)
    return " ".join(" ".join(kept).split())


def drafted_ruling(rec):
