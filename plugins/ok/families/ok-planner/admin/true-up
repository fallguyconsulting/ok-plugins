def workspaces_plan():
    plan = {"removes": [], "leftovers": [], "blocked": [], "held": [], "trees": [], "branches": [], "waiting": False,
            "prefix": None}
    if os.path.islink(ws_dir) or not os.path.isdir(ws_dir):
        return plan
    plan["blocked"] = estate_blocked([ws_dir])
    profile = ws_profile()
    prefix = profile_string(profile, "worktrees", "dirPrefix", WS_DEFAULT_TREES)
    branch_prefix = profile_string(profile, "worktrees", "branchPrefix", WS_DEFAULT_BRANCHES)
    plan["prefix"] = prefix
    tree_dir = os.path.normpath(os.path.join(root, prefix))
    trees = [t for t in registered_worktrees()[1:] if inside(t["path"], os.path.realpath(tree_dir))]
    branches = [b for b in local_branches() if b.startswith(branch_prefix)]
    scanned = tree_dir.startswith(root + os.sep) and tree_dir != ws_dir and not os.path.islink(tree_dir)
    custom_ignore = os.path.join(tree_dir, ".gitignore")
    custom = scanned and not inside(tree_dir, ws_dir) and head_stamped(custom_ignore)
    if scanned and os.path.isdir(tree_dir):
        for name in sorted(os.listdir(tree_dir)):
            entry = os.path.join(tree_dir, name)
            if (custom and entry == custom_ignore) or any(inside(t["path"], os.path.realpath(entry)) for t in trees):
                continue
            plan["leftovers"].extend(files_under(entry))
    settled_worktrees(plan, trees, branches)
    if plan["held"]:
        plan["waiting"] = True
        return plan
    held = script_plan()["held"]
    scripts = [path for path, _, _ in workspaces_scripts() if os.path.isfile(path)]
    kept = [path for path in scripts if path in held]
    keep_profile = any(path == WS_PORT_BLOCK or not inside(path, ws_dir) for path in kept)
    candidates = [path for path in scripts if path not in kept and not inside(path, ws_dir)]
    for f in files_under(ws_dir):
        if f in kept or (scanned and inside(f, tree_dir)):
            continue
        if f == WS_PROFILE and keep_profile:
            continue
        relf = os.path.relpath(f, ws_dir)
        if f in scripts or junk(f) or relf.split(os.sep)[0] in WS_RETIRED_TOPS:
            candidates.append(f)
        else:
            plan["leftovers"].append(f)
    if custom:
        candidates.append(custom_ignore)
    plan["removes"] = candidates
    return plan


