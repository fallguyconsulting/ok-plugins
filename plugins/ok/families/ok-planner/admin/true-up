        return
    pairs = archive_pairs(plan, kept)
    plan["gone"].update(kept)
    plan["destinations"].extend(dst for _, dst in pairs)
    mirror = os.path.join(ARCHIVE_DIR, sub)
    suffixed = [(src, dst) for src, dst in pairs if dst != os.path.join(mirror, os.path.relpath(src, folder))]
    step(plan, "archives under %s/ %s, which no current skill reads: %s/ -> %s/, %d file(s)%s"
         % (rel(ARCHIVE_DIR), what, rel(folder), rel(mirror), len(pairs),
            "; each name the archive already holds takes a suffix: %s" % ", ".join(
