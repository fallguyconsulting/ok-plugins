def section_bounds(lines, heading):
    start = lines.index(heading) + 1
    end = start
    while end < len(lines) and not lines[end].startswith(("## ", "```")):
        end += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return start, end


@functools.lru_cache(maxsize=None)
def carried_boilerplate():
    lines = read_text(SPRINT_TEMPLATE).split("\n")
    assert SPRINT_TEMPLATE_HEADING in lines, "the carried sprint template has no %s block: %s" % (
        SPRINT_TEMPLATE_HEADING, SPRINT_TEMPLATE)
    heading_at = lines.index(SPRINT_TEMPLATE_HEADING)
    assert "```markdown" in lines[heading_at:], "the carried sprint template's block opens no markdown fence: %s" % (
        SPRINT_TEMPLATE)
    template = lines[lines.index("```markdown", heading_at) + 1:]
    sections = {}
    for heading in BOILERPLATE_SECTIONS:
        assert heading in template, "the carried sprint template has no %s section: %s" % (heading, SPRINT_TEMPLATE)
        start, end = section_bounds(template, heading)
        sections[heading] = template[start:end]
    return sections


