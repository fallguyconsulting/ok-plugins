    for top in sorted({stop or stop_for(p) for p in paths}):
        prune([p for p in paths if (stop or stop_for(p)) == top], top)
    for p in paths:
        print("removed: %s%s" % (rel(p), " (git rm; staged)" if rel(p) in tracked else ""))
