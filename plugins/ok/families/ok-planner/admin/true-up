PLAN_ID = re.compile(r"[0-9a-f]{12}")


def plan_id(plan):
    return hashlib.sha256("\n".join(sorted(step_lines(plan))).encode("utf-8")).hexdigest()[:12]


def prechecks(plan):
    causes = []
    touched = sorted({p for p in plan["touched"] if inside(p, root)})
    if touched:
        lock = git_lines("rev-parse", "--git-path", "index.lock")
        if lock and os.path.lexists(os.path.join(root, lock[0].strip())):
            causes.append("git's index is locked (%s exists); let the other git command finish, or remove the "
                          "stale lock file" % rel(os.path.normpath(os.path.join(root, lock[0].strip()))))
        unmerged = git_lines("ls-files", "-u", "-z", "--", *[rel(p) for p in touched]) or []
        if unmerged:
            causes.append("%s carry unmerged changes; settle the merge first"
                          % ", ".join(sorted({l.split("\t", 1)[-1] for l in unmerged})))
        for folder in sorted({nearest_existing(os.path.dirname(p)) for p in touched}):
            if not os.access(folder, os.W_OK):
                causes.append("%s/ cannot be written" % rel(folder))
    taken = [dst for dst in plan["destinations"] if os.path.lexists(dst)]
    if taken:
        causes.append("%s already stand where the plan moves files" % listing(taken))
    for refusal in plan["refusals"]:
        causes.extend(refusal())
    return causes


