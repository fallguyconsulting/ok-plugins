def read_text(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def stamped(path):
    if not os.path.isfile(path):
        return False
    lines = [l for l in read_text(path).split("\n") if l.strip()]
    return bool(lines) and lines[-1].startswith(ANY_OK_STAMP)


def head_stamped(path):
    if not os.path.isfile(path):
        return False
    return any("Materialized by ok" in line for line in read_text(path).split("\n")[:5])


def suite_stamped(path):
    return stamped(path) or head_stamped(path)


def owned(path):
    if not path.startswith(claude_dir + os.sep) or os.path.basename(path) == "LICENSE":
        return False
    if not os.path.lexists(path):
        return False
    if path.startswith(dest + os.sep) or path.startswith(agents_dest + os.sep):
        return path.endswith(".md") and not stamped(path)
    if path in FIXED_RULES:
        return not fixed_content(path, FIXED_RULES[path])
    return not suite_stamped(path)


def fixed_content(path, body):
    if os.path.islink(path) or not os.path.isfile(path):
        return False
    with open(path, "rb") as f:
        return f.read() == body.encode("utf-8")


def vendored_folder(path):
    """The folder a vendored skill path belongs to: its top folder under
    .claude/skills/, or None for an agent profile."""
    if not path.startswith(dest + os.sep):
        return None
    return os.path.join(dest, os.path.relpath(path, dest).split(os.sep)[0])


def rel(path):
    return os.path.relpath(path, root)


def git_lines(*args):
    out = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True)
    if out.returncode != 0:
        return None
    return [l for l in out.stdout.split("\0") if l]


def tracked_files(paths):
    rels = [rel(p) for p in paths]
    return (git_lines("ls-files", "-z", "--", *rels) or []) if rels else []


def uncommitted(paths):
    rels = [rel(p) for p in paths]
    if not rels:
        return []
    if git_lines("rev-parse", "-q", "--verify", "HEAD") is None:
        return sorted(git_lines("ls-files", "-z", "--", *rels) or [])
    changed = set()
    for cached in ((), ("--cached",)):
        changed.update(git_lines("diff", *cached, "--name-only", "--no-renames", "-z", "--relative",
                                 "HEAD", "--", *rels) or [])
    return sorted(changed)


def symlinked(paths):
    """The symbolic links between the project root and these paths."""
    found = set()
    for path in paths:
        p = os.path.dirname(path)
        while p.startswith(root + os.sep):
            if os.path.islink(p):
                found.add(rel(p))
            p = os.path.dirname(p)
    return sorted(found)


