def probe(path, interpreter, args):
    if interpreter == "node" and NODE is None:
        return
    argv = ([NODE] if interpreter == "node" else []) + [path] + list(args)
    try:
        result = subprocess.run(argv, cwd=root, capture_output=True, text=True)
    except OSError as err:
        sys.exit("true-up: %s does not run: %s; true-up wrote nothing further" % (rel(path), err))
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        sys.exit("true-up: %s does not run (exit %d)%s; true-up wrote nothing further"
                 % (rel(path), result.returncode, ": " + detail if detail else ""))


