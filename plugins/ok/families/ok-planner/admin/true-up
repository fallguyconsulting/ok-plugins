def caller_kind(f, script_paths):
    path = os.path.join(root, f)
    if (f.split("/")[0] in RETIRED_TOPS or path in script_paths
            or any(inside(path, os.path.join(ok_dir, folder)) for folder in ARCHIVED_FOLDERS)
            or inside(os.path.realpath(path), os.path.realpath(family_dir)) or payload_copy_file(f)):
        return None
    owner = carried_review().left_alone(root, f)
    if owner in ("record", "suite"):
        return None
    if f.startswith(".claude/rules/"):
        return "rules"
    if os.path.basename(f) == "CLAUDE.md":
        return "memory"
    if os.path.islink(path) or symlinked([path]):
        return "link"
    try:
        caller_text(path)
    except UnicodeDecodeError:
        return "encoding"
    return "rewrite"


def caller_issue(issue):
    f, name, kind = issue["file"], issue["name"], issue["kind"]
    dropin = issue["scripts"][0][2]
    names = sorted({old for _, old, _ in issue["scripts"]})
    planner_path, planner_keep = PLANNER_RETIRED_NAMES.get(name, (None, ""))
    shown = rel(planner_path) if planner_path is not None else name
    problem = ["%s names the retired %s script%s, which /ok no longer materializes, and true-up rewrites none "
               "of its lines." % (f, shown, "" if names == [shown] else " (%s)" % ", ".join(names))]
    if kind != "rewrite":
        problem.append("%s is %s." % (f, CALLER_LEFT[kind]))
    if issue["unsure"]:
        problem.append("True-up cannot tell whether the text before the path on a listed line names the project "
                       "root, where the retired copy stands, or another directory.")
    if dropin is None:
        problem.append(NO_DROP_IN[name][0])
    standing = [script for script, _, _ in issue["scripts"] if os.path.isfile(script)]
    for script, old, _ in issue["scripts"]:
        problem.append("The retired copy stands at %s, and true-up keeps it while a tracked file other than a record "
                       "names it." % old if script in standing else
                       "No retired copy stands at %s now, so each listed call of it fails with not found." % old)
    lines = ["- line %d: %s" % (n, text) for n, text in sorted({(n, text) for _, n, text in issue["hits"]})]
    fix = (NO_DROP_IN[name][1] if dropin is None else
           "Rewrite each listed line by hand to name %s, the suite's copy, which behaves as the retired one did; "
           "true-up removes the retired copy once no tracked file other than a record names it." % dropin)
    keep = ("Keep the retired copy: leave each listed line as it stands, and true-up keeps %s%s while a tracked "
            "file other than a record names it.%s" % (", ".join(rel(s) for s in standing),
                                                      " and the workspaces profile it reads" if name == "port-block"
                                                      else "", planner_keep)
            if standing else "Delete each listed line, since the retired copy is gone and the line names nothing.")
    return {
        "file": f,
        "names": names,
        "summary": "%s names %s" % (f, ", ".join(names)),
        "spec": {
            "id": issue["id"],
            "kind": "audit",
            "category": "tooling",
            "artifacts": [],
            "title": "%s names the retired %s script" % (f, shown),
            "problem": " ".join(problem) + "\n\n" + "\n".join(lines),
            "options": [{"text": fix}, {"text": keep}],
            "route": None,
            "recommendation": None,
            "upstream": None,
        },
    }


@functools.lru_cache(maxsize=None)
def script_plan():
    scripts = retired_scripts()
    script_paths = {path for path, _, _ in scripts}
    olds = [(path, name, dropin, rel(path), script_pattern(rel(path))) for path, name, dropin in scripts]
    terms = []
    for _, _, _, old, _ in olds:
        terms += ["-e", old]
    files = set(git_lines("grep", "-l", "-z", "-I", "-F", *terms, "--") or [])
    files.update(rel(p) for p in ESTATE_CALLERS if os.path.isfile(p))
    plan = {"repoints": [], "issues": [], "held": set()}
    issues = {}
    for f in sorted(files):
        kind = caller_kind(f, script_paths)
        if kind is None:
            continue
        path = os.path.join(root, f)
        lines = (caller_text(path) if kind == "rewrite" else read_text(path)).split("\n")
        swaps = []
        for script, name, dropin, old, pattern in olds:
            hits = [(n + 1, line.strip()) for n, line in enumerate(lines) if pattern.search(line)]
            unsure = [(n + 1, line.strip()) for n, line in enumerate(lines) if unsure_reference(old, pattern, line)]
            if not hits and not unsure:
                continue
            if kind == "rewrite" and dropin is not None and not unsure:
                swaps.append((old, dropin, len(hits)))
                continue
            if os.path.isfile(script):
                plan["held"].add(script)
            form = "caller" if kind in ("rewrite", "link", "encoding") else "named-in"
            key = "retired-%s-%s-%s" % (name, form, slugified(f))
            issue = issues.setdefault(key, {"id": key, "file": f, "name": name, "kind": kind, "hits": [],
                                            "scripts": [], "unsure": False})
            issue["hits"] += [(old, n, text) for n, text in sorted(set(hits + unsure))]
            issue["unsure"] = issue["unsure"] or bool(unsure)
            issue["scripts"].append((script, old, dropin))
        if swaps:
            plan["repoints"].append((f, swaps))
    plan["issues"] = [caller_issue(issue) for issue in issues.values()]
    return plan


