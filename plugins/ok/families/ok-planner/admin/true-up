def repointed_script(entry):
    return any(dropin is not None and script_pattern(rel(path)).search(entry) for path, _, dropin in retired_scripts())


def estate_state(name, memo):
    if name not in memo:
        plan = ESTATE_PLANS[name]()
        moved = not plan["blocked"] and not plan.get("waiting")
        held = moved and any(inside(script, ESTATE_TOPS[name]) for script in script_plan()["held"])
        memo[name] = (moved, moved and not held)
    return memo[name]


# @decision: whole-file-ownership
def retired_entries(entries, estates, repoint):
    memo, kept, stale = {}, [], []
    for entry in entries:
        name = entry_estate(entry)
        if name not in estates or repointed_script(entry):
            kept.append(entry)
            continue
        moved, settled = estate_state(name, memo)
        new = planner_path(entry) if repoint else entry
        if new != entry and moved:
            stale.append((entry, new))
            if new not in entries and new not in kept:
                kept.append(new)
        elif settled:
            stale.append((entry, None))
        else:
            kept.append(entry)
    return kept, stale


def entry_changes(stale):
    return ", ".join("%s -> %s" % (old, new) if new is not None else "%s removed" % old for old, new in stale)


def ignore_rewritten(text):
    config = json.loads(text)
    if not isinstance(config, dict) or not isinstance(config.get("ignore"), list):
        return text
    kept, stale = retired_entries(config["ignore"], ("plumbline", "workspaces", "review"), True)
    if not stale:
        return text
    config["ignore"] = kept
    return swapped_text(text, [(old, new) for old, new in stale if new is not None], config)


