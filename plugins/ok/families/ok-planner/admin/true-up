def intake_migration_refusals(source, destination, pairs, records):
    causes = []
    lock = git_lines("rev-parse", "--git-path", "index.lock")
    if lock and os.path.lexists(os.path.join(root, lock[0].strip())):
        causes.append("git's index is locked (%s exists); let the other git command finish, or remove the "
                      "stale lock file" % rel(os.path.normpath(os.path.join(root, lock[0].strip()))))
    for folder in (source, nearest_existing(destination)):
        if not os.access(folder, os.W_OK):
            causes.append("%s/ cannot be written" % rel(folder))
    taken = [os.path.basename(dst) for _, dst in pairs if os.path.lexists(dst)]
    if taken:
        causes.append("%s/ already holds %s" % (rel(destination), ", ".join(taken)))
    if records:
        result = import_issues(records, dry_run=True)
        if result.returncode != 0:
            causes.append(import_refusal(result))
    return causes


def move_all(pairs, destination):
    try:
        os.makedirs(destination, exist_ok=True)
        tracked = tracked_entries([src for src, _ in pairs])
        if tracked:
            result = subprocess.run(["git", "-C", root, "mv", "--"] + [rel(src) for src in tracked]
                                    + [rel(destination)], capture_output=True, text=True)
            if result.returncode != 0:
                return "git mv failed: %s" % (result.stderr or result.stdout).strip()
            left = [rel(src) for src in tracked if os.path.lexists(src)]
            if left:
                return "git mv left %s behind" % ", ".join(left)
        for src, dst in pairs:
            if src not in tracked:
                shutil.move(src, dst)
    except OSError as err:
        return "a move failed: %s" % err
    for src, dst in pairs:
        print("moved: %s -> %s%s" % (rel(src), rel(dst), " (git mv; staged)" if src in tracked else ""))
    return None


def move_back(pairs, source, created):
    moved = [(src, dst) for src, dst in pairs if os.path.lexists(dst) and not os.path.lexists(src)]
    tracked = tracked_entries([dst for _, dst in moved])
    failures = []
    if tracked:
        result = subprocess.run(["git", "-C", root, "mv", "--"] + [rel(dst) for dst in tracked]
                                + [rel(source)], capture_output=True, text=True)
        if result.returncode != 0:
            failures.append("git mv failed: %s" % (result.stderr or result.stdout).strip())
    for src, dst in moved:
        if dst in tracked:
            continue
        try:
            shutil.move(dst, src)
        except OSError as err:
            failures.append("%s: %s" % (rel(dst), err))
    for src, dst in moved:
        if os.path.lexists(src) and not os.path.lexists(dst):
            print("moved back: %s -> %s" % (rel(dst), rel(src)))
    for folder in created:
        if os.path.isdir(folder) and not os.path.islink(folder) and not os.listdir(folder):
            os.rmdir(folder)
    return failures


