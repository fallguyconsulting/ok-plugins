def markdown_draft_defects(records, plan):
    expected = {history_source(name): name for name in plan["convert"]}
    found, seen = [], {}
    for n, rec in enumerate(records, 1):
        label = "record %d (%s)" % (n, rec.get("id"))
        source = rec.get("source")
        if source not in expected:
            found.append("%s names source %s, which is no issue file the step converts" % (label, json.dumps(source)))
            continue
        if source in seen:
            found.append("%s converts %s, which record %d converts too" % (label, expected[source], seen[source]))
            continue
        seen[source] = n
        name = expected[source]
        if rec.get("id") != plan["ids"][name]:
            found.append("%s takes the id %s; the step gives %s the id %s"
                         % (label, json.dumps(rec.get("id")), name, plan["ids"][name]))
        if drafted_ruling(rec) != owner_ruling(plan["texts"][name]):
            found.append("%s carries a ruling.text that differs from the owner's Ruling text in %s" % (label, name))
    found += ["no record converts %s" % name for source, name in expected.items() if source not in seen]
    return found


def draft_records(draft):
    intake = carried_intake()
    try:
        records = intake.read_records(draft)
    except intake.Refusal as refusal:
        return None, "the draft %s is refused: %s" % (draft, refusal)
    if not isinstance(records, list) or not records or not all(isinstance(r, dict) for r in records):
        return None, "the draft %s must hold one JSON object per line, one record or more" % draft
    closed = [str(r.get("id")) for r in records if "closed" in r or "closed_as" in r]
    if closed:
        return None, "the draft %s closes %s; a drafted issue stays open" % (draft, ", ".join(closed))
    return records, None


