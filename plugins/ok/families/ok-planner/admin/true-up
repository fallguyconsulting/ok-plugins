def logged_open(row):
    intake = carried_intake()
    notes = []
    kind, category = row.get("kind"), row.get("category")
    if kind not in intake.KINDS:
        notes.append("its kind was %s" % json.dumps(kind))
        kind = "human"
    if category not in intake.CATEGORIES:
        notes.append("its category was %s" % json.dumps(category))
        category = "other"
    cited = row.get("artifacts") if isinstance(row.get("artifacts"), list) else []
    artifacts = [a for a in cited if isinstance(a, str) and intake.ARTIFACT.match(a)]
    if len(artifacts) != len(cited):
        notes.append("it cited %s" % json.dumps([a for a in cited if a not in artifacts]))
    candidates = row.get("candidates") if isinstance(row.get("candidates"), list) else []
    title = logged_text(row, "summary") or str(row.get("id"))
    problem = logged_text(row, "detail", "summary") or title
    if notes:
        problem += "\n\nIn the pre-v9 event log, %s." % "; ".join(notes)
    stamp = logged_stamp(row)
    return {"title": title, "kind": kind, "category": category, "artifacts": artifacts, "route": None,
            "problem": problem,
            "options": [{"text": c.strip()} for c in candidates if isinstance(c, str) and c.strip()],
            "recommendation": None, "ruling": None, "messages": [], "upstream": None,
            "opened": stamp, "updated": stamp}


def logged_close(rec, row):
    stamp = logged_stamp(row)
    sprint = logged_sprint(row) if row["event"] != "retire" else None
    resolution = logged_text(row, "resolution") if row["event"] != "retire" else None
    if sprint:
        rec.update({"closed_as": "promoted", "sprint": sprint})
    else:
        rec.update({"closed_as": "retired",
                    "reason": logged_text(row, "reason", "resolution") or "retired in the pre-v9 event log"})
    if resolution:
        rec["ruling"] = {"text": resolution, "at": stamp}
    rec.update({"closed": stamp, "updated": stamp})
    return rec


def logged_key(row):
    value = row.get("id")
    return value if isinstance(value, str) else json.dumps(value)


# @decision: issue-records-in-one-file
def folded_log(rows):
    open_now, closed, keys = {}, [], []
    for row in rows:
        key = logged_key(row)
        if key not in keys:
            keys.append(key)
        if row["event"] == "open" and key not in open_now:
            open_now[key] = logged_open(row)
        elif row["event"] in ("promote", "retire", "resolve") and key in open_now:
            closed.append((key, logged_close(open_now.pop(key), row)))
    ids, derived = assigned_ids([(key, key, key) for key in keys])
    records = []
    for key, rec in closed + list(open_now.items()):
        rec["id"] = ids[key]
        records.append(rec)
    return records, [(key, ids[key]) for key in derived]


