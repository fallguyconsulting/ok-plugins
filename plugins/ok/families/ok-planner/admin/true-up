def parsed_config(text, label):
    try:
        parsed = json.loads(text)
    except ValueError as err:
        return None, [str(err)]
    if not isinstance(parsed, dict):
        return None, ["top level must be an object"]
    if NODE is None:
        return parsed, []
    result = subprocess.run([NODE, PLUMBLINE_SRC, "config-check", "--config", CONFIG_FROM_STDIN],
                            cwd=root, capture_output=True, text=True, input=text)
    if result.returncode == 0:
        return parsed, []
    if result.returncode == 2:
        return parsed, [line for line in result.stdout.split("\n") if line.strip()]
    detail = (result.stderr or result.stdout).strip()
    sys.exit("true-up: plumbline config-check could not read %s (exit %d)%s"
             % (label, result.returncode, ": " + detail if detail else ""))


