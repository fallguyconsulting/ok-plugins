def dropped_entries(current, draft, named, prefix=()):
    if WHOLE_FILE in named:
        return []
    found = []
    for key in sorted(set(current) | set(draft)):
        here = prefix + (key,)
        if here in named:
            continue
        label = ".".join(here)
        if any(n[:len(here)] == here for n in named) and isinstance(current.get(key), dict):
            if not isinstance(draft.get(key), dict):
                found.append(label)
            else:
                found.extend(dropped_entries(current[key], draft[key], named, here))
        elif key not in draft:
            found.append(label + " (dropped)")
        elif key not in current:
            found.append(label + " (added)")
        elif json_value(current[key]) != json_value(draft[key]):
            found.append(label + " (changed)")
    return found


