def populated_submodules(tree):
    marker = os.path.join(tree, ".git")
    first = read_text(marker).split("\n", 1)[0] if os.path.isfile(marker) else ""
    if first.startswith("gitdir: ") and os.path.isdir(os.path.join(tree, first[len("gitdir: "):].strip(), "modules")):
        return True
    gitmodules = os.path.join(tree, ".gitmodules")
    paths = re.findall(r"^\s*path\s*=\s*(.+?)\s*$", read_text(gitmodules), re.M) if os.path.isfile(gitmodules) else []
    return any(os.path.lexists(os.path.join(tree, p, ".git")) for p in paths)


def local_branches(*args):
    out = subprocess.run(["git", "-C", root, "for-each-ref", "--format=%(refname)"] + list(args) + ["refs/heads/"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        return []
    return [l[len("refs/heads/"):] for l in out.stdout.split("\n") if l.startswith("refs/heads/")]


def worktree_refusal(tree, locked):
    if not os.path.isdir(tree):
        return "worktree %s is missing (run git worktree prune)" % tree
    status = subprocess.run(["git", "-C", tree, "status", "--porcelain"], capture_output=True, text=True)
    if status.returncode != 0 or status.stdout.strip():
        return "worktree %s is not clean" % tree
    if populated_submodules(tree):
        return "worktree %s holds populated submodules, which git worktree remove refuses" % tree
    if locked:
        return "worktree %s is locked (git worktree unlock releases it)" % tree
    return None


def settled_worktrees(plan, trees, branches):
    listed = registered_worktrees()
    for t in trees:
        why = worktree_refusal(t["path"], t["locked"])
        if why is None:
            plan["trees"].append(t["path"])
        elif os.path.isdir(t["path"]):
            plan["held"].append("%s, and a whole-tree lint run walks it, since the lint skips no retired estate" % why)
        else:
            plan["held"].append(why)
    merged = set(local_branches("--merged", "HEAD"))
    elsewhere = {t["branch"]: t["path"] for t in listed if t["path"] not in plan["trees"]}
    for b in branches:
        if b not in merged:
            plan["held"].append("branch %s is not merged into HEAD" % b)
        elif b in elsewhere:
            plan["held"].append("branch %s is checked out in %s" % (b, elsewhere[b]))
        else:
            plan["branches"].append(b)


