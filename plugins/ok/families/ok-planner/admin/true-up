PROVENANCE_STAMP = "<!-- Revised by /document at"
PROVENANCE_END = "-->"
LINE_END = re.compile(r"[ \t]*\r?\n")
PROVENANCE_DETAIL = ("it opens with the provenance stamp the retired /document wrote; true-up deletes the stamp and "
                     "leaves the rest")


# @decision: whole-file-ownership
@functools.lru_cache(maxsize=None)
def provenance_stamped():
    rewrite, left = [], []
    hits = git_lines("grep", "-l", "-z", "-I", "-F", "--untracked", "-e", PROVENANCE_STAMP, "--") or []
    for f in sorted(hits):
        path = os.path.join(root, f)
        if not os.path.isfile(path):
            continue
        with open(path, "rb") as fh:
            raw = fh.read()
        if not raw.decode("utf-8", "surrogateescape").lstrip().startswith(PROVENANCE_STAMP):
            continue
        kind = caller_kind(f, frozenset())
        if kind == "rewrite":
            rewrite.append(path)
        elif kind is not None:
            left.append((path, kind))
    return rewrite, left


# @decision: whole-file-ownership
def without_provenance_stamp(text):
    at = len(text) - len(text.lstrip())
    end = text.find(PROVENANCE_END, at)
    if not text.startswith(PROVENANCE_STAMP, at) or end == -1:
        return text
    rest = text[end + len(PROVENANCE_END):]
    closing = LINE_END.match(rest)
    if closing is None:
        return text[:at] + rest.lstrip(" \t")
    rest = rest[closing.end():]
    blank = LINE_END.match(rest)
    return text[:at] + (rest[blank.end():] if blank else rest)


