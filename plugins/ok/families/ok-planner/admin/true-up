def opcode_hunks(opcodes):
    hunk = None
    for tag, i1, i2, j1, j2 in opcodes:
        if tag != "equal":
            hunk = (i1, i2, j1, j2) if hunk is None else (hunk[0], i2, hunk[2], j2)
            continue
        if hunk is not None:
            yield False, hunk
            hunk = None
        yield True, (i1, i2, j1, j2)
    if hunk is not None:
        yield False, hunk


def current_section(section, carried, retired):
    template = retired | set(carried)
    out, replaced = [], 0
    matcher = difflib.SequenceMatcher(None, section, carried, autojunk=False)
    for equal, (i1, i2, j1, j2) in opcode_hunks(matcher.get_opcodes()):
        old = section[i1:i2]
        held = sum(1 for line in old if line in retired)
        if equal or not held:
            out.extend(old)
            continue
        first = next(n for n, line in enumerate(old) if line in template)
        owner = [(n, line) for n, line in enumerate(old) if line not in template]
        out.extend(line for n, line in owner if n < first)
        out.extend(carried[j1:j2])
        out.extend(line for n, line in owner if n > first)
        replaced += held
    return out, replaced


# @decision: live-sprints-brought-current-on-true-up
def current_boilerplate(text):
    lines = text.split("\n")
    carried, retired = carried_boilerplate(), retired_boilerplate()
    replaced = 0
    for heading in BOILERPLATE_SECTIONS:
        if heading not in lines:
            continue
        start, end = section_bounds(lines, heading)
        lines[start:end], held = current_section(lines[start:end], carried[heading], retired)
        replaced += held
    return "\n".join(lines), replaced


def rewritten_sprint(path, text):
    text, changed = current_boilerplate(text)
    if not path.endswith("-build.md"):
        return text, changed
    table = dict(SPRINT_LINE_REWRITES)
    lines = text.split("\n")
    for n, line in enumerate(lines):
        if line in table:
            lines[n] = table[line]
            changed += 1
    return "\n".join(lines), changed


