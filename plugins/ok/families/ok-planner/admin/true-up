    for item in REVIEW_MOVED:
        src = os.path.join(legacy_review, item)
        if not os.path.lexists(src):
            continue
        dst = os.path.join(review_dest, item)
        if os.path.lexists(dst) and not (os.path.isdir(dst) and not os.listdir(dst)):
            plan["conflicts"].append((src, dst))
            continue
        deleted = git_lines("ls-files", "-d", "-z", "--", rel(src)) or []
        if deleted:
            plan["blocked"].append("%s has tracked files missing from the working tree (%s)"
                                   % (rel(src), ", ".join(deleted)))
        plan["moves"].append((src, dst))
    for f in files_under(legacy_review):
        relf = os.path.relpath(f, legacy_review)
        if relf.split(os.sep)[0] in REVIEW_MOVED:
            continue
        if junk(f):
            plan["removes"].append(f)
            continue
        suite_copy = legacy_suite_copy(relf)
        if suite_copy is None:
            plan["leftovers"].append(f)
        elif os.path.isfile(suite_copy) and read_text(f) in suite_renderings(suite_copy):
            plan["removes"].append(f)
        else:
            plan["edits"].append(f)
    return plan


