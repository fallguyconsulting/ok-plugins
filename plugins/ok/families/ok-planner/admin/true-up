MODE="true-up"
GO_AHEAD=""
DRAFTS=""

refuse_usage() {
    printf 'true-up: %s; nothing written\n%s\n' "$1" "$USAGE" >&2
    exit 1
}

if [ "$#" -gt 0 ]; then
    case "$1" in
        diagnose|show|wire-hooks|wire-env|resolve|amend|check-range) MODE="$1" ;;
        --go-ahead|--drafts) ;;
        -h|--help|help)
            printf '%s\n' "$USAGE"
            exit 0
            ;;
        *) refuse_usage "$1 names no mode" ;;
    esac
fi

if [ "$MODE" = "true-up" ]; then
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --go-ahead)
                { [ "$#" -ge 2 ] && [ -n "$2" ] && [ -z "$GO_AHEAD" ]; } || refuse_usage "--go-ahead takes one plan id, once"
                GO_AHEAD="$2"
                shift 2
                ;;
            --drafts)
                { [ "$#" -ge 2 ] && [ -n "$2" ] && [ -z "$DRAFTS" ]; } || refuse_usage "--drafts takes one folder, once"
                DRAFTS="$2"
                shift 2
                ;;
            *) refuse_usage "$1 is no argument of true-up" ;;
        esac
