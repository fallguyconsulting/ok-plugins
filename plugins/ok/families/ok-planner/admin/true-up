def drafted_records(kind, mplan, drafts):
    if drafts is None:
        return None, ("the %s step needs its draft: run --go-ahead with --drafts <folder> holding %s"
                      % (kind, DRAFT_NAMES[kind]))
    records, error = draft_records(os.path.join(drafts, DRAFT_NAMES[kind]))
    if error is None and kind == "markdown-intake":
        defects = markdown_draft_defects(records, mplan)
        if defects:
            error = "the draft %s is refused: %s" % (os.path.join(drafts, DRAFT_NAMES[kind]), "; ".join(defects))
