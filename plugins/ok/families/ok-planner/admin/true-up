def archive_path(src, taken=frozenset()):
    if inside(src, ok_dir):
        place = os.path.relpath(src, ok_dir)
    else:
        parts = rel(src).split(os.sep)
        parts[0] = parts[0][1:] if parts[0].startswith(".") else parts[0]
        place = os.path.join(*parts)
    dst = os.path.join(ARCHIVE_DIR, place)
    stem, ext = os.path.splitext(dst)
    n = 1
    while os.path.lexists(dst) or dst in taken:
        n += 1
        dst = "%s-%d%s" % (stem, n, ext)
    return dst


def prune(paths, stop):
    for p in sorted({os.path.dirname(p) for p in paths}, key=len, reverse=True):
        while p != stop and p.startswith(stop + os.sep) and os.path.isdir(p) and not os.listdir(p):
            os.rmdir(p)
            p = os.path.dirname(p)


