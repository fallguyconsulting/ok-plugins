TRAILING_BREAKS = re.compile(r"(?:\r?\n)+\Z")
LEADING_BREAKS = re.compile(r"\A(?:\r?\n)+")


def seam_breaks(pattern, text):
    found = pattern.search(text)
    return found.group(0) if found else ""


def stripped(text, names):
    headings = {"## %s" % name for name in names}
    pieces, found, cutting = [[]], [], False
    for line in re.split(r"(?<=\n)", text):
        heading = line.rstrip("\r\n")
        if heading in headings:
            if not cutting:
                pieces.append([])
            cutting = True
            if heading[3:] not in found:
                found.append(heading[3:])
            continue
        if heading.startswith("## "):
            cutting = False
        if not cutting:
            pieces[-1].append(line)
    out = "".join(pieces[0])
    for piece in pieces[1:]:
        after = "".join(piece)
        tail, head = seam_breaks(TRAILING_BREAKS, out), seam_breaks(LEADING_BREAKS, after)
        if tail.count("\n") + head.count("\n") >= 3:
            ending = "\r\n" if (tail or head).startswith("\r") else "\n"
            out, after = out[:len(out) - len(tail)] + ending * 2, after[len(head):]
        out += after
    return out, found


def retired_section_files(pattern=None):
    files, undecodable = [], []
    for folder, names in RETIRED_SECTIONS:
        if pattern not in (None, folder):
            continue
        for path in sorted(glob.glob(folder)):
            if not os.path.isfile(path):
                continue
            with open(path, "rb") as f:
                raw = f.read()
            new, found = stripped(raw.decode("utf-8", "surrogateescape"), names)
            if not found:
                continue
            try:
                raw.decode("utf-8")
            except UnicodeDecodeError:
                undecodable.append(path)
                continue
            files.append({"path": path, "text": new, "names": found})
    return files, undecodable


