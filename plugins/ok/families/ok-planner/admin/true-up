            defects = rule_draft_defects(text, read_text(target_path), suite_text(rule))
            replacement = os.path.join(RULES_DIR, rule["replacement"])
            if os.path.lexists(replacement):
                defects.append("%s already exists" % rel(replacement))
            if defects:
                sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
            write_text(replacement, text)
        retire_rule_file(target_path)
    elif kind == "review-config":
        text = draft_file(draft)
        defects = review_config_defects(draft)
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "reword":
        text = draft_file(draft)
        defects = rewrite_defects(read_text(target_path), text, stale_wording_lines, "a retired estate path")
        if defects:
            sys.exit("resolve: the draft is refused: %s; nothing written" % "; ".join(defects))
        write_text(target_path, text)
    elif kind == "review-facts":
        text = draft_file(draft)
        if seeded_project_md(draft) or not text.strip():
            sys.exit("resolve: the draft states no facts beyond the seed; nothing written")
        write_text(target_path, text)
    elif kind == "stack-lines":
        text = draft_file(draft)
        if not text.strip():
            sys.exit("resolve: the draft is empty; nothing written")
        if text == read_text(target_path):
            sys.exit("resolve: the draft is identical to %s; nothing written" % rel(target_path))
        write_text(target_path, text)
    elif kind == "settings":
        text = draft_file(draft)
        draft_settings, draft_error = read_settings(draft)
        still = unusable_findings(draft_settings, draft_error)
        if still:
            sys.exit("resolve: the draft is unusable too: %s; nothing written" % "; ".join(still))
        settings, error = read_settings(settings_path())
