    step(plan, "archives under %s/ %s: %s" % (rel(ARCHIVE_DIR), what, ", ".join(
        "%s -> %s" % (rel(src), rel(dst)) for src, dst in pairs)), run=lambda: archive(pairs), destructive=True,
         show=show or archive_show(paths), touched=paths + [dst for _, dst in pairs])


# @decision: whole-file-ownership
def removal(plan, paths, what):
    paths = [p for p in paths if os.path.lexists(p)]
    dropped = [p for p in paths if machine_local(p) or junk(p)]
    removable, kept = removal_split([p for p in paths if p not in dropped])
    plan["gone"].update(dropped + removable)
    if dropped:
        step(plan, "removes %s that holds no work of the project's (the suite's machine-local content, or an OS or "
                   "interpreter cache): %s" % (what, listing(dropped)), run=lambda: remove_files(dropped, None),
             touched=dropped)
    if removable:
        step(plan, "removes %s (git or the suite restores each): %s" % (what, listing(removable)),
             run=lambda: remove_files(removable, None), destructive=True, touched=removable)
    archive_step(plan, kept, "%s (git cannot restore them as they stand)" % what)


