def conversion_pairs(kind, mplan):
    if kind == "markdown-intake":
        source, history, names = MARKDOWN_DIR, MARKDOWN_HISTORY, mplan["names"]
    else:
        source, history, names = TENSIONS_DIR, TENSIONS_HISTORY, sorted(os.listdir(TENSIONS_DIR))
    return source, history, [(os.path.join(source, n), os.path.join(history, n)) for n in names]


def conversion_refusals(kind, mplan, drafts):
    records = []
    if needs_draft(kind, mplan):
        records, error = drafted_records(kind, mplan, drafts)
        if error is not None:
            return [error]
    source, history, pairs = conversion_pairs(kind, mplan)
    return intake_migration_refusals(source, history, pairs, records)


# @decision: issue-writes-through-one-module
def convert_moving(kind, mplan, drafts):
    records = drafted_records(kind, mplan, drafts)[0] if needs_draft(kind, mplan) else []
    source, history, pairs = conversion_pairs(kind, mplan)
    created = missing_folders(history)
    cause, completed, failures = move_all(pairs, history), False, []
    try:
        if cause is None and records:
            result = import_issues(records)
            if result.returncode != 0:
                cause = import_refusal(result)
            else:
                print(result.stdout.strip())
        completed = True
    finally:
        if cause is not None or not completed:
            failures = move_back(pairs, source, created)
            if failures and not completed:
                sys.stderr.write("true-up: moving the files back failed: %s\n" % "; ".join(failures))
    if failures:
        sys.exit("true-up: %s; moving the files back failed too: %s. Move what stands under %s/ back to %s/ "
                 "yourself, then run /ok again." % (cause, "; ".join(failures), rel(history), rel(source)))
    if cause is not None:
        sys.exit("true-up: %s; every file moved back to %s/; nothing imported" % (cause, rel(source)))
    if not os.listdir(source):
        os.rmdir(source)


