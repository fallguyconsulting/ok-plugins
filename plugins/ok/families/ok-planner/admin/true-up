    if lint is None or lint["parsed"] is None or lint["defects"]:
        return checks
    chosen = lint["parsed"].get("lint_checks", {})
    for name in LINT_CHECKS:
        if isinstance(chosen, dict) and chosen.get(name) is False:
            checks[name] = False
    return checks


def drop_emptied_sections(lines, sections):
    for i in reversed(range(len(sections))):
        start, emptied = sections[i]
        end = sections[i + 1][0] if i + 1 < len(sections) else len(lines)
        if emptied and lines[start].startswith("## ") and not any(l.strip() for l in lines[start + 1:end]):
            del lines[start:end]
    return lines


def render_rules(text, checks):
    kept, sections, open_blocks = [], [], []
    dropped_since_kept = False
    for line in text.split("\n"):
        opened = LINT_CHECK_OPEN.fullmatch(line.strip())
        if opened:
            assert opened.group(1) in checks, "lint-check marker names an unknown check: %s" % opened.group(1)
            open_blocks.append(opened.group(1))
            continue
        if line.strip() == LINT_CHECK_CLOSE:
            assert open_blocks, "a lint-check close marker has no open marker"
            open_blocks.pop()
            continue
        if not all(checks[name] for name in open_blocks):
            dropped_since_kept = True
            if sections:
                sections[-1] = (sections[-1][0], True)
            continue
        if not line.strip() and dropped_since_kept and kept and not kept[-1].strip():
            continue
        if line.startswith("# ") or line.startswith("## "):
            sections.append((len(kept), False))
        kept.append(line)
        dropped_since_kept = False
    assert not open_blocks, "a lint-check block is never closed: %s" % open_blocks[-1]
    return "\n".join(drop_emptied_sections(kept, sections))


