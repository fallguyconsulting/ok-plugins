    at = {role: n for n in range(start + 1, end) for role in roles
          if bare(lines[n]) == "- `%s`: %s" % (role, roles[role])}
    no_stack_at = next((n for n in range(start + 1, end) if carried_review().NO_STACK_PATTERN.match(lines[n])),
                       start)
    config_label = rel(planner_config)
    if "none" in declaration:
        return [(at[role], "a %s line while %s declares stack.none, so the drive runs it in place of the "
                           "declaration" % (role, config_label))
                for role in carried_review().STACK_ROLES if role in roles]
    if no_stack:
        return [(no_stack_at, "a - No stack: line while %s declares stack.start, so the drive starts no stack"
                 % config_label)]
    if "stack-start" not in roles:
        return [(at["stack-stop"], "a stack-stop line beside no stack-start line, so the drive starts none of the "
                                   "stack %s declares" % config_label)]
    if STACK_TOOL not in roles["stack-start"]:
        return [(at["stack-start"], "a stack-start line that does not call %s, so the drive runs it in place of "
                                    "the stack %s declares" % (STACK_TOOL, config_label))]
    return []


def tag_line_reason(value, ours, placeholder):
    command = single_command(value)
    if not ours:
        return ("it names %s, which the drive no longer fills, and true-up rewrites such a line only beside the "
                "stack-start line it writes" % placeholder)
    if command is None:
        return "it gives steps, not one command, naming %s, which the drive no longer fills" % placeholder
    if tag_in_single_quotes(command, placeholder):
        return "it names %s inside single quotes, where the tag true-up would read cannot expand" % placeholder
    return None


def prose_reason(line, placeholder):
    if placeholder in line:
        return "it names %s, which the drive no longer fills" % placeholder
    if (RUN_TAG_WORDS.search(line) or STACK_LIST_WORDS.search(line)) and not OWN_TAG_WORDS.search(line):
        return "it names a run tag or stack list for the tag the drive brief no longer carries"
    return None


def facts_plan(config, text):
    review = carried_review()
    heading = review.DRIVE_COMMANDS_HEADING
    plan = {"text": None, "appended": False, "tags": [], "listed": [], "left": []}
    section = review.project_section(root, heading)
    try:
        roles = review.drive_commands(root) if section is not None else {}
    except review.ReviewError as refusal:
        plan["left"].append("the review tool cannot read its %s section: %s" % (heading, refusal))
        return plan
    no_stack = section is not None and review.NO_STACK_PATTERN.search(section) is not None
    stated = [role for role in review.STACK_ROLES if role in roles]
    declaration = config["declaration"]
    wanted = written_stack_lines(declaration)
    new_text = text
    if wanted and not stated and not no_stack:
        new_text = appended_stack_lines(text, wanted)
        plan["appended"] = True
    lines = new_text.split("\n")
    spans = section_spans(lines)
    if declaration is not None and not plan["appended"]:
        plan["listed"] += stack_line_disagreements(declaration, roles, lines, spans, no_stack)
    ours = roles.get("stack-start") == "`%s`" % DRIVE_STACK_START or (plan["appended"] and "start" in declaration)
    placeholder = review.RETIRED_TAG_PLACEHOLDER
    variables = stack_variables(config)
    start, end = spans.get(heading, (0, 0))
    handled = {n for n, _ in plan["listed"]}
    if plan["appended"]:
        handled.update(n for n in range(start + 1, end) if bare(lines[n]) in wanted)
    for n in range(start + 1, end):
        role = next((r for r in roles if bare(lines[n]) == "- `%s`: %s" % (r, roles[r])), None)
        if role is None:
            continue
        value = roles[role]
        if placeholder in value:
            handled.add(n)
            why = tag_line_reason(value, ours, placeholder)
            if why is not None:
                plan["listed"].append((n, why))
                continue
            ending = "\r" if lines[n].endswith("\r") else ""
            lines[n] = role_line(role, DRIVE_TAG_READ + single_command(value).replace(
                placeholder, DRIVE_TAG_VALUE)) + ending
            plan["tags"].append(role)
            continue
        read = variables_read(value, variables) if role in INSTANCE_STOPS else []
        if read and not STACK_UP_WORDS.search(value):
            handled.add(n)
            plan["listed"].append((n, "it reads %s, which the drive no longer sets: a driver runs the %s line bare, "
                                      "outside any run of %s, so its stop line %s stops nothing the run left"
                                   % (", ".join(read), role, STACK_TOOL, INSTANCE_STOPS[role])))
    for name in (heading,) + DRIVE_PROSE_SECTIONS + (review.PROJECT_INSTANCE_HEADING,):
        first, last = spans.get(name, (0, 0))
        for n in range(first + 1, last):
            why = prose_reason(lines[n], placeholder) if n not in handled else None
            if why is not None:
                plan["listed"].append((n, why))
    reasons = {}
    for n, why in plan["listed"]:
        reasons.setdefault(n, []).append(why)
    plan["listed"] = [(n + 1, bare(lines[n]).strip(), "; ".join(reasons[n])) for n in sorted(reasons)]
    if plan["appended"] or plan["tags"]:
        plan["text"] = "\n".join(lines)
    return plan


