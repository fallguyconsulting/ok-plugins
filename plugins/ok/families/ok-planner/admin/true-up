        return ["- No stack: %s" % " ".join(declaration["none"].split())]
    return list(DRIVE_STACK_LINES)


def bare(line):
    return line.rstrip("\r").rstrip(" \t")


def section_spans(lines):
    heads = [n for n, line in enumerate(lines) if line.startswith("## ")]
    spans = {}
    for at, n in enumerate(heads):
        spans.setdefault(bare(lines[n]), (n, heads[at + 1] if at + 1 < len(heads) else len(lines)))
    return spans


def appended_stack_lines(text, new):
    heading = carried_review().DRIVE_COMMANDS_HEADING
    lines = text.split("\n")
    spans = section_spans(lines)
    if heading not in spans:
        body = text.rstrip("\r\n")
        return (body + "\n\n" if body else "") + "\n".join([heading, ""] + new) + "\n"
    start, end = spans[heading]
    at = end
    while at - 1 > start and not lines[at - 1].strip():
        at -= 1
    ending = "\r" if lines[start].endswith("\r") else ""
    lead = [] if lines[at - 1].startswith("- ") else [""]
    lines[at:at] = [line + ending for line in lead + new]
    return "\n".join(lines)


def without_written_stack_lines(text):
    lines = text.split("\n")
    pair = list(DRIVE_STACK_LINES)
    for n, line in enumerate(lines):
        if [bare(l) for l in lines[n:n + len(pair)]] == pair:
            width = len(pair)
        elif carried_review().NO_STACK_PATTERN.match(line):
            width = 1
        else:
            continue
        lead = 1 if n > 0 and not lines[n - 1].strip() else 0
        return "\n".join(lines[:n - lead] + lines[n + width:])
    return text


