def carries(entry, marker):
    hooks = entry.get("hooks", [])
    return isinstance(hooks, list) and any(
        isinstance(h, dict) and isinstance(h.get("command", ""), str) and marker in h.get("command", "")
        for h in hooks)


def marked_entry(entries, wiring):
    unreadable = EVENT_ENTRY_UNREADABLE % wiring["event"]
    for e in entries:
        if not isinstance(e, dict):
            return None, unreadable
        hooks = e.get("hooks", [])
        if not isinstance(hooks, list):
            return None, unreadable
        for h in hooks:
            if not isinstance(h, dict):
                return None, unreadable
            command = h.get("command", "")
            if isinstance(command, str) and wiring["marker"] in command:
                return e, None
    return None, None


def json_value(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=False)


def entry_shape(entry):
    return {"matcher": entry.get("matcher"), "hooks": entry.get("hooks")}


def wiring_current(entry, wiring):
    if wiring["whole"]:
        return json_value(entry_shape(entry)) == json_value(wiring["entry"])
    return entry.get("matcher") == wiring["entry"]["matcher"]


def retired_hook_entries(hooks):
    found = []
    for event, entries in sorted(hooks.items()):
        if not isinstance(entries, list):
            continue
        for e in entries:
            if not isinstance(e, dict):
                continue
            for group, marker in RETIRED_HOOK_MARKERS:
                if carries(e, marker):
                    found.append((group, event, e, marker))
                    break
    return found


def hook_findings(settings):
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        return [(None, HOOKS_NOT_AN_OBJECT)]
    found = []
    for wiring in WIRINGS:
        group, event = wiring["group"], wiring["event"]
        entries = hooks.get(event, [])
        if not isinstance(entries, list):
            found.append((group, EVENT_NOT_AN_ARRAY % event))
            continue
        entry, unreadable = marked_entry(entries, wiring)
        if unreadable is not None:
            found.append((group, unreadable))
        elif entry is None:
            found.append((group, "wiring: .claude/settings.json lacks the ok-planner %s entry for the %s hook"
                          % (event, wiring["label"])))
        elif wiring_current(entry, wiring):
            continue
        elif wiring["whole"]:
            found.append((group, "wiring: the ok-planner %s entry for the %s hook is %s — must be %s"
                          % (event, wiring["label"], json_value(entry_shape(entry)), json_value(wiring["entry"]))))
        else:
            found.append((group, "wiring: the ok-planner %s entry's matcher is %r — must be %r"
                          % (event, entry.get("matcher"), wiring["entry"]["matcher"])))
    for group, event, _, marker in retired_hook_entries(hooks):
        found.append((group, "wiring: .claude/settings.json still carries the retired %s entry for %s — "
                             "wire-hooks %s removes it" % (event, marker, group)))
    return found


