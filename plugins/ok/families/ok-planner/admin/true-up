def removal_split(paths):
    tracked = set(tracked_files(paths))
    changed = set(uncommitted(paths))
    removable, kept = [], []
    for p in paths:
        if os.path.islink(p) or symlinked([p]):
            kept.append(p)
        elif rel(p) in tracked:
            (kept if rel(p) in changed else removable).append(p)
        elif junk(p) or suite_marked(p):
            removable.append(p)
        else:
            kept.append(p)
    return removable, kept


