def materialize(writes, extras):
    lint_rules_absent = [p for p in LINT_RULES if not os.path.lexists(p)]
    wanted = set(writes)
    written = 0
    for _, dest_rel, interpreter, probe_args in EXECUTABLE_FILES:
        path = os.path.join(root, dest_rel)
        if path not in wanted:
            continue
        write_file(path, exp[path], executable=True)
        written += 1
        if probe_args is not None:
            probe(path, interpreter, probe_args)
    for path in sorted(wanted - EXECUTABLE):
        write_file(path, exp[path])
        written += 1
    print("materialized: %d files under .ok-planner/ and .claude/ (v%s), each skill folder carrying LICENSE"
          % (written, version))
    for placed_extra in extras:
        os.remove(placed_extra)
    prune(extras, BUILD_DEST)
    print("placed: the dashboard build at %s/ (v%s), ignored by git through its own .gitignore"
          % (rel(BUILD_DEST), version))
    if extras:
        print("removed: %d file(s) under %s/ not part of the carried v%s build: %s"
              % (len(extras), rel(BUILD_DEST), version, ", ".join(rel(p) for p in extras)))
    lint_rules_new = [p for p in lint_rules_absent if os.path.isfile(p)]
    if lint_rules_new:
        print(lint_rules_notice(lint_rules_new, "now bind"))
    if NODE is None:
        print(NODE_MISSING)


