#!/usr/bin/env python3
# Materialized by ok-planner v{{OK_PLANNER_VERSION}} — suite-owned; overwritten on true-up; do not hand-edit.
import calendar
import contextlib
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import types


def load_sibling(name):
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    module = types.ModuleType("ok_planner_%s" % name)
    module.__file__ = path
    with open(path, encoding="utf-8") as f:
        exec(compile(f.read(), path, "exec"), module.__dict__)
    return module


ports = load_sibling("ports")
issues = ports.issues
tasks = issues.tasks
sweep = ports.sweep
group = load_sibling("run-group")

USAGE = """stack — the reference stack tool: run each verification run from start to end.

  stack up [--name <name>]                 open a run of the declared stack: mint its tag, lease its
                                           ports, start it
  stack up [--name <name>] [--stop <command>] [--tag-variable <NAME>] -- <command> ...
                                           open a run of a command of your own, in the declared
                                           stack's place
  stack down <run-tag> | --name <name>     take a run down and delete its entry
  stack tag <name>                         print the tag of the run that holds the name
  stack cleanup                            take down each stale run nothing still uses
  stack list                               print the project's runs, one per line
  stack suggest-range                      print a free FIRST-LAST range of 200 ports
  stack check-range <first> <last>         check a range before it is declared
  stack -h | --help                        print this text

.ok-planner/config.json declares the stack, the port names, and the range:

  "stack": {"start": "<command>", "stop": "<command>", "tag_variable": "RUN_TAG"},
  "ports": ["DB_PORT", "WEB_PORT"],
  "port_range": {"first": 20000, "last": 20199}

or, for a project with no stack, "stack": {"none": "<why>"}. stop is
optional, and so is tag_variable beside none.

up mints the run tag (run-<12 hex>) with run-tag beside this script, records
the run in .ok-planner/.cache/stack.json under one lock, leases one port per
declared name from port_range through the port registry, ports, beside this
script (nothing where ports names none), makes the run folder under the
machine's temp folder, and runs the start command from the project root in
the run's own process group, kept by run-group beside this script, and waits
for it to exit: the command exits once the stack is up, and starts each
server in the background (docker compose up -d, or a trailing &), which keeps
the server in the run's process group.

A bare up runs the start command stack declares through sh -c, and down runs
the stop command it declares; the start command reads the tag from the
variable stack.tag_variable names. A bare up refuses where stack declares no
start command. up -- <command> runs that command in the declared one's place;
down runs the stop command --stop names, and the command reads the tag from
the variable --tag-variable names, or stack.tag_variable where --tag-variable
is absent. --stop and --tag-variable belong to up -- alone.

--name <name> (lower-case letters, digits, and hyphens) names the run, and
down --name and tag find it by that name. Where a run already holds the name,
up takes that run down first when nothing still uses it, and refuses when
something does.

The command's environment holds the tag under the tag variable, one
NAME=<port> per leased port, OK_RUN_LABEL=ok.run-tag=<tag>,
COMPOSE_PROJECT_NAME=<tag>, and OK_RUN_FOLDER=<the run folder>; its output
goes to stack-start.log in the run folder. up probes docker's daemon before
and after the command, on a failed start as on a passing one, and records on
the run's entry whether either probe answered. On success up prints the tag
on line 1, then one NAME=<port> line per port. On a failed start it takes the
run down, and where a leased port is then held by a program outside the run,
it starts again with a fresh tag and fresh ports, within 3 attempts;
otherwise it prints the start command's output on stderr and exits 1.

down runs the run's stop command where it has one, stops every process left
in the run's process group, removes every docker container (with its
anonymous volumes), network, volume, and image labelled ok.run-tag=<tag> or
in the compose project <tag> through docker-sweep beside this script, deletes
the run folder, releases the run's ports, and deletes the entry. Where a
removal is refused, down attempts every other one, keeps the entry and its
lease with the refusal named, clears the entry's name, and exits 1. Where the
stop command fails, the run folder stays for the stop command's next run.
Where docker's daemon does not answer now, down counts the sweep as done only
for a run whose two probes went unanswered; a run that reached docker keeps
its entry. down --name, where no run holds the name, prints took down:
nothing and exits 0.

cleanup takes down each run at least an hour old that nothing still uses: no
process left in its group, no running container with its label or in its
compose project, no program holding its ports. It prints one took down: line
or one left: line per run, and exits 1 only where a removal was refused.
list prints each run's tag, time, ports, and folder, then name: <name> where
the run has a name, then refused: <refusals> where a removal was refused.
cleanup, down, tag, and list read no stack declaration; suggest-range and
check-range read nothing of the project.

Exit 0 on success. Exit 1 on a refusal, with its reason on stderr, or on a
failure, with one STACK.RUN.FAILED event on stderr."""

REGISTRY_NAME = "stack.json"
REGISTRY_REL = os.path.join(".ok-planner", ".cache", REGISTRY_NAME)
LOCK_NAME = "stack.lock"
RUN_TAG_SCRIPT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "run-tag")
EXIT_REFUSED = 1
GRACE_SECONDS = 3600
START_ATTEMPTS = 3
LEASE_TIME = "%Y-%m-%dT%H:%M:%SZ"
STACK_KEYS = ("start", "stop", "tag_variable", "none")
TOOL_VARIABLES = ("OK_RUN_LABEL", "OK_RUN_FOLDER", "COMPOSE_PROJECT_NAME")
UP_OPTIONS = {"--name": "name", "--stop": "stop", "--tag-variable": "tag_variable"}
RUN_NAME = re.compile(r"^[a-z0-9-]+$")
RUN_FOLDER_PARENT = "ok-planner-stack"
START_LOG = "stack-start.log"
VERBS_TEXT = ("usage: stack up [--name <name>] [--stop <command>] [--tag-variable <NAME>] [-- <command> ...] | "
              "down <run-tag> | down --name <name> | tag <name> | cleanup | list | suggest-range | "
              "check-range <first> <last>; stack --help says more")


class Refusal(Exception):
    pass


def run_tag(value):
    if not tasks.RUN_TAG.match(value):
        raise Refusal("%r is not a run tag (run-<12 hex>), the tag stack up printed for the run; stack list "
                      "prints the runs" % value)
    return value


def run_name(value):
    if not RUN_NAME.match(value):
        raise Refusal("%r is not a run name: a name is lower-case letters, digits, and hyphens" % value)
    return value


def fresh_tag():
    result = subprocess.run(["sh", RUN_TAG_SCRIPT], stdin=subprocess.DEVNULL, capture_output=True, text=True)
    tag = result.stdout.strip()
    assert result.returncode == 0 and tasks.RUN_TAG.match(tag), (
        "sh %s exited %d and printed %r, not a run tag: %s"
        % (RUN_TAG_SCRIPT, result.returncode, tag, result.stderr.strip() or "no message"))
    return tag


def nonempty_text(value):
    return isinstance(value, str) and value.strip() != ""


def tag_variable_defects(label, variable, names):
    if not isinstance(variable, str) or not ports.PORT_NAME.match(variable):
        return ["%s %s is not a NAME (upper-case letters, digits, and underscores, not starting with a digit)"
                % (label, json.dumps(variable))]
    if variable in TOOL_VARIABLES:
        return ['%s "%s" is a variable the stack tool sets itself (%s)' % (label, variable, ", ".join(TOOL_VARIABLES))]
    if variable in names:
        return ['%s "%s" is also a name ports declares, and the stack tool sets it to the run tag' % (label, variable)]
    return []


def stack_defects(value, names):
    if not isinstance(value, dict):
        return ['stack must be an object: {"start": <command>, "stop": <command>, "tag_variable": <NAME>}, or '
                '{"none": <why the project has no stack>}']
    defects = ["stack names an unknown key %s (the keys are %s)" % (json.dumps(key), ", ".join(STACK_KEYS))
               for key in value if key not in STACK_KEYS]
    defects += ["stack.%s must be a non-empty string" % key
                for key in ("start", "stop", "none") if key in value and not nonempty_text(value[key])]
    if "start" in value and "none" in value:
        defects.append("stack sets both start and none: a project with a stack sets start, and one with none "
                       "sets none")
    if "start" not in value and "none" not in value:
        defects.append("stack sets neither start nor none: set start to the command that starts the stack, or "
                       "none to why the project has none")
    if "stop" in value and "start" not in value:
        defects.append("stack.stop is set without stack.start")
    if "start" in value and "tag_variable" not in value:
        defects.append("stack.tag_variable must name the variable the start command reads the run tag from")
    if "tag_variable" in value:
        defects += tag_variable_defects("stack.tag_variable", value["tag_variable"], names)
    defects += ['ports names "%s", which the stack tool sets itself as a variable of its own' % name
                for name in names if name in TOOL_VARIABLES]
    return defects


def stack_declaration(config, names):
    if "stack" not in config:
        return None
    defects = stack_defects(config["stack"], names)
    if defects:
        raise Refusal("%s: %s; %s" % (ports.CONFIG_REL, "; ".join(defects), ports.CONFIG_CHECK))
    return config["stack"]


def declared_stack(config):
    declaration = stack_declaration(config, ports.declared_names(config))
    if declaration is None:
        return "unfilled", ("%s declares no stack: set stack.start (with stack.tag_variable) in %s to the command "
                            "that starts the project's stack, or run stack up -- <command> to open a run for a "
                            "command of your own" % (ports.CONFIG_REL, ports.CONFIG_REL))
    if "none" in declaration:
        return "none", declaration["none"]
    return "stack", declaration["start"]


def utc_now():
    return time.strftime(LEASE_TIME, time.gmtime())


def entry_seconds(tag, entry):
    at = entry.get("at")
    assert isinstance(at, str), "the stack registry's run %s records no time" % tag
    return calendar.timegm(time.strptime(at, LEASE_TIME))


def read_registry(path):
    if not os.path.isfile(path):
        return {"runs": {}}
    with open(path, encoding="utf-8") as f:
        registry = json.load(f)
    assert isinstance(registry, dict) and isinstance(registry.get("runs"), dict), (
        "%s is not a stack registry: it holds no runs object" % path)
    for tag, entry in registry["runs"].items():
        assert isinstance(entry, dict) and isinstance(entry.get("ports", {}), dict), (
            "%s is not a stack registry: the run %s holds no entry object with a ports object" % (path, tag))
    return registry


def adopt_leases(root, registry):
    registry.pop("next", None)
    for tag, entry in registry["runs"].items():
        if "ports" in entry:
            at = entry["at"] if isinstance(entry.get("at"), str) else utc_now()
            ports.record_lease(root, tag, entry["ports"], at)
            del entry["ports"]


@contextlib.contextmanager
def registry_lock(root):
    cache = tasks.cache_dir(root)
    with open(os.path.join(cache, LOCK_NAME), "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield os.path.join(cache, REGISTRY_NAME)


def write_registry(path, registry):
    issues.write_records(path, json.dumps(registry, indent=2, sort_keys=True) + "\n")


def transaction(root, change):
    with registry_lock(root) as path:
        registry = read_registry(path)
        before = json.dumps(registry, sort_keys=True)
        adopt_leases(root, registry)
        result = change(registry)
        if json.dumps(registry, sort_keys=True) != before:
            write_registry(path, registry)
    return result


def named(registry, name):
    for tag, entry in registry["runs"].items():
        if entry.get("name") == name:
            return tag
    return None


def lease_of(root, tag):
    return ports.leases(root).get(tag, {}).get("ports", {})


def run_folder(tag):
    return os.path.join(tempfile.gettempdir(), RUN_FOLDER_PARENT, tag)


def port_text(leased):
    return ", ".join("%s=%d" % (name, port) for name, port in leased.items()) or "no ports"


def open_entry(root, plan):
    def change(registry):
        name = plan["name"]
        holder = named(registry, name) if name is not None else None
        if holder is not None:
            raise Refusal("the run %s holds the name %s; stack down --name %s takes it down" % (holder, name, name))
        tag = fresh_tag()
        while tag in registry["runs"]:
            tag = fresh_tag()
        entry = {"at": utc_now(), "name": name, "folder": run_folder(tag), "declared": plan["declared"],
                 "stop": plan["stop"], "tag_variable": plan["tag_variable"], "docker": False, "refused": None,
                 "stopping": None}
        registry["runs"][tag] = entry
        return tag, dict(entry)

    return transaction(root, change)


def lease_ports(lines):
    leased = {}
    for line in lines:
        name, port = line.split("=", 1)
        leased[name] = int(port)
    return leased


def run_env(tag, entry, leased):
    env = dict(os.environ)
    env.pop("OK_PLANNER_PROJECT_ROOT", None)
    if entry.get("tag_variable"):
        env[entry["tag_variable"]] = tag
    for name, port in leased.items():
        env[name] = str(port)
    env["OK_RUN_LABEL"] = "%s=%s" % (sweep.RUN_LABEL_KEY, tag)
    env["COMPOSE_PROJECT_NAME"] = tag
    env["OK_RUN_FOLDER"] = entry["folder"]
    return env


def record_docker(root, tag, reached):
    def change(registry):
        registry["runs"][tag]["docker"] = reached

    transaction(root, change)


def run_stop(root, tag, entry, leased):
    with tempfile.TemporaryFile() as out:
        code = subprocess.run(["sh", "-c", entry["stop"]], cwd=root, env=run_env(tag, entry, leased),
                              stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                              close_fds=True).returncode
        if code == 0:
            return None
        out.seek(0)
        text = out.read().decode("utf-8", "replace").strip()
    return "the stop command exited %d%s" % (code, ": " + text.splitlines()[-1] if text else "")


def remove_folder(entry):
    folder = entry.get("folder")
    if not isinstance(folder, str) or not folder:
        return None
    parent = os.path.dirname(folder)
    if os.path.basename(parent) != RUN_FOLDER_PARENT or not tasks.RUN_TAG.match(os.path.basename(folder)):
        return "the recorded folder %s is no run folder, so it stays" % folder
    if os.path.lexists(folder):
        shutil.rmtree(folder)
    return None


def unanswered_reason(entry, unanswered):
    reached = entry.get("docker")
    if reached is False or (reached is None and shutil.which("docker") is None):
        return None
    if reached is None:
        return "%s, and the run's entry records no docker probe" % unanswered
    return "%s, and the run reached docker" % unanswered


def sweep_run(tag, entry):
    try:
        docker = sweep.answering_docker()
    except sweep.Unanswered as unanswered:
        reason = unanswered_reason(entry, unanswered)
        tasks.event("STACK.SWEEP.SKIPPED", tag=tag, error=type(unanswered).__name__, message=str(unanswered),
                    kept=reason is not None)
        if reason is None:
            return "%s, and the run never reached docker" % unanswered, []
        return "%s" % unanswered, ["docker: %s" % reason]
    return sweep.sweep(docker, tag)


def removal_steps(root, tag, entry):
    leased = lease_of(root, tag)
    stop_refusals = []
    if entry.get("stop"):
        stop_refusals = attempt_step(tag, "stop", lambda: run_stop(root, tag, entry, leased))
    refusals = stop_refusals + attempt_step(tag, "group", lambda: group.stop(root, tag, pgid=entry.get("holder")))
    what, docker_refusals = sweep_run(tag, entry)
    refusals += docker_refusals
    if stop_refusals:
        refusals.append("folder: %s stays for the stop command's next run" % entry.get("folder"))
    else:
        refusals += attempt_step(tag, "folder", lambda: remove_folder(entry))
    return refusals, "%s; %s" % (port_text(leased), what)


def attempt_step(tag, step, attempt):
    try:
        refusal = attempt()
    except (OSError, subprocess.SubprocessError) as err:
        tasks.event("STACK.REMOVAL.REFUSED", tag=tag, step=step, error=type(err).__name__, message=str(err))
        return ["%s: %s" % (step, err)]
    return [refusal] if refusal else []


def live_claim(entry):
    claimant = entry.get("stopping")
    return claimant if claimant != os.getpid() and group.pid_live(claimant) else None


def claim(root, tag, name=None):
    def change(registry):
        found = named(registry, name) if name is not None else tag
        if found is None:
            return None
        entry = registry["runs"].get(found)
        if entry is None:
            raise Refusal("the registry holds no run %s; stack list prints the runs" % found)
        claimant = live_claim(entry)
        if claimant is not None:
            raise Refusal("pid %d is taking the run %s down now" % (claimant, found))
        entry["stopping"] = os.getpid()
        return found, dict(entry)

    return transaction(root, change)


def settle(root, outcomes):
    me = os.getpid()

    def change(registry):
        for tag, refusals in outcomes.items():
            entry = registry["runs"].get(tag)
            if entry is None or entry.get("stopping") != me:
                continue
            if refusals == []:
                ports.release(root, tag)
                del registry["runs"][tag]
                continue
            entry["stopping"] = None
            if refusals:
                entry["refused"] = refusals
                entry["name"] = None

    transaction(root, change)


def take_down(root, tag, name=None):
    claimed = claim(root, tag, name)
    if claimed is None:
        return None
    tag, entry = claimed
    outcome = {tag: None}
    try:
        refusals, what = removal_steps(root, tag, entry)
        outcome[tag] = refusals
    finally:
        settle(root, outcome)
    return tag, refusals, what


def held_port(leased):
    if not leased:
        return None
    addresses = ports.bind_addresses()
    for name, port in leased.items():
        if ports.held(port, addresses):
            return "%s=%d" % (name, port)
    return None


def start_run(root, plan, command):
    tag, entry = open_entry(root, plan)
    leased = {}
    try:
        leased = lease_ports(ports.lease(root, tag))
        os.makedirs(os.path.dirname(entry["folder"]), exist_ok=True)
        os.mkdir(entry["folder"])
        reached = sweep.docker_reached(shutil.which("docker"))
        record_docker(root, tag, reached)
        pgid = group.holder_group(root, tag)
        log = os.path.join(entry["folder"], START_LOG)
        try:
            with open(log, "wb") as out:
                code = subprocess.run(command, cwd=root, env=run_env(tag, entry, leased), stdin=subprocess.DEVNULL,
                                      stdout=out, stderr=subprocess.STDOUT, close_fds=True,
                                      preexec_fn=group.join_group(pgid)).returncode
        finally:
            after = sweep.docker_reached(shutil.which("docker"))
            record_docker(root, tag, reached or after)
        if code == 0:
            return {"tag": tag, "ports": leased}
        with open(log, encoding="utf-8", errors="replace") as f:
            output = f.read()
    except BaseException:
        take_down(root, tag)
        raise
    _, refusals, _ = take_down(root, tag)
    failed = {"tag": tag, "output": output, "code": code, "refusals": refusals, "port": None}
    if not refusals:
        failed["port"] = held_port(leased)
    return failed


def checked_command(root, command):
    program = command[0]
    runnable = os.access(os.path.join(root, program), os.X_OK) if os.sep in program else shutil.which(program)
    if not runnable:
        raise Refusal("%r names no program stack up can run from the project root; name a program on PATH, or a "
                      "path to one from the project root, after --" % program)
    return command


def start_plan(root, config, options, command):
    names = ports.declared_names(config)
    declaration = stack_declaration(config, names)
    state, reason = declared_stack(config)
    if command is None and state == "unfilled":
        raise Refusal(reason)
    if command is None and state == "none":
        raise Refusal("the project has no stack: %s declares stack.none (%s); run stack up -- <command> to open "
                      "a run for a command of your own" % (ports.CONFIG_REL, reason))
    if options["tag_variable"] is not None:
        defects = tag_variable_defects("--tag-variable", options["tag_variable"], names)
        if defects:
            raise Refusal("; ".join(defects))
    if command is None:
        stop, variable = declaration.get("stop"), declaration["tag_variable"]
    else:
        stop = options["stop"]
        variable = options["tag_variable"] or (declaration or {}).get("tag_variable")
    plan = {"names": names, "name": options["name"], "declared": command is None, "stop": stop,
            "tag_variable": variable}
    if names:
        ports.leasable_range(config)
    return plan, ["sh", "-c", declaration["start"]] if command is None else checked_command(root, command)


def free_name(root, name):
    claimed = claim(root, None, name)
    if claimed is None:
        return None
    tag, entry = claimed
    outcome = {tag: None}
    try:
        reason = in_use(root, tag, entry)
        if reason is not None:
            raise Refusal("the run %s holds the name %s, and %s; stack down --name %s takes it down"
                          % (tag, name, reason, name))
        refusals, what = removal_steps(root, tag, entry)
        outcome[tag] = refusals
    finally:
        settle(root, outcome)
    if refusals:
        return ("the run %s held the name %s and is not all taken down: %s; its entry stays without the name"
                % (tag, name, "; ".join(refusals)))
    return "took down: %s (%s), which held the name %s" % (tag, what, name)


def up(root, options, command, say, note):
    plan, argv = start_plan(root, ports.read_config(root), options, command)
    if plan["name"] is not None:
        freed = free_name(root, plan["name"])
        if freed is not None:
            note(freed)
    attempt = 1
    while True:
        result = start_run(root, plan, argv)
        if "ports" in result:
            say(result["tag"])
            for name, port in result["ports"].items():
                say("%s=%d" % (name, port))
            return 0
        if result["port"] is None or attempt >= START_ATTEMPTS:
            break
        attempt += 1
        tasks.event("STACK.START.RETRIED", tag=result["tag"], attempt=attempt, port=result["port"])
    sys.stderr.write(result["output"])
    if result["refusals"]:
        raise Refusal("the start command exited %d, and taking the run %s down was refused: %s; stack list "
                      "shows its entry" % (result["code"], result["tag"], "; ".join(result["refusals"])))
    if result["port"] is not None:
        raise Refusal("the start command failed on each of %d attempts while a program outside the run held a "
                      "leased port (last: %s, exit %d); every run is taken down, and stack suggest-range finds a "
                      "range no program holds" % (START_ATTEMPTS, result["port"], result["code"]))
    raise Refusal("the start command exited %d; the run %s is taken down" % (result["code"], result["tag"]))


def down(root, tag, name, say):
    taken = take_down(root, tag, name)
    if taken is None:
        say("took down: nothing (no run holds the name %s)" % name)
        return
    tag, refusals, what = taken
    if refusals:
        raise Refusal("the run %s is not all taken down: %s; its entry stays, and stack cleanup tries it again"
                      % (tag, "; ".join(refusals)))
    say("took down: %s (%s)" % (tag, what))


def named_tag(root, name):
    tag = transaction(root, lambda registry: named(registry, name))
    if tag is None:
        raise Refusal("no run holds the name %s; stack list prints the runs and their names" % name)
    return tag


def in_use(root, tag, entry):
    others = group.members(root, tag, pgid=entry.get("holder"))
    if others:
        return "pid(s) %s still run in its process group" % ", ".join(str(pid) for pid in others)
    docker = None
    try:
        docker = sweep.answering_docker()
    except sweep.Unanswered as unanswered:
        reason = unanswered_reason(entry, unanswered)
        tasks.event("STACK.CLEANUP.UNCHECKED", tag=tag, error=type(unanswered).__name__, message=str(unanswered))
        if reason is not None:
            return "%s, so its containers cannot be checked" % reason
    if docker is not None:
        try:
            running = sweep.running(docker, tag)
        except (sweep.DockerFailed, OSError) as err:
            tasks.event("STACK.CLEANUP.UNCHECKED", tag=tag, error=type(err).__name__, message=str(err))
            return "docker could not list its containers: %s" % err
        if running:
            return "%d running container(s) carry its label or belong to its compose project" % len(running)
    holder_port = held_port(lease_of(root, tag))
    if holder_port is not None:
        return "a program holds its port %s" % holder_port
    return None


def cleanup(root, say):
    now = time.time()

    def claim_due(registry):
        lines, due = {}, {}
        for tag in sorted(registry["runs"]):
            entry = registry["runs"][tag]
            claimant = live_claim(entry)
            if now - entry_seconds(tag, entry) < GRACE_SECONDS:
                lines[tag] = "left: %s — younger than an hour" % tag
            elif claimant is not None:
                lines[tag] = "left: %s — pid %d is taking it down now" % (tag, claimant)
            else:
                entry["stopping"] = os.getpid()
                due[tag] = dict(entry)
        return lines, due

    lines, due = transaction(root, claim_due)
    outcomes = {tag: None for tag in due}
    refused = False
    try:
        for tag in sorted(due):
            reason = in_use(root, tag, due[tag])
            if reason is not None:
                lines[tag] = "left: %s — %s" % (tag, reason)
                continue
            refusals, what = removal_steps(root, tag, due[tag])
            outcomes[tag] = refusals
            if refusals:
                refused = True
                lines[tag] = "left: %s — %s" % (tag, "; ".join(refusals))
            else:
                lines[tag] = "took down: %s (%s)" % (tag, what)
    finally:
        settle(root, outcomes)
    for tag in sorted(lines):
        say(lines[tag])
    return EXIT_REFUSED if refused else 0


def list_runs(root, say):
    registry = transaction(root, lambda current: current)
    leases = ports.leases(root)
    runs = registry["runs"]
    for tag in sorted(runs, key=lambda name: (runs[name].get("at") or "", name)):
        entry = runs[tag]
        fields = [tag, entry.get("at") or "no time", port_text(leases.get(tag, {}).get("ports", {})),
                  entry.get("folder") or "no folder"]
        if entry.get("name"):
            fields.append("name: %s" % entry["name"])
        if entry.get("refused"):
            fields.append("refused: %s" % "; ".join(entry["refused"]))
        say("  ".join(fields))


def up_arguments(args):
    options = {"name": None, "stop": None, "tag_variable": None}
    command = None
    at = 0
    while at < len(args):
        if args[at] == "--":
            command = args[at + 1:]
            if not command:
                raise Refusal("usage: stack up ... -- <command> ...: name the command to run after --")
            break
        key = UP_OPTIONS.get(args[at])
        if key is None:
            raise Refusal("%r is no option of stack up, which takes --name, --stop, and --tag-variable before --; "
                          "%s" % (args[at], VERBS_TEXT))
        if at + 1 >= len(args):
            raise Refusal("%s takes a value: stack up %s <value>" % (args[at], args[at]))
        if options[key] is not None:
            raise Refusal("stack up takes %s once" % args[at])
        options[key] = args[at + 1]
        at += 2
    if command is None and (options["stop"] is not None or options["tag_variable"] is not None):
        raise Refusal("--stop and --tag-variable belong to stack up -- <command>: the stack key supplies the stop "
                      "command and tag variable of a bare stack up")
    if options["name"] is not None:
        run_name(options["name"])
    if options["stop"] is not None and not nonempty_text(options["stop"]):
        raise Refusal("--stop names an empty command: name the command that stops the run, or leave --stop out")
    return options, command


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if not argv:
        raise Refusal(VERBS_TEXT)
    verb, args = argv[0], argv[1:]
    if verb == "up":
        options, command = up_arguments(args)
        return up(tasks.project_root(), options, command, print,
                  lambda line: sys.stderr.write("stack: %s\n" % line))
    if verb == "down":
        if len(args) == 1:
            down(tasks.project_root(), run_tag(args[0]), None, print)
        elif len(args) == 2 and args[0] == "--name":
            down(tasks.project_root(), None, run_name(args[1]), print)
        else:
            raise Refusal("usage: stack down <run-tag>, with the tag stack up printed, or stack down --name <name>")
        return 0
    if verb == "tag":
        if len(args) != 1:
            raise Refusal("usage: stack tag <name>, with the name stack up --name gave the run")
        print(named_tag(tasks.project_root(), run_name(args[0])))
        return 0
    if verb in ("cleanup", "list", "suggest-range"):
        if args:
            raise Refusal("usage: stack %s, which takes no argument" % verb)
        if verb == "cleanup":
            return cleanup(tasks.project_root(), print)
        if verb == "list":
            list_runs(tasks.project_root(), print)
        else:
            print(ports.suggest_range())
        return 0
    if verb == "check-range":
        if len(args) != 2:
            raise Refusal("usage: stack check-range <first> <last>")
        print(ports.check_range(args[0], args[1]))
        return 0
    raise Refusal("%r names no verb: stack takes up, down, tag, cleanup, list, suggest-range, or check-range; %s"
                  % (verb, VERBS_TEXT))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (Refusal, ports.Refusal, group.Refusal, sweep.Refusal) as refusal:
        sys.stderr.write("stack: %s\n" % refusal)
        sys.exit(EXIT_REFUSED)
    except Exception as err:
        tasks.event("STACK.RUN.FAILED", error=type(err).__name__, message=str(err), registry=REGISTRY_REL)
        sys.exit(EXIT_REFUSED)
