def load_sibling(name):
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    module = types.ModuleType("ok_planner_%s" % name)
    module.__file__ = path
    with open(path, encoding="utf-8") as f:
        exec(compile(f.read(), path, "exec"), module.__dict__)
    return module


issues = load_sibling("issues")

VERSION = "{{OK_PLANNER_VERSION}}"
ESTATE = os.path.join(".ok-planner", "review")
CONFIG_PATH = os.path.join(ESTATE, "config.json")
CATALOG_DIR = os.path.join(ESTATE, "catalog")
ACCEPT_PATH = os.path.join(CATALOG_DIR, "accept.md")
DEFECT_NOT_REAL = ("duplicate", "declined")
STORIES_DIR = os.path.join(".ok-planner", "design", "stories")
