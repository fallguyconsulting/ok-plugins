class ReviewError(Exception):
    pass


def project_root():
    found = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    if found.returncode != 0:
        raise ReviewError("not inside a git checkout: " + found.stderr.strip())
    top = found.stdout.strip()
    here = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(here, ESTATE)):
            return here
        if here == top or os.path.dirname(here) == here:
            raise ReviewError("no %s directory between here and %s" % (ESTATE, top))
        here = os.path.dirname(here)


def load_config(root):
    path = os.path.join(root, CONFIG_PATH)
    try:
        with open(path) as handle:
            config = json.load(handle)
    except (OSError, ValueError) as err:
        raise ReviewError("cannot read %s: %s" % (CONFIG_PATH, err)) from err
    for key in ("exclude", "prose_suffixes", "test_patterns", "bug_families"):
        if key not in config:
            raise ReviewError("%s declares no %r" % (CONFIG_PATH, key))
    return config


def git_lines(root, *args):
    ran = subprocess.run(["git"] + list(args), cwd=root, capture_output=True, text=True)
    if ran.returncode != 0:
        raise ReviewError("git %s failed: %s" % (" ".join(args), ran.stderr.strip()))
    return [line for line in ran.stdout.split("\n") if line]


def is_binary(path):
    try:
        with open(path, "rb") as handle:
            return b"\0" in handle.read(SNIFF_BYTES)
    except OSError as err:
        raise ReviewError("cannot read %s: %s" % (path, err)) from err


def matches_any(path, patterns):
    name = os.path.basename(path)
    for pattern in patterns:
        if pattern.endswith("/"):
            if path.startswith(pattern) or ("/" + pattern) in ("/" + path):
                return True
        elif fnmatch.fnmatch(path, pattern) or fnmatch.fnmatch(name, pattern):
            return True
    return False


def project_folders(root):
    path = os.path.join(root, PROJECT_CONFIG_PATH)
    if not os.path.isfile(path):
        return []
    try:
        with open(path) as handle:
            text = handle.read()
    except OSError as err:
        raise ReviewError("cannot read %s: %s" % (PROJECT_CONFIG_PATH, err)) from err
    try:
        declared = json.loads(text)
    except ValueError:
        declared = None
    if isinstance(declared, dict) and "folders" not in declared:
        return []
    node = shutil.which("node")
    if node is None:
        print("review: %s may declare folders, and node is not on PATH to check them; the review reads the "
              "project root alone" % PROJECT_CONFIG_PATH, file=sys.stderr)
        return []
    ran = subprocess.run([node, os.path.join(root, LINT), "config-check", "--config", path],
                         cwd=root, capture_output=True, text=True)
    defects = [line for line in ran.stdout.split("\n") if line.strip()]
    if ran.returncode == 2 and defects:
        print("review: %s is malformed, so the review reads the project root alone; run /ok, which repairs it:\n%s"
              % (PROJECT_CONFIG_PATH, ran.stdout.rstrip()), file=sys.stderr)
        return []
    if ran.returncode not in (0, 2):
        raise ReviewError("plumbline config-check could not read %s (exit %d): %s"
                          % (PROJECT_CONFIG_PATH, ran.returncode, (ran.stderr or ran.stdout).strip()))
    assert isinstance(declared, dict), "config-check passed %s, which the review could not parse" % PROJECT_CONFIG_PATH
    return sorted({os.path.normpath(entry) for entry in declared["folders"]} - {"."})


def owned_text(root, path, base):
    full = os.path.join(root, path)
    if os.path.isfile(full):
        try:
            with open(full, encoding="utf-8", errors="replace") as handle:
                return handle.read()
        except OSError as err:
            raise ReviewError("cannot read %s: %s" % (path, err)) from err
    if base is None:
        return ""
    ran = subprocess.run(["git", "show", "%s:./%s" % (base, path)], cwd=root, capture_output=True,
                         text=True, errors="replace")
    return ran.stdout if ran.returncode == 0 else ""


def left_alone(root, path, base=None):
    path = os.path.normpath(path).replace(os.sep, "/")
    for kind, entries in OWNER_PATHS:
        if any(path == entry or (entry.endswith("/") and path.startswith(entry)) for entry in entries):
            return kind
    if HARNESS_SETTINGS.match(path):
        return "declaration"
    lines = owned_text(root, path, base).split("\n")
    filled = [line for line in lines if line.strip()]
    if any(SUITE_STAMP.search(line) for line in lines[:SUITE_STAMP_HEAD_LINES] + filled[-1:]):
        return "suite"
    if os.path.basename(path) == "LICENSE" and SUITE_LICENSE_HEAD in lines[0]:
        return "suite"
    return None


def cmd_owner(args, root, config):
    if args.base:
        ran = subprocess.run(["git", "rev-parse", "--verify", "--quiet", args.base + "^{commit}"],
                             cwd=root, capture_output=True, text=True)
        if ran.returncode != 0:
            raise ReviewError("--base %s names no commit of this repository" % args.base)
    for given in args.paths:
        path = os.path.relpath(given, root) if os.path.isabs(given) else given
        print("%s\t%s" % (left_alone(root, path, args.base) or "project", given))


def tree_files(root):
    return sorted(set(git_lines(root, "ls-files", "--cached", "--others", "--exclude-standard", "--", ".",
                                *project_folders(root))))


def scoped_files(root, config):
    kept = []
    for path in tree_files(root):
        full = os.path.join(root, path)
        if not os.path.isfile(full) or os.path.islink(full) or os.path.getsize(full) == 0:
            continue
        if path.lower().endswith(tuple(config["prose_suffixes"])):
            continue
        if matches_any(path, config["exclude"]) or matches_any(path, config["test_patterns"]):
            continue
        if is_binary(full) or left_alone(root, path):
            continue
        kept.append(path)
    return kept


def content_hash(root, path):
    digest = hashlib.sha256()
    try:
        with open(os.path.join(root, path), "rb") as handle:
            digest.update(handle.read())
    except OSError as err:
        raise ReviewError("cannot read %s: %s" % (path, err)) from err
    return digest.hexdigest()


def cmd_files(args, root, config):
    for path in scoped_files(root, config):
        print(path)


CHANGE_KINDS = {"A": "added", "D": "deleted"}


OUTSIDE_HEADING = "## Paths outside the project root"


def outside_paths(root, sprint):
    if not sprint:
        return []
    try:
        with open(os.path.join(root, sprint)) as handle:
            lines = handle.read().split("\n")
    except OSError as err:
        raise ReviewError("cannot read the sprint %s: %s" % (sprint, err)) from err
    if OUTSIDE_HEADING not in lines:
        return []
    top = git_lines(root, "rev-parse", "--show-toplevel")[0]
    paths = []
    for line in lines[lines.index(OUTSIDE_HEADING) + 1:]:
        if line.startswith("#"):
            break
        found = re.match(r"^- `([^`]+)`", line)
        if not found:
            continue
        path = os.path.normpath(found.group(1))
        full = os.path.normpath(os.path.join(root, path))
        if not path.startswith("../") or os.path.commonpath([full, top]) != top:
            raise ReviewError("%s names %s under %r, which is not a path beside the project root inside the repository" % (sprint, found.group(1), OUTSIDE_HEADING))
        paths.append(path)
    return paths


def sprint_base(root, sprint):
    path = os.path.join(root, re.sub(r"\.md$", "", sprint) + "-base.txt")
    try:
        with open(path) as handle:
            base = handle.read().strip()
    except FileNotFoundError:
        raise ReviewError("%s records no base commit (no %s); pass --base" % (sprint, os.path.relpath(path, root))) from None
    except OSError as err:
        raise ReviewError("cannot read the base file %s: %s" % (os.path.relpath(path, root), err)) from err
    if not base:
        raise ReviewError("%s is empty; pass --base" % os.path.relpath(path, root))
    return base


def chosen_base(args, root):
    if args.base:
        return args.base
    if args.sprint:
        return sprint_base(root, args.sprint)
    return None


def changed_files(root, config, base, outside=()):
    beside = sorted(set(outside) | set(project_folders(root)))
    kinds = {}
    for line in git_lines(root, "diff", "--relative", "--name-status", "--no-renames", base, "--", "."):
        status, path = line.split("\t", 1)
        kinds[path] = CHANGE_KINDS.get(status[0], "changed")
    for path in git_lines(root, "ls-files", "--others", "--exclude-standard", "--", "."):
        kinds[path] = "added"
    if beside:
        top = git_lines(root, "rev-parse", "--show-toplevel")[0]
        for line in git_lines(root, "diff", "--name-status", "--no-renames", base, "--", *beside):
            status, path = line.split("\t", 1)
            kinds[os.path.relpath(os.path.join(top, path), root)] = CHANGE_KINDS.get(status[0], "changed")
        for path in git_lines(root, "ls-files", "--others", "--exclude-standard", "--", *beside):
            kinds[os.path.normpath(path)] = "added"
    return {
        path: kind for path, kind in sorted(kinds.items())
        if not matches_any(path, config["exclude"]) and not matches_any(path, config["test_patterns"])
        and not left_alone(root, path, base)
    }


def cmd_changed(args, root, config):
    base = chosen_base(args, root) or "HEAD"
    for path, kind in changed_files(root, config, base, outside_paths(root, args.sprint)).items():
        print("%s\t%s" % (kind, path))


def cmd_checks(args, root, config):
    checks = config.get("checks")
    if not isinstance(checks, list) or not all(isinstance(check, str) for check in checks):
        raise ReviewError(f"{CONFIG_PATH} declares no 'checks' list of commands")
    if not all(check.strip() for check in checks):
        raise ReviewError(f"{CONFIG_PATH} 'checks' holds an empty command")
    base = chosen_base(args, root)
    if not base:
        raise ReviewError("checks needs --base or --sprint")
    changed = changed_files(root, config, base, outside_paths(root, args.sprint))
    paths = [path for path, kind in changed.items() if kind != "deleted"]
    filed = []
    if paths:
        quoted = " ".join(shlex.quote(path) for path in paths)
        for check in checks:
            command = check + " " + quoted
            task = filed_task(root, "--kind", "exec", "--key", args.key, "--command", command)
            filed.append({"task": task, "check": check})
    print(json.dumps({"check_tasks": filed}, indent=1))


def stored_blob(root, path):
    ran = subprocess.run(["git", "hash-object", "-w", "--", path], cwd=root, capture_output=True, text=True)
    if ran.returncode != 0:
        raise ReviewError("git hash-object %s failed: %s" % (path, ran.stderr.strip()))
    return ran.stdout.strip()


def round_paths(root, config, key, outside):
    paths = set()
    for defect in items_of(root, "defects", key):
        if defect["state"] == "open":
            paths.update(report_files(defect))
    paths.update(path for path, kind in changed_files(root, config, "HEAD", outside).items() if kind != "deleted")
    return sorted(path for path in paths if os.path.isfile(os.path.join(root, path)))


def cmd_snapshot(args, root, config):
    paths = args.paths or round_paths(root, config, args.key, outside_paths(root, args.sprint))
    snapshot = {
        path: {"hash": content_hash(root, path), "blob": stored_blob(root, path)} for path in paths
    }
    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    with open(args.out, "w") as handle:
        json.dump({"round": current_round(root), "files": snapshot}, handle, indent=1, sort_keys=True)
        handle.write("\n")
    print("snapshot: %d file(s)" % len(snapshot))


def unstamped(text):
    return "\n".join(line for line in text.split("\n") if not MATERIALIZED_STAMP.match(line))


def block_sources(root, config):
    blocks = {}
    heading = re.compile(r"^### \{\{([A-Z0-9-]+)\}\}\s*$")
    for source in config.get("block_sources", []):
        try:
            with open(os.path.join(root, source)) as handle:
                lines = unstamped(handle.read()).split("\n")
        except OSError as err:
            raise ReviewError("cannot read block source %s: %s" % (source, err)) from err
        index = 0
        while index < len(lines):
            found = heading.match(lines[index])
            if not found:
                index += 1
                continue
            end = index + 1
            while end < len(lines) and lines[end].strip() != "---" and not heading.match(lines[end]):
                end += 1
            body = lines[index + 1:end]
            fences = [n for n, line in enumerate(body) if line.startswith("```")]
            if len(fences) >= 2:
                body = body[fences[0] + 1:fences[-1]]
            blocks[found.group(1)] = "\n".join(body).strip("\n")
            index = end
    return blocks


def pasted(root, paths):
    parts = []
    for path in paths:
        full = os.path.join(root, path)
        if not os.path.exists(full):
            continue
        if os.path.isdir(full):
            names = sorted(os.path.join(path, name) for name in os.listdir(full) if name.endswith(".md"))
        else:
            names = [path]
        for name in names:
            with open(os.path.join(root, name)) as handle:
                parts.append("#### %s\n\n%s" % (name, unstamped(handle.read()).strip()))
    return "\n\n".join(parts) if parts else "none"


def cmd_prompt(args, root, config):
    template_path = os.path.join(root, config["prompts_dir"], args.name + ".md")
    try:
        with open(template_path) as handle:
            text = unstamped(handle.read())
    except OSError as err:
        raise ReviewError("cannot read prompt template %s: %s" % (template_path, err)) from err
    values = {
        "PROJECT": pasted(root, [os.path.join(ESTATE, "project.md")]),
        "STANDARDS": pasted(root, config.get("standards", [])),
        "ACCEPT": pasted(root, [ACCEPT_PATH]),
        "SHAPES": pasted(root, [os.path.join(CATALOG_DIR, family + ".md") for family in config["bug_families"]]),
    }
    blocks = block_sources(root, config)
    out = []
    for line in text.split("\n"):
        token = re.match(r"^\s*\{\{([A-Z0-9-]+)\}\}\s*$", line)
        slot = re.match(r"^\s*\[([A-Z]+)\]\s*$", line)
        if token:
            if token.group(1) not in blocks:
                raise ReviewError("prompt %s names block %s, which no block source defines" % (args.name, token.group(1)))
            out.append(blocks[token.group(1)])
        elif slot and slot.group(1) in values:
            out.append(values[slot.group(1)])
        else:
            out.append(
                line.replace("[SPRINT PATH]", args.sprint)
                .replace("[BASE]", args.base)
            )
    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    with open(args.out, "w") as handle:
        handle.write("\n".join(out))
    print(args.out)


def tasks_run(root, *args, stdin=None):
    ran = subprocess.run([os.path.join(root, TASKS)] + list(args), cwd=root, capture_output=True, text=True,
                         input=stdin)
    if ran.returncode != 0:
        raise ReviewError("tasks %s failed: %s" % (" ".join(args), (ran.stderr or ran.stdout).strip()))
    return ran.stdout


def hunt_settings(config):
    hunt = config.get("hunt")
    if not isinstance(hunt, dict):
        raise ReviewError("%s declares no 'hunt' settings" % CONFIG_PATH)
    for key in ("min", "max", "threshold", "slice", "rotation", "area_lines", "lenses"):
        if key not in hunt:
            raise ReviewError("%s 'hunt' declares no %r" % (CONFIG_PATH, key))
    assert hunt["min"] >= 2, "the hunt needs two hunts per area before it can estimate what is left"
    assert hunt["max"] >= hunt["min"], "the hunt's max must be at least its min"
    lensed = sorted(harm for harms in hunt["lenses"].values() for harm in harms)
    assert len(lensed) == len(set(lensed)), "each accept entry belongs to one lens: %s" % lensed
    return hunt


def line_count(root, path):
    with open(os.path.join(root, path), "rb") as handle:
        return handle.read().count(b"\n") + 1


def chunked(items, weigh, budget):
    chunk, weight = [], 0
    for item in items:
        heft = weigh(item)
        if chunk and weight + heft > budget:
            yield chunk
            chunk, weight = [], 0
        chunk.append(item)
        weight += heft
    if chunk:
        yield chunk


def file_areas(root, config, hunt):
    by_directory = {}
    for path in scoped_files(root, config):
        by_directory.setdefault(os.path.dirname(path) or ".", []).append(path)
    areas = []
    for directory in sorted(by_directory):
        paths = sorted(by_directory[directory])
        counts = {path: line_count(root, path) for path in paths}
        for index, chunk in enumerate(chunked(paths, counts.get, hunt["area_lines"]), 1):
            for lens in sorted(hunt["lenses"]):
                areas.append({
                    "name": "file:%s#%d@%s" % (directory, index, lens), "shape": "file",
                    "lens": lens, "harms": hunt["lenses"][lens],
                    "files": chunk, "lines": sum(counts[path] for path in chunk),
                })
    return areas


def declared_classes(root):
    path = os.path.join(root, SURFACE_INTENT_PATH)
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().split("\n")
    except (OSError, ValueError) as err:
        raise ReviewError("cannot read %s: %s" % (SURFACE_INTENT_PATH, err)) from err
    headings = [line.rstrip() for line in lines]
    if DECLARING_HEADING not in headings:
        return []
    start = headings.index(DECLARING_HEADING) + 1
    declared = []
    for number, line in enumerate(lines[start:], start + 1):
        if line.startswith("#"):
            break
        if not line.strip():
            continue
        found = DECLARING_LINE.match(line)
        if not found:
            print("areas: %s line %d under %r is not of the form - <class>: `<path or glob>`[, `<path or glob>`]; "
                  "skipped" % (SURFACE_INTENT_PATH, number, DECLARING_HEADING), file=sys.stderr)
            continue
        declared.append((found.group(1).strip(), DECLARED_PATH.findall(found.group(2))))
    return declared


def declaring_files(root, listed, cls, pattern):
    if GLOB_CHARACTERS.search(pattern):
        matched = [path for path in listed if fnmatch.fnmatch(path, pattern)]
    else:
        literal = os.path.normpath(pattern).replace(os.sep, "/")
        matched = [literal] if literal in listed else []
    if not matched:
        print("areas: %s declares the class %s in %s, which matches no file the tree holds; skipped"
              % (SURFACE_INTENT_PATH, cls, pattern), file=sys.stderr)
    return [path for path in matched if not left_alone(root, path)]


def flow_areas(root):
    declared = declared_classes(root)
    if declared is None:
        return None, []
    listed = [path for path in tree_files(root) if os.path.isfile(os.path.join(root, path))]
    areas, seen = [], set()
    for cls, patterns in declared:
        for pattern in patterns:
            for path in declaring_files(root, listed, cls, pattern):
                if (cls, path) in seen:
                    continue
                seen.add((cls, path))
                areas.append({
                    "name": "flow:%s@%s" % (re.sub(r"\s+", "-", cls), path), "shape": "flow",
                    "lens": "flow", "harms": [], "class": cls,
                    "files": [path], "lines": 0,
                })
    return SURFACE_INTENT_PATH, areas


def load_rotation(root, hunt):
    path = os.path.join(root, hunt["rotation"])
    if not os.path.isfile(path):
        return {}
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError) as err:
        raise ReviewError("cannot read %s: %s" % (hunt["rotation"], err)) from err


def area_keys(area):
    if area["shape"] == "file":
        return [("file:" + path, path) for path in area["files"]]
    return [(area["name"], area["files"][0])]


def area_priority(root, area, rotation):
    stamps = []
    for key, path in area_keys(area):
        record = rotation.get(key)
        if record is None:
            return (0, "")
        if record.get("hash") != content_hash(root, path):
            return (1, record.get("hunted", ""))
        stamps.append(record.get("hunted", ""))
    return (2, min(stamps) if stamps else "")


def cmd_areas(args, root, config):
    hunt = hunt_settings(config)
    files = file_areas(root, config, hunt)
    surface, flows = flow_areas(root)
    if not flows:
        print("areas: no surface intent at %s (or it names no declaring file); the run hunts files alone"
              % SURFACE_INTENT_PATH, file=sys.stderr)
    everything = files + flows
    if args.only:
        chosen = [area for area in everything if any(matches_any(path, args.only) for path in area["files"])]
    else:
        rotation = load_rotation(root, hunt)
        keyed = []
        for group in (files, flows):
            ordered = sorted(group, key=lambda area: (area_priority(root, area, rotation), area["name"]))
            keyed += [(area_priority(root, area, rotation)[0], place, area) for place, area in enumerate(ordered)]
        keyed.sort(key=lambda row: (row[0], row[1]))
        chosen = [area for _, _, area in keyed[:hunt["slice"]]]
    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    with open(args.out, "w") as handle:
        json.dump({"surface": surface, "areas": chosen, "of": len(everything)}, handle, indent=1)
        handle.write("\n")
    print("areas: %d of %d (%d file, %d flow) -> %s" % (
        len(chosen), len(everything), sum(1 for a in chosen if a["shape"] == "file"),
        sum(1 for a in chosen if a["shape"] == "flow"), args.out))


def cmd_rotate(args, root, config):
    hunt = hunt_settings(config)
    rotation = load_rotation(root, hunt)
    areas = load_areas(args.areas)
    commit = git_lines(root, "rev-parse", "--short", "HEAD")[0]
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for area in areas.values():
        for key, path in area_keys(area):
            rotation[key] = {"hunted": stamp, "commit": commit, "hash": content_hash(root, path)}
    path = os.path.join(root, hunt["rotation"])
    with open(path + ".tmp", "w") as handle:
        json.dump(rotation, handle, indent=1, sort_keys=True)
        handle.write("\n")
    os.replace(path + ".tmp", path)
    print("rotation: %d area(s) stamped %s at %s" % (len(areas), stamp, commit))


def items_of(root, pool, key):
    return json.loads(tasks_run(root, "item", "list", "--pool", pool, "--key", key, "--json"))


def seen_hunts(item):
    seen = item.get("fields", {}).get("seen") or []
    if isinstance(seen, str):
        seen = json.loads(seen)
    return {int(hunt) for hunt in seen}


def chapman_estimate(defects):
    first = sum(1 for seen in defects if 1 in seen)
    second = sum(1 for seen in defects if 2 in seen)
    both = sum(1 for seen in defects if 1 in seen and 2 in seen)
    return (first + 1) * (second + 1) / (both + 1) - 1


def cmd_tally(args, root, config):
    print(tally_report(root, config, args.key, args.areas))


def tally_report(root, config, key, only):
    hunt = hunt_settings(config)
    merges = items_of(root, "merges", key)
    defects = items_of(root, "defects", key)
    counted = {}
    for merge in merges:
        fields = merge.get("fields", {})
        counted.setdefault(fields["area"], {})[int(fields["hunt"])] = int(fields["new"])
    real = {}
    for defect in defects:
        if defect["state"] in DEFECT_NOT_REAL:
            continue
        real.setdefault(defect.get("fields", {}).get("area"), []).append(seen_hunts(defect))
    report = []
    for area in sorted(set(only or counted)):
        news = counted.get(area, {})
        hunts = max(news) if news else 0
        found = real.get(area, [])
        latest_new = news.get(hunts, 0) if hunts else None
        if hunts < hunt["min"]:
            decision = "hunt"
        elif hunts >= hunt["max"]:
            decision = "stop: cap"
        elif latest_new <= max(hunt["threshold"]["floor"], hunt["threshold"]["share"] * len(found)):
            decision = "stop: converged"
        else:
            decision = "hunt"
        estimate = chapman_estimate(found) if hunts >= 2 else None
        report.append({
            "area": area, "hunts": hunts, "latest_new": latest_new, "defects": len(found),
            "estimate": None if estimate is None else round(estimate, 1),
            "missed": None if estimate is None else round(max(0.0, estimate - len(found)), 1),
            "decision": decision,
        })
    return json.dumps(report, indent=1)


def cmd_fixes(args, root, config):
    size = config.get("fix", {}).get("group_size")
    assert isinstance(size, int) and size > 0, "%s must declare fix.group_size as a positive integer" % CONFIG_PATH
    defects = json.loads(tasks_run(root, "item", "list", "--pool", "defects", "--key", args.key, "--state", "open", "--json"))
    parent = {}

    def root_of(node):
        while parent.setdefault(node, node) != node:
            parent[node] = parent[parent[node]]
            node = parent[node]
        return node

    for defect in defects:
        files = defect.get("fields", {}).get("files") or []
        if isinstance(files, str):
            files = json.loads(files)
        defect["_files"] = sorted(files)
        root_of(defect["id"])
        for path in defect["_files"]:
            parent[root_of(defect["id"])] = root_of("path:" + path)
        same = defect.get("fields", {}).get("same_as")
        if same:
            parent[root_of(defect["id"])] = root_of(same)
    groups = {}
    for defect in defects:
        groups.setdefault(root_of(defect["id"]), []).append(defect)
    filed = []
    for members in groups.values():
        previous = None
        for chunk in chunked(members, lambda defect: 1, size):
            files = sorted({path for defect in chunk for path in defect["_files"]})
            command = [
                "batch", "--pool", "defects", "--key", args.key, "--items"] + [d["id"] for d in chunk] + [
                "--prompt", args.prompt, "--agent", args.agent, "--role", "fix", "--mark", "fixing",
                "--brief", "fix round %s; defects %s" % (args.round, " ".join(d["id"] for d in chunk)),
            ]
            if files:
                command += ["--files"] + files
            if previous:
                command += ["--after", previous]
            previous = tasks_run(root, *command).strip().split("\n")[-1].strip()
            filed.append({"task": previous, "defects": [d["id"] for d in chunk], "files": files})
    print(json.dumps(filed, indent=1))


def load_areas(path):
    try:
        with open(path) as handle:
            return {area["name"]: area for area in json.load(handle)["areas"]}
    except (OSError, ValueError, KeyError) as err:
        raise ReviewError("cannot read the areas file %s: %s" % (path, err)) from err


def hunts_run(root, key):
    run = {}
    for merge in items_of(root, "merges", key):
        fields = merge.get("fields", {})
        run.setdefault(fields["area"], set()).add(int(fields["hunt"]))
    return run


def cmd_hunts(args, root, config):
    hunt_settings(config)
    areas = load_areas(args.areas)
    done = hunts_run(root, args.key)
    if args.first:
        wanted = {name: [1, 2] for name in areas}
    else:
        tallied = json.loads(tally_report(root, config, args.key, sorted(areas)))
        wanted = {
            row["area"]: [row["hunts"] + 1] for row in tallied if row["decision"] == "hunt"
        }
    filed = []
    for name in sorted(wanted):
        area = areas[name]
        for number in wanted[name]:
            assert number not in done.get(name, set()), "hunt %d of %s already merged" % (number, name)
            if area["shape"] == "file":
                prompt = "hunt-file"
                brief = "area %s; lens %s: %s; hunt %d; files: %s" % (
                    name, area["lens"], " ".join(area["harms"]), number, " ".join(area["files"]))
            else:
                prompt = "hunt-flow"
                brief = "area %s; hunt %d; class %s; declared in %s" % (
                    name, number, area["class"], area["files"][0])
            task = tasks_run(
                root, "file", "--role", "hunt", "--prompt", prompt, "--agent", args.agent,
                "--key", args.key, "--brief", brief[:4000],
            ).strip().split("\n")[-1].strip()
            filed.append({"area": name, "hunt": number, "task": task})
    round_file = {}
    for row in filed:
        round_file.setdefault(row["area"], []).append(row["hunt"])
    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    with open(args.out, "w") as handle:
        json.dump(round_file, handle, indent=1, sort_keys=True)
        handle.write("\n")
    print("hunts: %d task(s) over %d area(s) -> %s" % (len(filed), len(round_file), args.out))


def report_files(report):
    files = report.get("fields", {}).get("files") or []
    if isinstance(files, str):
        files = json.loads(files)
    return files


MERGE_SOURCES = {
    "backlog": ("reports", lambda item: item.get("fields", {}).get("area") == "backlog"),
    "sprint": ("reports", lambda item: item.get("fields", {}).get("area") != "backlog"),
    "drive": ("failures", lambda item: True),
}


def merge_cap(config):
    cap = config["hunt"].get("merge_reports")
    assert isinstance(cap, int) and cap > 0, "%s must declare hunt.merge_reports as a positive integer" % CONFIG_PATH
    return cap


def file_source_merges(args, root, config):
    pool, wanted = MERGE_SOURCES[args.source]
    items = [item for item in items_of(root, pool, args.key) if item["state"] == "open" and wanted(item)]
    filed = []
    for chunk in chunked(items, lambda item: 1, merge_cap(config)):
        ids = [item["id"] for item in chunk]
        brief = "%s; %s %s" % (args.source, pool, " ".join(ids))
        task = tasks_run(
            root, "file", "--role", "merge", "--prompt", args.prompt, "--agent", args.agent,
            "--key", args.key, "--brief", brief,
        ).strip().split("\n")[-1].strip()
        filed.append({"task": task, pool: ids})
    print(json.dumps({"merge_tasks": filed}, indent=1))


def cmd_merges(args, root, config):
    if bool(args.round) == bool(args.source):
        raise ReviewError("merges takes one of --round (analysis) or --source (backlog, drive, sprint)")
    if args.source:
        return file_source_merges(args, root, config)
    cap = merge_cap(config)
    try:
        with open(args.round) as handle:
            hunted = json.load(handle)
    except (OSError, ValueError) as err:
        raise ReviewError("cannot read the round file %s: %s" % (args.round, err)) from err
    reports = [
        report for report in items_of(root, "reports", args.key)
        if report["state"] == "open" and report.get("fields", {}).get("area") in hunted
    ]
    parent = {}

    def root_of(node):
        while parent.setdefault(node, node) != node:
            parent[node] = parent[parent[node]]
            node = parent[node]
        return node

    by_area = {}
    for report in reports:
        area = report["fields"]["area"]
        by_area.setdefault(area, []).append(report)
        for path in report_files(report):
            parent[root_of("area:" + area)] = root_of("path:" + path)
    groups = {}
    for area in by_area:
        groups.setdefault(root_of("area:" + area), []).append(area)
    filed = []
    for members in groups.values():
        members.sort()
        for chunk in chunked(members, lambda area: len(by_area[area]), cap):
            brief = "; ".join(
                "area %s hunts %s reports %s" % (
                    area, ",".join(str(number) for number in sorted(hunted[area])),
                    " ".join(report["id"] for report in by_area[area]))
                for area in chunk)
            task = tasks_run(
                root, "file", "--role", "merge", "--prompt", args.prompt, "--agent", args.agent,
                "--key", args.key, "--brief", brief,
            ).strip().split("\n")[-1].strip()
            filed.append({"task": task, "areas": chunk, "reports": sum(len(by_area[area]) for area in chunk)})
    silent = 0
    for area in sorted(set(hunted) - set(by_area)):
        for number in sorted(hunted[area]):
            tasks_run(
                root, "item", "add", "--pool", "merges", "--key", args.key, "--state", "done",
                "--field", "area=" + area, "--field", "hunt=%d" % number, "--field", "new=0",
                "--field", "matched=0", "--field", "rejected=0", "--body", "no reports",
            )
            silent += 1
    print(json.dumps({"merge_tasks": filed, "zero_counts_written": silent}, indent=1))


BACKLOG_STATES = ("open", "verified")
SITE_PATTERN = re.compile(r"([\w./-]+\.\w+):([A-Za-z_][\w.]*)")
PATH_PATTERN = re.compile(r"[\w./-]+\.\w+")
PROJECT_ALONE_HEADING = "## Stories that drive alone"
PROJECT_INSTANCE_HEADING = "## Stories that drive on an instance of their own"
INSTANCE_ONE_AT_A_TIME_PATTERN = re.compile(r"^- One at a time\b", re.M)
INSTANCE_FOLDER_PREFIX = "drive-"
DRIVE_NAME_RUN_DIGEST_CHARS = 8
DRIVE_NAME_PATTERN = re.compile(r"[a-z0-9-]+")
DRIVE_COMMANDS_HEADING = "## Drive commands"
NO_STACK_PATTERN = re.compile(r"^- No stack:", re.M)
STACK_ROLES = ("stack-start", "stack-stop")
DRIVE_ROLES = (
    "stack-start", "stack-stop", "instance-create", "instance-destroy",
    "resource-start", "resource-stop", "service-log", "sign-in",
)
DRIVE_PLACEHOLDER_VALUES = {
    "name": DRIVE_NAME_PATTERN,
    "folder": re.compile(r"[A-Za-z0-9_./-]+"),
    "service": re.compile(r"[A-Za-z0-9_.-]+"),
}
RETIRED_TAG_PLACEHOLDER = "{tag}"
CONFIRM_EVIDENCE_CHARS = 300


def current_round(root):
    return json.loads(tasks_run(root, "status", "--json"))["run"].get("round")


def dumped_tasks(root):
    return [json.loads(line) for line in tasks_run(root, "dump", "--type", "task").splitlines() if line.strip()]


def filed_task(root, *args):
    return tasks_run(root, "file", *args).strip().split("\n")[-1].strip()


def add_reports(root, key, reports):
    if not reports:
        return []
    lines = "".join(json.dumps({"body": body, "fields": fields}) + "\n" for body, fields in reports)
    ids = tasks_run(root, "item", "add", "--pool", "reports", "--key", key, "--from", "-", stdin=lines).split()
    assert len(ids) == len(reports), "tasks item add --from printed %d ids for %d reports" % (len(ids), len(reports))
    return ids


def backlog_entry(root, config, rec):
    problem = rec["problem"]
    files, alone = [], {}
    for token in PATH_PATTERN.findall(problem):
        if token in files or token in alone or not os.path.isfile(os.path.join(root, token)):
            continue
        owner = left_alone(root, token)
        if owner:
            alone[token] = owner
        elif not matches_any(token, config["exclude"]):
            files.append(token)
    if not files:
        return None, {"issue": rec["id"], "files": [], "left_alone": alone}
    site = SITE_PATTERN.search(problem)
    return {"issue": rec["id"], "site": site.group(0) if site else files[0], "files": files, "body": problem}, None


def cmd_backlog(args, root, config):
    reports, settled = [], []
    for rec in issues.select(root, category="defect"):
        if rec["state"] not in BACKLOG_STATES or rec.get("sprint"):
            continue
        report, left = backlog_entry(root, config, rec)
        if report:
            reports.append(report)
        else:
            settled.append(left)
    items = add_reports(root, args.key, [
        (report["body"], {"area": "backlog", "hunt": 1, "issue": report["issue"], "site": report["site"],
                          "files": report["files"]})
        for report in reports])
    added = [{"item": item, "issue": report["issue"], "files": report["files"]}
             for item, report in zip(items, reports, strict=True)]
    print(json.dumps({"reports": added, "settled": settled}, indent=1))


def project_section(root, heading):
    with open(os.path.join(root, ESTATE, "project.md")) as handle:
        text = handle.read()
    found = re.search("^" + re.escape(heading) + r"[ \t]*$", text, re.M)
    if not found:
        return None
    section = text[found.end():]
    following = re.search(r"^## ", section, re.M)
    if following:
        section = section[:following.start()]
    return section


def listed_stories(root, heading):
    section = project_section(root, heading)
    if section is None:
        return []
    return re.findall(r"^- `([a-z0-9-]+)`", section, re.M)


def drive_commands(root):
    project = os.path.join(ESTATE, "project.md")
    heading = DRIVE_COMMANDS_HEADING
    section = project_section(root, heading)
    if section is None:
        raise ReviewError(f"{project} has no {heading!r} section")
    lines = {}
    for role, value in re.findall(r"^- `([a-z-]+)`: (.+?)[ \t]*$", section, re.M):
        if role in lines:
            raise ReviewError(f"{project} gives the role {role} twice under {heading!r}")
        lines[role] = value
    return lines


def drive_stack(root):
    project = os.path.join(ESTATE, "project.md")
    heading = DRIVE_COMMANDS_HEADING
    lines = drive_commands(root)
    declared = NO_STACK_PATTERN.search(project_section(root, heading)) is not None
    named = [role for role in STACK_ROLES if role in lines]
    if declared and named:
        raise ReviewError(
            f"{project} declares no stack under {heading!r} and also gives the role " + ", ".join(named)
        )
    if declared:
        return "none", None
    if "stack-start" in lines:
        return "stack", None
    return "unfilled", (
        f"{project} gives no stack-start line and no '- No stack:' line under {heading!r}; write the lines "
        "- `stack-start`: `<the command that starts the stack>` and - `stack-stop`: `<the command that stops it>`, "
        "or, for a product with no stack, the line - No stack: <why>"
    )


def cmd_drive_stack(args, root, config):
    word, reason = drive_stack(root)
    print(word)
    if word == "unfilled":
        print(reason)


def cmd_drive_command(args, root, config):
    project = os.path.join(ESTATE, "project.md")
    role = args.role
    lines = drive_commands(root)
    if role in STACK_ROLES and drive_stack(root)[0] == "none":
        raise ReviewError(
            f"{project} declares no stack under {DRIVE_COMMANDS_HEADING!r}; file no {role} task"
        )
    if role not in lines:
        raise ReviewError(
            f"{project} gives no line for the role {role} under {DRIVE_COMMANDS_HEADING!r}"
        )
    found = re.fullmatch(r"`([^`]+)`", lines[role])
    if not found:
        raise ReviewError(
            f"{project} gives steps, not one command, for the role {role}: {lines[role]}"
        )
    command = found.group(1)
    if RETIRED_TAG_PLACEHOLDER in command:
        raise ReviewError(
            f"the {role} command under {DRIVE_COMMANDS_HEADING!r} in {project} names {RETIRED_TAG_PLACEHOLDER}, "
            "which the drive no longer fills; run /ok, which rewrites the line or asks you to reword it"
        )
    given = {"name": args.name, "folder": args.folder, "service": args.service}
    used = set(re.findall(r"\{(" + "|".join(DRIVE_PLACEHOLDER_VALUES) + r")\}", command))
    for placeholder, value in given.items():
        if placeholder in used and value is None:
            raise ReviewError(
                f"the {role} command names {{{placeholder}}}; pass --{placeholder}"
            )
        if placeholder not in used and value is not None:
            raise ReviewError(
                f"the {role} command names no {{{placeholder}}}; drop --{placeholder}"
            )
        alphabet = DRIVE_PLACEHOLDER_VALUES[placeholder]
        if value is not None and not alphabet.fullmatch(value):
            raise ReviewError(
                f"--{placeholder} {value!r} does not match {alphabet.pattern}"
            )
    for placeholder in sorted(used):
        command = command.replace("{" + placeholder + "}", given[placeholder])
    print(command)


def story_lists(root):
    headings = (PROJECT_ALONE_HEADING, PROJECT_INSTANCE_HEADING)
    lists = [listed_stories(root, heading) for heading in headings]
    named = [story for stories in lists for story in stories]
    doubled = sorted({story for story in named if named.count(story) > 1})
    if doubled:
        raise ReviewError(
            os.path.join(ESTATE, "project.md") + " names " + ", ".join(doubled)
            + " under more than one of the headings " + "; ".join(headings)
        )
    instance_section = project_section(root, PROJECT_INSTANCE_HEADING)
    one_at_a_time = instance_section is not None and INSTANCE_ONE_AT_A_TIME_PATTERN.search(instance_section) is not None
    return lists[0], lists[1], one_at_a_time


def ordinal_suffixes(briefs):
    stories = [story for story, _ in briefs]
    return [
        "-" + str(stories[:place + 1].count(story)) if stories.count(story) > 1 else ""
        for place, story in enumerate(stories)
    ]


def instance_folders(run, briefs, instance):
    stem = INSTANCE_FOLDER_PREFIX + run["name"] + "-" + (run.get("round") or "unrounded") + "-"
    return [
        os.path.join(tempfile.gettempdir(), stem + story + suffix) if story in instance else None
        for (story, _), suffix in zip(briefs, ordinal_suffixes(briefs), strict=True)
    ]


def drive_names(run, briefs):
    stamp = run["name"] + "\0" + (run.get("round") or "unrounded")
    digest = hashlib.sha256(stamp.encode()).hexdigest()[:DRIVE_NAME_RUN_DIGEST_CHARS]
    names = [
        story + "-" + digest + suffix
        for (story, _), suffix in zip(briefs, ordinal_suffixes(briefs), strict=True)
    ]
    for name in names:
        if not DRIVE_NAME_PATTERN.fullmatch(name):
            raise ReviewError(
                f"the drive name {name!r} holds a character outside {DRIVE_NAME_PATTERN.pattern};"
                " rename its story"
            )
    return names


def confirm_briefs(root, key):
    this_round = current_round(root)
    verified_here = set()
    for task in dumped_tasks(root):
        if task.get("role") == "verify" and task.get("round") == this_round:
            found = re.search(r"defects ([^;]+)", task.get("brief") or "")
            verified_here.update(found.group(1).split() if found else [])
    briefs = []
    for defect in items_of(root, "defects", key):
        fields = defect.get("fields", {})
        if defect["id"] not in verified_here or defect["state"] != "verified" or fields.get("source") != "drive":
            continue
        seen = " ".join((defect.get("body") or "").split())[:CONFIRM_EVIDENCE_CHARS]
        briefs.append((fields["story"], "confirm: defect %s; story %s; surface %s; variant %s; kickbacks %s; earlier driver saw: %s" % (
            defect["id"], fields["story"], fields.get("surface"), fields.get("variant"), fields.get("kickbacks", 0), seen)))
    return briefs


def cmd_drives(args, root, config):
    alone, instance, one_at_a_time = story_lists(root)
    if args.confirm:
        briefs = confirm_briefs(root, args.key)
    else:
        briefs = [(story, "story " + story) for story in story_slugs(root)]
    run = json.loads(tasks_run(root, "status", "--json"))["run"]
    folders = instance_folders(run, briefs, instance)
    names = drive_names(run, briefs)
    drives = []
    for (story, brief), folder, name in zip(briefs, folders, names, strict=True):
        brief += "; drive name " + name
        if folder is not None:
            brief += "; instance folder " + folder
        drives.append({"story": story, "name": name, "brief": brief, "instance": folder})
    filed = []

    def file_drive(drive, after):
        command = [
            "--role", "drive", "--prompt", "drive", "--agent", args.agent,
            "--key", args.key, "--brief", drive["brief"],
        ]
        if after:
            command += ["--after"] + after
        row = {"task": filed_task(root, *command), "story": drive["story"], "name": drive["name"]}
        if after:
            row["after"] = after
        if drive["instance"]:
            row["instance"] = drive["instance"]
        filed.append(row)
        return row["task"]

    held_back = set(alone) | (set(instance) if one_at_a_time else set())
    for drive in drives:
        if drive["story"] not in held_back:
            file_drive(drive, [])
    for story in alone + (instance if one_at_a_time else []):
        for drive in drives:
            if drive["story"] == story:
                file_drive(drive, [row["task"] for row in filed])
    print(json.dumps({"drive_tasks": filed}, indent=1))


def load_snapshot(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError) as err:
        raise ReviewError("cannot read the snapshot %s: %s" % (path, err)) from err


def before_blob(root, snapshot, path):
    held = snapshot["files"].get(path)
    if held:
        return held["blob"]
    ran = subprocess.run(["git", "rev-parse", "--verify", "--quiet", "HEAD:./" + path], cwd=root, capture_output=True, text=True)
    return ran.stdout.strip() if ran.returncode == 0 else "new"


def before_list(root, snapshot, paths):
    return "; ".join("%s %s" % (path, before_blob(root, snapshot, path)) for path in paths)


VERIFIED_STATES = ("fixed",) + DEFECT_NOT_REAL


def refile_chains(tasks, this_round):
    fixes = {task["id"]: task for task in tasks if task.get("role") == "fix" and task.get("round") == this_round}
    named = {task.get("previous") for task in fixes.values()}
    chains = []
    for tip in fixes.values():
        if tip["id"] in named:
            continue
        chain = [tip]
        while chain[-1].get("previous") in fixes:
            chain.append(fixes[chain[-1]["previous"]])
        chains.append(chain[::-1])
    return chains


def first_seen(values):
    return list(dict.fromkeys(values))


def cmd_verifies(args, root, config):
    snapshot = load_snapshot(args.snapshot)
    states = {defect["id"]: defect["state"] for defect in items_of(root, "defects", args.key)}
    filed = []
    for chain in refile_chains(dumped_tasks(root), snapshot.get("round")):
        if chain[-1].get("state") != "closed":
            continue
        batch = first_seen(item for task in chain for item in task.get("batch_items") or [])
        named = [item for item in batch if states.get(item) in VERIFIED_STATES]
        if not named:
            continue
        staged = first_seen(path for task in chain for path in task.get("staged") or [])
        ids = [task["id"] for task in chain]
        brief = "fix tasks %s; defects %s; before: %s" % (" ".join(ids), " ".join(named), before_list(root, snapshot, staged))
        verify = filed_task(root, "--role", "verify", "--prompt", "verify", "--agent", args.agent, "--key", args.key, "--brief", brief)
        filed.append({"task": verify, "fix_task": ids[-1], "fix_tasks": ids, "defects": named})
    print(json.dumps({"verify_tasks": filed}, indent=1))


def cmd_backouts(args, root, config):
    snapshots = {}
    for name in sorted(os.listdir(args.folder)):
        if name.startswith("fix-") and name.endswith(".json"):
            held = load_snapshot(os.path.join(args.folder, name))
            snapshots[held.get("round")] = held
    tasks = dumped_tasks(root)
    backed = set()
    for task in tasks:
        found = re.match(r"defect (\S+);", task.get("brief") or "")
        if task.get("role") == "backout" and found:
            backed.add(found.group(1))
    filed = []
    for defect in items_of(root, "defects", args.key):
        if defect["state"] != "stuck" or defect["id"] in backed:
            continue
        fixes = [
            task for task in tasks
            if task.get("role") == "fix" and defect["id"] in (task.get("batch_items") or []) and task.get("staged")
        ]
        if not fixes:
            continue
        first = snapshots.get(fixes[0].get("round"))
        if first is None:
            raise ReviewError("no snapshot in %s for %s, the round that first fixed %s" % (args.folder, fixes[0].get("round"), defect["id"]))
        paths = sorted({path for task in fixes for path in task["staged"]})
        brief = "defect %s; fix tasks %s; before: %s" % (defect["id"], " ".join(task["id"] for task in fixes), before_list(root, first, paths))
        task = filed_task(root, "--role", "backout", "--prompt", "backout", "--agent", args.agent, "--key", args.key, "--files", *paths, "--brief", brief)
        filed.append({"task": task, "defect": defect["id"], "files": paths})
    print(json.dumps({"backout_tasks": filed}, indent=1))


def cmd_noticed(args, root, config):
    ran = subprocess.run(
        [os.path.join(root, TASKS), "--file", args.build_run, "item", "list", "--pool", "divergences", "--state", "noticed", "--json"],
        cwd=root, capture_output=True, text=True,
    )
    if ran.returncode != 0:
        raise ReviewError("cannot list the noticed items of %s: %s" % (args.build_run, (ran.stderr or ran.stdout).strip()))
    worked = []
    for noticed in json.loads(ran.stdout):
        files = report_files(noticed) or [noticed.get("fields", {}).get("file")]
        files = [path for path in files if path]
        if not files:
            raise ReviewError("noticed item %s of %s names no file; no report was added" % (noticed["id"], args.build_run))
        worked.append((noticed, files))
    items = add_reports(root, args.key, [
        (noticed.get("body") or "", {"area": "sprint-noticed", "hunt": 1, "site": files[0], "files": files})
        for noticed, files in worked])
    added = [{"item": item, "noticed": noticed["id"], "files": files}
             for item, (noticed, files) in zip(items, worked, strict=True)]
    print(json.dumps({"reports": added}, indent=1))


def story_slugs(root):
    folder = os.path.join(root, STORIES_DIR)
    try:
        return sorted(name[:-3] for name in os.listdir(folder) if name.endswith(".md"))
    except OSError as err:
        raise ReviewError("cannot list %s: %s" % (STORIES_DIR, err)) from err


def cmd_stories(args, root, config):
    for name in story_slugs(root):
        print(name)


def cmd_held(args, root, config):
    status = json.loads(tasks_run(root, "status", "--json"))
    wanted = set(args.paths)
    holders = {}
    for task in status["open_tasks"]:
        if task["id"] == args.task or task.get("kind") == "exec":
            continue
        for path in task.get("files") or []:
            if path in wanted:
                holders.setdefault(path, []).append("%s(%s)" % (task["id"], task["state"]))
    print(json.dumps(holders, indent=1, sort_keys=True))
    return 2 if holders else 0


def resolved_sprint(root, sprint):
    if os.path.isfile(os.path.join(root, sprint)):
        return sprint
    archived = os.path.join(ARCHIVED_SPRINTS, os.path.basename(sprint))
    if os.path.isfile(os.path.join(root, archived)):
        return archived
    raise ReviewError("no sprint at %s or %s" % (sprint, archived))


def closed_stamp(text):
    lines = text.split("\n")
    if not lines or lines[0] != "---" or "---" not in lines[1:]:
        return None
    for line in lines[1:lines.index("---", 1)]:
        found = re.match(r"^closed:\s*(\S+)\s*$", line)
        if found:
            return found.group(1)
    return None


def section_lines(lines, heading):
    if heading not in lines:
        return None
    level = heading.split(" ")[0] + " "
    body = []
    fence = None
    for line in lines[lines.index(heading) + 1:]:
        opened = re.match(r"^(`{3,})", line)
        if fence is None and opened:
            fence = opened.group(1)
        elif fence is not None and line.rstrip() == fence:
            fence = None
        elif fence is None and line.startswith(level):
            break
        body.append(line)
    return body


def delta_target(kind, slug):
    if kind == "surface":
        return SURFACE_INTENT_PATH
    if kind == "docspec":
        return os.path.join(".ok-planner", "docspec", slug + ".md")
    if kind in ("subject", "practice"):
        return os.path.join(".ok-planner", DELTA_FOLDERS[kind], slug + ".md")
    return os.path.join(".ok-planner", "design", DELTA_FOLDERS[kind], slug + ".md")


def sidecar_path(sprint, kind, slug):
    sidecar = re.sub(r"\.md$", "", sprint) + "-deltas"
    if kind == "surface":
        return os.path.join(sidecar, "surface", "surface.md")
    return os.path.join(sidecar, DELTA_FOLDERS[kind], slug + ".md")


def sprint_deltas(lines):
    section = section_lines(lines, DELTAS_HEADING) or []
    deltas = []
    for n, line in enumerate(section):
        found = DELTA_HEADING.match(line)
        if not found:
            continue
        operation, kind, slug = found.group(1), found.group(2) or "surface", found.group(3)
        rest = section[n + 1:]
        until = next((m for m, later in enumerate(rest) if DELTA_HEADING.match(later)), len(rest))
        deltas.append((operation, kind, slug, inline_body(rest[:until])))
    return deltas


def inline_body(lines):
    for n, line in enumerate(lines):
        opened = re.match(r"^(`{3,})markdown\s*$", line)
        if opened:
            rest = lines[n + 1:]
            end = next((m for m, later in enumerate(rest) if later.rstrip() == opened.group(1)), len(rest))
            return "\n".join(rest[:end])
    return None


def read_text(root, path):
    try:
        with open(os.path.join(root, path), encoding="utf-8") as handle:
            return handle.read()
    except FileNotFoundError:
        return None


def delta_failures(root, sprint, lines):
    deltas = sprint_deltas(lines)
    failures = []
    for operation, kind, slug, body in deltas:
        target = delta_target(kind, slug)
        name = "%s %s%s" % (operation, kind, ": " + slug if slug else "")
        landed = read_text(root, target)
        if operation == "Retire":
            if landed is not None:
                failures.append("%s: %s still exists" % (name, target))
            continue
        if body is None:
            body = read_text(root, sidecar_path(sprint, kind, slug))
            if body is None:
                failures.append("%s: no inline body and no sidecar file at %s" % (name, sidecar_path(sprint, kind, slug)))
                continue
        if landed is None:
            failures.append("%s: %s does not exist" % (name, target))
        elif landed.rstrip("\n") != body.rstrip("\n"):
            failures.append("%s: %s differs from the delta's body" % (name, target))
    toc = subprocess.run([sys.executable, os.path.join(root, CATALOG_TOC), "--check", root],
                         cwd=root, capture_output=True, text=True)
    if toc.returncode != 0:
        failures.append("catalog-toc --check exited %d: %s" % (toc.returncode, (toc.stdout + toc.stderr).strip()))
    return len(deltas), failures


def ledger_path(section):
    found = LEDGER_PATH.search("\n".join(section))
    return found.group(0) if found else None


def certification_failures(root, sprint):
    report = re.sub(r"\.md$", "", sprint) + "-completion.md"
    text = read_text(root, report)
    if text is None:
        return None, [], ["no completion report at %s" % report]
    section = section_lines(text.split("\n"), CERTIFICATION_HEADING)
    if not section or not "".join(section).strip():
        return None, [], ["%s carries no %r return block" % (report, CERTIFICATION_HEADING)]
    ledger = ledger_path(section)
    if not ledger or not os.path.isfile(os.path.join(root, ledger)):
        return None, [], ["the return block in %s names no ledger that exists" % report]
    tasks = [json.loads(line) for line in tasks_run(root, "--file", ledger, "dump", "--type", "task").splitlines()
             if line.strip()]
    failures = []
    if not any(t.get("role") == "review" and t.get("outcome") == "done" for t in tasks):
        failures.append("%s holds no review task closed done, so the find loop did not run" % ledger)
    defects = json.loads(tasks_run(root, "--file", ledger, "item", "list", "--pool", "defects", "--key", "gate", "--json"))
    for defect in defects:
        if defect["state"] not in SETTLED_DEFECT_STATES:
            failures.append("defect %s stands %s in %s" % (defect["id"], defect["state"], ledger))
        elif defect["state"] == "stuck" and not re.search(r"\b%s\b" % re.escape(defect["id"]), "\n".join(section)):
            failures.append("stuck defect %s is not listed in the return block in %s" % (defect["id"], report))
    stuck = [d for d in defects if d["state"] == "stuck"]
    return ledger, stuck, failures


def stuck_files(stuck):
    files = set()
    for defect in stuck:
        fields = defect.get("fields") or {}
        files.update(fields.get("files") or [])
        if fields.get("site"):
            files.add(fields["site"].split(":")[0])
    return files


def failing(root, command):
    return subprocess.run(command, shell=True, cwd=root, capture_output=True, text=True).returncode != 0


def check_failures(root, config, sprint, stuck):
    checks = config.get("checks")
    if not isinstance(checks, list) or not all(isinstance(check, str) and check.strip() for check in checks):
        return 0, 0, ["%s declares no 'checks' list of commands" % CONFIG_PATH]
    changed = changed_files(root, config, sprint_base(root, sprint), outside_paths(root, sprint))
    paths = [path for path, kind in changed.items() if kind != "deleted"]
    allowed = stuck_files(stuck)
    failures = []
    for check in checks if paths else []:
        if not failing(root, check + " " + " ".join(shlex.quote(path) for path in paths)):
            continue
        for path in paths:
            if path not in allowed and failing(root, check + " " + shlex.quote(path)):
                failures.append("%s fails on %s, which no stuck defect lists" % (check, path))
    return len(checks), len(paths), failures


def cmd_certified(args, root, config):
    sprint = resolved_sprint(root, args.sprint)
    text = read_text(root, sprint)
    stamp = closed_stamp(text)
    if sprint.startswith(ARCHIVED_SPRINTS + os.sep) and stamp:
        print("item 1-3: the sprint is archived with closed: %s, which is terminal" % stamp)
        return certified_verdict(sprint, [])
    count, deltas = delta_failures(root, sprint, text.split("\n"))
    ledger, stuck, certification = certification_failures(root, sprint)
    checks, files, checked = check_failures(root, config, sprint, stuck)
    print("item 1 (deltas): %s" % ("holds: %d deltas landed, catalog TOCs current" % count if not deltas else "fails"))
    print("item 2 (checks): %s" % ("holds: %d checks over %d changed files pass, or fail only where a stuck defect lists the file"
                                   % (checks, files) if not checked else "fails"))
    print("item 3 (certification): %s" % ("holds: the return block names %s, the find loop ran, every defect is settled, and %d stuck defects are listed"
                                          % (ledger, len(stuck)) if not certification else "fails"))
    return certified_verdict(sprint, deltas + checked + certification)


def certified_verdict(sprint, failures):
    if failures:
        print("SPRINT NOT COMPLETE: %s" % sprint)
        for failure in failures:
            print("- %s" % failure)
        print("The completion contract does not hold yet. Keep working toward the goal for this sprint file.")
        return 2
    print("SPRINT COMPLETE: %s" % sprint)
    print("The completion contract holds. This meets the goal for this sprint file.")
    print("Archiving, committing, and the closed: stamp are the owner's acts, not goal terms.")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="review", description="the review loop's mechanical steps")
    parser.add_argument("--version", action="version", version="review (ok-planner) " + VERSION)
    verbs = parser.add_subparsers(dest="verb", required=True)

    def add_verb(name):
        return verbs.add_parser(name, help=VERB_HELP[name], description=VERB_HELP[name])

    add_verb("files").set_defaults(run=cmd_files)

    owner = add_verb("owner")
    owner.add_argument("--base", help="the commit whose blob classifies a path the working tree no longer holds")
    owner.add_argument("paths", nargs="+", help="paths relative to the project root")
    owner.set_defaults(run=cmd_owner)

    changed = add_verb("changed")
    changed.add_argument("--base", help="the commit to diff from (default: the sprint's recorded base with --sprint, else HEAD)")
    changed.add_argument("--sprint", help="a sprint document: adds its paths outside the project root, and supplies its recorded base when --base is absent")
    changed.set_defaults(run=cmd_changed)

    checks = add_verb("checks")
    checks.add_argument("--base", help="the commit to diff from (default: the sprint's recorded base)")
    checks.add_argument("--key", default="gate")
    checks.add_argument("--sprint", help="a sprint document: adds its paths outside the project root, and supplies its recorded base when --base is absent")
    checks.set_defaults(run=cmd_checks)

    snapshot = add_verb("snapshot")
    snapshot.add_argument("--out", required=True)
    snapshot.add_argument("--paths", nargs="+")
    snapshot.add_argument("--key", default="gate")
    snapshot.add_argument("--sprint")
    snapshot.set_defaults(run=cmd_snapshot)

    prompt = add_verb("prompt")
    prompt.add_argument("--name", required=True)
    prompt.add_argument("--out", required=True)
    prompt.add_argument("--sprint", default="none")
    prompt.add_argument("--base", default="none")
    prompt.set_defaults(run=cmd_prompt)

    held = add_verb("held")
    held.add_argument("--task", required=True)
    held.add_argument("paths", nargs="+")
    held.set_defaults(run=cmd_held)

    areas = add_verb("areas")
    areas.add_argument("--out", required=True)
    areas.add_argument("--only", nargs="+")
    areas.set_defaults(run=cmd_areas)

    rotate = add_verb("rotate")
    rotate.add_argument("--areas", required=True)
    rotate.set_defaults(run=cmd_rotate)

    tally = add_verb("tally")
    tally.add_argument("--key", default="gate")
    tally.add_argument("--areas", nargs="+")
    tally.set_defaults(run=cmd_tally)

    add_verb("stories").set_defaults(run=cmd_stories)

    hunts = add_verb("hunts")
    hunts.add_argument("--key", default="gate")
    hunts.add_argument("--agent", default="ok-opus")
    hunts.add_argument("--areas", required=True)
    hunts.add_argument("--first", action="store_true")
    hunts.add_argument("--out", required=True)
    hunts.set_defaults(run=cmd_hunts)

    merges = add_verb("merges")
    merges.add_argument("--key", default="gate")
    merges.add_argument("--prompt", default="merge")
    merges.add_argument("--agent", default="ok-opus")
    merges.add_argument("--round")
    merges.add_argument("--source", choices=sorted(MERGE_SOURCES))
    merges.set_defaults(run=cmd_merges)

    noticed = add_verb("noticed")
    noticed.add_argument("--key", default="gate")
    noticed.add_argument("--build-run", required=True)
    noticed.set_defaults(run=cmd_noticed)

    backlog = add_verb("backlog")
    backlog.add_argument("--key", default="gate")
    backlog.set_defaults(run=cmd_backlog)

    drives = add_verb("drives")
    drives.add_argument("--key", default="gate")
    drives.add_argument("--agent", default="ok-opus")
    drives.add_argument("--confirm", action="store_true")
    drives.set_defaults(run=cmd_drives)

    drive_command = add_verb("drive-command")
    drive_command.add_argument("--role", required=True, choices=DRIVE_ROLES)
    drive_command.add_argument("--name")
    drive_command.add_argument("--folder")
    drive_command.add_argument("--service")
    drive_command.set_defaults(run=cmd_drive_command)

    add_verb("drive-stack").set_defaults(run=cmd_drive_stack)

    verifies = add_verb("verifies")
    verifies.add_argument("--key", default="gate")
    verifies.add_argument("--agent", default="ok-opus")
    verifies.add_argument("--snapshot", required=True)
    verifies.set_defaults(run=cmd_verifies)

    backouts = add_verb("backouts")
    backouts.add_argument("--key", default="gate")
    backouts.add_argument("--agent", default="ok-opus")
    backouts.add_argument("--folder", required=True)
    backouts.set_defaults(run=cmd_backouts)

    fixes = add_verb("fixes")
    fixes.add_argument("--key", default="gate")
    fixes.add_argument("--prompt", default="fix")
    fixes.add_argument("--agent", default="ok-opus")
    fixes.add_argument("--round", required=True)
    fixes.set_defaults(run=cmd_fixes)

    certified = add_verb("certified")
    certified.add_argument("--sprint", required=True, help="the sprint document, at its sprints/ path or archived")
    certified.set_defaults(run=cmd_certified)

    return parser


def run_under_project_python(root, config):
    wanted = config.get("python")
    if not wanted or os.environ.get(REEXEC_MARK):
        return
    if sys.version_info >= tuple(wanted["minimum"]):
        return
    os.environ[REEXEC_MARK] = "1"
    os.chdir(root)
    os.execvp(wanted["command"][0], wanted["command"] + [os.path.abspath(sys.argv[0])] + sys.argv[1:])


def main():
    args = build_parser().parse_args()
    try:
        root = project_root()
        config = load_config(root)
        run_under_project_python(root, config)
        return args.run(args, root, config) or 0
    except (ReviewError, issues.Refusal) as err:
        print("review: %s" % err, file=sys.stderr)
        return 1
    except Exception as err:
        issues.tasks.event("REVIEW.RUN.FAILED", type=type(err).__name__, message=str(err))
        return 1


if __name__ == "__main__":
    sys.exit(main())
