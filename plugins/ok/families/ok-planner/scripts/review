        ".ok-planner/review/runs/", ".ok-planner/tasks/", ".ok-planner/.cache/", ".ok-planner/review/rotation.json",
        ".ok-planner/issues.jsonl", ".ok-plumbline/audits/", ".ok-plumbline/budget.json", ".plumbline-budget.json",
    )),
    ("suite", (
        ".ok-planner/review/catalog/", ".ok-planner/package.json", ".claude/rules/ok-concepts.md",
        ".ok-planner/dashboard/",
    )),
)
HARNESS_SETTINGS = re.compile(r"^\.claude/settings[^/]*\.json$")


VERB_HELP = {
    "files": "list the code files in the run's population",
    "owner": "print who owns each path: project, suite, corpus, declaration, or record",
    "changed": "list the files added, changed, or deleted since a base commit",
    "checks": "file one exec task per configured check over the files changed since a base commit",
    "snapshot": "save the blob of every file a fix round may touch",
    "prompt": "assemble one of the loop's prompts into a file",
