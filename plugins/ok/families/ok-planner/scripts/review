REEXEC_MARK = "OK_PLANNER_REVIEW_REEXEC"
MATERIALIZED_STAMP = re.compile(r"^<!-- Materialized by ok[a-z-]* v\S+ .*-->\s*$")
SUITE_STAMP = re.compile(r"Materialized by ok-[a-z-]* v\d")
SUITE_STAMP_HEAD_LINES = 5
SUITE_LICENSE_HEAD = "materialized by the ok-* suite"
OWNER_PATHS = (
