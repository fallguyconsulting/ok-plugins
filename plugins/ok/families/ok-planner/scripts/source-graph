#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
#
# source-graph — the deterministic extractor and checker for an
# ok-planner source graph (.ok-planner/graph/): a committed,
# mechanically derived map of the project's sources. One graph file
# per source file, mirroring the tree; one node per file and per
# declared unit within it (a function, a class, a method, a
# heading-bounded section of prose), each carrying a structural
# identity derived from declared names and a content hash over its
# exact span bytes; edges record syntactic reference. Containment is
# encoded in identity itself (`path#a.b` lies inside `path#a` inside
# `path`), so no containment edges are stored. The graph carries no
# judgment and nothing hand-written; audits and adjudications point
# into it from their own records. Canonical rules:
# .ok-planner/design/concepts/source-graph.md in consumer projects.
#
#   source-graph build [<project-root>]
#   source-graph check [<project-root>]
#
# `build` regenerates the committed graph wholesale — identical trees
# yield byte-identical graphs, so regenerating is always safe.
# `check` regenerates in memory and reports drift between the
# committed graph and the tree: exit 0 clean, exit 2 findings (one
# per line, `path: [check] message`), exit 1 internal error.
#
# Graph file format (one per source file, at
# .ok-planner/graph/<relpath>.graph):
#
#   # source-graph v1 — mechanically generated; do not hand-edit.
#   file <relpath> sha256:<12>[ masked:<12>]
#   node <relpath>#<chain> sha256:<12>[ masked:<12>]
#   ref <identity> :: <target relpath>
#
# Hashes cover exact span bytes. The `masked:` field appears only
# when masking release-mutable metadata (the same stamp mask
# audit-check applies) changes the content: citations pin the masked
# hash where present, so a release that changes only versions moves
# no pinned hash while the exact hash still records the true bytes.
#
# The file set is sourced from git whenever the project root is a git
# working tree — tracked files plus untracked ones git does not
# ignore — so gitignored, machine- or session-local files (personal
# settings, editor state, runtime locks, build output) never enter the
# graph and two checkouts of the same committed tree yield the same
# graph. Projects with no git fall back to a plain filesystem walk.
# Either way the hardcoded exclusions still apply: the `.git` and
# `node_modules` directories (at any depth), the `.ok-planner` estate
# at the root (records and judgments are not sources; the graph itself
# lives there), and `.DS_Store` files. Symlinks are never followed.
# Non-UTF-8 files get a file node only.
#
# Adapters are (name, matcher, extractor) entries in ADAPTERS below;
# a later language lands by appending an entry — the file format,
# identity scheme, and walk are adapter-agnostic. The v1 set is
# lexical, in the audit-check vendoring shape (stdlib-only):
# markdown (heading sections), javascript (function/class/method
# declarations, require/import references), shell (function
# declarations, source/invocation references), and a generic
# explicit-path-reference fallback that also runs for every text
# file.
#
# @concept: source-graph

import hashlib
import os
import re
import subprocess
import sys

VERSION = "{{OK_PLANNER_VERSION}}"

GRAPH_DIR = os.path.join(".ok-planner", "graph")
HEADER = "# source-graph v1 — mechanically generated; do not hand-edit.\n"
EXCLUDED_DIRS = (".git", "node_modules")
EXCLUDED_FILES = (".DS_Store",)


def sha12(data):
    return hashlib.sha256(data).hexdigest()[:12]


# The release-metadata mask, byte-compatible with audit-check's: a
# graph consumer comparing a masked node hash and audit-check emitting
# a citation for it must always agree.
_SEMVER = r"\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?"
MASKED_VERSION = "0.0.0"
STAMP_MASK = re.compile(r"(Materialized by [^\r\n]*?\bv)" + _SEMVER)
VERSION_STAMP_MASK = re.compile(
    r"(?m)^(\s*(?:const\s+|var\s+|let\s+|local\s+|readonly\s+|export\s+)?"
    r"VERSION\s*=\s*[\"'])" + _SEMVER + r"([\"'])")
MANIFEST_VERSION_MASK = re.compile(
    r'(?m)^(\s*"version"\s*:\s*")' + _SEMVER + r'(")')
SUITE_FAMILY = re.compile(r"\bok-[a-z][a-z0-9-]*\b")
SUITE_VERSION_TOKEN = re.compile(r"(\bv)" + _SEMVER)


def mask_release_metadata(text, target):
    text = STAMP_MASK.sub(lambda m: m.group(1) + MASKED_VERSION, text)
    text = VERSION_STAMP_MASK.sub(
        lambda m: m.group(1) + MASKED_VERSION + m.group(2), text)
    if SUITE_FAMILY.search(text):
        text = "\n".join(
            SUITE_VERSION_TOKEN.sub(lambda m: m.group(1) + MASKED_VERSION, ln)
            if SUITE_FAMILY.search(ln) else ln
            for ln in text.split("\n"))
    if target.replace(os.sep, "/").endswith(".claude-plugin/plugin.json"):
        text = MANIFEST_VERSION_MASK.sub(
            lambda m: m.group(1) + MASKED_VERSION + m.group(2), text)
    return text


def hash_pair(data, rel):
    """(exact, masked-or-None): masked only when masking changes bytes."""
    exact = sha12(data)
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return exact, None
    masked = sha12(mask_release_metadata(text, rel).encode("utf-8"))
    return exact, (masked if masked != exact else None)


def slugify(text):
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug or "section"


def dedupe_chain(chain, seen):
    """Node identity must be unique per file: a repeated declaration
    chain gets an ordinal suffix in document order (-2, -3, ...)."""
    n = seen.get(chain, 0) + 1
    seen[chain] = n
    return chain if n == 1 else "%s-%d" % (chain, n)


# --- adapters ---------------------------------------------------------------
# Each extractor takes (lines: list of keepends-str) and returns
# (nodes, refs): nodes as [(chain, start_line, end_line_exclusive)],
# refs as [(chain-or-None, raw target string)] — chain None attributes
# the reference to the file node; targets are resolved later.

MD_HEADING = re.compile(r"^(#{1,6})\s+(.+?)\s*#*\s*$")
FENCE = re.compile(r"^\s*(```|~~~)")


def extract_markdown(lines):
    nodes = []
    stack = []  # (level, slug, start)
    in_fence = False
    fence_mark = ""
    for i, raw in enumerate(lines):
        line = raw.rstrip("\r\n")
        f = FENCE.match(line)
        if f:
            if not in_fence:
                in_fence, fence_mark = True, f.group(1)
            elif f.group(1) == fence_mark:
                in_fence = False
            continue
        if in_fence:
            continue
        m = MD_HEADING.match(line)
        if not m:
            continue
        level = len(m.group(1))
        while stack and stack[-1][0] >= level:
            lvl, slug, start = stack.pop()
            nodes.append((".".join(s for _, s, _ in stack) +
                          ("." if stack else "") + slug, start, i))
        stack.append((level, slugify(m.group(2)), i))
    while stack:
        lvl, slug, start = stack.pop()
        nodes.append((".".join(s for _, s, _ in stack) +
                      ("." if stack else "") + slug, start, len(lines)))
    nodes.sort(key=lambda n: (n[1], n[2]))
    return nodes, []


JS_DECL = [
    re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?"
               r"function\s*\*?\s*([A-Za-z_$][\w$]*)\s*\("),
    re.compile(r"^\s*(?:export\s+)?(?:default\s+)?class\s+([A-Za-z_$][\w$]*)"),
    re.compile(r"^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)"
               r"\s*=\s*(?:async\s+)?(?:function\b|\([^)]*\)\s*=>|"
               r"[A-Za-z_$][\w$]*\s*=>)"),
]
JS_METHOD = re.compile(
    r"^\s*(?:static\s+)?(?:async\s+)?(?:get\s+|set\s+)?\*?\s*"
    r"([A-Za-z_$][\w$]*)\s*\([^;{}]*\)\s*\{")
JS_KEYWORDS = frozenset((
    "if", "for", "while", "switch", "catch", "return", "function",
    "typeof", "new", "do", "else", "in", "of", "await", "yield"))
JS_REF = [
    re.compile(r"""require\(\s*['"]([^'"]+)['"]"""),
    re.compile(r"""(?:^|\s)import\b[^'"()]*['"]([^'"]+)['"]"""),
    re.compile(r"""import\(\s*['"]([^'"]+)['"]"""),
    re.compile(r"""(?:^|\s)export\b[^'"()]*\bfrom\s*['"]([^'"]+)['"]"""),
]


# A `/` opens a regular-expression literal only where an operand cannot
# already have ended — after one of these punctuators, or after one of
# these keywords. Everywhere else it is division. Regex bodies must be
# blanked like strings: a class such as `/^[\s/*#]+/` carries what looks
# like a block-comment opener, and reading it as one blanks the rest of
# the file, swallowing every declaration after it into whichever scope
# happened to be open. Two shapes look like preceders and are not: a
# postfix `++`/`--` ends an operand even though `+` and `-` are in the
# punctuator set, and a reserved word reached through `.` is a property
# name, not the keyword it spells.
JS_REGEX_PRECEDERS = frozenset("(,=:[!&|?{};+-*%~^<>")
JS_REGEX_KEYWORDS = frozenset((
    "return", "typeof", "instanceof", "in", "of", "new", "delete",
    "void", "do", "else", "yield", "await", "case", "throw"))


def blank_js_noise(lines):
    """Blank comment, string, template-literal and regular-expression
    content with spaces, preserving line structure, so brace counting
    and declaration regexes read code only. Template literals nest: a
    `${...}` substitution is code again, and its own braces are tracked
    so that its closing `}` returns to the literal instead of closing an
    enclosing declaration's scope. A lexical approximation, but a
    deterministic one."""
    out = []
    mode = "code"  # code | block | sq | dq | template | regex | class
    stack = []     # open contexts: "template", or a substitution's depth
    prev = ""      # last significant code character emitted
    word = ""      # the identifier ending at `prev`, for the regex test
    word_dotted = False  # whether that identifier is a `.`-reached member
    word_open = False    # whether that identifier is still accumulating
    for raw in lines:
        line = raw.rstrip("\r\n")
        buf = []
        i = 0
        n = len(line)
        while i < n:
            ch = line[i]
            nxt = line[i + 1] if i + 1 < n else ""
            if mode == "block":
                if ch == "*" and nxt == "/":
                    buf.append("  ")
                    i += 2
                    mode = "code"
                    continue
                buf.append(" ")
                i += 1
                continue
            if mode in ("sq", "dq"):
                quote = "'" if mode == "sq" else '"'
                if ch == "\\":
                    buf.append("  ")
                    i += 2
                    continue
                if ch == quote:
                    buf.append(ch)
                    mode = "code"
                    prev, word, word_open = quote, "", False
                else:
                    buf.append(" ")
                i += 1
                continue
            if mode == "template":
                if ch == "\\":
                    buf.append("  ")
                    i += 2
                    continue
                if ch == "`":
                    buf.append(ch)
                    stack.pop()
                    mode = "code"
                    prev, word, word_open = "`", "", False
                    i += 1
                    continue
                if ch == "$" and nxt == "{":
                    buf.append("  ")
                    stack.append(0)
                    mode = "code"
                    prev, word, word_open = "{", "", False
                    i += 2
                    continue
                buf.append(" ")
                i += 1
                continue
            if mode in ("regex", "class"):
                if ch == "\\":
                    buf.append("  ")
                    i += 2
                    continue
                if mode == "regex" and ch == "[":
                    mode = "class"
                elif mode == "class" and ch == "]":
                    mode = "regex"
                elif mode == "regex" and ch == "/":
                    mode = "code"
                    prev, word, word_open = "/", "", False
                buf.append(" ")
                i += 1
                continue
            if ch == "/" and nxt == "/":
                break
            if ch == "/" and nxt == "*":
                buf.append("  ")
                i += 2
                mode = "block"
                continue
            if ch == "/" and (prev == "" or prev in JS_REGEX_PRECEDERS
                              or (word in JS_REGEX_KEYWORDS
                                  and not word_dotted)):
                buf.append(" ")
                i += 1
                mode = "regex"
                continue
            if ch == "`":
                buf.append(ch)
                stack.append("template")
                mode = "template"
                i += 1
                continue
            if ch in ("'", '"'):
                buf.append(ch)
                mode = "sq" if ch == "'" else "dq"
                i += 1
                continue
            if stack and isinstance(stack[-1], int):
                if ch == "{":
                    stack[-1] += 1
                elif ch == "}":
                    if stack[-1] == 0:
                        stack.pop()
                        buf.append(" ")
                        mode = "template"
                        prev, word, word_open = "}", "", False
                        i += 1
                        continue
                    stack[-1] -= 1
            buf.append(ch)
            if ch.isspace():
                # Whitespace ends the identifier without discarding it:
                # the `/` in `return /re/` still needs to see `return`,
                # while the `in` in `k in /re/` must not glue onto `k`.
                word_open = False
            else:
                if ch.isalnum() or ch in "_$":
                    if not word_open:
                        # A reserved word is a legal property name, so
                        # remember whether this identifier is reached
                        # through `.`: `obj.in / 2` is division.
                        word, word_dotted = "", prev == "."
                        word_open = True
                    word += ch
                else:
                    word, word_dotted, word_open = "", False, False
                if ch in "+-" and prev == ch and i and line[i - 1] == ch:
                    # A postfix `++`/`--` ends an operand, so the `/` in
                    # `total++ / count` is division, not a regex opener.
                    # `)` is not a preceder, and stands for that operand.
                    prev = ")"
                else:
                    prev = ch
            i += 1
        if mode in ("sq", "dq", "regex", "class"):
            # An unterminated quote or regex does not leak across lines.
            mode = "code"
        word_open = False  # a line break ends the identifier too
        out.append("".join(buf))
    return out


def extract_braced(lines, code, decl_res, method_re=None,
                   keywords=frozenset()):
    """Shared scanner for brace-delimited languages: declarations open
    scopes at their brace depth; a scope closes when depth returns."""
    nodes = []
    stack = []  # (name, start_line, open_depth, is_class)
    depth = 0
    for i, line in enumerate(code):
        name = None
        is_class = False
        for r in decl_res:
            m = r.match(line)
            if m and m.group(1) not in keywords:
                name = m.group(1)
                is_class = "class" in r.pattern
                break
        if name is None and method_re and stack and stack[-1][3]:
            m = method_re.match(line)
            if m and m.group(1) not in keywords:
                name = m.group(1)
        opens = line.count("{")
        closes = line.count("}")
        if name is not None:
            if opens == 0:
                # a braceless declaration (an arrow expression):
                # a single-line span
                chain = ".".join([s[0] for s in stack] + [name])
                nodes.append((chain, i, i + 1))
            else:
                stack.append((name, i, depth, is_class))
        depth += opens - closes
        while stack and depth <= stack[-1][2]:
            n, start, _, _ = stack.pop()
            chain = ".".join([s[0] for s in stack] + [n])
            nodes.append((chain, start, i + 1))
    while stack:
        n, start, _, _ = stack.pop()
        chain = ".".join([s[0] for s in stack] + [n])
        nodes.append((chain, start, len(code)))
    nodes.sort(key=lambda n: (n[1], n[2]))
    return nodes


def extract_javascript(lines):
    code = blank_js_noise(lines)
    nodes = extract_braced(code, code, JS_DECL, JS_METHOD, JS_KEYWORDS)
    refs = []
    for i, raw in enumerate(lines):
        for r in JS_REF:
            for m in r.finditer(raw):
                refs.append((i, m.group(1)))
    return nodes, refs


SH_DECL = [
    re.compile(r"^\s*function\s+([A-Za-z_][\w-]*)\s*(?:\(\)\s*)?\{"),
    re.compile(r"^\s*([A-Za-z_][\w-]*)\s*\(\)\s*\{"),
]
SH_REF = re.compile(r"(?:^|[;&|(\s])(?:source|\.)\s+([^\s;|&)]+)")
# A heredoc redirection: `<<WORD`, `<< WORD`, `<<'WORD'`, `<<"WORD"`,
# `<<\WORD`, and the `<<-` tab-stripping form. A bare delimiter must
# start with a letter or underscore so an arithmetic left shift
# (`$((1 << 3))`) is never mistaken for one; `<<<` (a here-string) is
# excluded by the caller before this pattern is tried.
SH_HEREDOC = re.compile(
    r"<<(-?)\s*(?:'([^']*)'|\"([^\"]*)\"|\\?([A-Za-z_][\w.-]*))")


def blank_sh_noise(lines):
    """Blank comments, string contents, and heredoc bodies with spaces,
    preserving line structure, so brace counting and declaration
    regexes read code only. Heredoc bodies are arbitrary text — a
    stray brace in one would otherwise close the enclosing function's
    scope early — so an opened heredoc blanks every line through its
    terminator (honoring `<<-` tab stripping and quoted delimiters)."""
    out = []
    pending = []  # heredocs opened but not yet terminated: (delim, strip)
    for raw in lines:
        line = raw.rstrip("\r\n")
        if pending:
            delim, strip_tabs = pending[0]
            probe = line.lstrip("\t") if strip_tabs else line
            if probe == delim:
                pending.pop(0)
            out.append(" " * len(line))
            continue
        buf = []
        state = None
        i = 0
        while i < len(line):
            ch = line[i]
            if state == "'":
                buf.append("'" if ch == "'" else " ")
                if ch == "'":
                    state = None
                i += 1
                continue
            if state == '"':
                if ch == "\\":
                    buf.append("  ")
                    i += 2
                    continue
                buf.append('"' if ch == '"' else " ")
                if ch == '"':
                    state = None
                i += 1
                continue
            if ch == "#":
                break
            if ch == "<" and line[i + 1:i + 2] == "<":
                if line[i + 2:i + 3] == "<":  # here-string, not a heredoc
                    buf.append("   ")
                    i += 3
                    continue
                m = SH_HEREDOC.match(line, i)
                if m:
                    delim = m.group(2)
                    if delim is None:
                        delim = m.group(3)
                    if delim is None:
                        delim = m.group(4)
                    pending.append((delim, m.group(1) == "-"))
                    buf.append(" " * (m.end() - i))
                    i = m.end()
                    continue
            if ch in ("'", '"'):
                buf.append(ch)
                state = ch
                i += 1
                continue
            if ch == "\\":
                buf.append("  ")
                i += 2
                continue
            buf.append(ch)
            i += 1
        out.append("".join(buf))
    return out


def extract_shell(lines):
    code = blank_sh_noise(lines)
    nodes = extract_braced(code, code, SH_DECL)
    refs = []
    for i, line in enumerate(code):
        for m in SH_REF.finditer(line):
            refs.append((i, m.group(1)))
    return nodes, refs


def extract_generic(lines):
    return [], []


# A path-looking token: at least one interior slash, no URL scheme.
# Resolution against the walked file set is what keeps this from
# being noise — a token that names no file in the tree emits nothing.
PATH_TOKEN = re.compile(r"(?<![\w:/])(\.{0,2}[A-Za-z0-9_@.-]*"
                        r"(?:/[A-Za-z0-9_@.-]+)+)")


def generic_path_refs(lines):
    refs = []
    for i, raw in enumerate(lines):
        for m in PATH_TOKEN.finditer(raw):
            refs.append((i, m.group(1)))
    return refs


def is_shell(rel, first_line):
    if rel.endswith(".sh") or rel.endswith(".bash"):
        return True
    return bool(re.match(r"^#!.*\b(ba|z|da)?sh\b", first_line))


def pick_adapter(rel, first_line):
    for name, matcher, extractor in ADAPTERS:
        if matcher(rel, first_line):
            return extractor
    return extract_generic


ADAPTERS = [
    ("markdown",
     lambda rel, fl: rel.endswith(".md") or rel.endswith(".markdown"),
     extract_markdown),
    ("javascript",
     lambda rel, fl: rel.endswith((".js", ".mjs", ".cjs"))
     or bool(re.match(r"^#!.*\bnode\b", fl)),
     extract_javascript),
    ("shell", is_shell, extract_shell),
]


# --- the walk and the graph -------------------------------------------------

def is_excluded(rel):
    """The hardcoded exclusions, applied to whichever source produced
    the candidate: `.git` and `node_modules` directories at any depth,
    the `.ok-planner` estate at the root, and `.DS_Store` files."""
    parts = rel.split("/")
    if parts[0] == ".ok-planner":
        return True
    if parts[-1] in EXCLUDED_FILES:
        return True
    return any(p in EXCLUDED_DIRS for p in parts[:-1])


def git_listed_files(root):
    """The working tree as git sees it — tracked files plus untracked
    ones no ignore rule covers — or None when root is not a git work
    tree, or git cannot be run. Asking git is what keeps gitignored
    local files (personal settings, session locks, build output) out of
    the graph: they vary per contributor and per machine, so graphing
    them would make identical committed trees produce different
    graphs."""
    if not os.path.exists(os.path.join(root, ".git")):
        return None
    try:
        proc = subprocess.Popen(
            ["git", "-C", root, "ls-files", "--cached", "--others",
             "--exclude-standard", "-z"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        out, _ = proc.communicate()
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    # `--cached` lists an unmerged path once per stage; dedupe.
    return set(p for p in out.decode("utf-8", "surrogateescape").split("\0")
               if p)


def filesystem_files(root):
    """The non-git fallback: every regular file under the root."""
    found = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        rel_dir = os.path.relpath(dirpath, root).replace(os.sep, "/")
        dirnames[:] = sorted(
            d for d in dirnames
            if d not in EXCLUDED_DIRS
            and not (rel_dir == "." and d == ".ok-planner"))
        for fn in sorted(filenames):
            found.append(
                os.path.relpath(os.path.join(dirpath, fn), root)
                .replace(os.sep, "/"))
    return found


def walk_sources(root):
    """Every included regular file, as sorted /-separated relpaths."""
    candidates = git_listed_files(root)
    if candidates is None:
        candidates = filesystem_files(root)
    found = []
    for rel in candidates:
        if is_excluded(rel):
            continue
        full = os.path.join(root, rel.replace("/", os.sep))
        if os.path.islink(full) or not os.path.isfile(full):
            continue
        found.append(rel)
    return sorted(found)


def resolve_ref(root, rel, target, fileset):
    """Resolve a raw reference string to a walked relpath, or None."""
    target = target.strip().rstrip(".,;:)")
    if not target or "://" in target:
        return None
    candidates = []
    base = os.path.dirname(rel)
    if target.startswith(("./", "../")):
        stems = [os.path.normpath(os.path.join(base, target))]
    else:
        stems = [os.path.normpath(target),
                 os.path.normpath(os.path.join(base, target))]
    for stem in stems:
        stem = stem.replace(os.sep, "/")
        for suffix in ("", ".js", ".mjs", ".cjs", "/index.js"):
            candidates.append(stem + suffix)
    for c in candidates:
        if c in fileset and c != rel:
            return c
    return None


def declared_units(rel, lines):
    """One file's declared structure: (spans, refs) — spans as
    [(chain, start, end)] line ranges over `lines` (as produced by
    splitlines(keepends=True)) with identity chains already deduped,
    refs as [(line_no, raw target)]. The single place adapter choice
    and identity deduping happen, so everything that needs to know
    what a declared unit is agrees by construction."""
    first_line = lines[0].rstrip("\r\n") if lines else ""
    nodes, raw_refs = pick_adapter(rel, first_line)(lines)
    seen = {}
    spans = [(dedupe_chain(chain, seen), start, end)
             for chain, start, end in nodes]
    return spans, list(raw_refs) + generic_path_refs(lines)


def declared_unit_spans(rel, lines):
    """Just the declared-unit line spans. The change-inspection floor
    imports this to excise a file's declared units and hash what
    remains outside them: the region outside every unit is a real part
    of the file that no node covers, and the floor has to see it move.
    Loading the extractor here rather than restating it there is what
    keeps the floor's granularity identical to the graph's."""
    return declared_units(rel, lines)[0]


def graph_for(root, rel, fileset):
    """The graph file body for one source file — a pure function of
    the file's bytes (and the walked file set, for ref resolution)."""
    full = os.path.join(root, rel)
    with open(full, "rb") as f:
        data = f.read()
    exact, masked = hash_pair(data, rel)
    out = [HEADER]
    out.append("file %s sha256:%s%s\n"
               % (rel, exact, (" masked:%s" % masked) if masked else ""))
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return "".join(out)
    lines = text.splitlines(keepends=True)
    spans, raw_refs = declared_units(rel, lines)

    node_rows = []
    for chain, start, end in spans:
        span = "".join(lines[start:end]).encode("utf-8")
        n_exact, n_masked = hash_pair(span, rel)
        node_rows.append("node %s#%s sha256:%s%s\n"
                         % (rel, chain, n_exact,
                            (" masked:%s" % n_masked) if n_masked else ""))
    node_rows.sort()
    out.extend(node_rows)

    ref_rows = set()
    for line_no, raw_target in raw_refs:
        target = resolve_ref(root, rel, raw_target, fileset)
        if target is None:
            continue
        owner = rel
        best = None
        for chain, start, end in spans:
            if start <= line_no < end:
                if best is None or (end - start) < (best[2] - best[1]):
                    best = (chain, start, end)
        if best is not None:
            owner = "%s#%s" % (rel, best[0])
        ref_rows.add("ref %s :: %s\n" % (owner, target))
    out.extend(sorted(ref_rows))
    return "".join(out)


def expected_graph(root):
    fileset = set(walk_sources(root))
    return {rel: graph_for(root, rel, fileset) for rel in sorted(fileset)}


def graph_path(root, rel):
    return os.path.join(root, GRAPH_DIR, rel + ".graph")


def committed_graph_files(root):
    base = os.path.join(root, GRAPH_DIR)
    found = []
    if not os.path.isdir(base):
        return found
    for dirpath, dirnames, filenames in os.walk(base):
        dirnames.sort()
        for fn in sorted(filenames):
            if fn.endswith(".graph"):
                rel = os.path.relpath(os.path.join(dirpath, fn), base)
                found.append(rel[:-len(".graph")].replace(os.sep, "/"))
    return sorted(found)


def build(root):
    exp = expected_graph(root)
    written = 0
    for rel, body in exp.items():
        path = graph_path(root, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        current = None
        if os.path.isfile(path):
            with open(path) as f:
                current = f.read()
        if current != body:
            with open(path, "w") as f:
                f.write(body)
            written += 1
    removed = 0
    for rel in committed_graph_files(root):
        if rel not in exp:
            os.remove(graph_path(root, rel))
            removed += 1
    # Bottom-up, re-listing at removal time: os.walk precomputes its
    # dirnames, so a parent emptied by removing its last child in this
    # same pass must be re-checked against the filesystem, not against
    # the stale listing — otherwise a deep tree sheds one level per run.
    base = os.path.join(root, GRAPH_DIR)
    for dirpath, _, _ in os.walk(base, topdown=False):
        if dirpath != base and not os.listdir(dirpath):
            os.rmdir(dirpath)
    print("source-graph: %d files graphed (%d rewritten, %d orphans removed)"
          % (len(exp), written, removed))
    return 0


def check(root):
    exp = expected_graph(root)
    findings = []
    committed = committed_graph_files(root)
    for rel in sorted(exp):
        path = graph_path(root, rel)
        gp = os.path.relpath(path, root)
        if not os.path.isfile(path):
            findings.append("%s: [graph-missing] %s has no committed "
                            "graph file — run source-graph build"
                            % (gp, rel))
            continue
        with open(path) as f:
            if f.read() != exp[rel]:
                findings.append("%s: [graph-stale] committed graph "
                                "differs from the tree — run "
                                "source-graph build" % gp)
    for rel in committed:
        if rel not in exp:
            findings.append("%s: [graph-orphaned] no source file at %s "
                            "— run source-graph build"
                            % (os.path.relpath(graph_path(root, rel), root),
                               rel))
    for line in findings:
        print(line)
    return 2 if findings else 0


def main():
    args = sys.argv[1:]
    if not args or args[0] not in ("build", "check"):
        print("usage: source-graph build|check [<project-root>]",
              file=sys.stderr)
        return 1
    mode = args[0]
    root = os.path.abspath(args[1]) if len(args) > 1 else os.getcwd()
    if not os.path.isdir(root):
        print("source-graph: no directory at %s" % root, file=sys.stderr)
        return 1
    return build(root) if mode == "build" else check(root)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as err:
        print("source-graph: internal error: %s" % err, file=sys.stderr)
        sys.exit(1)
