#!/bin/sh
# Materialized by ok-planner v{{OK_PLANNER_VERSION}} — suite-owned; overwritten on true-up; do not hand-edit.

set -eu
usage='usage: run-tag (prints run-<12 hex>; takes no argument)'
if [ "$#" -gt 0 ]; then
  if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
    printf '%s\n' "$usage"
    exit 0
  fi
  printf '%s\n' "$usage" >&2
  exit 1
fi
hex=$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')
case $hex in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *) echo "run-tag: could not read 6 random bytes" >&2; exit 1 ;;
esac
printf 'run-%s\n' "$hex"
