#!/usr/bin/env python3
# Materialized by ok-planner v{{OK_PLANNER_VERSION}} — suite-owned; overwritten on converge; do not hand-edit.
VERSION = "{{OK_PLANNER_VERSION}}"

"""surface-corpus: given an issue, print design-corpus artifacts
(concepts, stories, decisions) that likely bear on it.

Input: argv[1], an issue's id. The record comes through the intake's
module, `.ok-planner/bin/issues`: its `artifacts`, and the text of its
id, title, problem, and options.

Two tiers:
  1. Explicit — anything the issue cites as `concept:` / `story:` /
     `decision:` artifacts resolves to a file and is surfaced with
     maximum score.
  2. Textual — tokens extracted from the issue's id, title, problem, and options
     are matched against the corpus. Only RARE tokens count: a token
     appearing in more than a small share of docs is discarded as noise
     ("runtime", "terminal", "auth" appear in most concepts and carry no
     signal). Rare-token hits are weighted by inverse frequency across
     the corpus.

Output: `<relpath>\t<kind>\t<why>` per line, ranked, capped at 10. Empty
output = no bearing artifact found (itself a signal to the walker).

Env: OK_PLANNER_PROJECT_ROOT sets the search root (default cwd)."""
import sys, os, re, pathlib, collections, types

STOP = set("""a an and are as at be but by for from has have here how in is it its of
on or that the this to was were what when where which who why will with also new
old two one three each all any not need may can issue open close bug fix drift
stale still might must into onto over under above below through between within
without some other same than then while thus both above below yet very quite
always never often maybe likely because so if else than only own get set did
done make made used use uses using kind category summary detail candidates event
promote retire resolve open true false null none row rows json field fields file
files line lines path paths dir dirs code source thing things call calls""".split())

MAX_DOC_FRACTION = 0.30
MIN_TOKEN_LEN = 4
TOP_N = 10


def tokens(text):
    for m in re.findall(r"`([^`]+)`", text):
        yield m.strip()
    for m in re.finditer(r"[A-Za-z_][A-Za-z0-9_]{" + str(MIN_TOKEN_LEN - 1) + r",}", text):
        w = m.group(0)
        if w.lower() in STOP:
            continue
        yield w


def gather(project_root):
    design = project_root / ".ok-planner" / "design"
    kinds = {}
    for sub, kind in (("concepts", "concept"), ("stories", "story"), ("decisions", "decision")):
        d = design / sub
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*.md")):
            kinds[p] = kind
    return kinds


def build_doc_freq(paths):
    df = collections.Counter()
    bodies = {}
    for p in paths:
        try:
            body = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            body = ""
        bodies[p] = body
        seen = set()
        for w in re.findall(r"[A-Za-z_][A-Za-z0-9_]{" + str(MIN_TOKEN_LEN - 1) + r",}", body):
            if w.lower() in STOP or w in seen:
                continue
            seen.add(w)
            df[w] += 1
        for w in re.findall(r"`([^`]+)`", body):
            w = w.strip()
            if not w or w in seen:
                continue
            seen.add(w)
            df[w] += 1
    return df, bodies


def load_issues(project_root):
    path = str(project_root / ".ok-planner" / "bin" / "issues")
    module = types.ModuleType("ok_planner_issues")
    module.__file__ = path
    with open(path, encoding="utf-8") as f:
        exec(compile(f.read(), path, "exec"), module.__dict__)
    return module


def main():
    if len(sys.argv) != 2:
        print("usage: surface-corpus <issue id>", file=sys.stderr)
        return 2
    project_root = pathlib.Path(os.environ.get("OK_PLANNER_PROJECT_ROOT", ".")).resolve()
    issues = load_issues(project_root)
    try:
        record, _ = issues.find(str(project_root), sys.argv[1])
    except issues.Refusal as refusal:
        print(f"surface-corpus: {refusal}", file=sys.stderr)
        return 2

    docs = gather(project_root)
    if not docs:
        return 0

    total = len(docs)
    df, bodies = build_doc_freq(docs.keys())
    rare_cap = max(1, int(total * MAX_DOC_FRACTION))

    surfaced = {}

    for a in record["artifacts"]:
        if ":" not in a:
            continue
        kind, slug = a.split(":", 1)
        if kind not in ("concept", "story", "decision"):
            continue
        path = project_root / ".ok-planner" / "design" / (kind + "s") / f"{slug}.md"
        if path in docs:
            surfaced[path] = (10_000.0, "cited in the issue's artifacts")

    text = " ".join([record["id"], record["title"], record["problem"]] + [o["text"] for o in record["options"]])
    issue_toks = set(tokens(text))
    rare_issue_toks = {t for t in issue_toks if 0 < df.get(t, 0) <= rare_cap}

    if rare_issue_toks:
        for path, body in bodies.items():
            if path in surfaced:
                continue
            hits = []
            for t in rare_issue_toks:
                if re.search(r"\b" + re.escape(t) + r"\b", body):
                    weight = (total / df[t])
                    hits.append((t, weight))
            if not hits:
                continue
            score = sum(w for _, w in hits)
            hits.sort(key=lambda tw: -tw[1])
            names = ", ".join(t for t, _ in hits[:4])
            surfaced[path] = (score, f"{len(hits)} rare-token hit(s): {names}")

    ranked = sorted(surfaced.items(), key=lambda kv: -kv[1][0])[:TOP_N]
    for path, (score, why) in ranked:
        rel = path.relative_to(project_root)
        print(f"{rel}\t{docs[path]}\t{why}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
