#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
#
# browse — up/down for the corpus view, from the project's own estate.
#
#   browse up     start the estate's corpus-view on any free loopback
#                 port, record the process in gitignored run state, and
#                 open the system browser on the page
#   browse down   stop the recorded process and remove the run state
#
# Both verbs are idempotent and stale-record tolerant: `up` against a
# live view reuses it, `down` with nothing recorded is a no-op, and a
# recorded pid that no longer answers (or now belongs to some other
# process) is cleaned up, never an error and never killed blind.
#
# The view it starts is the sibling corpus-view beside this script —
# the estate's own pinned copy when this is .ok-planner/bin/browse, the
# payload's copy when run from the carried family — so the resolution
# arithmetic and the announced version are always the sibling's own.
# The run state lives under the estate's gitignored run/ directory, so
# a recorded pid and port never become repository content.
#
# @story: trace-corpus-to-code
# @decision: local-web-surface
# @decision: per-project-pinning

import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
import webbrowser

VERSION = "{{OK_PLANNER_VERSION}}"

SERVING = re.compile(r"corpus view: serving (http://127\.0\.0\.1:(\d+)/)")


def resolve_root(start=None):
    """Nearest .git ancestor of the working directory, else the cwd —
    the same resolution the sibling corpus-view performs, so the run
    state is recorded for the project the view actually serves."""
    d = os.path.abspath(start or os.getcwd())
    while d != "/":
        if os.path.exists(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return os.path.abspath(start or os.getcwd())


def sibling_view():
    view = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "corpus-view")
    if not os.path.isfile(view):
        sys.exit("browse: no corpus-view beside this script at %s — "
                 "/ok pins both into .ok-planner/bin/" % view)
    return view


def run_dir(root):
    return os.path.join(root, ".ok-planner", "run")


def run_file(root):
    return os.path.join(run_dir(root), "corpus-view")


def log_file(root):
    return os.path.join(run_dir(root), "corpus-view.log")


def read_record(root):
    """The recorded (pid, port), or None for absent/malformed."""
    try:
        with open(run_file(root)) as f:
            pid, port = f.read().split()
        return int(pid), int(port)
    except (OSError, ValueError):
        return None


def is_corpus_view(pid):
    """Whether pid is alive AND is a corpus-view process. A recorded
    pid the OS has since reused must never be killed on the record's
    say-so, so identity is confirmed from the process table."""
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "corpus-view" in out.stdout


def answers(url, tries=1, delay=0.2):
    for _ in range(tries):
        try:
            with urllib.request.urlopen(url, timeout=2):
                return True
        except (urllib.error.URLError, OSError):
            time.sleep(delay)
    return False


def clear_record(root):
    for p in (run_file(root), log_file(root)):
        try:
            os.remove(p)
        except OSError:
            pass


def reused_or_gone(pid):
    """What to say about a recorded pid that is not a corpus view. The
    two cases differ in system state and must not be reported alike: a
    dead pid is simply gone, whereas a live pid the OS has recycled for
    something else is still running — the record is dropped either way,
    but nothing is ever signalled at a recycled pid."""
    if is_alive(pid):
        return ("recorded pid %d is running something else now — record "
                "cleaned up, nothing signalled" % pid)
    return "stale run record (pid %d is gone) — cleaned up" % pid


def up(root):
    record = read_record(root)
    if record is None and os.path.exists(run_file(root)):
        print("malformed run record removed — starting fresh")
        clear_record(root)
    if record:
        pid, port = record
        url = "http://127.0.0.1:%d/" % port
        if is_corpus_view(pid) and answers(url, tries=3):
            print("corpus view already serving %s (pid %d)" % (url, pid))
            webbrowser.open(url)
            return 0
        if is_corpus_view(pid):
            # Recorded, alive, but not answering on the recorded port:
            # a wedged leftover. Stop it and start fresh.
            print("recorded corpus view (pid %d) is not answering — "
                  "restarting it" % pid)
            terminate(pid)
        else:
            print(reused_or_gone(pid))
        clear_record(root)

    view = sibling_view()
    os.makedirs(run_dir(root), exist_ok=True)
    log = open(log_file(root), "w")
    # --port 0 hands the choice to the OS: any free loopback port.
    proc = subprocess.Popen(
        [sys.executable, view, "--port", "0"],
        cwd=root, stdout=log, stderr=subprocess.STDOUT,
        start_new_session=True)

    url = None
    deadline = time.time() + 15
    while time.time() < deadline:
        with open(log_file(root)) as f:
            m = SERVING.search(f.read())
        if m:
            url = m.group(1)
            break
        if proc.poll() is not None:
            break
        time.sleep(0.1)

    if url is None or not answers(url, tries=25):
        with open(log_file(root)) as f:
            sys.stderr.write(f.read())
        if proc.poll() is None:
            terminate(proc.pid)
        clear_record(root)
        sys.exit("browse: the corpus view did not come up")

    with open(run_file(root), "w") as f:
        f.write("%d %d\n" % (proc.pid, int(m.group(2))))
    with open(log_file(root)) as f:
        print(f.read(), end="")
    print("run state: %s" % os.path.relpath(run_file(root), root))
    webbrowser.open(url)
    return 0


def terminate(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return
    deadline = time.time() + 5
    while time.time() < deadline:
        if not is_alive(pid):
            return
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        pass


def is_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def down(root):
    record = read_record(root)
    if record is None:
        if os.path.exists(run_file(root)):
            clear_record(root)
            print("malformed run record removed — nothing recognizable to stop")
        else:
            print("no recorded corpus view — nothing to stop")
        return 0
    pid, port = record
    if is_corpus_view(pid):
        terminate(pid)
        print("corpus view stopped (pid %d, port %d)" % (pid, port))
    else:
        print(reused_or_gone(pid))
    clear_record(root)
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) != 1 or argv[0] not in ("up", "down"):
        sys.exit("usage: browse up|down")
    root = resolve_root()
    return up(root) if argv[0] == "up" else down(root)


if __name__ == "__main__":
    sys.exit(main())
