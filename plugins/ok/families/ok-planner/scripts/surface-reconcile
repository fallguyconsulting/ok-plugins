import hashlib
import json
import os
import sys

VERSION = "{{OK_PLANNER_VERSION}}"

USAGE = """surface-reconcile — the deterministic reconciler for the
public-surface partition.

  surface-reconcile [<project-root>]

It reads the surface declaration at `.ok-planner/surface/surface.json`,
reads each declared kind's committed member list at
`.ok-planner/surface/members/<kind>` (one member per line — the
mechanical face of the agentically derived population; the audit run's
opening re-derives it and walks drift with the owner), writes the
fresh extraction to `.ok-planner/audits/surface/extraction.json`, and
reconciles the result against the surface ruling at
`.ok-planner/audits/surface/ruling.json`:

  per element   classified public, classified private, or UNCLAIMED
                (listed, but the ruling does not rule it);
  per ruling    STALE entries — members the ruling rules that no
                member list carries this run;
  guidance      the current guidance blob hash
                (`.ok-planner/surface/guidance.md`, hashed as git
                hashes a blob) against the hash the ruling recorded.

It classifies nothing itself — applying the guidance prose is the
audit run's judgment, and an element the guidance cannot settle is the
owner's question. It only reports whether the recorded partition still
covers what the member lists carry and whether the guidance the
ruling applied is the guidance on disk.

Exit 0: settled — every listed element is ruled, the ruling rules
nothing that is not listed, and the guidance hash matches.
Exit 2: unclaimed or stale elements, an unratified guidance change, or
no ruling yet. Exit 1: a missing or malformed declaration, guidance,
or member list, a legacy declaration field (`enumerate`,
`derivation`), or a kind whose list is empty without
`expectedEmpty`."""

DECLARATION = os.path.join(".ok-planner", "surface", "surface.json")
GUIDANCE = os.path.join(".ok-planner", "surface", "guidance.md")
MEMBERS = os.path.join(".ok-planner", "surface", "members")
RULING = os.path.join(".ok-planner", "audits", "surface", "ruling.json")
EXTRACTION = os.path.join(".ok-planner", "audits", "surface",
                          "extraction.json")


def fail(msg):
    print("error: %s" % msg)
    sys.exit(1)


def git_blob_hash(path):
    with open(path, "rb") as fh:
        content = fh.read()
    header = b"blob %d\0" % len(content)
    return hashlib.sha1(header + content).hexdigest()


def load_json(path, what):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except json.JSONDecodeError as exc:
        fail("%s is not valid JSON (%s): %s" % (what, path, exc))


def read_kind_members(root, kind):
    # @decision:owner-guided-surface-partition @concept:surface-declaration
    name = kind.get("kind")
    if not name or not isinstance(name, str):
        fail("a declared kind is missing its `kind` name")
    for legacy in ("enumerate", "derivation"):
        if legacy in kind:
            fail("kind `%s` carries the retired `%s` field — the "
                 "declaration names only `kind`, `reads`, and "
                 "`expectedEmpty`; every population lives in its "
                 "committed member list at %s/<kind>, derived "
                 "agentically by the audit run's opening"
                 % (name, legacy, MEMBERS))
    reads = kind.get("reads")
    if not reads or not isinstance(reads, str) or "\n" in reads:
        fail("kind `%s` carries no one-line `reads` naming what its "
             "derivation reads" % name)
    members_path = os.path.join(root, MEMBERS, name)
    if not os.path.isfile(members_path):
        fail("kind `%s` has no committed member list at %s/%s — the "
             "audit run's opening derives it from what `reads` names"
             % (name, MEMBERS, name))
    with open(members_path, encoding="utf-8") as fh:
        members = sorted({line.strip() for line in fh
                          if line.strip()})
    if not members and not kind.get("expectedEmpty", False):
        fail("member list for kind `%s` is empty and the kind is not "
             "marked expectedEmpty" % name)
    return name, members


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    if args and args[0] in ("-V", "--version"):
        print("surface-reconcile %s" % VERSION)
        return 0
    root = os.path.abspath(args[0]) if args else os.getcwd()

    declaration_path = os.path.join(root, DECLARATION)
    guidance_path = os.path.join(root, GUIDANCE)
    ruling_path = os.path.join(root, RULING)
    extraction_path = os.path.join(root, EXTRACTION)

    if not os.path.isfile(declaration_path):
        fail("no surface declaration at %s" % DECLARATION)
    if not os.path.isfile(guidance_path):
        fail("no surface guidance at %s" % GUIDANCE)

    declaration = load_json(declaration_path, "surface declaration")
    kinds = declaration.get("kinds")
    if not isinstance(kinds, list) or not kinds:
        fail("surface declaration declares no kinds")

    extraction = {}
    for kind in kinds:
        name, members = read_kind_members(root, kind)
        if name in extraction:
            fail("kind `%s` is declared twice" % name)
        extraction[name] = members

    os.makedirs(os.path.dirname(extraction_path), exist_ok=True)
    with open(extraction_path, "w", encoding="utf-8") as fh:
        json.dump({"kinds": [{"kind": k, "members": extraction[k]}
                             for k in sorted(extraction)]},
                  fh, indent=2, sort_keys=True)
        fh.write("\n")

    guidance_hash = git_blob_hash(guidance_path)

    if not os.path.isfile(ruling_path):
        total = sum(len(v) for v in extraction.values())
        print("no ruling at %s — all %d listed elements unclaimed"
              % (RULING, total))
        for name in sorted(extraction):
            for member in extraction[name]:
                print("  %s/%s: UNCLAIMED" % (name, member))
        print("guidance: %s (no ruling to compare)" % guidance_hash[:12])
        return 2

    ruling = load_json(ruling_path, "surface ruling")
    ruled = {}
    for entry in ruling.get("kinds", []):
        name = entry.get("kind")
        for member in entry.get("public", []):
            ruled.setdefault(name, {})[member] = "public"
        for member in entry.get("private", []):
            ruled.setdefault(name, {})[member] = "private"

    unclaimed = []
    counts = {}
    for name in sorted(extraction):
        pub = priv = 0
        for member in extraction[name]:
            side = ruled.get(name, {}).get(member)
            if side == "public":
                pub += 1
            elif side == "private":
                priv += 1
            else:
                unclaimed.append((name, member))
        counts[name] = (len(extraction[name]), pub, priv)

    stale = []
    for name in sorted(ruled):
        for member in sorted(ruled[name]):
            if member not in set(extraction.get(name, [])):
                stale.append((name, member, ruled[name][member]))

    for name in sorted(counts):
        total, pub, priv = counts[name]
        print("%s: %d listed — %d public, %d private, %d unclaimed"
              % (name, total, pub, priv, total - pub - priv))
    for name, member in unclaimed:
        print("  %s/%s: UNCLAIMED" % (name, member))
    for name, member, side in stale:
        print("  %s/%s: STALE in ruling (%s; no longer enumerated)"
              % (name, member, side))

    recorded = ruling.get("guidanceHash", "")
    if recorded == guidance_hash:
        print("guidance: ratified (hash %s matches ruling)"
              % guidance_hash[:12])
        guidance_ok = True
    else:
        print("guidance: UNRATIFIED change (current %s, ruling recorded %s)"
              % (guidance_hash[:12], (recorded or "nothing")[:12]))
        guidance_ok = False

    if not unclaimed and not stale and guidance_ok:
        print("settled")
        return 0
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001 — exit 1 is the error contract
        print("error: %s" % exc)
        sys.exit(1)
