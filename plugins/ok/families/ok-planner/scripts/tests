class InputError(Exception):
    pass


def load_sibling(name):
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    module = types.ModuleType("ok_planner_%s" % name)
    module.__file__ = path
    with open(path, encoding="utf-8") as f:
        exec(compile(f.read(), path, "exec"), module.__dict__)
    return module


review = load_sibling("review")
ARCHIVED_PLAN_FOLDERS = (review.ARCHIVED_SPRINTS, os.path.join(ESTATE, "history", "test-sprints"))


def project_root():
    env = os.environ.get("OK_PLANNER_PROJECT_ROOT")
    if env:
        return os.path.abspath(env)
    here = os.path.abspath(os.getcwd())
    while True:
        if os.path.isdir(os.path.join(here, ESTATE)):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            raise InputError("no %s estate in %s or any folder above it" % (ESTATE, os.getcwd()))
        here = parent


def read_text(root, rel):
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def read_json(root, rel, what):
    text = read_text(root, rel)
    if text is None:
        return None
    try:
        return json.loads(text)
    except json.JSONDecodeError as err:
        raise InputError("%s is not JSON (%s); %s" % (rel, err, what))


def write_replacing(path, body):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    staging = "%s.%d.tmp" % (path, os.getpid())
    try:
        with open(staging, "w", encoding="utf-8") as f:
            f.write(body)
        os.replace(staging, path)
    finally:
        if os.path.exists(staging):
            os.unlink(staging)


def json_text(root, rel, value):
    found = re.search(r"\n( +)\S", read_text(root, rel) or "")
    return json.dumps(value, indent=len(found.group(1)) if found else 2) + "\n"


def write_json(root, rel, value):
    write_replacing(os.path.join(root, rel), json_text(root, rel, value))


def git(root, *args):
    done = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("git %s failed: %s" % (" ".join(args), done.stderr.strip()))
    return done.stdout


def stamp_held(root, stamp):
    return subprocess.run(["git", "cat-file", "-e", "%s^{commit}" % stamp], cwd=root,
                          capture_output=True, text=True).returncode == 0


def project_folders(root):
    return review.project_folders(root, "tests", "the tests tool")


def plan_folders(plan):
    if not isinstance(plan.get("folders"), list):
        raise InputError("the plan records no folders: assemble it again with `tests plan`")
    return plan["folders"]


# @story: project-spans-folders
def tree_files(root, folders):
    listed = git(root, "ls-files", "--cached", "--others", "--exclude-standard", "--", ".", *folders).split("\n")
    return sorted({os.path.normpath(path) for path in listed if path and os.path.isfile(os.path.join(root, path))})


def earlier_testing(testing):
    run = testing.get("run")
    return "timeout" in testing or (isinstance(run, str) and "{path}" in run and "{tests}" not in run)


def is_command(value):
    return isinstance(value, str) and bool(value.strip())


def suite_command_refusal(run):
    missing = [holder for holder in ("{tests}", "{results}") if holder not in run]
    if missing:
        return ("%r holds no %s: the tool puts the path of the list of tests at {tests} and the path of the result "
                "stream at {results}" % (run, " and no ".join(missing)))
    return None


# @decision: fixes-rerun-the-tests-they-reach
# @decision: scenario-list-decided-once
# @decision: settings-have-no-code-defaults
# @decision: testing-set-up-by-its-own-verb
# @decision: tests-isolated-unless-declared
def testing_config(root, sprint):
    tasks = review.issues.tasks
    enabled = review.testing_enabled(root)
    if enabled == "off" and sprint:
        raise InputError("%s sets testing.enabled to off, so no sprint plans or runs tests: run /ok-setup to turn "
                         "testing on, or run the tests a person asks for without --sprint" % CONFIG)
    config = tasks.project_config(root)
    testing = config["testing"]
    if earlier_testing(testing):
        raise InputError("%s: %s" % (CONFIG, EARLIER_TESTING))
    missing = ["testing.%s" % key for key in required_keys(testing) if key not in testing]
    if missing:
        raise InputError("%s sets no %s: %s" % (CONFIG, ", ".join(missing), DECLARE))
    run = tasks.setting(config, "testing.run", is_command, "a non-empty command")
    setup = tasks.setting(config, "testing.setup", lambda value: value is None or is_command(value),
                          "a non-empty command, or null where the project needs no setup")
    if setup is not None and "setup_silence" not in testing:
        raise InputError("%s sets testing.setup and no testing.setup_silence: declare it with `tests declare "
                         "--setup-silence <seconds>`" % CONFIG)
    refusal = suite_command_refusal(run)
    if refusal:
        raise InputError("%s testing.run %s" % (CONFIG, refusal))
    return {"run": run, "silence": tasks.count(config, "testing.silence"),
            "named": tasks.setting(config, "testing.named", lambda named: isinstance(named, bool), "true or false"),
            "leftovers": tasks.setting(config, "testing.leftovers", is_command, "a non-empty command"),
            "slowest": tasks.count(config, "testing.slowest"),
            "runners": tasks.setting(config, "testing.runners",
                                     lambda runners: isinstance(runners, list) and all(map(is_command, runners)),
                                     "a list of non-empty commands"),
            "setup": setup,
            "setup_silence": tasks.count(config, "testing.setup_silence") if setup is not None else None,
            "schedule": tasks.setting(config, "testing.schedule", schedule_held, SCHEDULE_SHAPE),
            "reaches": tasks.setting(config, "testing.reaches", reaches_held, REACHES_SHAPE),
            "enabled": enabled,
            "offers": tasks.setting(config, "testing.offers", offers_listed, OFFERS_SHAPE) if "offers" in testing else None}


def required_keys(testing):
    return [key for key in TESTING_KEYS if key != "offers" or testing.get("enabled") == "on"]


def form_and_said(value, forms):
    return (isinstance(value, dict) and set(value) == {"form", "said"} and value["form"] in forms
            and (value["said"] is None or is_command(value["said"])))


def schedule_held(schedule):
    return form_and_said(schedule, SCHEDULE_FORMS)


def reaches_held(reaches):
    return form_and_said(reaches, REACHES_FORMS)


# @decision: tests-isolated-unless-declared
def recorded_schedule(root):
    return review.issues.tasks.setting(review.issues.tasks.project_config(root), "testing.schedule", schedule_held,
                                       SCHEDULE_SHAPE)


def offers_listed(offers):
    return (isinstance(offers, list) and all(isinstance(offer, str) and offer in OFFERS for offer in offers)
            and len(set(offers)) == len(offers))


def read_state(root):
    state = read_json(root, STATE, "only this tool writes it, so restore it from git")
    if state is None:
        return {"stamps": {}, "scenarios": [], "unguarded": [], "budget": None, "inferred": [],
                "kept": [], "ranking": [], "ranked_sprints": [], "acceptances": {}}
    if not isinstance(state, dict) or not isinstance(state.get("scenarios"), list):
        raise InputError("%s does not hold a scenario list" % STATE)
    state.setdefault("unguarded", [])
    state.setdefault("budget", None)
    state.setdefault("inferred", [])
    state.setdefault("kept", [])
    state.setdefault("stamps", {})
    state.setdefault("ranking", [])
    state.setdefault("ranked_sprints", [])
    state.setdefault("acceptances", {})
    if not isinstance(state["inferred"], list) or not all(isinstance(rule, dict) for rule in state["inferred"]):
        raise InputError("%s: inferred is not a list of rules; only this tool writes it, so restore it from git" % STATE)
    if not isinstance(state["kept"], list) or not all(isinstance(path, str) and path for path in state["kept"]):
        raise InputError("%s: kept is not a list of paths; only this tool writes it, so restore it from git" % STATE)
    if not isinstance(state["stamps"], dict) or not all(isinstance(slug, str) and isinstance(blob, str) and blob
                                                        for slug, blob in state["stamps"].items()):
        raise InputError("%s: stamps is not a map of story slugs to blob ids; only this tool writes it, so restore it "
                         "from git" % STATE)
    if not isinstance(state["ranking"], list) or not all(ranked_held(row) for row in state["ranking"]):
        raise InputError("%s: ranking is not a list of {scenario, blob, seconds: [<number>, ...], median, cost}; only "
                         "this tool writes it, so restore it from git" % STATE)
    if not isinstance(state["ranked_sprints"], list) or not all(isinstance(path, str) and path
                                                                for path in state["ranked_sprints"]):
        raise InputError("%s: ranked_sprints is not a list of sprint paths; only this tool writes it, so restore it "
                         "from git" % STATE)
    if not isinstance(state["acceptances"], dict) or not all(isinstance(sid, str) and isinstance(accepted, dict)
                                                             for sid, accepted in state["acceptances"].items()):
        raise InputError("%s: acceptances is not a map of scenario ids to {blob, support, seconds}; only this tool "
                         "writes it, so restore it from git" % STATE)
    return state


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def ranked_held(row):
    return (isinstance(row, dict) and isinstance(row.get("scenario"), str) and isinstance(row.get("blob"), str)
            and isinstance(row.get("seconds"), list) and all(map(is_number, row["seconds"])))


def rule_text(entry):
    if entry.get("rule") == INFERRED:
        return 'the inferred rule "%s"' % (entry.get("inferred") or "-")
    return entry.get("rule") or "-"


def locator(test):
    if not test:
        return None
    return "%s::%s" % (test["path"], test["name"]) if test.get("name") else test["path"]


def claimed_paths(scenarios):
    paths = set()
    for scenario in scenarios:
        if scenario.get("test"):
            paths.add(scenario["test"]["path"])
        paths.update(scenario.get("support") or [])
    return paths


def recorded_stories(scenarios):
    recorded = {}
    for scenario in scenarios:
        source = STORY_SOURCE.match(scenario.get("source") or "")
        if source:
            recorded.setdefault(source.group(1), []).append(scenario["id"])
    return recorded


def story_blobs(root, slugs):
    if not slugs:
        return {}
    blobs = git(root, "hash-object", "--", *(os.path.join(STORIES, slug + ".md") for slug in slugs)).split()
    if len(blobs) != len(slugs):
        raise InputError("git hash-object printed %d blob ids for %d story files" % (len(blobs), len(slugs)))
    return dict(zip(slugs, blobs))


def story_offers(kind, reasons, citations):
    return [{"key": "%s:%d" % (kind, n), "kind": kind, "stories": chunk,
             "reasons": {slug: reasons[slug] for slug in chunk}}
            for n, chunk in enumerate(planning_groups(reasons, citations, GROUP_SIZE), 1)]


# @story: grow-test-coverage-a-part-at-a-time
# @decision: scenario-list-decided-once
# @decision: legacy-suites-sorted-automatically
def offer_groups(root, kinds):
    state = read_state(root)
    folders = project_folders(root)
    catalog = review.story_slugs(root)
    recorded = recorded_stories(state["scenarios"])
    citations = story_citations(root, folders) if {"stale", "untested"} & set(kinds) else {}
    groups = []
    if "stale" in kinds:
        stale = {}
        planned = [slug for slug in catalog if slug in recorded or slug in state["stamps"]]
        for slug, blob in story_blobs(root, planned).items():
            stamp = state["stamps"].get(slug)
            if not stamp:
                stale[slug] = "recorded scenarios and no test stamp"
            elif stamp != blob:
                stale[slug] = "its file changed since its test stamp %s" % stamp
        groups += story_offers("stale", stale, citations)
    if "untested" in kinds:
        answered = {entry.get("story") for entry in state["unguarded"] if entry.get("story")}
        groups += story_offers("untested", {slug: "no recorded scenario" for slug in catalog
                                            if slug not in recorded and slug not in state["stamps"]
                                            and slug not in answered}, citations)
    if "legacy" in kinds:
        claimed = claimed_paths(state["scenarios"])
        by_folder = {}
        for path in sorted(review.test_paths(root, tree_files(root, folders))):
            if path not in claimed:
                by_folder.setdefault(os.path.dirname(path) or ".", []).append(path)
        groups += [{"key": "legacy:%s" % folder, "kind": "legacy", "folder": folder, "files": files}
                   for folder, files in sorted(by_folder.items())]
    if "runtime" in kinds:
        groups.append({"key": "runtime", "kind": "runtime",
                       "scenarios": sorted(s["id"] for s in state["scenarios"] if s.get("source") == "runtime")})
    return groups


def offer_line(group):
    if group["kind"] == "legacy":
        return "%d test files no scenario claims in %s" % (len(group["files"]), group["folder"])
    if group["kind"] == "runtime":
        return "the runtime scenarios, %d recorded" % len(group["scenarios"])
    return "%d %s stories" % (len(group["stories"]), group["kind"])


def cmd_offers(args, root):
    enabled = review.testing_enabled(root)
    if enabled != "on":
        raise InputError("%s sets testing.enabled to %s, and only on makes offers: under frozen a sprint plans only "
                         "the rewrites and retirements each changed story needs, and under off none; run /ok-setup "
                         "to turn testing on" % (CONFIG, enabled))
    kinds = testing_config(root, None)["offers"]
    record = {"offers": kinds, "groups": offer_groups(root, kinds)}
    if args.json:
        print(json.dumps(record, indent=2))
        return 0
    print("offers: %s" % (", ".join(kinds) or "none: testing.offers lists no kind"))
    if kinds and not record["groups"]:
        print("None: no story is stale or untested, no test file is unclaimed, and no runtime group is offered.")
    for group in record["groups"]:
        print()
        print("%s: %s" % (group["key"], offer_line(group)))
        for slug in group.get("stories") or []:
            print("  - %s: %s" % (slug, group["reasons"][slug]))
        for path in group.get("files") or []:
            print("  - %s" % path)
    return 0


def cmd_scenarios(args, root):
    state = read_state(root)
    if args.json:
        print(json.dumps(state, indent=2))
        return 0
    if not state["stamps"]:
        print("stamps: none")
    for slug, blob in sorted(state["stamps"].items()):
        print("stamp %s: %s" % (slug, blob))
    if not state["scenarios"]:
        print("None.")
    for scenario in state["scenarios"]:
        test = "gap" if scenario.get("gap") else locator(scenario.get("test")) or "-"
        print("- %s [%s]: %s Test: %s" % (scenario["id"], scenario.get("source"), scenario.get("text"), test))
    for entry in state["unguarded"]:
        print("- unguarded %s: %s" % (entry["path"], entry.get("reason")))
    return 0


def stamped_blobs(root, commit, slugs):
    paths = {os.path.join(STORIES, slug + ".md"): slug for slug in slugs}
    if not paths:
        return {}
    blobs = {}
    for entry in git(root, "ls-tree", "-z", commit, "--", *paths).split("\0"):
        if not entry:
            continue
        meta, path = entry.split("\t", 1)
        kind, blob = meta.split()[1:3]
        if kind == "blob" and path in paths:
            blobs[paths[path]] = blob
    return blobs


# @decision: scenario-list-decided-once
# @decision: whole-file-ownership
def cmd_convert_state(args, root):
    cleared = args.clear or []
    bad = [slug for slug in cleared if not SLUG.match(slug)]
    if bad:
        raise InputError("--clear takes story slugs, lowercase letters, digits, and hyphens: %s is none"
                         % ", ".join(map(repr, bad)))
    said = sys.stderr if args.dry_run else sys.stdout
    state = read_json(root, STATE, "only this tool writes it, so restore it from git")
    if state is None:
        print("none: %s does not exist, so nothing converts" % STATE, file=said)
        return 0
    if not isinstance(state, dict) or not isinstance(state.get("scenarios"), list):
        raise InputError("%s does not hold a scenario list" % STATE)
    if "stamp" not in state:
        print("current: %s holds no top-level stamp, so it is in the current form and nothing converts" % STATE,
              file=said)
        return 0
    stamp = state["stamp"]
    print("earlier: %s holds the top-level stamp %s, which converts to a test stamp per story"
          % (STATE, stamp or "null"), file=said)
    recorded = sorted(recorded_stories(state["scenarios"]))
    kept_out = [slug for slug in recorded if slug in set(cleared)]
    stamping = [slug for slug in recorded if slug not in kept_out]
    held = isinstance(stamp, str) and bool(SHA.match(stamp)) and stamp_held(root, stamp)
    blobs = stamped_blobs(root, stamp, stamping) if held else {}
    converted = {key: value for key, value in state.items() if key != "stamp"}
    converted.update(stamps=blobs, ranking=[], acceptances={}, reaches={})
    print("stamped: %d of %d stories with recorded scenarios%s" % (len(blobs), len(recorded),
                                                                   " at %s" % stamp if held else ""), file=said)
    if kept_out:
        print("cleared: %s" % ", ".join(kept_out), file=said)
    absent = [slug for slug in stamping if slug not in blobs]
    if absent and held:
        print("no stamp: %s: no story file at %s" % (", ".join(absent), stamp), file=said)
    elif absent:
        print("no stamp: %s: %s" % (", ".join(absent), "%s names no commit in this repository" % stamp
                                    if stamp else "the earlier form records no stamp commit"), file=said)
    if args.dry_run:
        sys.stdout.write(json_text(root, STATE, converted))
        return 0
    write_json(root, STATE, converted)
    print("converted: %s" % STATE)
    return 0


def declared_values(args):
    if args.timeout is not None:
        raise InputError("--timeout is refused: a run of the suite command has no time limit per test, and stops "
                         "after testing.silence seconds with no result; pass --silence <seconds>")
    values = {}
    if args.run is not None:
        refusal = suite_command_refusal(args.run) if is_command(args.run) else "is empty"
        if refusal:
            raise InputError("--run %s" % refusal)
        values["run"] = args.run
    for name in ("silence", "slowest", "setup_silence"):
        value = getattr(args, name)
        if value is not None and value < 1:
            raise InputError("--%s %d: it is a whole number, 1 or more" % (name, value))
        if value is not None:
            values[name] = value
    if args.named is not None:
        values["named"] = args.named == "yes"
    if args.leftovers is not None:
        if not is_command(args.leftovers):
            raise InputError("--leftovers is empty: name a command that prints one JSON object of counts, such as "
                             "`echo {}` where the project counts nothing")
        values["leftovers"] = args.leftovers
    if args.setup is not None:
        if not is_command(args.setup):
            raise InputError("--setup is empty: name the command that gets the test environment ready, or none where "
                             "the project needs no setup")
        values["setup"] = None if args.setup.strip() == "none" else args.setup
    if args.runners is not None:
        if not all(map(is_command, args.runners)):
            raise InputError("--runners holds an empty command")
        values["runners"] = list(args.runners)
    if args.enabled is not None:
        values["enabled"] = args.enabled
    if args.schedule is not None:
        if not is_command(args.schedule_said):
            raise InputError("--schedule-said is empty: give the owner's words for the schedule the suite command runs")
        values["schedule"] = {"form": args.schedule, "said": args.schedule_said}
    if args.reaches is not None:
        if not is_command(args.reaches_said):
            raise InputError("--reaches-said is empty: give the owner's words for what the suite command writes as "
                             "each test's reaches")
        values["reaches"] = {"form": args.reaches, "said": args.reaches_said}
    if args.offers is not None:
        if not offers_listed(args.offers):
            raise InputError("--offers %s: name each of %s at most once, or none for no standing offer"
                             % (" ".join(args.offers), ", ".join(OFFERS)))
        values["offers"] = list(args.offers)
    if not values:
        raise InputError("declare names no key: pass any of --enabled, --run, --silence, --named, --leftovers, "
                         "--slowest, --runners, --setup, --setup-silence, --schedule with --schedule-said, --reaches with "
                         "--reaches-said, and --offers")
    return values


def cmd_declare(args, root):
    values = declared_values(args)
    config = review.issues.tasks.project_config(root)
    testing = dict(config["testing"]) if isinstance(config.get("testing"), dict) else {}
    testing.pop("timeout", None)
    testing.update(values)
    config["testing"] = testing
    write_json(root, CONFIG, config)
    for key in TESTING_KEYS + ("setup_silence",):
        if key in values:
            print("declared: testing.%s = %s" % (key, json.dumps(values[key])))
    unset = [key for key in required_keys(testing) if key not in testing]
    if testing.get("setup") is not None and "setup_silence" not in testing:
        unset.append("setup_silence")
    if unset:
        print("still unset: %s" % ", ".join("testing.%s" % key for key in unset))
    return 0


# @decision: testing-set-up-by-its-own-verb
def cmd_enabled(args, root):
    print(review.testing_enabled(root))
    return 0


# @decision: testing-set-up-by-its-own-verb
# @decision: tests-isolated-unless-declared
def cmd_budget(args, root):
    if not review.stored_log(root, args.from_run):
        raise InputError("no budget run at %s: open it as /ok-setup says, file the budget task keyed budget, and "
                         "drain" % args.from_run)
    tasks = run_tasks(root, args.from_run)
    items = {"tasks": tasks, "done": latest_done(tasks, ("budget",)),
             "budget": run_items(root, args.from_run, "budget"), "limits": run_items(root, args.from_run, "limits")}
    origins = {}
    budget = planned_budget(items, origins)
    if budget is None:
        raise InputError("no budget task closed done on %s: file one keyed budget as /ok-setup says, and drain"
                         % args.from_run)
    failures = budget_failures(budget, origins)
    if failures:
        raise InputError("the budget does not hold:\n" + "\n".join("- %s" % failure for failure in failures))
    state = read_state(root)
    state["budget"] = budget
    write_json(root, STATE, state)
    print("written: the budget of %d workers into %s" % (budget["workers"], STATE))
    print_budget(budget)
    return 0


def resolved_sprint(root, path, exists=True):
    rel = os.path.relpath(os.path.abspath(path), root) if os.path.isabs(path) else os.path.normpath(path)
    if not rel.startswith((review.SPRINTS + os.sep, review.ARCHIVED_SPRINTS + os.sep)) or not rel.endswith(".md"):
        raise InputError("%s is not a sprint under %s/ or %s/" % (path, review.SPRINTS, review.ARCHIVED_SPRINTS))
    if exists and read_text(root, rel) is None:
        raise InputError("no sprint at %s" % rel)
    return rel


def sibling(sprint, suffix):
    return sprint[:-3] + suffix


def written_plan(root, sprint):
    return read_json(root, sibling(sprint, "-plan.json"), "`tests plan` writes it, so assemble it again")


def read_plan(root, sprint):
    plan = written_plan(root, sprint)
    if plan is None:
        raise InputError("no plan at %s: assemble it with `tests plan --sprint %s --from-run <run>`"
                         % (sibling(sprint, "-plan.json"), sprint))
    return plan


def sprint_plan(root, sprint):
    plan = written_plan(root, sprint)
    if plan is not None:
        return plan
    state = read_state(root)
    return {"scenarios": [], "legacy": [], "unguarded": list(state["unguarded"]), "folders": project_folders(root),
            "budget": state["budget"], "kept": list(state["kept"])}


def tasks_run(root, run, *args):
    done = subprocess.run([sys.executable, os.path.join(root, TASKS), "--file", run, *args], cwd=root,
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("tasks %s failed: %s" % (" ".join(args), (done.stderr or done.stdout).strip()))
    return done.stdout


def run_tasks(root, run):
    return [json.loads(line) for line in tasks_run(root, run, "dump", "--type", "task").split("\n") if line.strip()]


def run_items(root, run, pool):
    return json.loads(tasks_run(root, run, "item", "list", "--pool", pool, "--json"))


def field(item, name):
    return (item.get("fields") or {}).get(name)


def text_field(item, name):
    value = field(item, name)
    return None if value is None else str(value)


def list_field(item, name):
    value = field(item, name)
    if value is None:
        return []
    if isinstance(value, list):
        return [str(entry) for entry in value]
    return [str(value)]


def first_line(value):
    return (value or "").split("\n")[0]


def latest_done(tasks, roles):
    latest = {}
    for task in tasks:
        if task.get("role") in roles:
            latest[(task.get("role"), task.get("key"))] = task
    return {task["id"] for task in latest.values() if task.get("state") == "closed" and task.get("outcome") == "done"}


def test_of(item):
    path = text_field(item, "path")
    return {"path": path, "name": text_field(item, "name")} if path else None


def scenario_of(item):
    scenario = {"id": text_field(item, "id"), "source": text_field(item, "source"),
                "action": text_field(item, "action"), "text": item.get("body") or "",
                "test": test_of(item), "support": list_field(item, "support"),
                "reach": text_field(item, "reach"), "entry": text_field(item, "entry"),
                "call": text_field(item, "call")}
    for name in ("part", "class", "harm", "kind", "setup", "waits"):
        if field(item, name) is not None:
            scenario[name] = text_field(item, name)
    for name in ("resources", "reads"):
        if field(item, name) is not None:
            scenario[name] = field(item, name)
    return scenario


def apply_answer(scenario, answer, old):
    kind = text_field(answer, "answer")
    if kind == "retire":
        scenario["action"] = "retire"
    elif kind == "rewrite":
        scenario["action"] = "rewrite"
        if not scenario.get("test") and old.get("test"):
            scenario["test"] = dict(old["test"])
        if text_field(answer, "text"):
            scenario["text"] = text_field(answer, "text")
    elif kind == "issue":
        scenario["action"] = "keep"
        scenario["issue"] = text_field(answer, "issue")
    scenario["ruling"] = "%s: %s" % (kind, text_field(answer, "said") or "-")


def open_issue_ids(root):
    module = os.path.join(root, ISSUES)
    if not os.path.isfile(module):
        raise InputError("no intake module at %s: /ok materializes it" % ISSUES)
    done = subprocess.run([sys.executable, module, "list", "--json"], cwd=root, capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("issues list failed: %s" % (done.stderr or done.stdout).strip())
    return {record.get("id") for record in json.loads(done.stdout or "[]")}


def question_target(item):
    return text_field(item, "scenario") or text_field(item, "path")


def settled_questions(questions, selected):
    answered = {}
    for item in questions:
        if item["state"] == "answered":
            answered[question_target(item)] = item
    settled = []
    for item in selected:
        if item["state"] == "answered":
            settled.append(item)
        elif question_target(item) in answered:
            settled.append(dict(answered[question_target(item)], id=item["id"]))
        else:
            settled.append(item)
    return settled


def item_story(item, scenario_stories):
    if item.get("pool") == "scenarios":
        source = STORY_SOURCE.match(text_field(item, "source") or "")
        return source.group(1) if source else None
    if item.get("pool") == "questions":
        return scenario_stories.get((item.get("task"), text_field(item, "scenario")))
    return text_field(item, "story")


# @decision: scenario-list-decided-once
def planning_items(root, run):
    tasks = run_tasks(root, run)
    done = latest_done(tasks, PLAN_ROLES)
    order = {task["id"]: task_order(task) for task in tasks}
    story_tasks = {task["id"] for task in tasks if task["id"] in done and task.get("role") == "story"}
    owners = {}
    for item in run_items(root, run, "stories"):
        slug = text_field(item, "story") or item.get("key")
        if item.get("task") in story_tasks and slug and order[item["task"]] >= order.get(owners.get(slug), -1):
            owners[slug] = item["task"]
    pools = {pool: run_items(root, run, pool)
             for pool in ("scenarios", "questions", "legacy", "calls", "budget", "limits", "controls")}
    scenario_stories = {(item.get("task"), text_field(item, "id")): item_story(item, {})
                        for item in pools["scenarios"] if item.get("task") in story_tasks}

    def stands(item):
        if item.get("task") not in done:
            return False
        story = item_story(item, scenario_stories) if item.get("task") in story_tasks else None
        return story is None or owners.get(story) == item.get("task")

    selected = {pool: [item for item in items if stands(item)] for pool, items in pools.items()}
    selected["settled"] = settled_questions(pools["questions"], selected["questions"])
    selected.update(tasks=tasks, done=done, stories=owners)
    return selected


def item_origin(item):
    return (item["id"], item.get("task"))


def origin_text(origin):
    item, task = origin
    return "%s (task %s)" % (item, task) if item else "task %s" % task


def rested(origins, keys, text):
    found = [origin_text(origins[key]) for key in keys if key in origins]
    return "%s: %s" % (", ".join(found), text) if found else text


def project_relative(root, path):
    return os.path.normpath(os.path.relpath(path, root) if os.path.isabs(path) else path)


def kept_uses(scenarios, old_by_id):
    kept = []
    for scenario in scenarios:
        if scenario["action"] not in KEPT:
            continue
        old = old_by_id.get(scenario["id"]) or {}
        support = set(scenario.get("support") or [])
        if scenario["action"] == "keep":
            support |= set(old.get("support") or [])
        kept.append((scenario["id"], scenario.get("test") or old.get("test"),
                     {os.path.normpath(path) for path in support}))
    return kept


def reads(user, test):
    path, _, name = user.partition("::")
    if not test or os.path.normpath(path) != os.path.normpath(test["path"]):
        return False
    return not name or not test.get("name") or name == test["name"]


# @story: retire-a-legacy-suite
# @decision: legacy-suites-sorted-automatically
def sorted_support(legacy, kept):
    for entry in legacy:
        if entry["sort"] != "support":
            continue
        path = os.path.normpath(entry["path"]) if entry["path"] else None
        entry["scenarios"] = sorted(sid for sid, test, support in kept
                                    if path in support or any(reads(user, test) for user in entry["users"]))
        if entry["users"] and not entry["scenarios"]:
            entry.update(sort="delete", reason="orphan", note="no kept test uses it")


def story_citations(root, folders):
    cited = {}
    for rel in tree_files(root, folders):
        if rel.startswith(ESTATE + os.sep):
            continue
        try:
            with open(os.path.join(root, rel), encoding="utf-8") as f:
                slugs = set(STORY_CITATION.findall(f.read()))
        except UnicodeDecodeError:
            continue
        if slugs:
            cited[rel] = slugs
    return cited


# @decision: scenario-list-decided-once
def touched_stories(replan, taken, new, widen):
    touches = [(slug, "behavior") for slug in replan]
    touches += [(slug, group["kind"]) for group in taken for slug in group.get("stories") or []]
    touches += [(slug, "new") for slug in new] + [(slug, "widen") for slug in widen]
    touched = {}
    for slug, reason in touches:
        reasons = touched.setdefault(slug, [])
        if reason not in reasons:
            reasons.append(reason)
    return touched


def new_stories(root, sprint, slugs):
    if not slugs:
        return []
    text = read_text(root, sprint)
    if text is None:
        raise InputError("no sprint at %s: --new names stories its ## Corpus deltas add" % sprint)
    deltas, _ = review.sprint_deltas(text.split("\n"))
    added = {slug for operation, kind, slug, _, _ in deltas if operation == "New" and kind == "story"}
    missing = sorted(set(slugs) - added)
    if missing:
        raise InputError("--new %s: %s holds no ### New story: <slug> delta for each; name only the stories the "
                         "sprint's deltas add, and each tested story it changes with --replan"
                         % (", ".join(missing), sprint))
    return sorted(set(slugs))


def taken_offers(keys, offered):
    by_key = {group["key"]: group for group in offered}
    unknown = sorted(set(keys) - set(by_key))
    if unknown:
        raise InputError("--take %s: no offer group `tests offers` prints holds that key; the keys are %s"
                         % (", ".join(unknown), ", ".join(by_key) or "none"))
    return [by_key[key] for key in sorted(set(keys), key=list(by_key).index)]


def archived_plans(root):
    found = []
    for archive in ARCHIVED_PLAN_FOLDERS:
        folder = os.path.join(root, archive)
        for name in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
            sprint = os.path.join(archive, name)
            if not name.endswith(".md") or read_text(root, sibling(sprint, "-plan.json")) is None:
                continue
            stamp = review.closed_stamp(read_text(root, sprint) or "")
            if stamp:
                found.append({"sprint": sprint, "plan": sibling(sprint, "-plan.json"), "stamp": stamp,
                              "held": stamp_held(root, stamp)})

    def newer_first(a, b):
        if a["held"] and b["held"] and a["stamp"] != b["stamp"]:
            if review.is_ancestor(root, a["stamp"], b["stamp"]):
                return 1
            if review.is_ancestor(root, b["stamp"], a["stamp"]):
                return -1
        a_name, b_name = os.path.basename(a["sprint"]), os.path.basename(b["sprint"])
        return (a_name < b_name) - (a_name > b_name)

    return sorted(found, key=functools.cmp_to_key(newer_first))


def call_of_story(call, slug):
    if call.get("story"):
        return call["story"] == slug
    return any(value == slug or value.startswith(slug + "--")
               for value in (call.get("site"), call.get("key")) if isinstance(value, str))


# @decision: scenario-list-decided-once
def earlier_calls(root, slugs):
    plans = []
    for found in archived_plans(root):
        plan = read_json(root, found["plan"], "an archived plan is read as `tests plan` wrote it")
        if not isinstance(plan, dict) or not isinstance(plan.get("calls", []), list) \
                or not isinstance(plan.get("stories"), (list, type(None))):
            raise InputError("%s does not hold a plan: its calls and its stories are lists where present" % found["plan"])
        plans.append((found["plan"], plan))
    earlier = {}
    for slug in slugs:
        latest = next(((rel, plan) for rel, plan in plans if plan.get("stories") is None or slug in plan["stories"]),
                      None)
        if latest is None:
            earlier[slug] = {"plan": None, "calls": []}
            continue
        calls = [call for call in latest[1].get("calls") or [] if isinstance(call, dict)]
        kinded = any(call.get("kind") for call in calls)
        earlier[slug] = {"plan": latest[0], "calls": [
            {name: call.get(name) for name in ("key", "site", "kind", "story", "choice", "body")}
            for call in calls if call_of_story(call, slug) and (call.get("kind") == "untested" or not kinded)]}
    return earlier


def unknown_stories(root, slugs):
    known = set(review.story_slugs(root))
    unknown = [slug for slug in slugs if slug not in known]
    if unknown:
        raise InputError("no story at %s/<slug>.md for %s: name each story by the slug of its file"
                         % (STORIES, ", ".join(unknown)))


def cmd_calls(args, root):
    unknown_stories(root, args.stories)
    earlier = earlier_calls(root, args.stories)
    if args.json:
        print(json.dumps(earlier, indent=2))
        return 0
    for slug in args.stories:
        entry = earlier[slug]
        if not entry["plan"]:
            print("%s: no archived plan planned it" % slug)
            continue
        print("%s: planned last by %s; %d calls left a path out" % (slug, entry["plan"], len(entry["calls"])))
        for call in entry["calls"]:
            print("  - %s, %s" % (call["kind"] or "no kind", call_line(call)))
            for line in call["body"].split("\n") if call["body"] else []:
                print("    %s" % line if line else "")
    return 0


def planning_groups(touched, citations, size):
    joined = {slug: {slug} for slug in touched}
    for cited in citations.values():
        together = set().union(*(joined[slug] for slug in cited if slug in joined))
        for slug in together:
            joined[slug] = together
    components = {tuple(sorted(members)) for members in joined.values()}
    chunks = [list(members[i:i + size]) for members in components if len(members) > 1
              for i in range(0, len(members), size)]
    alone = sorted(members[0] for members in components if len(members) == 1)
    chunks += [alone[i:i + size] for i in range(0, len(alone), size)]
    return sorted(chunks, key=lambda chunk: chunk[0])


def planning_inputs(questions):
    answers = []
    for item in questions:
        if item["state"] != "answered" or text_field(item, "scenario") or not text_field(item, "path"):
            continue
        kind = text_field(item, "answer")
        if kind == "issue":
            answers.append("%s: issue %s" % (text_field(item, "path"), text_field(item, "issue") or "-"))
        elif kind == "no-guard":
            answers.append("%s: no-guard, %s" % (text_field(item, "path"),
                                                 text_field(item, "reason") or text_field(item, "said") or "-"))
        else:
            answers.append("%s: %s" % (text_field(item, "path"), kind))
    return "program answers: %s" % ("; ".join(sorted(answers)) or "none")


def group_brief(stories, touched, inputs, last_run, frozen):
    named = ", ".join("%s (%s)" % (slug, "; ".join(touched[slug])) for slug in stories)
    held = "; frozen: testing.enabled is frozen, so plan no new scenario" if frozen else ""
    return "stories: %s; %s; the last run is at %s%s" % (named, inputs, last_run or "none", held)


# @story: grow-test-coverage-a-part-at-a-time
# @decision: scenario-list-decided-once
# @decision: legacy-suites-sorted-automatically
def cmd_groups(args, root):
    sprint = resolved_sprint(root, args.sprint, exists=False)
    if args.size < 1:
        raise InputError("--size %d: a group holds at least one story" % args.size)
    testing = testing_config(root, sprint)
    if args.frozen != (testing["enabled"] == "frozen"):
        raise InputError("%s sets testing.enabled to %s: pass --frozen exactly where it is frozen"
                         % (CONFIG, testing["enabled"]))
    replan = sorted(set(args.replan or []))
    unknown_stories(root, replan + (args.widen or []))
    new = new_stories(root, sprint, args.new or [])
    if not review.stored_log(root, args.from_run):
        raise InputError("no planning run at %s: open it as /plan-sprint's test planning says" % args.from_run)
    settled = planning_items(root, args.from_run)["settled"]
    waiting = [item for item in settled if item["state"] != "answered" and not text_field(item, "scenario")]
    if waiting:
        raise InputError("program questions stand unanswered: %s; ask the owner each one, record the answer, and "
                         "run tests groups again" % ", ".join("%s on %s" % (origin_text(item_origin(item)),
                                                                         question_target(item)) for item in waiting))
    folders = project_folders(root)
    citations = story_citations(root, folders)
    widen = sorted(set(args.widen or []))
    if args.widen == []:
        catalog = review.story_slugs(root)
        earlier = earlier_calls(root, catalog)
        widen = [slug for slug in catalog if earlier[slug]["calls"]]
    kinds = testing["offers"] or []
    offered = offer_groups(root, sorted(set(kinds) | {"legacy"}))
    taken = taken_offers(args.take or [], [group for group in offered if group["kind"] in kinds])
    touched = touched_stories(replan, taken, new, widen)
    sort = sorted(path for group in taken if group["kind"] == "legacy" for path in group["files"])
    kept = sorted(path for group in offered if group["kind"] == "legacy" for path in group["files"] if path not in sort)
    results = sibling(sprint, "-planning-results.json")
    last_run = results if read_text(root, results) is not None else None
    inputs = planning_inputs(settled)
    groups = [{"key": "group:%d" % n, "stories": chunk,
               "brief": group_brief(chunk, touched, inputs, last_run, args.frozen)}
              for n, chunk in enumerate(planning_groups(touched, citations, args.size), 1)]
    record = {"frozen": args.frozen, "taken": [group["key"] for group in taken], "replan": replan, "new": new,
              "widen": widen, "runtime": any(group["kind"] == "runtime" for group in taken), "size": args.size,
              "inputs": inputs, "last_run": last_run, "stories": {slug: touched[slug] for slug in sorted(touched)},
              "groups": groups, "sort": sort, "kept": kept}
    write_json(root, sibling(sprint, "-groups.json"), record)
    if args.json:
        print(json.dumps(record, indent=2))
        return 0
    print("written: %s" % sibling(sprint, "-groups.json"))
    print("%d stories touched in %d groups; runtime planner: %s; frozen: %s"
          % (len(touched), len(groups), "yes" if record["runtime"] else "no", "yes" if args.frozen else "no"))
    print("taken: %s" % (", ".join(record["taken"]) or "none"))
    if args.widen is not None:
        print("widen: %s" % (", ".join(widen) or "none: no earlier plan's call left a path out of a story"))
    unguarded = [item for item in settled
                 if not text_field(item, "scenario") and text_field(item, "answer") == "no-guard"]
    if not touched and not sort and not record["runtime"] and not unguarded:
        print("nothing to plan: no story is re-planned, taken, new, or widened, no legacy folder or runtime "
              "group is taken, and no program is answered no-guard")
    print("inputs: %s" % inputs)
    print("last run: %s" % (last_run or "none"))
    for group in groups:
        print()
        print(group["key"])
        for slug in group["stories"]:
            print("  - %s: %s" % (slug, "; ".join(touched[slug])))
        print("  brief: %s" % group["brief"])
    print()
    print("sort: %d test files in the taken legacy folders" % len(sort))
    for path in sort:
        print("  - %s" % path)
    print("kept: %d test files no scenario claims outside the taken folders, left as they stand" % len(kept))
    for path in kept:
        print("  - %s" % path)
    return 0


def read_groups(root, sprint):
    rel = sibling(sprint, "-groups.json")
    groups = read_json(root, rel, "`tests groups` writes it, so write it again")
    if groups is None:
        raise InputError("no planning groups at %s: write them with `tests groups --sprint %s --from-run <run>`"
                         % (rel, sprint))
    if not isinstance(groups, dict) or not isinstance(groups.get("stories"), dict) \
            or not isinstance(groups.get("groups"), list) \
            or not all(isinstance(groups.get(name), list) and all(isinstance(path, str) for path in groups[name])
                       for name in ("sort", "kept", "new")):
        raise InputError("%s does not hold planning groups: write them again with `tests groups`" % rel)
    return groups


def unplanned_story(slug, groups, tasks):
    key = next((group.get("key") for group in groups["groups"] if slug in (group.get("stories") or [])), None)
    filed = [task["id"] for task in sorted(tasks, key=task_order) if task.get("role") == "story" and task.get("key") == key]
    return "story %s (%s)" % (slug, ", ".join([key or "no group"] + (["task %s" % filed[-1]] if filed else [])))


# @decision: tests-isolated-unless-declared
def planned_budget(items, origins):
    budget_tasks = sorted((task for task in items["tasks"] if task.get("role") == "budget" and task["id"] in items["done"]),
                          key=task_order)
    if not budget_tasks:
        return None
    latest = budget_tasks[-1]["id"]
    recorded = [item for item in items["budget"] if item.get("task") == latest]
    if len(recorded) != 1:
        raise InputError("budget task %s records %d budget items, and a plan takes one: %s" % (
            latest, len(recorded), "refile it with `tasks refile %s`" % latest if not recorded else
            "drop the others with `tasks item drop <item> --by plan-sprint --reason \"<why>\"`, keeping one of %s"
            % ", ".join(item["id"] for item in recorded)))
    item = recorded[0]
    origins[("budget",)] = item_origin(item)
    limits = []
    for limit in items["limits"]:
        if limit.get("task") != latest:
            continue
        origins[("limit", len(limits))] = item_origin(limit)
        limits.append({"limit": text_field(limit, "limit"), "how": text_field(limit, "how"),
                       "detail": text_field(limit, "detail"), "tests": first_line(limit.get("body"))})
    return {"workers": field(item, "workers"), "stack": text_field(item, "stack"), "sizing": text_field(item, "sizing"),
            "files": field(item, "files") if field(item, "files") is not None else [],
            "said": first_line(item.get("body")), "limits": limits}


def waited_control(scenario):
    found = WAITS.match(scenario.get("waits") or "")
    return found.group(2).strip() if found and found.group(1) == "control" else None


# @decision: planned-tests-name-their-waits
def planned_controls(items, origins):
    controls, problems = {}, []
    for item in items["controls"]:
        cid = text_field(item, "id")
        if not cid:
            problems.append("%s: a time control item records no id field" % origin_text(item_origin(item)))
            continue
        control = {"id": cid, "form": text_field(item, "form"), "site": text_field(item, "site"),
                   "files": field(item, "files"), "gate": text_field(item, "gate")}
        first = controls.get(cid)
        if first is None:
            controls[cid] = dict(control, text=item.get("body") or "")
            origins[("control", cid)] = item_origin(item)
        elif {name: first[name] for name in control} != control:
            problems.append("%s and %s: time control %s is recorded with different fields; every planner that names "
                            "one control records its form, site, files, and gate alike"
                            % (origin_text(origins[("control", cid)]), origin_text(item_origin(item)), cid))
    return sorted(controls.values(), key=lambda control: control["id"]), problems


# @decision: every-timer-has-a-time-control
# @decision: planned-tests-name-their-waits
def control_failures(plan, origins):
    failures = []
    ids = {control["id"] for control in plan.get("controls") or []}
    for scenario in plan["scenarios"]:
        sid, here, waits = scenario["id"], [("scenario", scenario["id"])], scenario.get("waits")
        if scenario["action"] in ("new", "rewrite") and not waits:
            failures.append(rested(origins, here, "scenario %s: %s names no waits, what its test waits on: %s"
                                   % (sid, scenario["action"], WAIT_KINDS)))
        elif waits and not WAITS.match(waits):
            failures.append(rested(origins, here, "scenario %s: waits %r is none of %s" % (sid, waits, WAIT_KINDS)))
        elif scenario["action"] in ("new", "rewrite") and (waited_control(scenario) or "").startswith(CONTROL_PREFIX) \
                and waited_control(scenario) not in ids:
            failures.append(rested(origins, here, "scenario %s: it waits on time control %s, which no time control "
                                   "item records" % (sid, waited_control(scenario))))
    for control in plan.get("controls") or []:
        cid, here = control["id"], [("control", control["id"])]
        if not CONTROL_ID.match(cid):
            failures.append(rested(origins, here, "time control %r: its id is control--<slug>, lower-case letters, "
                                   "digits, and hyphens" % cid))
        if control["form"] not in CONTROL_FORMS:
            failures.append(rested(origins, here, "time control %s: form %r is not one of %s"
                                   % (cid, control["form"], ", ".join(CONTROL_FORMS))))
        if not (control["site"] or "").strip():
            failures.append(rested(origins, here, "time control %s: it names no site, the path::symbol of its timer" % cid))
        files = control["files"]
        if not isinstance(files, list) or not files or not all(isinstance(path, str) and path.strip() for path in files):
            failures.append(rested(origins, here, "time control %s: files %s is not a list of the files it changes, "
                                   "the deployment configurations that carry its setting included"
                                   % (cid, json.dumps(files))))
        if control["form"] in GATED_FORMS and not (control["gate"] or "").strip():
            failures.append(rested(origins, here, "time control %s: a %s forces an event or moves the product's "
                                   "time, so it names its gate setting" % (cid, control["form"])))
        if control["form"] == "setting" and control["gate"]:
            failures.append(rested(origins, here, "time control %s: an exposed setting has no gate, and it names %r"
                                   % (cid, control["gate"])))
        if not control.get("scenarios"):
            failures.append(rested(origins, here, "time control %s: no planned scenario waits on it" % cid))
    return failures


# @decision: legacy-suites-sorted-automatically
# @decision: testing-runs-inside-the-sprint
def assembled_plan(root, run, sprint, frozen):
    groups = read_groups(root, sprint)
    items = planning_items(root, run)
    tasks, done = items["tasks"], items["done"]
    touched = groups["stories"]
    unplanned = sorted(slug for slug in touched if slug not in items["stories"])
    if unplanned:
        raise InputError("touched stories no done story task records a stories item for: %s; re-plan each one alone "
                         "in a story task keyed story:<slug>"
                         % ", ".join(unplanned_story(slug, groups, tasks) for slug in unplanned))
    runtime_ran = bool(groups.get("runtime"))
    if runtime_ran and not any(task.get("role") == "runtime" and task["id"] in done for task in tasks):
        raise InputError("the groups plan the runtime scenarios, and no runtime task closed done: file one, or "
                         "refile it, and drain")
    origins = {("story", slug): (None, task) for slug, task in items["stories"].items()}
    scenario_items = items["scenarios"]
    nameless = [item for item in scenario_items if not text_field(item, "id")]
    if nameless:
        raise InputError("scenario items with no id field: %s"
                         % ", ".join(origin_text(item_origin(item)) for item in nameless))
    scenarios = [scenario_of(item) for item in scenario_items]
    for item in items["questions"]:
        origins[("question", item["id"])] = item_origin(item)
    aimless = [item for item in items["questions"] if not question_target(item)]
    if aimless:
        raise InputError("questions with no scenario or path field: %s"
                         % ", ".join(origin_text(item_origin(item)) for item in aimless))
    questions = items["settled"]
    legacy = []
    for item in items["legacy"]:
        entry = {"path": text_field(item, "path"), "name": text_field(item, "name"), "sort": text_field(item, "sort"),
                 "scenario": text_field(item, "scenario"), "reason": text_field(item, "reason"),
                 "rule": text_field(item, "rule"), "inferred": text_field(item, "inferred"),
                 "check": text_field(item, "check"),
                 "scenarios": list_field(item, "scenarios"), "users": list_field(item, "users"),
                 "note": first_line(item.get("body"))}
        legacy.append(entry)
        origins[("legacy", entry["path"], entry["name"])] = item_origin(item)
    calls = []
    for item in items["calls"]:
        origins[("call", len(calls))] = item_origin(item)
        calls.append({"key": item.get("key"), "site": text_field(item, "site"), "kind": text_field(item, "kind"),
                      "story": text_field(item, "story"), "choice": text_field(item, "choice"),
                      "body": item.get("body")})
    unanswered = [item for item in questions if item["state"] != "answered"]
    if unanswered:
        raise InputError("%d questions stand unanswered: %s" % (len(unanswered), ", ".join(
            "%s on %s" % (origin_text(origins[("question", item["id"])]), question_target(item)) for item in unanswered)))
    by_id = {}
    for item, scenario in zip(scenario_items, scenarios):
        if scenario["id"] in by_id:
            raise InputError("scenario %s is planned twice: %s and %s" % (
                scenario["id"], origin_text(origins[("scenario", scenario["id"])]), origin_text(item_origin(item))))
        by_id[scenario["id"]] = scenario
        origins[("scenario", scenario["id"])] = item_origin(item)
    state = read_state(root)
    old_by_id = {s["id"]: s for s in state["scenarios"]}
    stories = set(review.story_slugs(root))
    for old in state["scenarios"]:
        source = STORY_SOURCE.match(old.get("source") or "")
        if old["id"] not in by_id and source and source.group(1) not in stories:
            by_id[old["id"]] = dict(old, action="retire", support=list(old.get("support") or []),
                                    ruling="the rules: its story %s is retired" % source.group(1))
    standing = {}
    for old in state["scenarios"]:
        source = STORY_SOURCE.match(old.get("source") or "")
        if old["id"] in by_id:
            continue
        if source and source.group(1) not in touched and source.group(1) not in items["stories"]:
            standing[old["id"]] = "the rules: its story was not touched"
        elif source and touched.get(source.group(1)) == ["widen"]:
            standing[old["id"]] = "the rules: a widen run keeps it as recorded"
        elif old.get("source") == "runtime" and not runtime_ran:
            standing[old["id"]] = "the rules: no runtime planner ran"
    for sid, ruling in standing.items():
        recorded = {name: value for name, value in old_by_id[sid].items() if name != "issue"}
        by_id[sid] = dict(recorded, action="keep", support=list(recorded.get("support") or []), ruling=ruling)
    whole_file = not testing_config(root, sprint)["named"]
    adopted_test = lambda entry: {"path": entry["path"], "name": None if whole_file else entry["name"]}
    adopted = {}
    for entry in sorted(legacy, key=lambda e: (e["path"] or "", e["name"] or "")):
        if entry["sort"] != "adopt":
            continue
        first = adopted.get(entry["scenario"])
        if first and whole_file and first["path"] == entry["path"]:
            continue
        if first:
            entry.update(sort="delete", reason="duplicate",
                         note="%s already adopts %s" % (locator(first), entry["scenario"]))
            continue
        adopted[entry["scenario"]] = adopted_test(entry)
        target = by_id.get(entry["scenario"])
        if target and (target["action"] == "new" or (target["id"] in standing and target.get("gap"))):
            for name in ("gap", "ruling"):
                target.pop(name, None)
            target.update(action="adopt", test=adopted_test(entry), reach=None,
                          call="a legacy test already checks it: %s" % locator(adopted_test(entry)))
    for scenario in by_id.values():
        if whole_file and scenario["action"] == "adopt" and scenario.get("test"):
            scenario["test"] = dict(scenario["test"], name=None)
    still_open = open_issue_ids(root)
    for scenario in by_id.values():
        carried = (old_by_id.get(scenario["id"]) or {}).get("issue")
        if scenario["action"] == "keep" and carried in still_open and not scenario.get("issue"):
            scenario["issue"] = carried
            scenario["ruling"] = "the rules: it fails until issue %s is settled" % carried
    planner_written = {sid for sid, scenario in by_id.items() if scenario["action"] in ("new", "rewrite")}
    unguarded = [dict(entry) for entry in state["unguarded"]]
    for answer in questions:
        kind = text_field(answer, "answer")
        asked = origin_text(origins[("question", answer["id"])])
        if kind not in ANSWERS:
            raise InputError("question %s carries answer %r; the answers are %s" % (asked, kind, ", ".join(ANSWERS)))
        target = text_field(answer, "scenario")
        if target:
            if target not in by_id:
                raise InputError("question %s answers scenario %s, which no planner planned" % (asked, target))
            if kind == "no-guard":
                raise InputError("question %s answers scenario %s with no-guard, which answers a program" % (asked, target))
            apply_answer(by_id[target], answer, old_by_id.get(target) or {})
        elif kind == "no-guard":
            unguarded.append({"path": text_field(answer, "path"), "reason": text_field(answer, "reason")
                              or text_field(answer, "said")})
    sorted_support(legacy, kept_uses(by_id.values(), old_by_id))
    budget = planned_budget(items, origins)
    budget_problems = budget_failures(budget, origins) if budget is not None else []
    if budget is None:
        budget = state["budget"]
    controls, control_problems = planned_controls(items, origins)
    for control in controls:
        control["scenarios"] = sorted(sid for sid, scenario in by_id.items()
                                      if scenario["action"] not in ("retire", "gap") and waited_control(scenario) == control["id"])
    claimed = claimed_paths(scenario for scenario in by_id.values() if scenario["action"] in KEPT)
    plan = {"commit": git(root, "rev-parse", "HEAD").strip(), "scenarios": sorted(by_id.values(), key=lambda s: s["id"]),
            "legacy": sorted(legacy, key=lambda e: (e["path"] or "", e["name"] or "")),
            "unguarded": sorted(unguarded, key=lambda e: e["path"] or ""), "calls": calls,
            "folders": project_folders(root), "stories": sorted(items["stories"]), "budget": budget,
            "controls": controls, "kept": sorted(path for path in groups["kept"] if path not in claimed)}
    failures = control_problems + budget_problems + plan_failures(root, sprint, plan, state, origins, planner_written,
                                                                  runtime_ran, frozen)
    if failures:
        raise InputError("the plan does not hold:\n" + "\n".join("- %s" % failure for failure in failures))
    return plan


def slug_list(value):
    return isinstance(value, list) and all(isinstance(entry, str) and SLUG.match(entry) for entry in value)


def whole_count(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


# @decision: tests-isolated-unless-declared
def budget_failures(budget, origins):
    here = [("budget",)]
    failures = []
    if not whole_count(budget["workers"]):
        failures.append(rested(origins, here, "budget: workers %s is not a whole number, 1 or more"
                               % json.dumps(budget["workers"])))
    for name, what in (("stack", "the command that starts the test stack, or none"),
                       ("sizing", "each configuration file and the values it gives for that many workers")):
        if not (budget[name] or "").strip():
            failures.append(rested(origins, here, "budget: it names no %s, %s" % (name, what)))
    if not isinstance(budget["files"], list) or not all(isinstance(path, str) and path.strip() for path in budget["files"]):
        failures.append(rested(origins, here, "budget: files %s is not a list of the configuration files the "
                               "preflight may edit" % json.dumps(budget["files"])))
    for index, limit in enumerate(budget["limits"]):
        where = [("limit", index)]
        if not (limit["limit"] or "").strip():
            failures.append(rested(origins, where, "limit: it names no deployment-wide limit"))
        if limit["how"] not in LIMIT_HANDLINGS:
            failures.append(rested(origins, where, "limit %s: how %r is not one of %s"
                                   % (limit["limit"] or "-", limit["how"], ", ".join(LIMIT_HANDLINGS))))
        if not (limit["detail"] or "").strip():
            failures.append(rested(origins, where, "limit %s: it says nowhere how the test stack's configuration "
                                   "raises it, how the workers split it, or what hands out its lease"
                                   % (limit["limit"] or "-")))
    return failures


# @decision: scenario-list-decided-once
# @decision: legacy-suites-sorted-automatically
# @decision: testing-runs-inside-the-sprint
def plan_failures(root, sprint, plan, state, origins, planner_written, runtime_ran, frozen):
    failures = []
    left_unguarded = {project_relative(root, entry["path"]) for entry in plan["unguarded"] if entry.get("path")}
    testing = testing_config(root, sprint)
    groups = read_groups(root, sprint)
    stories = set(review.story_slugs(root)) | set(groups["new"])
    taken_files = set(groups["sort"])
    old = {scenario["id"]: scenario for scenario in state["scenarios"]}
    seen_tests = {}
    planned = {scenario["id"]: scenario for scenario in plan["scenarios"]}
    kept_support = {}
    for sid, _, support in kept_uses(plan["scenarios"], old):
        for path in support:
            kept_support.setdefault(path, set()).add(sid)
    for scenario in plan["scenarios"]:
        sid, action = scenario["id"], scenario["action"]
        here = [("scenario", sid)]
        if not sid or not SLUG.match(sid):
            failures.append(rested(origins, here, "scenario id %r is not a slug: lower-case letters, digits, and hyphens" % sid))
            continue
        if action not in ACTIONS:
            failures.append(rested(origins, here, "scenario %s: action %r is not one of %s" % (sid, action, ", ".join(ACTIONS))))
            continue
        source = scenario.get("source") or ""
        story = STORY_SOURCE.match(source)
        if action != "retire":
            if story and story.group(1) not in stories:
                failures.append(rested(origins, here, "scenario %s: its story %s does not exist" % (sid, story.group(1))))
            elif not story and source != "runtime":
                failures.append(rested(origins, here, "scenario %s: source %r is neither story:<slug> nor runtime" % (sid, source)))
            elif source == "runtime" and not all(scenario.get(name) for name in ("part", "class", "harm")):
                failures.append(rested(origins, here, "scenario %s: a runtime scenario names its part, class, and harm" % sid))
            elif source == "runtime" and not ACCEPT_ENTRY.match(scenario.get("harm") or ""):
                failures.append(rested(origins, here, "scenario %s: harm %r is not an accept-list entry, A1 to A9"
                                       % (sid, scenario.get("harm"))))
        if action in ("keep", "rewrite", "retire") and sid not in old:
            failures.append(rested(origins, here, "scenario %s: %s names a scenario the stamp did not record" % (sid, action)))
        if action in ("new", "adopt") and sid in old and not old[sid].get("gap"):
            failures.append(rested(origins, here, "scenario %s: %s names a scenario the stamp already recorded with a test"
                                   % (sid, action)))
        test = scenario.get("test") or (old.get(sid) or {}).get("test")
        if action in ("new", "rewrite", "adopt") and not scenario.get("test"):
            failures.append(rested(origins, here, "scenario %s: %s names no test path" % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("reach"):
            failures.append(rested(origins, here, "scenario %s: %s says nowhere how its test reaches the code" % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("entry"):
            failures.append(rested(origins, here, "scenario %s: %s names no entry, the program its test reaches"
                                   % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("kind"):
            failures.append(rested(origins, here, "scenario %s: %s names no kind, the kind of test it is, such as unit, "
                                   "cli, browser, or stack" % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("setup"):
            failures.append(rested(origins, here, "scenario %s: %s names no setup, what its test needs in place before "
                                   "it runs" % (sid, action)))
        if action == "new" and frozen:
            failures.append(rested(origins, here, "scenario %s: new, and testing.enabled is frozen, so the plan adds no "
                                   "scenario; plan it as a call of kind untested that names the outcome" % sid))
        if action in ("new", "rewrite") and sid in planner_written and scenario.get("entry") \
                and project_relative(root, scenario["entry"]) in left_unguarded:
            failures.append(rested(origins, here, "scenario %s: its entry %s is a program the owner left unguarded"
                                   % (sid, scenario["entry"])))
        if action == "gap" and scenario.get("test"):
            failures.append(rested(origins, here, "scenario %s: a gap has no test" % sid))
        if "resources" in scenario and not slug_list(scenario["resources"]):
            failures.append(rested(origins, here, "scenario %s: resources %s is not a list of slugs, each a shared "
                                   "resource its test changes, [] for an isolated test"
                                   % (sid, json.dumps(scenario["resources"]))))
        if "reads" in scenario and not slug_list(scenario["reads"]):
            failures.append(rested(origins, here, "scenario %s: reads %s is not a list of slugs, each a shared "
                                   "resource its test reads and does not change, [] for a test that reads none"
                                   % (sid, json.dumps(scenario["reads"]))))
        if action not in ("retire", "gap") and test:
            if testing["named"] and not test.get("name"):
                failures.append(rested(origins, here, "scenario %s: testing.named is true, and test %s names none"
                                       % (sid, test["path"])))
            key = locator(test)
            if key in seen_tests:
                failures.append(rested(origins, [("scenario", seen_tests[key])] + here,
                                       "scenarios %s and %s share the test %s" % (seen_tests[key], sid, key)))
            seen_tests[key] = sid
        if action == "keep" and not test and not (old.get(sid) or {}).get("gap"):
            failures.append(rested(origins, here, "scenario %s: keep names a scenario with no test; plan it new or as a gap" % sid))
    planned_stories = plan.get("stories")
    for sid in old:
        if sid not in planned:
            story = STORY_SOURCE.match(old[sid].get("source") or "")
            if story and planned_stories is not None and story.group(1) not in planned_stories:
                continue
            if old[sid].get("source") == "runtime" and not runtime_ran:
                continue
            failures.append(rested(origins, [("story", story.group(1))] if story else [],
                                   "scenario %s: the stamp recorded it, and the plan says nothing of it" % sid))
    for entry in plan["legacy"]:
        where = locator(entry) or "-"
        here = [("legacy", entry["path"], entry["name"])]
        if not entry["path"]:
            failures.append(rested(origins, here, "legacy entry %r names no path" % entry["note"]))
        elif os.path.normpath(entry["path"]) not in taken_files:
            failures.append(rested(origins, here, "legacy %s: it lies outside the legacy folders the owner took, and the "
                                   "plan keeps it as it stands; drop the entry" % where))
        elif entry["sort"] not in SORTS:
            failures.append(rested(origins, here, "legacy %s: sort %r is not one of %s" % (where, entry["sort"], ", ".join(SORTS))))
        elif entry["sort"] == "adopt" and (planned.get(entry["scenario"]) or {}).get("action") != "adopt":
            failures.append(rested(origins, here, "legacy %s: adopted into %s, which the plan does not adopt"
                                   % (where, entry["scenario"])))
        elif entry["sort"] == "port" and not (entry["rule"] and entry["check"]):
            failures.append(rested(origins, here, "legacy %s: a port names the rule it enforces and the check it becomes" % where))
        elif entry["sort"] == "port" and entry["rule"] == INFERRED and not entry.get("inferred"):
            failures.append(rested(origins, here, "legacy %s: a port of an unwritten rule states the rule it infers in "
                                   "the inferred field" % where))
        elif entry["sort"] == "delete" and entry["reason"] not in DELETE_REASONS:
            failures.append(rested(origins, here, "legacy %s: a deletion's reason is orphan or duplicate" % where))
        elif entry["sort"] == "support" and not all(sid in planned for sid in entry["scenarios"]):
            failures.append(rested(origins, here, "legacy %s: support names a scenario the plan lacks" % where))
        elif entry["sort"] == "support" and not entry["users"] and not entry["scenarios"]:
            failures.append(rested(origins, here, "legacy %s: support names no test that reads it, and no kept scenario "
                                   "names it as support; record its users" % where))
        if entry.get("inferred") and not (entry["sort"] == "port" and entry["rule"] == INFERRED):
            failures.append(rested(origins, here, "legacy %s: inferred text goes only with sort port and rule inferred, "
                                   "not sort %s and rule %s" % (where, entry["sort"], entry["rule"] or "-")))
        users_of = kept_support.get(os.path.normpath(entry["path"])) if entry["path"] and not entry["name"] else None
        if entry["sort"] in ("delete", "port") and users_of:
            failures.append(rested(origins, here, "legacy %s: a %s of a file the kept scenarios %s name as support"
                                   % (where, entry["sort"], ", ".join(sorted(users_of)))))
    failures.extend(control_failures(plan, origins))
    for index, call in enumerate(plan["calls"]):
        if call["kind"] not in CALL_KINDS:
            named = "kind %r is not one of" % call["kind"] if call["kind"] else "it names no kind; the kinds are"
            failures.append(rested(origins, [("call", index)], "call at %s: %s %s"
                                   % (call["site"] or "-", named, ", ".join(CALL_KINDS))))
    for scenario in plan["scenarios"]:
        if scenario["action"] == "adopt" and not any(entry["sort"] == "adopt" and entry["scenario"] == scenario["id"]
                                                     for entry in plan["legacy"]):
            failures.append(rested(origins, [("scenario", scenario["id"])],
                                   "scenario %s: adopt names no legacy test" % scenario["id"]))
    sorted_paths = {entry["path"] for entry in plan["legacy"]}
    for path in groups["sort"]:
        if path not in sorted_paths and not any((s.get("test") or {}).get("path") == path
                                                or path in (s.get("support") or []) for s in plan["scenarios"]):
            failures.append("test file %s: no scenario claims it, and the sort names it nowhere" % path)
    return failures


def cmd_plan(args, root):
    sprint = resolved_sprint(root, args.sprint, exists=False)
    if args.show:
        plan = read_plan(root, sprint)
        if args.json:
            print(json.dumps(plan, indent=2))
            return 0
        print_plan(plan)
        return 0
    if not args.from_run:
        raise InputError("name the planning run with --from-run, or pass --show")
    if not review.stored_log(root, args.from_run):
        raise InputError("no planning run at %s" % args.from_run)
    if args.questions:
        waiting = [item for item in planning_items(root, args.from_run)["settled"] if item["state"] != "answered"]
        print(json.dumps(waiting, indent=2))
        return 0
    enabled = testing_config(root, sprint)["enabled"]
    if args.frozen != (enabled == "frozen"):
        raise InputError("%s sets testing.enabled to %s: pass --frozen exactly where it is frozen" % (CONFIG, enabled))
    plan = assembled_plan(root, args.from_run, sprint, args.frozen)
    write_json(root, sibling(sprint, "-plan.json"), plan)
    print("written: %s" % sibling(sprint, "-plan.json"))
    print_counts(plan)
    return 0


def print_counts(plan):
    actions = {action: sum(1 for s in plan["scenarios"] if s["action"] == action) for action in ACTIONS}
    sorts = {sort: sum(1 for e in plan["legacy"] if e["sort"] == sort) for sort in SORTS}
    print("scenarios: %s" % ", ".join("%d %s" % (actions[a], a) for a in ACTIONS))
    print("legacy tests: %s" % ", ".join("%d %s" % (sorts[s], s) for s in SORTS))
    print("unguarded programs: %d; calls: %d" % (len(plan["unguarded"]), len(plan["calls"])))
    print("test files kept as they stand: %d" % len(plan.get("kept") or []))


def scenario_story(scenario):
    story = STORY_SOURCE.match(scenario.get("source") or "")
    return story.group(1) if story else scenario.get("source") or "-"


def call_line(call):
    story = "; story `%s`" % call["story"] if call.get("story") else ""
    return "`%s`%s: %s" % (call["site"] or "-", story, call["choice"] or "-")


def print_summary(plan):
    print("## Summary")
    print()
    print("### Scenarios per story")
    stories = {}
    for s in plan["scenarios"]:
        counts = stories.setdefault(scenario_story(s), {})
        counts[s["action"]] = counts.get(s["action"], 0) + 1
    for story in sorted(stories):
        counts = stories[story]
        print("- `%s`: %s" % (story, ", ".join("%d %s" % (counts[a], a) for a in ACTIONS if counts.get(a))))
    if not stories:
        print("None.")
    by_kind = {}
    for call in plan["calls"]:
        by_kind.setdefault(call.get("kind") or "no kind", []).append(call)
    print()
    print("### Calls that leave a behavior untested or depart from an owner answer")
    whole = [call for kind in WHOLE_CALL_KINDS for call in by_kind.get(kind, [])]
    for call in whole:
        print("- %s, %s" % (call["kind"], call_line(call)))
        for line in (call["body"] or "").split("\n"):
            print("  %s" % line if line else "")
    if not whole:
        print("None.")
    print()
    print("### Other calls by kind")
    others = [kind for kind in CALL_KINDS if kind not in WHOLE_CALL_KINDS]
    others += sorted(kind for kind in by_kind if kind not in CALL_KINDS)
    for kind in [kind for kind in others if kind in by_kind]:
        print("- %s (%d):" % (kind, len(by_kind[kind])))
        for call in by_kind[kind]:
            print("  - %s" % call_line(call))
    if not any(kind in by_kind for kind in others):
        print("None.")
    print()
    print("### Inferred rules")
    inferred = [e for e in plan["legacy"] if e["sort"] == "port" and e["rule"] == INFERRED]
    for e in inferred:
        print('- "%s" test `%s`, check `%s`' % (e.get("inferred") or "-", locator(e) or "-", e["check"] or "-"))
    if not inferred:
        print("None: every port enforces a written rule.")
    print()
    print("### Planned tests by kind and setup")
    pairs = {}
    for s in plan["scenarios"]:
        if s["action"] in ("new", "rewrite"):
            pair = "%s, %s" % (s.get("kind") or "no kind", s.get("setup") or "no setup")
            pairs[pair] = pairs.get(pair, 0) + 1
    for pair in sorted(pairs):
        print("- %s: %d" % (pair, pairs[pair]))
    if not pairs:
        print("None.")
    print()
    print("### Shared resources declared")
    declared = {}
    for s in plan["scenarios"]:
        for resource in s.get("resources") or []:
            declared.setdefault(resource, []).append(s["id"])
    for resource in sorted(declared):
        print("- `%s`: %s" % (resource, ", ".join("`%s`" % sid for sid in sorted(declared[resource]))))
    if not declared:
        print("None: every planned test is isolated.")
    print()
    print("### The test stack's budget")
    print_budget(plan.get("budget"))
    print()
    print("### Time controls the plan builds")
    print_controls(plan.get("controls") or [])
    print()


def control_text(control):
    gate = "gate setting `%s`" % control["gate"] if control.get("gate") else "no gate"
    return "`%s`: %s at `%s`, %s; files: %s; waited on by %s. %s" % (
        control["id"], control.get("form") or "-", control.get("site") or "-", gate,
        ", ".join("`%s`" % path for path in control.get("files") or []) or "none",
        ", ".join("`%s`" % sid for sid in control.get("scenarios") or []) or "no scenario", control.get("text") or "")


def print_controls(controls):
    for control in controls:
        print("- %s" % control_text(control).rstrip())
    if not controls:
        print("None: the product has a time control for every timer the planned tests meet.")


def print_budget(budget):
    if not isinstance(budget, dict):
        print("None: the plan records no budget, so the suite runs with one worker and no preflight.")
        return
    print("- workers: %s" % budget.get("workers"))
    print("- stack: %s" % (budget.get("stack") or "-"))
    print("- sizing: %s" % (budget.get("sizing") or "-"))
    print("- files the preflight may edit: %s" % (", ".join(budget.get("files") or []) or "none"))
    for limit in budget.get("limits") or []:
        print("- limit %s: %s, %s" % (limit.get("limit") or "-", limit.get("how") or "-", limit.get("detail") or "-"))
    if not budget.get("limits"):
        print("- limits: none the tests meet")
    print("- preflight: %s" % ("passed as task %s, so a sprint whose plan carries this budget unchanged runs none"
                               % budget["preflight"] if budget.get("preflight")
                               else "none recorded, so the next sprint that names a stack runs one"))


def print_plan(plan):
    print("Planned against commit `%s`." % plan["commit"])
    print()
    print_summary(plan)
    print_counts(plan)
    print()
    print("## Scenarios")
    for s in plan["scenarios"]:
        test = locator(s.get("test")) or ("as the stamp recorded it" if s["action"] == "keep" else "-")
        extra = "".join("; %s: %s" % (name, s[name])
                        for name in ("part", "class", "harm", "reach", "entry", "waits", "ruling", "issue", "call")
                        if s.get(name))
        extra += "; resources: %s" % ", ".join(s["resources"]) if s.get("resources") else ""
        print("- `%s`: %s. Source: %s. Checks: %s Test: %s%s" % (s["id"], s["action"], s.get("source"), s["text"], test, extra))
    print()
    print("## Legacy tests")
    for e in plan["legacy"]:
        extra = {"adopt": "into %s" % e["scenario"], "port": "enforces %s; becomes %s" % (rule_text(e), e["check"]),
                 "delete": e["reason"], "support": "for %s" % ", ".join(e["scenarios"])}.get(e["sort"], "")
        if e.get("users"):
            extra += "; read by %s" % ", ".join(e["users"])
        print("- `%s`: %s, %s. %s" % (locator(e), e["sort"], extra, e["note"]))
    if not plan["legacy"]:
        print("None.")
    print()
    print("## Test files kept as they stand")
    for path in plan.get("kept") or []:
        print("- `%s`: no scenario claims it, and its folder was not taken, so a later sprint may take it" % path)
    if not plan.get("kept"):
        print("None.")
    print()
    print("## Unguarded programs")
    for e in plan["unguarded"]:
        print("- `%s`: %s" % (e["path"], e["reason"]))
    if not plan["unguarded"]:
        print("None.")
    print()
    print("## Calls")
    for c in plan["calls"]:
        print("- `%s`: %s. %s" % (c["site"] or "-", c["choice"] or "-", first_line(c["body"])))
    if not plan["calls"]:
        print("None.")


def opened_run(root, run):
    if not review.stored_log(root, run):
        raise InputError("no run at %s: open the run first" % run)
    return run


def run_file(root, sprint):
    return opened_run(root, sibling(sprint, "-run.jsonl"))


def selected_run(root):
    tasks = review.issues.tasks
    if not os.environ.get("OK_TASKS") and not os.path.isfile(tasks.pointer_path(root)):
        return None
    return project_relative(os.path.realpath(root), tasks.resolve_file(root))


@functools.lru_cache(maxsize=None)
def selected_ledger(root, sprint):
    run = selected_run(root)
    if run is None or not review.LEDGER_PATH.fullmatch(run) or not review.stored_log(root, run):
        return None
    certified, _ = review.certified_sprint(root, run)
    return run if certified and os.path.basename(certified) == os.path.basename(sprint) else None


# @story: certify-completion
def certification_ledger(root, sprint):
    selected = selected_ledger(root, sprint)
    if selected:
        return selected
    text = read_text(root, sibling(sprint, "-completion.md"))
    section = review.section_lines(text.split("\n"), review.CERTIFICATION_HEADING) if text else None
    ledger = review.ledger_path(section) if section else None
    return ledger if ledger and review.stored_log(root, ledger) else None


def record_runs(root, sprint):
    return [run for run in (sibling(sprint, "-run.jsonl"), certification_ledger(root, sprint))
            if run and review.stored_log(root, run)]


def ledger_defects(root, sprint):
    ledger = certification_ledger(root, sprint)
    return run_items(root, ledger, "defects") if ledger else []


def defect_tests(defects, state):
    return {text_field(defect, "test") for defect in defects if defect["state"] == state and text_field(defect, "test")}


def labelled_tasks(root, sprint, ledger):
    labelled = [(task["id"], task) for task in run_tasks(root, run_file(root, sprint))]
    if ledger:
        labelled += [(LEDGER_TASK % (ledger, task["id"]), task) for task in run_tasks(root, ledger)]
    return labelled


def recorded_tests(root, *runs):
    latest = {}
    for run in runs:
        for item in run_items(root, run, "tests"):
            sid = text_field(item, "scenario")
            if sid:
                latest[sid] = item
    return latest


def declared_resources(*records):
    return next((list(record["resources"]) for record in records if isinstance(record.get("resources"), list)), [])


def declared_reads(*records):
    return next((list(record["reads"]) for record in records if isinstance(record.get("reads"), list)), None)


def shared_resources(entries):
    return {resource for entry in entries for name in ("resources", "reads") for resource in entry.get(name) or []}


# @decision: tests-isolated-unless-declared
def effective_reads(entry, shared):
    if entry.get("reads") is not None:
        return sorted(entry["reads"])
    return sorted(shared - set(entry["resources"])) if entry["resources"] else []


def declared_silence(record):
    value = field(record, "silence") if "fields" in record else record.get("silence")
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 1 else None


def plan_text(*records):
    return {name: next(record[name] for record in records if record.get(name))
            for name in PLAN_TEXT if any(record.get(name) for record in records)}


def recorded_plan_text(planned, record):
    return dict(planned, **{name: text_field(record, name) for name in PLAN_TEXT if text_field(record, name)})


# @decision: test-tasks-own-the-tests
def recorded_declarations(entry, record):
    resources, reads = field(record, "resources"), field(record, "reads")
    if isinstance(resources, list):
        entry["resources"] = list(resources)
    if isinstance(reads, list):
        entry["reads"] = list(reads)


def take_record(entry, record, legacy_support):
    entry["test"] = test_of(record)
    entry["support"] = sorted(set(list_field(record, "support")) | legacy_support)
    recorded_declarations(entry, record)
    entry["plan_text"] = recorded_plan_text(entry["plan_text"], record)
    entry["silence"] = declared_silence(record)


# @decision: tests-isolated-unless-declared
def live_tests(root, sprint=None):
    state = read_state(root)
    live = {s["id"]: {"id": s["id"], "test": s.get("test"), "support": list(s.get("support") or []),
                      "resources": declared_resources(s), "reads": declared_reads(s), "silence": declared_silence(s),
                      "plan_text": plan_text(s)}
            for s in state["scenarios"] if s.get("test")}
    if sprint is None:
        return live
    plan = sprint_plan(root, sprint)
    records = recorded_tests(root, *record_runs(root, sprint))
    for s in plan["scenarios"]:
        if s["action"] in ("retire", "gap"):
            live.pop(s["id"], None)
            continue
        legacy_support = {e["path"] for e in plan["legacy"] if e["sort"] == "support" and s["id"] in e["scenarios"]}
        record = records.get(s["id"])
        if s["action"] == "keep":
            entry = live.get(s["id"])
            if entry is None:
                continue
            entry["support"] = sorted(set(entry["support"]) | legacy_support)
            entry["resources"] = declared_resources(s, entry)
            entry["reads"] = declared_reads(s, entry)
            entry["plan_text"] = plan_text(s, entry["plan_text"])
            if record and not field(record, "retired") and not field(record, "gap") and test_of(record):
                take_record(entry, record, legacy_support)
            continue
        entry = {"id": s["id"], "test": None, "support": sorted(set(s.get("support") or []) | legacy_support),
                 "resources": declared_resources(s), "reads": declared_reads(s), "silence": None,
                 "plan_text": plan_text(s)}
        if s["action"] == "adopt":
            entry["test"] = s.get("test")
        if record and field(record, "gap"):
            live.pop(s["id"], None)
            continue
        if record and not field(record, "retired") and test_of(record):
            take_record(entry, record, legacy_support)
        live[s["id"]] = entry
    return live


def end_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        return


def run_blobs(root, folders, targets):
    support = {os.path.normpath(path) for target in targets for path in target["support"]}
    paths = sorted(review.test_paths(root, tree_files(root, folders))
                   | {path for path in support if os.path.isfile(os.path.join(root, path))})
    if not paths:
        return {}
    done = subprocess.run(["git", "hash-object", "--stdin-paths"], cwd=root,
                          input="\n".join(os.path.join(root, path) for path in paths) + "\n",
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("git hash-object failed: %s" % done.stderr.strip())
    return dict(zip(paths, done.stdout.split()))


def output_tail(text):
    return "\n".join((text or "").rstrip().split("\n")[-TAIL_LINES:])


def result_key(path, name):
    return (os.path.normpath(path), name or None)


def reported(line):
    if not isinstance(line, dict) or not isinstance(line.get("path"), str) or not line["path"]:
        return None
    if not isinstance(line.get("passed"), bool) or not isinstance(line.get("name"), (str, type(None))):
        return None
    if isinstance(line.get("seconds"), bool) or not isinstance(line.get("seconds"), (int, float)):
        return None
    return line


# @decision: fixes-rerun-the-tests-they-reach
def reached_paths(value):
    if not isinstance(value, list) or not all(isinstance(entry, str) and entry.strip() for entry in value):
        return None
    paths = set()
    for entry in value:
        path = os.path.normpath(entry)
        if os.path.isabs(path) or path == ".." or path.startswith("../"):
            return None
        paths.add(path + "/" if entry.endswith("/") else path)
    return sorted(paths)


def covers(entry, path):
    if not entry.endswith("/"):
        return entry == path
    return entry == "./" or path.startswith(entry)


# @decision: fixes-rerun-the-tests-they-reach
def take_line(raw, planned, found, on_result, started):
    arrived = round(time.monotonic() - started, 3)
    text = raw.decode("utf-8", "replace")
    try:
        line = reported(json.loads(text))
    except ValueError:
        line = None
    target = planned.get(result_key(line["path"], line.get("name"))) if line else None
    if target is None or target["scenario"] in found["results"]:
        found["unmatched"].append(text[:RESULT_LINE_BYTES])
        return False
    result = {"scenario": target["scenario"], "path": target["path"], "name": target["name"],
              "passed": line["passed"], "seconds": line["seconds"], "arrived": arrived,
              "tail": output_tail(line["output"] if isinstance(line.get("output"), str) else "")}
    if "reaches" in line:
        reaches = reached_paths(line["reaches"])
        if reaches is None:
            sys.stderr.write("tests: %s: reaches %s is not a list of non-empty paths inside the project, so the result "
                             "stands with no reaches\n" % (target["scenario"], json.dumps(line["reaches"])[:200]))
        else:
            result["reaches"] = reaches
    found["results"][target["scenario"]] = result
    on_result(result)
    return True


def stream_lines(reader, pending, planned, found, on_result, started):
    while True:
        try:
            chunk = os.read(reader, READ_BYTES)
        except BlockingIOError:
            break
        if not chunk:
            break
        pending += chunk
    lines = pending.split(b"\n")
    landed = False
    for raw in lines[:-1]:
        if raw.strip():
            landed = take_line(raw, planned, found, on_result, started) or landed
    return lines[-1], landed


def kept_tail(tail, data):
    lines = (tail + data).split(b"\n")
    return b"\n".join(lines[-TAIL_LINES - 1:])


def exit_watch(proc):
    waker, signal_end = os.pipe()

    def watch():
        try:
            proc.wait()
        except Exception as err:
            review.issues.tasks.event("TESTS.SUITE.UNWATCHED", type=type(err).__name__, message=str(err))
        finally:
            os.close(signal_end)

    try:
        threading.Thread(target=watch, daemon=True).start()
    except BaseException:
        os.close(signal_end)
        os.close(waker)
        raise
    return waker


def silence_limit(silence, planned, results):
    return max([silence] + [target.get("silence") or 0 for target in planned.values()
                            if target["scenario"] not in results])


def read_stream(proc, reader, waker, silence, planned, on_result, started):
    found = {"results": {}, "unmatched": [], "stopped": None}
    pending, tail = b"", b""
    last = time.monotonic()
    output = proc.stdout.fileno()
    watched = [reader, output, waker]
    while waker in watched:
        left = silence_limit(silence, planned, found["results"]) - (time.monotonic() - last)
        if left <= 0:
            found["stopped"] = "silence"
            break
        ready = select.select(watched, [], [], left)[0]
        if reader in ready:
            pending, landed = stream_lines(reader, pending, planned, found, on_result, started)
            last = time.monotonic() if landed else last
        if output in ready:
            data = os.read(output, READ_BYTES)
            tail = kept_tail(tail, data) if data else tail
            last = time.monotonic() if data else last
            if not data:
                watched.remove(output)
        if waker in ready:
            watched.remove(waker)
    if output in watched and output in select.select([output], [], [], 0)[0]:
        tail = kept_tail(tail, os.read(output, READ_BYTES))
    pending, _ = stream_lines(reader, pending, planned, found, on_result, started)
    if pending.strip():
        found["unmatched"].append(pending.decode("utf-8", "replace")[:RESULT_LINE_BYTES])
    found["exit"] = proc.poll()
    found["tail"] = output_tail(tail.decode("utf-8", "replace"))
    return found


def stop_suite(proc):
    end_group(proc)
    proc.wait()
    proc.stdout.close()


# @decision: scenario-list-decided-once
# @decision: test-loop-fixes-code-never-tests
def run_suite(root, testing, workers, targets, on_result):
    planned = {}
    for target in targets:
        planned.setdefault(result_key(target["path"], target["name"]), target)
    with contextlib.ExitStack() as cleanup:
        folder = tempfile.mkdtemp(prefix="ok-planner-tests-")
        cleanup.callback(shutil.rmtree, folder)
        listed = os.path.join(folder, "tests.json")
        with open(listed, "w", encoding="utf-8") as f:
            json.dump({"workers": workers, "tests": [{"path": t["path"], "name": t["name"], "resources": t["resources"],
                                                      "reads": t["reads"]} for t in targets]}, f)
        stream = os.path.join(folder, "results")
        os.mkfifo(stream)
        reader = os.open(stream, os.O_RDONLY | os.O_NONBLOCK)
        cleanup.callback(os.close, reader)
        holder = os.open(stream, os.O_WRONLY)
        cleanup.callback(os.close, holder)
        command = testing["run"].replace("{tests}", shlex.quote(listed)).replace("{results}", shlex.quote(stream))
        started = time.monotonic()
        proc = subprocess.Popen(command, shell=True, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, start_new_session=True)
        cleanup.callback(stop_suite, proc)
        waker = exit_watch(proc)
        cleanup.callback(os.close, waker)
        return read_stream(proc, reader, waker, testing["silence"], planned, on_result, started)


def setup_refusal(proc, output, waker, setup_silence):
    tail, last = b"", time.monotonic()
    watched = [output, waker]
    while waker in watched:
        left = setup_silence - (time.monotonic() - last)
        if left <= 0:
            end_group(proc)
            return "it printed nothing for testing.setup_silence, %d seconds" % setup_silence, tail
        ready = select.select(watched, [], [], left)[0]
        if output in ready:
            data = os.read(output, READ_BYTES)
            tail = kept_tail(tail, data) if data else tail
            last = time.monotonic() if data else last
            if not data:
                watched.remove(output)
        if waker in ready:
            watched.remove(waker)
    if output in watched and output in select.select([output], [], [], 0)[0]:
        tail = kept_tail(tail, os.read(output, READ_BYTES))
    code = proc.wait()
    return ("it exited %d" % code if code != 0 else None), tail


# @decision: tests-spend-time-only-on-their-outcome
def run_setup(root, testing):
    proc = subprocess.Popen(testing["setup"], shell=True, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, start_new_session=True)
    with contextlib.ExitStack() as cleanup:
        cleanup.callback(proc.stdout.close)
        cleanup.callback(proc.wait)
        waker = exit_watch(proc)
        cleanup.callback(os.close, waker)
        refusal, tail = setup_refusal(proc, proc.stdout.fileno(), waker, testing["setup_silence"])
    if refusal is None:
        return None
    return "setup failed: testing.setup %s\n%s" % (refusal, output_tail(tail.decode("utf-8", "replace")))


def unreported(target, stopped, closed):
    notes = ["the suite command reported no result"]
    if stopped:
        notes.append("the run stopped after testing.silence seconds with no result")
    if not closed:
        notes.append("the round did not close")
    result = {"scenario": target["scenario"], "path": target["path"], "name": target["name"], "passed": False,
              "seconds": None, "tail": "; ".join(notes)}
    if stopped or not closed:
        result["not_run"] = True
    return result


def failed(result):
    return not result["passed"] and not result.get("not_run")


def round_results(planned, results, stopped, closed):
    return [results.get(target["scenario"]) or unreported(target, stopped, closed) for target in planned]


# @decision: tests-isolated-unless-declared
def held_groups(declared, scenarios):
    groups = []
    for sid in sorted(set(scenarios)):
        changed = set((declared.get(sid) or {}).get("resources") or [])
        if not changed:
            continue
        merged = {"members": {sid}, "resources": changed}
        for group in [group for group in groups if group["resources"] & changed]:
            merged["members"] |= group["members"]
            merged["resources"] |= group["resources"]
            groups.remove(group)
        groups.append(merged)
    return {sid: n for n, group in enumerate(groups) for sid in group["members"]}


# @decision: tests-isolated-unless-declared
def wall_bound(seconds, groups, workers, form):
    assert form in SCHEDULE_FORMS, "testing.schedule form %r is none of %s" % (form, ", ".join(SCHEDULE_FORMS))
    totals = {}
    for sid, group in groups.items():
        totals[group] = totals.get(group, 0) + seconds.get(sid, 0)
    isolated = sum(value for sid, value in seconds.items() if sid not in groups)
    held = sum(totals.values())
    longest = max(totals.values(), default=0)
    if form == "recommended":
        return max(longest, (isolated + held) / workers)
    if form == "groups-side-by-side":
        return isolated / workers + max(longest, held / workers)
    return isolated / workers + held


# @decision: tests-isolated-unless-declared
# @decision: tests-spend-time-only-on-their-outcome
def ranked_slowest(results, count, workers, declared, form):
    timed = [result for result in results if result.get("seconds") is not None]
    seconds = {result["scenario"]: result["seconds"] for result in timed}
    groups = held_groups(declared, seconds)
    bound = wall_bound(seconds, groups, workers, form)
    costed = [dict(result, cost=round(bound - wall_bound({**seconds, result["scenario"]: 0}, groups, workers, form), 3))
              for result in timed]
    return sorted(costed, key=lambda result: -result["cost"])[:count]


# @story: suite-gets-faster-over-time
# @decision: tests-spend-time-only-on-their-outcome
def median_seconds(rounds, state, sid, path, blob):
    values = [value for row in state["ranking"] if row["scenario"] == sid and row["blob"] == blob
              for value in row["seconds"]]
    for entry in rounds:
        if (entry.get("kind") or "whole") != "whole" or not entry["closed"]:
            continue
        if (entry.get("test_files") or {}).get(path) != blob:
            continue
        values += [result["seconds"] for result in entry["results"]
                   if result["scenario"] == sid and result["passed"] and is_number(result.get("seconds"))]
    return (statistics.median(values) if values else None), values


# @decision: tests-isolated-unless-declared
# @decision: tests-spend-time-only-on-their-outcome
def speed_ranking(root, rounds, state, live, declared, sids, workers, form, keep):
    rows = {}
    for sid in sids:
        blob = test_blob(root, live[sid])
        if blob is None:
            continue
        median, values = median_seconds(rounds, state, sid, os.path.normpath(live[sid]["test"]["path"]), blob)
        if median is not None:
            rows[sid] = {"scenario": sid, "blob": blob, "seconds": values[-keep:], "median": median}
    costed = ranked_slowest([{"scenario": sid, "seconds": row["median"]} for sid, row in sorted(rows.items())], None,
                            workers, declared, form)
    return [dict(rows[result["scenario"]], cost=result["cost"]) for result in costed]


def overlapped(a, b):
    return a["arrived"] - a["seconds"] < b["arrived"] and b["arrived"] - b["seconds"] < a["arrived"]


# @decision: tests-isolated-unless-declared
def forbidden_pair(a, b, declared, groups, form):
    if form == "recommended":
        changes = {sid: set((declared.get(sid) or {}).get("resources") or []) for sid in (a, b)}
        touches = {sid: changes[sid] | set((declared.get(sid) or {}).get("reads") or []) for sid in (a, b)}
        return bool(changes[a] & touches[b] or changes[b] & touches[a])
    if form == "groups-side-by-side":
        return (a in groups) != (b in groups) or (a in groups and groups[a] == groups[b])
    return a in groups or b in groups


# @decision: tests-isolated-unless-declared
def schedule_failures(entry, schedule):
    timed = sorted((result for result in entry["results"]
                    if result.get("arrived") is not None and result.get("seconds") is not None),
                   key=lambda result: result["arrived"] - result["seconds"])
    if schedule["said"] is None or not timed:
        return []
    declared = {target["scenario"]: target for target in entry["planned"]}
    groups = held_groups(declared, [result["scenario"] for result in entry["results"]])
    failures = []
    for n, a in enumerate(timed):
        for b in timed[n + 1:]:
            if b["arrived"] - b["seconds"] >= a["arrived"]:
                break
            if not overlapped(a, b) or not forbidden_pair(a["scenario"], b["scenario"], declared, groups,
                                                         schedule["form"]):
                continue
            first, second = sorted((a, b), key=lambda result: result["scenario"])
            failures.append({
                "scenario": "%s%s--%s" % (SCHEDULE_PREFIX, first["scenario"], second["scenario"]), "path": None,
                "name": None, "passed": False, "seconds": None, "schedule": [first["scenario"], second["scenario"]],
                "tail": "round %d ran %s from %ss to %ss and %s from %ss to %ss at the same time, which testing.schedule "
                        "%s forbids; fix the suite command so it runs the schedule recorded"
                        % (entry["round"], first["scenario"], round(first["arrived"] - first["seconds"], 3),
                           first["arrived"], second["scenario"], round(second["arrived"] - second["seconds"], 3),
                           second["arrived"], schedule["form"])})
    return sorted(failures, key=lambda failure: failure["scenario"])


def round_header(record):
    return isinstance(record, dict) and "planned" in record


def parsed_header(text):
    try:
        return round_header(json.loads(text))
    except ValueError:
        return False


def results_records(root, rel):
    data = review.issues.tasks.log_bytes(os.path.join(root, rel))
    body = data.decode("utf-8", errors="replace") if data is not None else ""
    lines = [line for line in body.split("\n") if line.strip()]
    records = []
    for n, text in enumerate(lines):
        try:
            records.append(json.loads(text))
        except ValueError:
            if n + 1 == len(lines) or parsed_header(lines[n + 1]):
                continue
            raise InputError("%s: line %d is not JSON and no round starts after it; only this tool writes the file, "
                             "so restore it from git" % (rel, n + 1))
    return records


# @decision: scenario-list-decided-once
def results_rounds(root, sprint):
    rel = sibling(sprint, "-results.jsonl")
    rounds = {}
    for record in results_records(root, rel):
        number = record.get("round") if isinstance(record, dict) else None
        if not isinstance(number, int) or (not round_header(record) and number not in rounds):
            raise InputError("%s holds a line that belongs to no round: %s" % (rel, json.dumps(record)[:200]))
        if round_header(record):
            rounds[number] = dict(record, results={}, closed=False, ended=None, exit=None, stopped=None,
                                  unmatched=[], leftovers_after=None, grew=[])
        elif "ended" in record:
            rounds[number].update(record, closed=not record.get("error"), results=rounds[number]["results"])
        elif "scenario" in record:
            rounds[number]["results"].setdefault(record["scenario"], record)
        else:
            raise InputError("%s holds a line that is neither a round's header, result, nor close: %s"
                             % (rel, json.dumps(record)[:200]))
    built = []
    for number in sorted(rounds):
        entry = rounds[number]
        entry["results"] = round_results(entry["planned"], entry["results"], entry["stopped"], entry["closed"])
        built.append(entry)
    return built


def budget_workers(root, sprint):
    budget = sprint_plan(root, sprint).get("budget") if sprint else read_state(root).get("budget")
    return budget["workers"] if isinstance(budget, dict) and "workers" in budget else 1


def run_targets(args, root, sprint):
    if args.from_file:
        listed = read_json(root, args.from_file, "write a JSON list of {path, name, scenario}")
        if not isinstance(listed, list):
            raise InputError("%s does not hold a JSON list" % args.from_file)
        entries = [dict(entry, resources=declared_resources(entry), reads=declared_reads(entry))
                   for entry in listed if isinstance(entry, dict) and entry.get("path")]
        shared = shared_resources(entries)
        return [{"scenario": str(entry.get("scenario") or locator(entry)), "path": entry["path"],
                 "name": entry.get("name"), "resources": entry["resources"], "reads": effective_reads(entry, shared),
                 "silence": declared_silence(entry), "support": []}
                for entry in entries]
    live = live_tests(root, sprint)
    if args.only:
        missing = [sid for sid in args.only if sid not in live]
        if missing:
            raise InputError("no live test for %s" % ", ".join(missing))
    return live_targets(live, [sid for sid in sorted(live) if not args.only or sid in args.only])


def live_targets(live, sids):
    shared = shared_resources(live.values())
    return [{"scenario": sid, "path": (live[sid]["test"] or {}).get("path"),
             "name": (live[sid]["test"] or {}).get("name"), "resources": live[sid]["resources"],
             "reads": effective_reads(live[sid], shared), "silence": live[sid]["silence"],
             "support": list(live[sid]["support"])}
            for sid in sids]


def unrunnable(target, testing):
    if not target["path"]:
        return "the plan names this test and no test task recorded it yet"
    if testing["named"] and not target["name"]:
        return "testing.named is true, and this test records no name"
    return None


def result_text(result):
    seconds = "-" if result.get("seconds") is None else "%ss" % result["seconds"]
    where = locator({"path": result["path"], "name": result["name"]}) if result["path"] else "-"
    verdict = "pass" if result["passed"] else "FAIL" if failed(result) else "not run"
    return "%s %s %s %s" % (verdict, result["scenario"], where, seconds)


def appended_text(f, text):
    f.write(text)
    f.flush()


def appended_lines(f, records):
    appended_text(f, "".join(json.dumps(record) + "\n" for record in records))


def cache_path(root, name):
    return os.path.join(review.issues.tasks.cache_dir(root), name)


def sprint_stem(sprint):
    return os.path.basename(sibling(sprint, ""))


def runs_folder(root):
    return cache_path(root, "tests-runs")


def run_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def registered_runs(root):
    folder = runs_folder(root)
    entries = []
    for name in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
        if not re.match(r"^[0-9]+\.json$", name) or int(name.split(".")[0]) == os.getpid():
            continue
        try:
            with open(os.path.join(folder, name), encoding="utf-8") as f:
                entry = json.load(f)
        except FileNotFoundError:
            continue
        if run_alive(entry["pid"]):
            entries.append(entry)
    return entries


def run_names(entries):
    return ", ".join("run %d (%s of %s, started %s)" % (entry["pid"], entry["kind"], entry["sprint"] or "no sprint",
                                                         entry["start"]) for entry in entries)


# @decision: scenario-list-decided-once
@contextlib.contextmanager
def whole_round_lock(root, sprint):
    with open(cache_path(root, "tests-%s-whole.lock" % sprint_stem(sprint)), "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            holders = [entry for entry in registered_runs(root)
                       if entry["sprint"] == sprint and entry["kind"] == "whole"]
            raise InputError("another whole-suite round of %s is under way, %s, and writes %s: wait for it to end, "
                             "then run again" % (sprint, run_names(holders) or "a run that has not registered yet",
                                                 sibling(sprint, "-results.jsonl"))) from None
        yield


@contextlib.contextmanager
def results_lock(root, sprint):
    with open(cache_path(root, "tests-%s-results.lock" % sprint_stem(sprint)), "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def lock_modes(targets):
    changed = {resource for target in targets for resource in target["resources"]}
    modes = {resource: "reads" for target in targets for resource in target["reads"] if resource not in changed}
    modes.update({resource: "changes" for resource in changed})
    bad = sorted(resource for resource in modes if not isinstance(resource, str) or not SLUG.match(resource))
    if bad:
        raise InputError("shared resources %s are not slugs: name each resource a test declares in lowercase letters, "
                         "digits, and hyphens" % ", ".join(json.dumps(resource) for resource in bad))
    return modes


# @decision: tests-isolated-unless-declared
@contextlib.contextmanager
def resource_locks(root, sprint, kind, targets):
    modes = lock_modes(targets)
    path = os.path.join(runs_folder(root), "%d.json" % os.getpid())
    with contextlib.ExitStack() as held:
        write_replacing(path, json.dumps({"pid": os.getpid(), "sprint": sprint, "kind": kind,
                                          "start": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                          "resources": modes}) + "\n")
        held.callback(os.remove, path)
        for slug in sorted(modes):
            lock = held.enter_context(open(cache_path(root, "tests-resource-%s.lock" % slug), "a+"))
            mode = fcntl.LOCK_EX if modes[slug] == "changes" else fcntl.LOCK_SH
            try:
                fcntl.flock(lock, mode | fcntl.LOCK_NB)
            except BlockingIOError:
                holders = [entry for entry in registered_runs(root) if slug in (entry.get("resources") or {})
                           and "changes" in (modes[slug], entry["resources"][slug])]
                print("tests: waiting to %s shared resource %s, which %s holds" % (
                    "change" if modes[slug] == "changes" else "read", slug,
                    run_names(holders) or "a run that has not registered"), file=sys.stderr, flush=True)
                fcntl.flock(lock, mode)
        yield


# @decision: scenario-list-decided-once
def results_file(root, sprint, header, results, close):
    path = os.path.join(root, sibling(sprint, "-results.jsonl"))
    with results_lock(root, sprint):
        if review.issues.tasks.log_parts(path):
            raise InputError("%s is stored in parts, and a log stored in parts is read-only; record the round in an "
                             "unarchived sprint" % sibling(sprint, "-results.jsonl"))
        number = len(results_rounds(root, sprint)) + 1
        torn = False
        if os.path.isfile(path) and os.path.getsize(path):
            with open(path, "rb") as f:
                f.seek(-1, os.SEEK_END)
                torn = f.read(1) != b"\n"
        with open(path, "a", encoding="utf-8") as f:
            if torn:
                appended_text(f, "\n")
            appended_lines(f, [dict({"round": number}, **record) for record in [header] + results + [close]])
    return number


def suite_outcome(root, testing, workers, targets, on_result):
    runnable, results = [], {}
    for target in targets:
        why = unrunnable(target, testing)
        if why:
            results[target["scenario"]] = dict(target, passed=False, seconds=None, tail=why)
            results[target["scenario"]].pop("resources")
            results[target["scenario"]].pop("reads")
            results[target["scenario"]].pop("silence", None)
            results[target["scenario"]].pop("support")
            on_result(results[target["scenario"]])
        else:
            runnable.append(target)
    refused = run_setup(root, testing) if runnable and testing["setup"] is not None else None
    if refused:
        for target in runnable:
            results[target["scenario"]] = dict(target, passed=False, seconds=None, tail=refused)
            results[target["scenario"]].pop("resources")
            results[target["scenario"]].pop("reads")
            results[target["scenario"]].pop("silence", None)
            results[target["scenario"]].pop("support")
            on_result(results[target["scenario"]])
        runnable = []
    found = (run_suite(root, testing, workers, runnable, on_result) if runnable
             else {"results": {}, "unmatched": [], "stopped": None, "exit": None, "tail": refused or ""})
    found["setup_failed"] = bool(refused)
    found["results"] = dict(results, **found["results"])
    return found


def counts_held(counts):
    return isinstance(counts, dict) and all(
        SLUG.match(kind) and isinstance(count, int) and not isinstance(count, bool) and count >= 0
        for kind, count in counts.items())


# @decision: tests-isolated-unless-declared
def leftover_counts(root, testing):
    done = subprocess.run(testing["leftovers"], shell=True, cwd=root, stdin=subprocess.DEVNULL, capture_output=True,
                          text=True)
    if done.returncode != 0:
        raise InputError("testing.leftovers %r exited %d: %s" % (testing["leftovers"], done.returncode,
                                                                 output_tail(done.stderr or done.stdout)))
    try:
        counts = json.loads(done.stdout)
    except ValueError:
        counts = None
    if not counts_held(counts):
        raise InputError("testing.leftovers %r printed %r: it prints one JSON object of kind to count, each kind a "
                         "slug and each count a whole number, 0 or more, such as {} where the project counts nothing"
                         % (testing["leftovers"], done.stdout.strip()[:RESULT_LINE_BYTES]))
    return counts


def grown(before, after):
    return sorted(kind for kind, count in after.items() if count > before.get(kind, 0))


# @decision: fixes-rerun-the-tests-they-reach
# @decision: test-loop-fixes-code-never-tests
def failing_targets(root, sprint):
    latest, failing = unsettled_failures(root, sprint)
    if latest is None:
        raise InputError("no round recorded yet, so no test failed: run the whole suite first, `tests run --sprint %s`"
                         % sprint)
    live = live_tests(root, sprint)
    rerun = sorted({result["scenario"] for result in failing if result["scenario"] in live})
    if not rerun:
        others = [result["scenario"] for result in failing]
        raise InputError("no standing failure to rerun since round %s%s: run the whole suite as the gate, `tests run "
                         "--sprint %s`, as sprint certification's suite loop says"
                         % (since_round(results_rounds(root, sprint)), ", only %s" % ", ".join(others) if others
                            else "", sprint))
    return live_targets(live, rerun)


# @decision: fixes-rerun-the-tests-they-reach
def changed_targets(root, sprint):
    rounds = results_rounds(root, sprint)
    live = live_tests(root, sprint)
    standing = standing_results(rounds, live)
    current = run_blobs(root, plan_folders(sprint_plan(root, sprint)), live_targets(live, sorted(live)))
    changed = []
    for sid in sorted(live):
        result = standing.get(sid)
        paths = {os.path.normpath(path) for path in live[sid]["support"]}
        if live[sid]["test"] and live[sid]["test"].get("path"):
            paths.add(os.path.normpath(live[sid]["test"]["path"]))
        if result is None or result.get("not_run") or any(result["blobs"].get(path) != current.get(path)
                                                          for path in paths):
            changed.append(sid)
    if not changed:
        raise InputError("every live test has a result since round %s at its test file and support files as they "
                         "stand, so --changed reruns none: run the whole suite as the gate, `tests run --sprint %s`"
                         % (since_round(rounds), sprint))
    return live_targets(live, changed)


def print_leftovers(before, after, grew):
    print("testing.leftovers before: %s; after: %s" % (json.dumps(before, sort_keys=True), json.dumps(after, sort_keys=True)))
    print("grew: %s" % (", ".join(grew) if grew else "no kind"))


# @decision: scenario-list-decided-once
# @decision: test-loop-fixes-code-never-tests
# @decision: tests-isolated-unless-declared
def cmd_run(args, root):
    testing = testing_config(root, args.sprint)
    sprint = resolved_sprint(root, args.sprint) if args.sprint else None
    recorded = bool(sprint) and not args.from_file
    whole = recorded and not args.only and not args.failing and not args.changed
    kind = ("whole" if whole else "rerun") if recorded else "unrecorded"
    if args.failing:
        targets = failing_targets(root, sprint)
    elif args.changed:
        targets = changed_targets(root, sprint)
    else:
        targets = run_targets(args, root, sprint)
    with whole_round_lock(root, sprint) if whole else contextlib.nullcontext():
        with resource_locks(root, sprint, kind, targets):
            return tested_round(args, root, testing, sprint, targets, kind)


# @decision: scenario-list-decided-once
def recorded_round(root, testing, sprint, kind, workers, targets, planned, before, shown):
    labelled = labelled_tasks(root, sprint, certification_ledger(root, sprint))
    header = {"kind": kind, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "workers": workers,
              "tasks_closed": sorted(label for label, task in labelled if task.get("state") == "closed"),
              "test_files": run_blobs(root, plan_folders(sprint_plan(root, sprint)), targets),
              "planned": planned, "leftovers_before": before}
    landed, found, after, grew, error = [], None, None, [], None
    try:
        found = suite_outcome(root, testing, workers, targets, lambda result: (landed.append(result), shown(result)))
        after = leftover_counts(root, testing)
        grew = grown(before, after)
    except BaseException as err:
        error = "%s: %s" % (type(err).__name__, err)
        raise
    finally:
        ran = found or {"exit": None, "stopped": None, "unmatched": []}
        number = results_file(root, sprint, header, landed, {
            "ended": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "exit": ran["exit"],
            "stopped": ran["stopped"], "unmatched": ran["unmatched"], "leftovers_after": after, "grew": grew,
            "error": error})
        print("round %d (%s) recorded in %s%s" % (number, kind, sibling(sprint, "-results.jsonl"),
                                                  ", closed with the error " + error if error else ""), flush=True)
    return found, after, grew


def tested_round(args, root, testing, sprint, targets, kind):
    workers = budget_workers(root, sprint)
    shown = (lambda result: None) if args.json else (lambda result: print(result_text(result), flush=True))
    planned = [{"scenario": t["scenario"], "path": t["path"], "name": t["name"], "resources": t["resources"],
                "reads": t["reads"]} for t in targets]
    recorded = kind != "unrecorded"
    counted = recorded or bool(args.only)
    before = leftover_counts(root, testing) if counted else None
    if recorded:
        found, after, grew = recorded_round(root, testing, sprint, kind, workers, targets, planned, before, shown)
    else:
        found = suite_outcome(root, testing, workers, targets, shown)
        after = leftover_counts(root, testing) if counted else None
        grew = grown(before, after) if counted else []
    results = round_results(planned, found["results"], found["stopped"], True)
    if args.json:
        print(json.dumps(results, indent=2))
        return 0
    for result in results:
        if result["scenario"] not in found["results"]:
            print(result_text(result))
    print("%d passed, %d failed, %d not run" % (sum(1 for r in results if r["passed"]),
                                                sum(1 for r in results if failed(r)),
                                                sum(1 for r in results if r.get("not_run"))))
    if counted:
        print_leftovers(before, after, grew)
    if found["setup_failed"]:
        print(found["tail"])
    if found["stopped"]:
        print("the run stopped: no result or output arrived for testing.silence, %d seconds, or for the longer "
              "silence a test still running declares" % testing["silence"])
    if found["unmatched"]:
        print("%d result lines matched no planned test" % len(found["unmatched"]))
    print("slowest %d by what each costs the run's wall time under testing.schedule %s (workers: %d):"
          % (testing["slowest"], testing["schedule"]["form"], workers))
    for result in ranked_slowest(results, testing["slowest"], workers, {t["scenario"]: t for t in targets},
                                 testing["schedule"]["form"]):
        print("  %s, adds %ss" % (result_text(result), result["cost"]))
    return 0


def owner_issues(plan):
    return {s["id"]: s["issue"] for s in plan["scenarios"] if s.get("issue")}


def held_promises(root, run):
    return {text_field(item, "scenario"): text_field(item, "issue")
            for item in run_items(root, run, "promises") if item["state"] == "held"}


def open_issue_scenarios(root, scenarios):
    carried = {s["id"]: s["issue"] for s in scenarios if s.get("issue")}
    if not carried:
        return set()
    held = open_issue_ids(root)
    return {sid for sid, issue in carried.items() if issue in held}


# @decision: test-loop-fixes-code-never-tests
def settled_scenarios(root, sprint):
    return (set(owner_issues(sprint_plan(root, sprint))) | set(held_promises(root, run_file(root, sprint)))
            | defect_tests(ledger_defects(root, sprint), PROMISED)
            | open_issue_scenarios(root, read_state(root)["scenarios"]))


def round_failures(root, sprint, entry):
    settled = settled_scenarios(root, sprint)
    found = [r for r in entry["results"] if failed(r)] + entry_failures(entry, recorded_schedule(root))
    return [failure for failure in found if failure["scenario"] not in settled]


def entry_failures(entry, schedule):
    return leftover_failures(entry) + stopped_failures(entry) + schedule_failures(entry, schedule)


def entry_tests(failure, entry):
    if failure.get("schedule"):
        return set(failure["schedule"])
    if failure.get("tests"):
        return set(failure["tests"])
    return {target["scenario"] for target in entry["planned"]}


def entry_cleared(tests, needs_every, entry):
    if not entry["closed"]:
        return False
    reached = {result["scenario"] for result in entry["results"] if not result.get("not_run")}
    return tests <= reached if needs_every else bool(tests & reached)


# @decision: fixes-rerun-the-tests-they-reach
def standing_entries(rounds, schedule):
    whole = latest_whole(rounds)
    standing = []
    for entry in rounds:
        if whole is not None and entry["round"] < whole["round"]:
            continue
        standing = [kept for kept in standing if not entry_cleared(kept[1], kept[2], entry)]
        rerun = (entry.get("kind") or "whole") != "whole"
        standing += [(dict(failure, round=entry["round"]), entry_tests(failure, entry),
                      rerun or bool(failure.get("schedule"))) for failure in entry_failures(entry, schedule)]
    latest = {failure["scenario"]: failure for failure, _, _ in standing}
    return [latest[sid] for sid in sorted(latest)]


# @decision: fixes-rerun-the-tests-they-reach
# @decision: test-loop-fixes-code-never-tests
def unsettled_failures(root, sprint):
    rounds = results_rounds(root, sprint)
    settled = settled_scenarios(root, sprint)
    perf = [failure for failure in perf_failures(root, sprint) if failure["scenario"] not in settled]
    if not rounds:
        return None, perf
    standing = standing_results(rounds, live_tests(root, sprint))
    failing = [standing[sid] for sid in sorted(standing) if failed(standing[sid])]
    found = failing + standing_entries(rounds, recorded_schedule(root))
    return rounds[-1], [failure for failure in found if failure["scenario"] not in settled] + perf


def latest_whole(rounds):
    return next((entry for entry in reversed(rounds) if (entry.get("kind") or "whole") == "whole" and entry["closed"]),
                None)


def since_round(rounds):
    whole = latest_whole(rounds)
    return whole["round"] if whole else rounds[0]["round"] if rounds else "-"


# @decision: fixes-rerun-the-tests-they-reach
def standing_results(rounds, live):
    whole = latest_whole(rounds)
    standing = {}
    for entry in rounds:
        if whole is not None and entry["round"] < whole["round"]:
            continue
        for result in entry["results"]:
            earlier = standing.get(result["scenario"])
            if result["scenario"] in live and not (result.get("not_run") and earlier and not earlier.get("not_run")):
                standing[result["scenario"]] = dict(result, round=entry["round"], blobs=entry.get("test_files") or {})
    return standing


# @decision: tests-isolated-unless-declared
def leftover_failures(entry):
    before, after = entry.get("leftovers_before") or {}, entry.get("leftovers_after") or {}
    return [{"scenario": LEFTOVERS + kind, "path": None, "name": None, "passed": False, "seconds": None,
             "leftovers": kind, "tail": "testing.leftovers counted %s %s before round %d and %s after it"
             % (before.get(kind, 0), kind, entry["round"], after.get(kind, "-"))}
            for kind in entry.get("grew") or []]


def stopped_failures(entry):
    unreached = [result["scenario"] for result in entry["results"] if result.get("not_run")]
    if not entry.get("stopped") or not unreached:
        return []
    return [{"scenario": STOPPED + entry["stopped"], "path": None, "name": None, "passed": False, "seconds": None,
             "tests": unreached, "tail": "round %d stopped after testing.silence seconds, or the longer silence a test "
             "still running declared, with no result and no output, and reached no result for %s: one of them hangs"
             % (entry["round"], ", ".join(unreached))}]


def cmd_failures(args, root):
    sprint = resolved_sprint(root, args.sprint)
    latest, failing = unsettled_failures(root, sprint)
    if args.json:
        print(json.dumps({"round": latest["round"] if latest else None, "failures": failing}, indent=2))
        return 0
    if latest is None and not failing:
        print("no round recorded yet: run `tests run --sprint %s`" % sprint)
        return 0
    if latest is None:
        print("no round recorded yet: %d unsettled product-slow verdicts" % len(failing))
    else:
        print("round %d: %d unsettled failures standing since round %s" % (latest["round"], len(failing),
                                                                           since_round(results_rounds(root, sprint))))
    for result in failing:
        where = ("speed item %s" % result["perf"] if result.get("perf")
                 else "round %s" % result.get("round", latest["round"]))
        print("- %s %s %s: %s" % (result["scenario"], result["path"] or "-", where, first_line(result["tail"])))
    return 0


def own_rerun(rounds, whole, sid):
    for entry in rounds:
        if entry["round"] <= whole["round"] or entry.get("kind") != "rerun":
            continue
        if [target["scenario"] for target in entry["planned"]] != [sid] or entry["results"][0].get("not_run"):
            continue
        return "passed" if entry["results"][0]["passed"] else "failed"
    return None


def reached_files(reaches, sids):
    return sorted({path for sid in sids for path in reaches.get(sid) or []})


def suite_report(entry, failure, number, files, rerun=None):
    test = failure["scenario"]
    where = locator({"path": failure["path"], "name": failure["name"]}) if failure.get("path") else test
    fields = {"area": SUITE_AREA, "hunt": 1, "entry": entry, "test": test, "round": number, "files": files,
              "site": failure.get("site") or where}
    said = ["%s %s" % (test, "failed in whole-suite round %s" % number if entry == FAILING_TEST
                       else "stands in whole-suite round %s" % number if number is not None else "stands")]
    if rerun:
        fields["rerun"] = rerun
        said.append("its rerun alone %s" % rerun)
    return "%s: %s" % ("; ".join(said), failure.get("tail") or "-"), fields


# @decision: test-loop-fixes-code-never-tests
# @story: catch-broken-promises
def suite_reports(root, sprint):
    rounds = results_rounds(root, sprint)
    whole = latest_whole(rounds)
    held = settled_scenarios(root, sprint)
    reaches = reaches_map(root, sprint)
    number = whole["round"] if whole else None
    reports = []
    if whole:
        for result in whole["results"]:
            if failed(result):
                reports.append(suite_report(FAILING_TEST, result, number, reached_files(reaches, [result["scenario"]]),
                                            own_rerun(rounds, whole, result["scenario"])))
        reports += [suite_report(GROWN_LEFTOVERS, failure, number, []) for failure in leftover_failures(whole)]
        reports += [suite_report(FAILING_TEST, failure, number, reached_files(reaches, failure["tests"]))
                    for failure in stopped_failures(whole)]
        reports += [suite_report(SCHEDULE_BREACH, failure, number, reached_files(reaches, failure["schedule"]))
                    for failure in schedule_failures(whole, recorded_schedule(root))]
    for failure in perf_failures(root, sprint):
        sid = failure["scenario"][len(PERF_PREFIX):].rsplit(":", 1)[0]
        site = (failure.get("site") or "").split("::")[0]
        reports.append(suite_report(SLOW_PRODUCT, failure, number,
                                    sorted(set(reached_files(reaches, [sid])) | ({site} if site else set()))))
    kept = [report for report in reports if report[1]["test"] not in held]
    return kept, sorted(report[1]["test"] for report in reports if report[1]["test"] in held)


def reported_key(fields):
    if str(fields.get("entry")) == SLOW_PRODUCT:
        return (str(fields.get("test")),)
    return str(fields.get("test")), str(fields.get("round"))


# @decision: test-loop-fixes-code-never-tests
def cmd_reports(args, root):
    testing_config(root, args.sprint)
    sprint = resolved_sprint(root, args.sprint)
    ledger = selected_ledger(root, sprint)
    if ledger is None:
        raise InputError("the selected run, %s, is no sprint certification ledger of %s: select the ledger "
                         "`/converge sprint %s` opened with `tasks use <ledger>` and run reports again"
                         % (selected_run(root) or "none", sprint, sprint))
    reports, held = suite_reports(root, sprint)
    standing = {reported_key(item.get("fields") or {}) for item in review.items_of(root, "reports", REPORT_KEY)
                if (item.get("fields") or {}).get("area") == SUITE_AREA}
    fresh = [report for report in reports if reported_key(report[1]) not in standing]
    items = review.add_reports(root, REPORT_KEY, fresh)
    print(json.dumps({"ledger": ledger, "reports": [
        {"item": item, "entry": fields["entry"], "test": fields["test"], "round": fields["round"]}
        for item, (_, fields) in zip(items, fresh)],
        "already": sorted(report[1]["test"] for report in reports if reported_key(report[1]) in standing),
        "held": held}, indent=1))
    return 0


def unsettled_send_backs(root, sprint, live):
    latest = {}
    for run in record_runs(root, sprint):
        items, records = run_items(root, run, "speed"), recorded_tests(root, run)
        for sid in {text_field(item, "scenario") for item in items if text_field(item, "scenario")}:
            latest[sid] = (latest_verdict(items, sid), records)
    found = []
    for sid, (verdict, records) in sorted(latest.items()):
        entry = live.get(sid)
        if verdict is None or verdict["state"] != "sent-back" or entry is None or not (entry["test"] or {}).get("path"):
            continue
        if rewrite_accepted(records, sid, verdict) or test_blob(root, entry) == text_field(verdict, "digest"):
            continue
        found.append("speed item %s sent %s back, and no accepted rewrite settles it nor does its test file stand at "
                     "its last passing version, blob %s: accept the rewrite, or return the test file to that blob"
                     % (verdict["id"], sid, text_field(verdict, "digest") or "-"))
    return found


# @story: certify-completion
# @decision: test-loop-fixes-code-never-tests
def settled_failures(root, sprint, ledger):
    rounds = results_rounds(root, sprint)
    whole = latest_whole(rounds)
    live = live_tests(root, sprint)
    failures = []
    if whole is None:
        failures.append("no closed whole-suite round is recorded in %s: run `tests run --sprint %s`"
                        % (sibling(sprint, "-results.jsonl"), sprint))
    else:
        late = late_tasks(root, whole, labelled_tasks(root, sprint, ledger))
        if late:
            failures.append("%s closed after whole-suite round %d and changed files outside the test paths: run the "
                            "whole suite again" % (", ".join(late), whole["round"]))
        standing = standing_results(rounds, live)
        unrun = [sid for sid in sorted(live) if sid not in standing or standing[sid].get("not_run")]
        if unrun:
            failures.append("%s ran in no round since whole-suite round %d: run the whole suite again"
                            % (", ".join(unrun), whole["round"]))
    _, failing = unsettled_failures(root, sprint)
    failures += ["%s stands failing, and no promised defect, held promise, owner issue, or open issue on its "
                 "scenario holds it: %s"
                 % (failure["scenario"], first_line(failure.get("tail"))) for failure in failing]
    return whole, failures + unsettled_send_backs(root, sprint, live)


# @story: certify-completion
def cmd_settled(args, root):
    testing_config(root, args.sprint)
    sprint = resolved_sprint(root, args.sprint)
    ledger = opened_run(root, project_relative(root, args.ledger))
    used = certification_ledger(root, sprint)
    if used != ledger:
        raise InputError("%s is not the ledger the tool reads for the certification of %s, %s: select the "
                         "certification's ledger with `tasks use %s`" % (ledger, sprint, used or "none", ledger))
    whole, failures = settled_failures(root, sprint, ledger)
    if failures:
        print("NOT SETTLED: %s" % sprint)
        for failure in failures:
            print("- %s" % failure)
        return 2
    print("SETTLED: %s: whole-suite round %d ran after the last change, every failure is held, and every speed "
          "send-back is settled or back at its last passing version" % (sprint, whole["round"]))
    return 0


# @decision: tests-spend-time-only-on-their-outcome
def cmd_slowest(args, root):
    sprint = resolved_sprint(root, args.sprint)
    source = STATE_SOURCE if args.from_state else args.round
    picked = speed_candidates(root, sprint, source, run_file(root, sprint))
    if args.json:
        print(json.dumps(picked, indent=2))
        return 0
    origin = "the ranking %s carries" % STATE if source == STATE_SOURCE else "round %d" % source
    if not picked:
        print("no unsettled test in %s: every ranked test's speed is settled, or no test has a passing whole-suite "
              "time at its test file as it stands" % origin)
        return 0
    print("%d unsettled tests from %s, ranked by what each costs the run's wall time under testing.schedule %s "
          "(workers: %d):" % (len(picked), origin, picked[0]["form"], picked[0]["workers"]))
    for row in picked:
        print("  %d. %s %s median %ss over %d runs, adds %ss; blob %s, support digest %s"
              % (row["rank"], row["scenario"], locator(row["test"]), row["median"], row["rounds"], row["cost"],
                 row["blob"], row["support"]))
    return 0


# @decision: fixes-rerun-the-tests-they-reach
# @decision: scenario-list-decided-once
def reaches_map(root, sprint):
    recorded = read_state(root).get("reaches", {})
    if not isinstance(recorded, dict) or not all(isinstance(sid, str) and reached_paths(paths) is not None
                                                 for sid, paths in recorded.items()):
        raise InputError("%s: reaches is not a map of scenario ids to lists of paths; only this tool writes it, so "
                         "restore it from git" % STATE)
    reaches = {sid: reached_paths(paths) for sid, paths in recorded.items()}
    for entry in results_rounds(root, sprint):
        for result in entry["results"]:
            if result.get("not_run"):
                continue
            if "reaches" in result:
                reaches[result["scenario"]] = result["reaches"]
            else:
                reaches.pop(result["scenario"], None)
    return reaches


def changed_files(root, paths):
    changed = sorted({project_relative(root, path) for path in paths})
    outside = [path for path in changed if os.path.isabs(path) or path == ".." or path.startswith("../")]
    if outside:
        raise InputError("--files %s: name each file the fix changed by its path inside the project"
                         % ", ".join(outside))
    return changed


# @decision: fixes-rerun-the-tests-they-reach
def cmd_reached(args, root):
    form = testing_config(root, args.sprint)["reaches"]["form"]
    sprint = resolved_sprint(root, args.sprint)
    changed = changed_files(root, args.files)
    if form == "none":
        sys.stderr.write("tests: testing.reaches is none, so the suite command records no reaches: rerun only the "
                         "tests the fix was for, and the final whole-suite round catches the rest\n")
        return 0
    live = live_tests(root, sprint)
    reaches = {sid: paths for sid, paths in reaches_map(root, sprint).items() if sid in live}
    unnamed = [path for path in changed if not any(covers(entry, path) for paths in reaches.values() for entry in paths)]
    if unnamed:
        sys.stderr.write("tests: no live test's reaches names %s, so every live test reruns\n" % ", ".join(unnamed))
        rerun = sorted(live)
    else:
        rerun = sorted(sid for sid in live if sid not in reaches
                       or any(covers(entry, path) for entry in reaches[sid] for path in changed))
    unrecorded = [sid for sid in sorted(live) if sid not in reaches]
    if unrecorded and not unnamed:
        sys.stderr.write("tests: %s record no reaches, so each reruns after every fix\n" % ", ".join(unrecorded))
    for sid in rerun:
        print(sid)
    return 0


def stray_paths(root, sprint):
    live = live_tests(root, sprint)
    claimed = set()
    for entry in live.values():
        if entry["test"]:
            claimed.add(entry["test"]["path"])
        claimed.update(entry["support"])
    plan = sprint_plan(root, sprint)
    state = read_state(root)
    kept = {os.path.normpath(path) for path in (plan.get("kept") or []) + state["kept"]}
    files = tree_files(root, plan_folders(plan))
    recorded = {path for s in state["scenarios"] + plan["scenarios"] for path in s.get("support") or []}
    recorded |= {e["path"] for e in plan["legacy"] if e["sort"] == "support" and e["path"]}
    candidates = review.test_paths(root, files) | (recorded & set(files))
    return sorted(path for path in candidates if path not in claimed and path not in kept)


def cmd_stray(args, root):
    sprint = resolved_sprint(root, args.sprint)
    strays = stray_paths(root, sprint)
    if args.json:
        print(json.dumps(strays, indent=2))
        return 0
    if not strays:
        print("None.")
    for path in strays:
        print("- %s" % path)
    return 0


def file_task(root, run, role, key, files, brief, after=(), cites=(), prompt=None):
    args = ["file", "--role", role, "--prompt", prompt or role, "--agent", "ok-opus", "--key", key, "--brief", brief]
    if files:
        args += ["--files", *files]
    if after:
        args += ["--after", *sorted(set(after))]
    if cites:
        args += ["--cites", *cites]
    out = tasks_run(root, run, *args).strip()
    return {"role": role, "key": key, "task": out.split()[-1] if out else None}


def scenario_brief(s, support=None):
    support = s.get("support") if support is None else support
    parts = ["scenario %s (%s): %s" % (s["id"], s["action"], s["text"]), "Source: %s." % s.get("source")]
    for name in ("part", "class", "harm"):
        if s.get(name):
            parts.append("%s: %s." % (name.capitalize(), s[name]))
    if s.get("test"):
        parts.append("Test: %s." % locator(s["test"]))
    if support:
        parts.append("Support: %s." % ", ".join(support))
    for name in ("kind", "setup", "entry"):
        if s.get(name):
            parts.append("%s: %s." % (name.capitalize(), s[name]))
    if s.get("reach"):
        parts.append("Reach: %s" % s["reach"])
    if s.get("waits"):
        parts.append("Waits on: %s." % s["waits"])
    if s.get("resources"):
        parts.append("Shared resources it declares it changes: %s." % ", ".join(s["resources"]))
    if s.get("reads"):
        parts.append("Shared resources it declares it reads and does not change: %s." % ", ".join(s["reads"]))
    elif s.get("resources") and s.get("reads") is None:
        parts.append("It declares no reads, so it counts as reading every shared resource.")
    if s.get("ruling"):
        parts.append("Owner's ruling: %s" % s["ruling"])
    return " ".join(parts)


def holders_of(tasks, roles):
    holders = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") in roles and task.get("state") != "closed":
            for path in task.get("files") or []:
                holders[path] = task["id"]
    return holders


def planned_file(filings, holders, role, key, files, brief, after=(), cites=()):
    waits = [holders[path] for path in files if path in holders] + list(after)
    filing = {"op": "file", "role": role, "key": key, "files": list(files), "brief": brief,
              "after": sorted(set(waits)), "cites": list(cites), "task": "+%d" % len(filings)}
    filings.append(filing)
    for path in files:
        holders[path] = filing["task"]
    return filing


def planned_refile(filings, holders, task, brief=None, after=(), files=None):
    filing = {"op": "refile", "role": task.get("role"), "key": task.get("key"), "of": task["id"], "brief": brief,
              "after": sorted(set(after)), "copied": list(task.get("after") or []), "files": files,
              "task": "+%d" % len(filings)}
    filings.append(filing)
    for path in (task.get("files") or []) if files is None else files:
        holders[path] = filing["task"]
    return filing


def planned_files(filings, holders, task, files):
    filing = {"op": "files", "role": task.get("role"), "key": task.get("key"), "of": task["id"], "after": [],
              "files": files, "task": task["id"]}
    filings.append(filing)
    for path in files:
        holders[path] = task["id"]
    return filing


def set_files(root, run, task, files):
    tasks_run(root, run, "task", "set", task, "--field", "files=%s" % json.dumps(files))


def filed_tasks(root, run, filings):
    ids, filed = {}, []
    for filing in filings:
        after = [ids.get(dep, dep) for dep in filing["after"]]
        if filing["op"] == "file":
            task = file_task(root, run, filing["role"], filing["key"], filing["files"], filing["brief"], after,
                             filing["cites"])
        elif filing["op"] == "refile":
            args = ["refile", filing["of"]] + (["--brief", filing["brief"]] if filing["brief"] is not None else [])
            out = tasks_run(root, run, *(args + (["--after", *after] if after else []))).strip()
            task = {"role": filing["role"], "key": filing["key"], "task": out.split()[-1] if out else None,
                    "refile_of": filing["of"]}
            if filing["files"] is not None:
                set_files(root, run, task["task"], filing["files"])
                task["files"] = filing["files"]
        else:
            set_files(root, run, filing["of"], filing["files"])
            task = {"role": filing["role"], "key": filing["key"], "task": filing["of"], "files": filing["files"]}
        ids[filing["task"]] = task["task"]
        filed.append(task)
    return filed


# @decision: test-support-written-before-tests
def after_refusals(filings, tasks):
    by_id = {task["id"]: task for task in tasks}
    refusals = []
    for filing in filings:
        if filing["op"] == "files":
            continue
        what = ("the refile of %s task %s (%s)" % (filing["role"], filing["of"], filing["key"])
                if filing["op"] == "refile" else "a new %s task (%s)" % (filing["role"], filing["key"]))
        for dep in filing["after"] or filing.get("copied") or []:
            waited = by_id.get(dep)
            if waited and waited.get("state") == "closed" and waited.get("outcome") != "done":
                refusals.append("%s would wait on %s task %s (%s), which closed %s: %s; surface it as a genuine "
                                "blocker" % (what, waited.get("role"), dep, waited.get("key"), waited.get("outcome"),
                                             waited.get("result") or "-"))
    return refusals


def refile_successors(tasks):
    return {task["previous"]: task["id"] for task in sorted(tasks, key=task_order) if task.get("previous")}


def latest_of(tid, successors):
    seen = {tid}
    while successors.get(tid) and successors[tid] not in seen:
        tid = successors[tid]
        seen.add(tid)
    return tid


def given_after_refusals(after, tasks, successors):
    by_id = {task["id"]: task for task in tasks}
    refusals = []
    for named in after:
        dep = latest_of(named, successors)
        waited = by_id.get(dep)
        if waited is None:
            refusals.append("--after names %s, which is no task of the run: name the build tasks of the code stages "
                            "the test stages follow" % named)
        elif waited.get("state") == "closed" and waited.get("outcome") != "done":
            through = "" if dep == named else ", whose latest refile is %s," % dep
            refusals.append("--after names %s task %s (%s)%s which closed %s: %s; surface it as a genuine blocker"
                            % (waited.get("role"), named, waited.get("key"), through or ",", waited.get("outcome"),
                               waited.get("result") or "-"))
    return refusals


def refused_write(refusals):
    return InputError("--stage write files nothing:\n" + "\n".join("- %s" % refusal for refusal in refusals))


def task_order(task):
    digits = re.sub(r"\D", "", task.get("id") or "")
    return int(digits) if digits else 0


def registered_prompts(root, run):
    return {json.loads(line).get("id") for line in tasks_run(root, run, "dump", "--type", "prompt").split("\n")
            if line.strip()}


def support_of(plan, s):
    if s["action"] not in ("new", "rewrite"):
        return []
    return sorted(set(s.get("support") or []) | {e["path"] for e in plan["legacy"]
                                                 if e["sort"] == "support" and s["id"] in e["scenarios"]})


def cited_scenarios(task):
    return {cite for cite in task.get("cites") or [] if not cite.startswith(SUPPORT_CITE)}


def cited_support_items(task):
    return {cite[len(SUPPORT_CITE):] for cite in task.get("cites") or [] if cite.startswith(SUPPORT_CITE)}


def support_item_path(item):
    return text_field(item, "path") or item.get("key")


# @decision: test-support-written-before-tests
def write_refusals(run, tasks, items):
    ordered = sorted(tasks, key=task_order)
    support = [task for task in ordered if task.get("role") == "support"]
    latest = {(task.get("role"), task.get("key")): task for task in ordered}
    refusals = []
    for item in items:
        if text_field(item, "change") not in SUPPORT_CHANGES:
            refusals.append("support item %s (%s) records change %s, not one of %s: set it with `%s --file %s item "
                            "set %s --field change=<%s>`" % (
                                item["id"], support_item_path(item), json.dumps(field(item, "change")),
                                ", ".join(SUPPORT_CHANGES), TASKS, run, item["id"], "|".join(SUPPORT_CHANGES)))
        briefed = [task for task in support if item["id"] in cited_support_items(task)]
        if not briefed:
            continue
        last = latest.get(("support", briefed[-1].get("key"))) or briefed[-1]
        if item["state"] == "open" and last.get("state") == "closed" and last.get("outcome") == "done":
            refusals.append("support item %s (%s) stands open, and support task %s, whose brief named it, closed "
                            "done; surface it as a genuine blocker" % (item["id"], support_item_path(item), last["id"]))
    filers = {item.get("task") for item in items}
    by_scenario = {}
    for task in ordered:
        if task.get("role") == "test":
            by_scenario.setdefault(task.get("key"), []).append(task)
    for sid, mine in sorted(by_scenario.items()):
        last_two = mine[-2:]
        if len(last_two) == 2 and all(t.get("state") == "closed" and t.get("outcome") == "blocked" for t in last_two) \
                and not any(t["id"] in filers for t in last_two):
            refusals.append("scenario %s: test tasks %s closed blocked twice, and neither filed a support item: %s; "
                            "surface it as a genuine blocker"
                            % (sid, ", ".join(t["id"] for t in last_two), last_two[-1].get("result")))
    return refusals


# @decision: test-loop-fixes-code-never-tests
def awaits_verifier(item):
    return item["state"] == "open" and test_of(item) is not None and not field(item, "retired") \
        and not field(item, "gap")


def sender_of(item):
    return "the speed reviewer" if text_field(item, "by") == SPEED_SENDER else "the verifier"


def sent_back_tests(records, tasks):
    ordered = sorted(tasks, key=task_order)
    found = []
    for sid, item in sorted(records.items()):
        if item["state"] != "sent-back":
            continue
        mine = [task for task in ordered if task.get("role") == "test" and task.get("key") == sid]
        last = mine[-1] if mine else None
        if last is not None and (last.get("state") != "closed"
                                 or task_order(last) > task_order({"id": item.get("task")})):
            continue
        found.append((sid, item, last))
    return found


def rewrite_support(plan, s, item):
    planned = set(s.get("support") or []) | set(support_of(plan, s)) if s else set()
    return sorted(planned | set(list_field(item, "support")))


def rewrite_files(plan, s, item, last):
    tests = {path for path in [text_field(item, "path"), *((last or {}).get("files") or [])] if path}
    return sorted(tests | set(rewrite_support(plan, s, item)))


# @decision: test-tasks-own-the-tests
def refiled_tests(plan, records, tasks, holders, filings, state):
    by_id = {s["id"]: s for s in plan["scenarios"]}
    for sid, item, last in sent_back_tests(records, tasks):
        s = by_id.get(sid) or (carried_scenario(state, sid) if last is None else None)
        files = rewrite_files(plan, s, item, last)
        base = scenario_brief(s, rewrite_support(plan, s, item)) if s else (
            (last or {}).get("brief") or "scenario %s" % sid)
        brief = "%s\n%s sent the test back: %s" % (
            base, sender_of(item).capitalize(), text_field(item, "reason") or first_line(item.get("body")))
        if last is None:
            planned_file(filings, holders, "test", sid, files, brief)
            continue
        after = {holders[path] for path in files if path in holders}
        planned_refile(filings, holders, last, brief, after,
                       None if files == sorted(last.get("files") or []) else files)


def unwidened_rewrites(plan, records, tasks):
    by_id = {s["id"]: s for s in plan["scenarios"]}
    ordered = sorted(tasks, key=task_order)
    found = []
    for sid, item in sorted(records.items()):
        if item["state"] != "sent-back":
            continue
        mine = [task for task in ordered if task.get("role") == "test" and task.get("key") == sid]
        last = mine[-1] if mine else None
        if last is None or last.get("state") != "open" or task_order(last) <= task_order({"id": item.get("task")}):
            continue
        files = sorted(set(last.get("files") or []) | set(rewrite_files(plan, by_id.get(sid), item, last)))
        if files != sorted(last.get("files") or []):
            found.append((last, files))
    return found


def blocked_on_support(tasks, items):
    latest = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") == "test":
            latest[task.get("key")] = task
    filed_by = {}
    for item in items:
        filed_by.setdefault(item.get("task"), []).append(item)
    return [(task, filed_by[task["id"]]) for sid, task in sorted(latest.items())
            if task.get("state") == "closed" and task.get("outcome") == "blocked" and task["id"] in filed_by]


def support_brief(path, scenarios, items):
    lines = ["support file %s." % path]
    if scenarios:
        lines.append("Scenarios whose tests use it:")
        lines += ["- %s" % scenario_brief(s) for s in scenarios]
    if items:
        lines.append("Support to make, each a support item to mark made once the file holds it:")
        lines += ["- support item %s (%s, scenario %s): %s" % (
            item["id"], SUPPORT_CHANGE_TEXT.get(text_field(item, "change"), text_field(item, "change")),
            text_field(item, "scenario") or "-", item.get("body") or "") for item in items]
    return "\n".join(lines)


def stage_support(plan, existing, tasks, items, holders, filings):
    support = sorted((task for task in tasks if task.get("role") == "support"), key=task_order)
    served, count, latest = {}, {}, {}
    for task in support:
        for path in task.get("files") or []:
            served.setdefault(path, set()).update(cited_scenarios(task))
            count[path] = count.get(path, 0) + 1
            latest[path] = task["id"]
    held = {path for task in support if task.get("state") != "closed" for path in task.get("files") or []}
    briefed = set().union(*(cited_support_items(task) for task in support)) if support else set()
    wanting, open_items = {}, {}
    for s in plan["scenarios"]:
        if s["action"] in WRITTEN and ("test", s["id"]) not in existing:
            for path in support_of(plan, s):
                if s["id"] not in served.get(path, set()):
                    wanting.setdefault(path, []).append(s)
    for item in items:
        path = support_item_path(item)
        if item["state"] == "open" and item["id"] not in briefed and path and path not in held:
            open_items.setdefault(path, []).append(item)
    for path in sorted(set(wanting) | set(open_items)):
        n = count.get(path, 0) + 1
        key = "support:%s" % path if n == 1 else "support:%s:%d" % (path, n)
        scenarios, mine = wanting.get(path, []), open_items.get(path, [])
        cites = sorted(s["id"] for s in scenarios) + [SUPPORT_CITE + item["id"] for item in mine]
        filing = planned_file(filings, holders, "support", key, [path], support_brief(path, scenarios, mine),
                              cites=cites)
        latest[path] = filing["task"]
        briefed.update(item["id"] for item in mine)
    return latest, briefed


def unregistered(sprint, run, role, stage):
    prompt = sibling(sprint, "-%s.md" % role)
    return InputError("the run registers no %s prompt, so --stage %s files nothing: assemble it with `review prompt "
                      "--name test-%s --sprint %s --out %s`, run `tasks --file %s prompt register %s %s`, and run "
                      "--stage %s again" % (role, stage, role, sprint, prompt, run, role, prompt, stage))


def stack_named(plan):
    budget = plan.get("budget")
    return isinstance(budget, dict) and bool(budget.get("stack")) and budget["stack"] != NO_STACK


def preflight_brief(budget):
    lines = ["the test stack's budget: %d workers; start the stack with: %s" % (budget["workers"], budget["stack"]),
             "Sizing: %s" % budget["sizing"],
             "Files you may edit, to that sizing: %s." % (", ".join(budget["files"]) or "none")]
    lines += ["Limit %s: %s, %s" % (limit["limit"], limit["how"], limit["detail"]) for limit in budget["limits"]]
    return "\n".join(lines)


# @decision: tests-isolated-unless-declared
def stage_preflight(root, sprint, run, plan, tasks, prompts, after):
    if not stack_named(plan):
        return None
    if plan["budget"].get("preflight") and plan["budget"] == read_state(root)["budget"]:
        return None
    mine = sorted((task for task in tasks if task.get("role") == "preflight"), key=task_order)
    last = mine[-1] if mine else None
    if last is not None and last.get("state") == "closed" and last.get("outcome") == "done":
        return None
    if last is not None and last.get("state") != "closed":
        return []
    if "preflight" not in prompts:
        raise unregistered(sprint, run, "preflight", "write")
    budget = plan["budget"]
    if last is None:
        return [file_task(root, run, "preflight", "preflight", budget["files"], preflight_brief(budget), after)]
    if len(mine) >= 2 and all(task.get("outcome") == "blocked" for task in mine[-2:]):
        raise InputError("preflight tasks %s closed blocked twice: %s; surface it as a genuine blocker"
                         % (", ".join(task["id"] for task in mine[-2:]), last.get("result")))
    brief = "%s\nThe last preflight, %s, closed %s: %s" % (preflight_brief(budget), last["id"], last.get("outcome"),
                                                          last.get("result") or "-")
    out = tasks_run(root, run, "refile", last["id"], "--brief", brief).strip()
    return [{"role": "preflight", "key": "preflight", "task": out.split()[-1] if out else None, "refile_of": last["id"]}]


# @decision: test-support-written-before-tests
def stage_write(root, sprint, run, plan, existing, tasks, after):
    prompts = registered_prompts(root, run)
    if "support" not in prompts:
        raise unregistered(sprint, run, "support", "write")
    successors = refile_successors(tasks)
    refusals = given_after_refusals(after, tasks, successors)
    if refusals:
        raise refused_write(refusals)
    after = sorted({latest_of(dep, successors) for dep in after})
    planned = run == sibling(sprint, "-run.jsonl")
    preflight = stage_preflight(root, sprint, run, plan, tasks, prompts, after) if planned else None
    if preflight is not None:
        return preflight
    items = run_items(root, run, SUPPORT_POOL)
    refusals = write_refusals(run, tasks, items)
    if refusals:
        raise refused_write(refusals)
    holders = holders_of(tasks, [role for role in HOLDING_ROLES if role != "sweep"])
    filings = []
    latest_support, briefed = stage_support(plan if planned else dict(plan, scenarios=[]), existing, tasks, items,
                                            holders, filings)
    live = live_tests(root, sprint)
    state = {s["id"]: s for s in read_state(root)["scenarios"]}
    by_id = {s["id"]: s for s in plan["scenarios"]}
    for s in plan["scenarios"] if planned else []:
        if s["action"] not in WRITTEN or ("test", s["id"]) in existing:
            continue
        test = s.get("test") or (state.get(s["id"]) or {}).get("test") or {}
        old = (state.get(s["id"]) or {}).get("test") or {}
        if s["action"] == "retire" and not test and not old:
            continue
        files = sorted({path for path in (test.get("path"), old.get("path")) if path})
        waits = [latest_support[path] for path in support_of(plan, s) if path in latest_support]
        support = sorted(set(s.get("support") or []) | set(support_of(plan, s)))
        planned_file(filings, holders, "test", s["id"], files, scenario_brief(s, support), waits)
    by_file = {}
    for entry in plan["legacy"] if planned else []:
        if entry["sort"] in ("port", "delete"):
            by_file.setdefault(entry["path"], []).append(entry)
    for path, entries in sorted(by_file.items()):
        key = "legacy:%s" % path
        if ("legacy", key) in existing:
            continue
        lines = ["%s %s: %s" % (e["sort"], e["name"] or "the whole file",
                                e["reason"] if e["sort"] == "delete" else "enforces %s; becomes the check %s" % (rule_text(e), e["check"]))
                 for e in entries]
        at_path = [entry for entry in live.values() if entry["test"] and entry["test"]["path"] == path]
        kept = sorted({locator(e) for e in plan["legacy"] if e["path"] == path and e["sort"] in ("adopt", "support")}
                      | {locator(entry["test"]) for entry in at_path if entry["test"].get("name")})
        file_tests = sorted(entry["id"] for entry in at_path if not entry["test"].get("name"))
        brief = "legacy file %s. %s.%s%s" % (
            path, "; ".join(lines), " Keep as written: %s." % ", ".join(kept) if kept else "",
            " Keep as written every test in it the lines above do not name: the whole file is the test of %s."
            % ", ".join(file_tests) if file_tests else "")
        files = sorted({path} | {e["check"] for e in entries if e["sort"] == "port"})
        planned_file(filings, holders, "legacy", key, files, brief)
    records = recorded_tests(root, run)
    refiled_tests(plan, records, tasks, holders, filings, state)
    for task, files in unwidened_rewrites(plan, records, tasks):
        planned_files(filings, holders, task, files)
    for task, mine in blocked_on_support(tasks, items):
        if any(item["state"] == "open" and item["id"] not in briefed for item in mine):
            continue
        paths = set(support_of(plan, by_id[task["key"]]) if task.get("key") in by_id else []) | {
            support_item_path(item) for item in mine}
        waits = {latest_support[path] for path in paths if path in latest_support}
        waits |= {holders[path] for path in task.get("files") or [] if path in holders}
        planned_refile(filings, holders, task, None, waits)
    for filing in filings:
        if filing["op"] == "file":
            filing["after"] = sorted(set(filing["after"]) | set(after))
        elif filing["op"] == "refile":
            filing["after"] = sorted(set(filing["after"]) | {latest_of(dep, successors) for dep in filing["copied"]})
    refusals = after_refusals(filings, tasks)
    if refusals:
        raise refused_write(refusals)
    return filed_tasks(root, run, filings)


def stage_sweep(root, sprint, run, existing, tasks):
    if any(task.get("role") == "sweep" and task.get("state") != "closed" for task in tasks):
        return []
    strays = stray_paths(root, sprint)
    if not strays:
        return []
    n = 1 + sum(1 for role, key in existing if role == "sweep")
    return [file_task(root, run, "sweep", "sweep:%d" % n, strays,
                      "stray test files: %s" % ", ".join(strays))]


def planned_declaration(name, s, old):
    return next((list(record[name]) for record in (s, old) if isinstance(record.get(name), list)), None)


# @decision: test-tasks-own-the-tests
def declaration_changes(item, s, old):
    lines = []
    planned_resources = planned_declaration("resources", s, old)
    for name in ("resources", "reads"):
        recorded = field(item, name)
        planned = planned_declaration(name, s, old)
        if not isinstance(recorded, list) or (planned is not None and sorted(planned) == sorted(recorded)):
            continue
        reads_all = name == "reads" and planned is None and bool(planned_resources)
        added = [] if reads_all else sorted(set(recorded) - set(planned or []))
        before = ("none declared, so it reads every shared resource" if reads_all
                  else json.dumps(planned) if planned is not None else "none declared")
        lines.append("Declared %s changed: before %s; after %s.%s" % (
            name, before, json.dumps(recorded), " Added: %s." % ", ".join(added) if added else ""))
    for name in PLAN_TEXT:
        recorded, planned = text_field(item, name), s.get(name) or old.get(name)
        if recorded and recorded != planned:
            lines.append("Plan text %s changed: before %s; after %s." % (name, planned or "none", recorded))
    return lines


def created_at(record):
    return (record.get("created") or record.get("at") or "").rstrip("Z")


def own_run(rounds, item, tasks, ledger):
    task = next((task for task in tasks if task["id"] == item.get("task")), None)
    if task is None:
        return None
    sid, found = text_field(item, "scenario"), None
    label = LEDGER_TASK % (ledger, task["id"]) if ledger else task["id"]
    for entry in rounds:
        if label in (entry.get("tasks_closed") or []) or created_at(entry) < created_at(task):
            continue
        result = next((r for r in entry["results"] if r["scenario"] == sid and not r.get("not_run")), None)
        if result is not None:
            found = (entry["round"], result)
    return found


def own_run_text(ran, item):
    if ran is None:
        return "No round records a run of it by its test task %s." % (item.get("task") or "-")
    number, result = ran
    return "Its seconds in round %d, the run its test task %s made: %ss, %s." % (
        number, item.get("task"), result.get("seconds"), "passed" if result["passed"] else "failed")


def declarations_text(item, s, old):
    entry = {"resources": declared_resources(s, old), "reads": declared_reads(s, old)}
    recorded_declarations(entry, item)
    lines = ["Shared resources it declares it changes: %s." % (", ".join(entry["resources"]) or "none")]
    if entry["reads"] is not None:
        lines.append("Shared resources it declares it reads and does not change: %s."
                     % (", ".join(entry["reads"]) or "none"))
    elif entry["resources"]:
        lines.append("It declares no reads, so it counts as reading every shared resource.")
    else:
        lines.append("It declares no reads and changes no shared resource, so it is isolated.")
    return lines


def test_verify_brief(item, s, old, ran, workers):
    parts = ["tests item %s: scenario %s. Test: %s." % (item["id"], text_field(item, "scenario"),
                                                        locator(test_of(item)))]
    if s.get("reach"):
        parts.append("Reach: %s" % s["reach"])
    if s.get("waits"):
        parts.append("Waits on: %s." % s["waits"])
    parts.append(own_run_text(ran, item))
    parts.append("The budget's workers: %d." % workers)
    parts += declarations_text(item, s, old)
    parts += declaration_changes(item, s, old)
    parts.append(first_line(item.get("body")))
    return " ".join(parts)


# @decision: test-loop-fixes-code-never-tests
# @decision: tests-spend-time-only-on-their-outcome
def stage_verify(root, sprint, run, plan, existing, tasks):
    filed = []
    by_id = {s["id"]: s for s in plan["scenarios"]}
    state = {s["id"]: s for s in read_state(root)["scenarios"]}
    rounds = results_rounds(root, sprint)
    workers = budget_workers(root, sprint)
    ledger = None if run == sibling(sprint, "-run.jsonl") else run
    prompt = "verify" if ledger is None else LEDGER_VERIFY_PROMPT
    for item in recorded_tests(root, run).values():
        key = "verify:%s" % item["id"]
        if not awaits_verifier(item) or ("verify", key) in existing:
            continue
        sid = text_field(item, "scenario")
        brief = test_verify_brief(item, by_id.get(sid) or {}, state.get(sid) or {},
                                  own_run(rounds, item, tasks, ledger), workers)
        filed.append(file_task(root, run, "verify", key, [], brief, prompt=prompt))
    pools = {pool: run_items(root, run, pool) for pool in ("fixes", "promises")}
    chained = {"verify:%s" % item["id"] for items in pools.values() for item in items}
    unclosed = sorted((task for task in tasks if task.get("role") == "verify" and task.get("state") != "closed"
                       and task.get("key") in chained), key=task_order)
    previous = unclosed[-1]["id"] if unclosed else None
    for pool, items in pools.items():
        for item in items:
            key = "verify:%s" % item["id"]
            if item["state"] != "open" or ("verify", key) in existing:
                continue
            brief = "%s item %s: scenario %s, round %s. %s" % (
                pool, item["id"], text_field(item, "scenario"), field(item, "round"), first_line(item.get("body")))
            files = list_field(item, "files") if pool == "fixes" else []
            task = file_task(root, run, "verify", key, files, brief, [previous] if previous else (), prompt=prompt)
            previous = task["task"]
            filed.append(task)
    return filed


def late_tasks(root, entry, labelled):
    before = set(entry.get("tasks_closed") or [])
    changing = [(label, task) for label, task in labelled if task.get("role") in CHANGING_ROLES
                and task.get("state") == "closed" and label not in before]
    staged = sorted({path for _, task in changing for path in task.get("staged") or []})
    tests = review.test_paths(root, staged)
    return sorted(label for label, task in changing if set(task.get("staged") or []) - tests)


def test_blob(root, entry):
    return blob_of(root, os.path.normpath(entry["test"]["path"]), False)


def support_digest(root, entry):
    named = "".join("%s %s\n" % (rel, blob_of(root, rel, False) or "-")
                    for rel in sorted({os.path.normpath(path) for path in entry["support"]}))
    return hashlib.sha256(named.encode("utf-8")).hexdigest()[:16]


def seconds_of(value):
    if is_number(value):
        return value
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def accepted_at(accepted, blob, support, median):
    seconds = seconds_of(accepted.get("seconds"))
    return accepted.get("blob") == blob and (accepted.get("support") == support
                                             or (seconds is not None and median <= seconds))


def accepted_fixes(fixes):
    return {text_field(item, "perf") for item in fixes if item["state"] == "accepted" and text_field(item, "perf")}


def latest_verdict(items, sid):
    verdicts = sorted((item for item in items if text_field(item, "scenario") == sid
                       and item["state"] in SPEED_VERDICTS), key=task_order)
    return verdicts[-1] if verdicts else None


# @decision: tests-spend-time-only-on-their-outcome
def speed_settled(items, records, fixed, verified, state, sid, blob, support, median):
    latest = latest_verdict(items, sid)
    if latest is None:
        carried = state["acceptances"].get(sid)
        return carried is not None and accepted_at(carried, blob, support, median)
    if latest["state"] == "accepted":
        return accepted_at({"blob": text_field(latest, "digest"), "support": text_field(latest, "support"),
                            "seconds": field(latest, "seconds")}, blob, support, median)
    if latest["state"] == PRODUCT_SLOW:
        return latest["id"] not in fixed and perf_scenario(sid, latest["id"]) not in verified
    return rewrite_accepted(records, sid, latest)


def rewrite_accepted(records, sid, verdict):
    record = records.get(sid)
    return record is not None and record["state"] == "accepted" and task_order(record) > task_order(verdict)


def speed_sent_back(items, sid):
    return [item for item in items if text_field(item, "scenario") == sid and item["state"] in SPEED_BACKS]


def perf_scenario(sid, item_id):
    return "%s%s:%s" % (PERF_PREFIX, sid, item_id)


def perf_failure(sid, item):
    test = (text_field(item, "test") or "").split("::", 1)
    said = [item.get("task") or "-", sid] + [text_field(item, name) or "-" for name in ("site", "does", "grows",
                                                                                      "cheaper")]
    return {"scenario": perf_scenario(sid, item["id"]), "path": test[0] or None,
            "name": test[1] if len(test) > 1 else None, "passed": False,
            "seconds": seconds_of(field(item, "seconds")), "perf": item["id"], "site": text_field(item, "site"),
            "tail": "speed review %s found the test of %s slow because the product is slow at %s, which %s; its "
                    "cost grows %s; the cheaper behavior: %s" % tuple(said)}


# @decision: tests-spend-time-only-on-their-outcome
def perf_failures(root, sprint):
    latest = {}
    for run in record_runs(root, sprint):
        fixed = accepted_fixes(run_items(root, run, "fixes"))
        for item in sorted(run_items(root, run, "speed"), key=task_order):
            if item["state"] == PRODUCT_SLOW and text_field(item, "scenario"):
                latest[text_field(item, "scenario")] = (item, item["id"] in fixed)
    verified = defect_tests(ledger_defects(root, sprint), VERIFIED)
    found = [perf_failure(sid, item) for sid, (item, fixed) in sorted(latest.items()) if not fixed]
    return [failure for failure in found if failure["scenario"] not in verified]


def speed_source(root, sprint, source, live):
    tested = [sid for sid in sorted(live) if (live[sid]["test"] or {}).get("path")]
    if source == STATE_SOURCE:
        return [], tested, live, budget_workers(root, sprint)
    rounds = results_rounds(root, sprint)
    entry = next((entry for entry in rounds if entry["round"] == source), None)
    if entry is None or (entry.get("kind") or "whole") != "whole" or not entry["closed"]:
        raise InputError("round %s is no closed whole-suite round in %s: name a round `tests run --sprint %s` recorded "
                         "over the whole suite, or rank from the ranking %s carries with --from state"
                         % (source, sibling(sprint, "-results.jsonl"), sprint, STATE))
    recorded = "workers" in entry and all("resources" in target for target in entry["planned"])
    declared = {target["scenario"]: target for target in entry["planned"]} if recorded else live
    workers = entry["workers"] if recorded else budget_workers(root, sprint)
    ran = {target["scenario"] for target in entry["planned"]}
    return [counted for counted in rounds if counted["round"] <= source], [sid for sid in tested if sid in ran], \
        declared, workers


# @decision: tests-spend-time-only-on-their-outcome
def speed_rows(root, sprint, source, testing, run):
    state = read_state(root)
    live = live_tests(root, sprint)
    counted, sids, declared, workers = speed_source(root, sprint, source, live)
    form = testing["schedule"]["form"]
    items, records = run_items(root, run, "speed"), recorded_tests(root, run)
    fixed, verified = accepted_fixes(run_items(root, run, "fixes")), defect_tests(ledger_defects(root, sprint), VERIFIED)
    for rank, row in enumerate(speed_ranking(root, counted, state, live, declared, sids, workers, form,
                                             testing["slowest"]), 1):
        entry = live[row["scenario"]]
        support = support_digest(root, entry)
        _, values = median_seconds(counted, state, row["scenario"], os.path.normpath(entry["test"]["path"]),
                                   row["blob"])
        yield dict(row, rank=rank, test=entry["test"], support=support, rounds=len(values),
                   round=None if source == STATE_SOURCE else source, workers=workers, form=form,
                   settled=speed_settled(items, records, fixed, verified, state, row["scenario"], row["blob"],
                                         support, row["median"]))


# @decision: tests-spend-time-only-on-their-outcome
def speed_candidates(root, sprint, source, run):
    testing = testing_config(root, sprint)
    picked = []
    for row in speed_rows(root, sprint, source, testing, run):
        if len(picked) == testing["slowest"]:
            break
        if not row.pop("settled"):
            picked.append(row)
    return picked


def speed_brief(s, entry, row, backs):
    ranking = "round %d's ranking" % row["round"] if row["round"] is not None else "the ranking %s carries" % STATE
    lines = [scenario_brief(dict(s, test=entry["test"], resources=entry["resources"], reads=entry["reads"],
                                 **entry["plan_text"]), entry["support"]),
             "%s%s ranks it %d by what each test costs the run's wall time under testing.schedule %s with %d workers. "
             "Its median seconds, setup and teardown included, are %ss over %d passing whole-suite runs of its test "
             "file as it stands; it costs %ss, how much the lower bound on wall time under that schedule drops when "
             "its seconds drop to zero. Blob of its test file: %s. Digest of its support files: %s."
             % (ranking[0].upper(), ranking[1:], row["rank"], row["form"], row["workers"], row["median"],
                row["rounds"], row["cost"], row["blob"], row["support"])]
    for item in backs:
        if item["state"] == PRODUCT_SLOW:
            tail = perf_failure(row["scenario"], item)["tail"]
            lines.append(tail[0].upper() + tail[1:])
            continue
        lines.append("Speed review %s sent it back: %s" % (item.get("task") or "-", text_field(item, "reason")
                                                           or first_line(item.get("body"))))
    return "\n".join(lines)


def speed_refusal(root, sprint, run, source):
    if source == STATE_SOURCE:
        waiting = sorted(sid for sid, item in recorded_tests(root, run).items()
                         if item["state"] == "sent-back" or awaits_verifier(item))
        if waiting:
            return ("the tests of %s stand sent back or await their verifier: run --stage write and --stage verify "
                    "until neither files a task, then --stage speed --from state" % ", ".join(waiting))
        return None
    entry = next((entry for entry in results_rounds(root, sprint) if entry["round"] == source), None)
    if entry is None or (entry.get("kind") or "whole") != "whole" or not entry["closed"]:
        return ("round %d is no closed whole-suite round in %s: name the failed whole-suite round sprint "
                "certification works, or, in the build stages, read the ranking %s carries with --from state"
                % (source, sibling(sprint, "-results.jsonl"), STATE))
    if not round_failures(root, sprint, entry):
        return ("round %d lists no failure: the speed step follows a failed whole-suite round, so a passing round "
                "files no speed task; in the build stages, read the ranking %s carries with --from state"
                % (source, STATE))
    return None


def carried_scenario(state, sid):
    record = state.get(sid)
    return dict(record, id=sid, action="keep", text=record.get("text") or "-") if record else None


def awaits_rewrite(items, sid):
    latest = latest_verdict(items, sid)
    return latest is not None and latest["state"] == "sent-back"


# @decision: tests-spend-time-only-on-their-outcome
def stage_speed(root, sprint, run, plan, tasks, source):
    refusal = speed_refusal(root, sprint, run, source)
    if refusal:
        raise InputError("--stage speed files nothing: %s" % refusal)
    if "speed" not in registered_prompts(root, run):
        raise unregistered(sprint, run, "speed", "speed")
    live = live_tests(root, sprint)
    items = run_items(root, run, "speed")
    by_id = {s["id"]: s for s in plan["scenarios"]}
    state = {s["id"]: s for s in read_state(root)["scenarios"]}
    by_key = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") == "speed":
            by_key.setdefault(task.get("key"), []).append(task)
    filed = []
    for row in speed_candidates(root, sprint, source, run):
        sid = row["scenario"]
        if awaits_rewrite(items, sid):
            continue
        key = "speed:%s:%s" % (sid, row["blob"])
        mine = by_key.get(key, [])
        last = mine[-1] if mine else None
        verdicts = {item.get("task") for item in items if text_field(item, "scenario") == sid}
        settled = [task for task in mine if task.get("outcome") == "done" and task["id"] in verdicts]
        if last is not None and last.get("state") != "closed":
            continue
        s = by_id.get(sid) or carried_scenario(state, sid) or {"id": sid, "action": "keep", "text": "-"}
        brief = speed_brief(s, live[sid], row, speed_sent_back(items, sid))
        if last is None:
            filed.append(file_task(root, run, "speed", key, [], brief))
            continue
        if len(mine) >= 2 and not any(task in settled for task in mine[-2:]):
            raise InputError("scenario %s: speed tasks %s closed short of done or with no verdict twice: %s; surface "
                             "it as a genuine blocker" % (sid, ", ".join(task["id"] for task in mine[-2:]),
                                                          last.get("result")))
        brief += "\nThe last speed review, %s, closed %s%s: %s" % (
            last["id"], last.get("outcome"), "" if last["id"] in verdicts else " with no verdict",
            last.get("result") or "-")
        out = tasks_run(root, run, "refile", last["id"], "--brief", brief).strip()
        filed.append({"role": "speed", "key": key, "task": out.split()[-1] if out else None, "refile_of": last["id"]})
    return filed


def cmd_tasks(args, root):
    sprint = resolved_sprint(root, args.sprint)
    run = project_relative(root, opened_run(root, args.run)) if args.run else run_file(root, sprint)
    plan = sprint_plan(root, sprint)
    tasks = run_tasks(root, run)
    existing = {(task.get("role"), task.get("key")) for task in tasks}
    if args.stage == "write":
        filed = stage_write(root, sprint, run, plan, existing, tasks, args.after)
    elif args.stage == "sweep":
        filed = stage_sweep(root, sprint, run, existing, tasks)
    elif args.stage == "verify":
        filed = stage_verify(root, sprint, run, plan, existing, tasks)
    else:
        filed = stage_speed(root, sprint, run, plan, tasks, STATE_SOURCE if args.from_state else args.round)
    print(json.dumps({"stage": args.stage, "filed": filed}, indent=2))
    return 0


def review_config(root):
    config = read_json(root, REVIEW_CONFIG, "fix it by hand")
    if not isinstance(config, dict):
        raise InputError("%s does not hold an object: /ok seeds it" % REVIEW_CONFIG)
    if "checks" not in config:
        raise InputError("%s declares no checks, the project's check commands, which `review checks` reads too: "
                         "restore it, with [] where the project has none" % REVIEW_CONFIG)
    return config


def ported_items(root, run):
    latest = {}
    for task in sorted(run_tasks(root, run), key=task_order):
        if task.get("role") == "legacy":
            latest[task.get("key")] = task["id"]
    current = set(latest.values())
    return [item for item in run_items(root, run, "ports") if item.get("task") in current]


def ports_refusal(run, starting):
    lines = ["- ports item %s, recorded by legacy task %s: %r starts the test runner %r"
             % (item["id"], item.get("task") or "-", text_field(item, "command"), runner) for item, runner in starting]
    return ("no check added to %s: a check runs on every review, and review checks refuses one that starts a test "
            "runner:\n%s\nRefile each legacy task named with `%s --file %s refile <task> --brief \"<its brief>; revise: "
            "<this refusal>\"`, drain, and run `tests ports` again" % (REVIEW_CONFIG, "\n".join(lines), TASKS, run))


# @decision: legacy-suites-sorted-automatically
def cmd_ports(args, root):
    sprint = resolved_sprint(root, args.sprint)
    run = run_file(root, sprint)
    items = [item for item in ported_items(root, run) if text_field(item, "command")]
    config = review_config(root)
    checks, refusal = review.declared_checks(root, config)
    if refusal:
        raise InputError("%s; no check added" % refusal)
    runners = review.project_runners(root)
    starting = [(item, review.test_runner_of(text_field(item, "command"), runners)) for item in items]
    starting = [(item, runner) for item, runner in starting if runner]
    if starting:
        raise InputError(ports_refusal(run, starting))
    commands = [text_field(item, "command") for item in items]
    checks = list(checks)
    added = [command for command in dict.fromkeys(commands) if command not in checks]
    if added:
        config["checks"] = checks + added
        write_json(root, REVIEW_CONFIG, config)
    for command in added:
        print("added check: %s" % command)
    print("%d checks added to %s" % (len(added), REVIEW_CONFIG))
    return 0


def read_snapshots(root, sprint):
    snapshots = read_json(root, sibling(sprint, "-snapshots.json"), "only this tool writes it")
    return snapshots if isinstance(snapshots, dict) else {}


def git_bytes(root, *args):
    done = subprocess.run(["git", *args], cwd=root, capture_output=True)
    if done.returncode != 0:
        raise InputError("git %s failed: %s" % (" ".join(args), done.stderr.decode("utf-8", "replace").strip()))
    return done.stdout


def blob_of(root, rel, store):
    if not os.path.isfile(os.path.join(root, rel)):
        return None
    args = ["hash-object", "-w", "--", rel] if store else ["hash-object", "--", rel]
    return git(root, *args).strip()


def cmd_snapshot(args, root):
    sprint = resolved_sprint(root, args.sprint)
    snapshots = read_snapshots(root, sprint)
    snap = snapshots.setdefault(args.key, {"before": {}, "after": {}})
    paths = [os.path.normpath(rel) for rel in args.paths]
    if args.after:
        unseen = [rel for rel in paths if rel not in snap["before"]]
        if unseen:
            raise InputError("%s: no snapshot before the edit of %s; a fixer snapshots each file before it first "
                             "edits it" % (args.key, ", ".join(unseen)))
        paths = sorted(snap["before"])
        for rel in paths:
            snap["after"][rel] = blob_of(root, rel, True)
    else:
        for rel in paths:
            if rel not in snap["before"]:
                snap["before"][rel] = blob_of(root, rel, True)
    write_json(root, sibling(sprint, "-snapshots.json"), snapshots)
    print("snapshot %s %s: %s" % (args.key, "after" if args.after else "before", ", ".join(sorted(paths))))
    return 0


def blob_lines(root, blob):
    if blob is None:
        return b"", []
    content = git_bytes(root, "cat-file", "-p", blob)
    return content, content.decode("utf-8", "replace").splitlines(keepends=True)


def cmd_diff(args, root):
    sprint = resolved_sprint(root, args.sprint)
    snap = read_snapshots(root, sprint).get(args.key)
    if snap is None:
        raise InputError("no snapshot for %s: the fixer runs `tests snapshot` before its first edit" % args.key)
    closed = bool(snap["after"])
    for rel, blob in sorted(snap["before"].items()):
        before_bytes, before = blob_lines(root, blob)
        if closed:
            after_bytes, after = blob_lines(root, snap["after"].get(rel))
            gone = snap["after"].get(rel) is None
        else:
            path = os.path.join(root, rel)
            after_bytes = open(path, "rb").read() if os.path.isfile(path) else b""
            after = after_bytes.decode("utf-8", "replace").splitlines(keepends=True)
            gone = not os.path.isfile(path)
        if b"\0" in before_bytes or b"\0" in after_bytes:
            if before_bytes != after_bytes:
                print("Binary file %s differs" % rel)
            continue
        sys.stdout.writelines(difflib.unified_diff(before, after, "a/%s" % rel if blob else "/dev/null",
                                                   "/dev/null" if gone else "b/%s" % rel))
    if not closed:
        print("(no closing snapshot: this compares the snapshot with the tree as it stands)")
    return 0


def stamped_test(kept, entry):
    for name in ("reads", "silence") + STAMPED_TEXT:
        kept.pop(name, None)
    kept.update(test=entry["test"], support=sorted(entry["support"]), resources=list(entry["resources"]))
    if entry["reads"] is not None:
        kept["reads"] = list(entry["reads"])
    if entry["silence"]:
        kept["silence"] = entry["silence"]
    kept.update({name: entry["plan_text"][name] for name in STAMPED_TEXT if entry["plan_text"].get(name)})
    return kept


def gap_scenario(kept):
    for name in ("test", "support", "resources", "reads", "silence") + STAMPED_TEXT:
        kept.pop(name, None)
    return dict(kept, gap=True)


# @decision: scenario-list-decided-once
def stamped_scenario(root, s, old, entry, record):
    if s["action"] == "retire":
        made = bool(field(record or {}, "retired")) or not (s.get("test") or (old or {}).get("test"))
        return (None, True) if made else (old, False)
    kept = {"id": s["id"], "source": s.get("source"), "text": s["text"]}
    kept.update({name: s[name] for name in ("part", "class", "harm") + STAMPED_TEXT if s.get(name)})
    if s["action"] == "keep" and old:
        kept = dict(old, text=s["text"])
    if s["action"] == "gap" or field(record or {}, "gap") or (s["action"] == "keep" and (old or {}).get("gap")):
        return gap_scenario(kept), True
    test = (entry or {}).get("test")
    if test and os.path.isfile(os.path.join(root, test["path"])):
        return stamped_test(kept, entry), True
    return (kept, True) if s["action"] == "keep" else (old, False)


def waiting_issues(root, sprint, plan):
    waiting = owner_issues(plan)
    for run in record_runs(root, sprint):
        waiting.update(held_promises(root, run))
    waiting.update({text_field(defect, "test"): text_field(defect, "issue") for defect in ledger_defects(root, sprint)
                    if defect["state"] == PROMISED and text_field(defect, "test") and text_field(defect, "issue")})
    return waiting


# @decision: tests-spend-time-only-on-their-outcome
def stamped_acceptances(root, sprint, carried, tested):
    latest = {}
    for run in record_runs(root, sprint):
        items = run_items(root, run, "speed")
        for sid in tested:
            verdict = latest_verdict(items, sid)
            if verdict is not None:
                latest[sid] = verdict
    accepted = {}
    for sid, entry in sorted(tested.items()):
        verdict = latest.get(sid)
        held = carried.get(sid) if verdict is None else None
        if verdict is not None and verdict["state"] == "accepted":
            held = {"blob": text_field(verdict, "digest"), "support": text_field(verdict, "support"),
                    "seconds": seconds_of(field(verdict, "seconds"))}
        blob = test_blob(root, entry)
        if held is not None and blob is not None and held.get("blob") == blob:
            accepted[sid] = held
    return accepted


def stamped_budget(root, run, plan):
    budget = plan.get("budget")
    preflights = sorted((task for task in run_tasks(root, run) if task.get("role") == "preflight"), key=task_order)
    if isinstance(budget, dict) and preflights and preflights[-1].get("state") == "closed" \
            and preflights[-1].get("outcome") == "done":
        budget = dict(budget, preflight=preflights[-1]["id"])
    return budget


# @story: certify-completion
# @story: suite-gets-faster-over-time
# @decision: scenario-list-decided-once
def cmd_stamp(args, root):
    sprint = resolved_sprint(root, args.sprint)
    if not sprint.startswith(review.ARCHIVED_SPRINTS + os.sep):
        raise InputError("%s is not archived: move it to %s/ and commit the sprint's work first"
                         % (sprint, review.ARCHIVED_SPRINTS))
    if not SHA.match(args.commit) or not review.is_ancestor(root, args.commit, "HEAD"):
        raise InputError("--commit %r names no commit on this branch" % args.commit)
    recorded = read_state(root)
    if "stamp" in recorded:
        raise InputError("%s holds the earlier form's top-level stamp: run /ok, whose true-up converts it, or `tests "
                         "convert-state`, then stamp again" % STATE)
    testing = testing_config(root, None)
    run = run_file(root, sprint)
    plan = sprint_plan(root, sprint)
    live = live_tests(root, sprint)
    old = {s["id"]: s for s in recorded["scenarios"]}
    inferred = stamped_rules(plan, ported_items(root, run), sprint, recorded["inferred"])
    records = recorded_tests(root, *record_runs(root, sprint))
    waiting = waiting_issues(root, sprint, plan)
    rounds = results_rounds(root, sprint)
    failing = {sid for sid, result in standing_results(rounds, live).items() if failed(result)}
    planned = set(plan.get("stories") or [])
    unsettled = set()
    by_id = {}
    for s in plan["scenarios"]:
        kept, settled = stamped_scenario(root, s, old.get(s["id"]), live.get(s["id"]), records.get(s["id"]))
        story = STORY_SOURCE.match(s.get("source") or "")
        if not settled and story and story.group(1) in planned:
            unsettled.add(story.group(1))
        if kept is not None and kept is not old.get(s["id"]):
            kept.pop("issue", None)
            if s["id"] in failing and waiting.get(s["id"]):
                kept["issue"] = waiting[s["id"]]
        if kept is not None:
            by_id[s["id"]] = kept
    planned_ids = {s["id"] for s in plan["scenarios"]}
    by_id.update({sid: carried for sid, carried in old.items() if sid not in planned_ids})
    scenarios = [by_id[sid] for sid in sorted(by_id)]
    stamps = {slug: blob for slug, blob in recorded["stamps"].items() if slug not in planned}
    stamped = stamped_blobs(root, args.commit, sorted(planned - unsettled))
    stamps.update(stamped)
    tested = {s["id"]: {"test": s["test"], "support": list(s.get("support") or []),
                        "resources": declared_resources(s), "reads": declared_reads(s)}
              for s in scenarios if s.get("test")}
    ranked = sprint in recorded["ranked_sprints"]
    ranking = speed_ranking(root, [] if ranked else rounds, recorded, tested, tested, sorted(tested),
                            budget_workers(root, sprint), testing["schedule"]["form"], testing["slowest"])
    reaches = {sid: paths for sid, paths in sorted(reaches_map(root, sprint).items()) if sid in tested}
    state = {name: value for name, value in recorded.items() if name != "stamp"}
    state.update(stamps=stamps, scenarios=scenarios, unguarded=plan["unguarded"],
                 budget=stamped_budget(root, run, plan), inferred=inferred, kept=plan.get("kept") or [],
                 ranking=ranking, ranked_sprints=sorted(set(recorded["ranked_sprints"]) | {sprint}),
                 acceptances=stamped_acceptances(root, sprint, recorded["acceptances"], tested),
                 reaches=reaches)
    write_json(root, STATE, state)
    cleared = sorted(planned - set(stamped))
    print("stamped: %s from %s at %s, %d scenarios, %d tests, %d gaps" % (
        STATE, sprint, args.commit, len(scenarios), len(tested), sum(1 for s in scenarios if s.get("gap"))))
    print("story stamps: %s" % (", ".join(sorted(stamped)) or "none"))
    print("cleared: %s" % (", ".join("%s (%s)" % (slug, "a planned test the sprint did not write, keep, or retire"
                                                  if slug in unsettled else "no story file at %s" % args.commit)
                                     for slug in cleared) or "none"))
    print("ranking: %d tests; acceptances: %d; reaches: %d tests" % (len(ranking), len(state["acceptances"]),
                                                                     len(reaches)))
    return 0


# @decision: legacy-suites-sorted-automatically
def stamped_rules(plan, port_items, sprint, carried):
    commands = {text_field(item, "test"): text_field(item, "command") for item in port_items}
    fresh = []
    for entry in plan["legacy"]:
        if entry["sort"] != "port" or entry["rule"] != INFERRED:
            continue
        test = locator(entry)
        if not commands.get(test):
            raise InputError("legacy test %s ports an inferred rule, and no legacy task recorded its check's command: "
                             "refile that legacy task and drain it before the stamp" % test)
        fresh.append({"rule": entry.get("inferred"), "check": entry["check"], "command": commands[test], "test": test,
                      "sprint": sprint})
    checks = {rule["check"] for rule in fresh}
    return [rule for rule in carried if rule.get("check") not in checks] + fresh


# @decision: intake-writers-are-gated
def surviving_rules(root):
    waiting = [rule for rule in read_state(root)["inferred"] if not rule.get("settled")]
    if not waiting:
        return []
    checks, refusal = review.listed_checks(review_config(root))
    if refusal:
        raise InputError(refusal)
    return [rule for rule in waiting if rule.get("command") in checks]


def take_rule(args, root):
    practice = SETTLED_PRACTICE.match(args.settled)
    if not practice and args.settled != RETIRED:
        raise InputError("--as %r is neither practice:<slug> nor %s" % (args.settled, RETIRED))
    if practice and not os.path.isfile(os.path.join(root, PRACTICES, practice.group(1) + ".md")):
        raise InputError("--as %s names no practice: %s/%s.md does not exist, so apply the practice's delta first"
                         % (args.settled, PRACTICES, practice.group(1)))
    state = read_state(root)
    matches = [rule for rule in state["inferred"] if rule.get("check") == args.check]
    if not matches:
        raise InputError("no inferred rule records the check %r: `tests rules` lists the rules that wait" % args.check)
    waiting = [rule for rule in matches if not rule.get("settled")]
    if not waiting:
        raise InputError("the inferred rule of the check %s is already settled as %s" % (args.check, matches[-1]["settled"]))
    for rule in waiting:
        rule["settled"] = args.settled
    write_json(root, STATE, state)
    print("settled: the inferred rule of the check %s as %s" % (args.check, args.settled))
    return 0


def cmd_rules(args, root):
    if args.rules_verb == "take":
        return take_rule(args, root)
    rules = surviving_rules(root)
    if args.json:
        print(json.dumps(rules, indent=2))
        return 0
    for rule in rules:
        print("- `%s`: %s Ported from `%s` in %s; review checks runs `%s`."
              % (rule.get("check"), rule.get("rule"), rule.get("test"), rule.get("sprint"), rule.get("command")))
    if not rules:
        print("None: no inferred rule waits for /plan-sprint.")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="tests", add_help=False)
    verbs = parser.add_subparsers(dest="verb")
    for name, run in (("offers", cmd_offers), ("scenarios", cmd_scenarios)):
        verb = verbs.add_parser(name)
        verb.add_argument("--json", action="store_true")
        verb.set_defaults(handler=run)
    convert = verbs.add_parser("convert-state")
    convert.add_argument("--clear", nargs="+")
    convert.add_argument("--dry-run", dest="dry_run", action="store_true")
    convert.set_defaults(handler=cmd_convert_state)
    declare = verbs.add_parser("declare")
    declare.add_argument("--run")
    declare.add_argument("--silence", type=int)
    declare.add_argument("--named", choices=("yes", "no"))
    declare.add_argument("--leftovers")
    declare.add_argument("--slowest", type=int)
    declare.add_argument("--runners", nargs="*")
    declare.add_argument("--setup")
    declare.add_argument("--setup-silence", dest="setup_silence", type=int)
    declare.add_argument("--timeout")
    declare.add_argument("--enabled", choices=review.TESTING_STATES)
    declare.add_argument("--schedule", choices=SCHEDULE_FORMS)
    declare.add_argument("--schedule-said", dest="schedule_said")
    declare.add_argument("--reaches", choices=REACHES_FORMS)
    declare.add_argument("--reaches-said", dest="reaches_said")
    declare.add_argument("--offers", nargs="*")
    declare.set_defaults(handler=cmd_declare)
    enabled = verbs.add_parser("enabled")
    enabled.set_defaults(handler=cmd_enabled)
    budget = verbs.add_parser("budget")
    budget.add_argument("--from-run", dest="from_run", required=True)
    budget.set_defaults(handler=cmd_budget)
    run = verbs.add_parser("run")
    run.add_argument("--sprint")
    run.add_argument("--only", nargs="+")
    run.add_argument("--from", dest="from_file")
    run.add_argument("--failing", action="store_true")
    run.add_argument("--changed", action="store_true")
    run.add_argument("--json", action="store_true")
    run.set_defaults(handler=cmd_run)
    plan = verbs.add_parser("plan")
    plan.add_argument("--sprint", required=True)
    plan.add_argument("--from-run", dest="from_run")
    plan.add_argument("--show", action="store_true")
    plan.add_argument("--questions", action="store_true")
    plan.add_argument("--frozen", action="store_true")
    plan.add_argument("--json", action="store_true")
    plan.set_defaults(handler=cmd_plan)
    groups = verbs.add_parser("groups")
    groups.add_argument("--sprint", required=True)
    groups.add_argument("--from-run", dest="from_run", required=True)
    groups.add_argument("--size", type=int, default=GROUP_SIZE)
    groups.add_argument("--replan", nargs="+")
    groups.add_argument("--take", nargs="+")
    groups.add_argument("--new", nargs="+")
    groups.add_argument("--widen", nargs="*")
    groups.add_argument("--frozen", action="store_true")
    groups.add_argument("--json", action="store_true")
    groups.set_defaults(handler=cmd_groups)
    calls = verbs.add_parser("calls")
    calls.add_argument("stories", nargs="+")
    calls.add_argument("--json", action="store_true")
    calls.set_defaults(handler=cmd_calls)
    tasks = verbs.add_parser("tasks")
    tasks.add_argument("--sprint", required=True)
    tasks.add_argument("--stage", required=True, choices=("write", "sweep", "verify", "speed"))
    tasks.add_argument("--run")
    tasks.add_argument("--after", nargs="+", default=[])
    tasks.add_argument("--from", dest="from_state", choices=(STATE_SOURCE,))
    tasks.add_argument("--round", type=int)
    tasks.set_defaults(handler=cmd_tasks)
    reached = verbs.add_parser("reached")
    reached.add_argument("--sprint", required=True)
    reached.add_argument("--files", nargs="+", required=True)
    reached.set_defaults(handler=cmd_reached)
    slowest = verbs.add_parser("slowest")
    slowest.add_argument("--sprint", required=True)
    slowest.add_argument("--from", dest="from_state", choices=(STATE_SOURCE,))
    slowest.add_argument("--round", type=int)
    slowest.add_argument("--json", action="store_true")
    slowest.set_defaults(handler=cmd_slowest)
    reports = verbs.add_parser("reports")
    reports.add_argument("--sprint", required=True)
    reports.set_defaults(handler=cmd_reports)
    settled = verbs.add_parser("settled")
    settled.add_argument("--sprint", required=True)
    settled.add_argument("--ledger", required=True)
    settled.set_defaults(handler=cmd_settled)
    for name, run_verb in (("stray", cmd_stray), ("failures", cmd_failures)):
        verb = verbs.add_parser(name)
        verb.add_argument("--sprint", required=True)
        verb.add_argument("--json", action="store_true")
        verb.set_defaults(handler=run_verb)
    for name, run_verb in (("snapshot", cmd_snapshot), ("diff", cmd_diff)):
        verb = verbs.add_parser(name)
        verb.add_argument("--sprint", required=True)
        verb.add_argument("--key", required=True)
        if name == "snapshot":
            verb.add_argument("--after", action="store_true")
            verb.add_argument("paths", nargs="+")
        verb.set_defaults(handler=run_verb)
    ports = verbs.add_parser("ports")
    ports.add_argument("--sprint", required=True)
    ports.set_defaults(handler=cmd_ports)
    stamp = verbs.add_parser("stamp")
    stamp.add_argument("--sprint", required=True)
    stamp.add_argument("--commit", required=True)
    stamp.set_defaults(handler=cmd_stamp)
    rules = verbs.add_parser("rules")
    rules.add_argument("--json", action="store_true")
    rules.set_defaults(handler=cmd_rules)
    rule_verbs = rules.add_subparsers(dest="rules_verb")
    take = rule_verbs.add_parser("take")
    take.add_argument("check")
    take.add_argument("--as", dest="settled", required=True)
    return parser


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE + "\n")
        return 0
    if argv[0] == "version":
        print(VERSION)
        return 0
    args = build_parser().parse_args(argv)
    if not getattr(args, "handler", None):
        sys.stderr.write(USAGE + "\n")
        return 1
    if args.verb == "run" and sum(map(bool, (args.only, args.from_file, args.failing, args.changed))) > 1:
        raise SystemExit("tests: --only, --from, --failing, and --changed each choose the tests a run runs; give at "
                         "most one")
    if args.verb == "run" and args.failing and not args.sprint:
        raise SystemExit("tests: --failing reruns a sprint's standing failures; name the sprint with --sprint")
    if args.verb == "run" and args.changed and not args.sprint:
        raise SystemExit("tests: --changed reruns a sprint's tests whose files changed since they last ran; name the "
                         "sprint with --sprint")
    if args.verb == "slowest" and (args.from_state is None) == (args.round is None):
        raise SystemExit("tests: slowest ranks from one source: --from state, the ranking %s carries, or --round <n>, "
                         "a whole-suite round of the sprint; give exactly one" % STATE)
    if args.verb == "tasks" and args.stage == "speed" and (args.from_state is None) == (args.round is None):
        raise SystemExit("tests: --stage speed files one batch from one source: --from state, the ranking %s "
                         "carries, in the build stages, or --round <n>, the failed whole-suite round certification "
                         "names; give exactly one" % STATE)
    if args.verb == "tasks" and args.stage != "speed" and (args.from_state is not None or args.round is not None):
        raise SystemExit("tests: --from and --round choose the speed stage's source; --stage %s takes neither"
                         % args.stage)
    if args.verb == "tasks" and args.stage != "write" and args.after:
        raise SystemExit("tests: --after chains the write stage's new tasks behind the code stages; --stage %s takes "
                         "no --after" % args.stage)
    if args.verb == "run" and args.from_file and args.sprint:
        raise SystemExit("tests: --from runs the tests its file lists; it takes no --sprint")
    if args.verb == "declare" and (args.schedule is None) != (args.schedule_said is None):
        raise SystemExit("tests: --schedule and --schedule-said go together: --schedule names the form the suite "
                         "command runs, one of %s, and --schedule-said the owner's words for it"
                         % ", ".join(SCHEDULE_FORMS))
    if args.verb == "declare" and (args.reaches is None) != (args.reaches_said is None):
        raise SystemExit("tests: --reaches and --reaches-said go together: --reaches names what the suite command "
                         "writes as each test's reaches, one of %s, and --reaches-said the owner's words for it"
                         % ", ".join(REACHES_FORMS))
    if args.verb == "plan" and args.show and (args.from_run or args.questions or args.frozen):
        raise SystemExit("tests: --show prints the plan; it takes no --from-run, --questions, or --frozen")
    if args.verb == "plan" and args.questions and args.frozen:
        raise SystemExit("tests: --frozen goes with assembly; --questions lists the questions that wait")
    if args.verb == "groups" and args.frozen and (args.take or args.new or args.widen is not None):
        raise SystemExit("tests: --frozen plans only the rewrites and retirements each changed story needs; it takes "
                         "no --take, --new, or --widen")
    if args.verb == "rules" and args.json and args.rules_verb == "take":
        raise SystemExit("tests: --json goes with the listing; rules take prints one line")
    if args.verb == "plan" and args.json and not (args.show or args.questions):
        raise SystemExit("tests: --json goes with --show; assembly prints the counts, and --questions prints JSON already")
    try:
        return args.handler(args, project_root())
    except (InputError, review.ReviewError, review.issues.tasks.Unset, review.issues.tasks.PartGap) as err:
        sys.stderr.write("tests: %s\n" % err)
        return 1
    except Exception as err:
        review.issues.tasks.event("TESTS.RUN.FAILED", type=type(err).__name__, message=str(err))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
