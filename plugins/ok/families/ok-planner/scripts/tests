TITLE_PREFIX = "Test sprint: "


class InputError(Exception):
    pass


def load_sibling(name):
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    module = types.ModuleType("ok_planner_%s" % name)
    module.__file__ = path
    with open(path, encoding="utf-8") as f:
        exec(compile(f.read(), path, "exec"), module.__dict__)
    return module


review = load_sibling("review")


def project_root():
    env = os.environ.get("OK_PLANNER_PROJECT_ROOT")
    if env:
        return os.path.abspath(env)
    here = os.path.abspath(os.getcwd())
    while True:
        if os.path.isdir(os.path.join(here, ESTATE)):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            raise InputError("no %s estate in %s or any folder above it" % (ESTATE, os.getcwd()))
        here = parent


def read_text(root, rel):
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def read_json(root, rel, what):
    text = read_text(root, rel)
    if text is None:
        return None
    try:
        return json.loads(text)
    except json.JSONDecodeError as err:
        raise InputError("%s is not JSON (%s); %s" % (rel, err, what))


def write_replacing(path, body):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    staging = "%s.%d.tmp" % (path, os.getpid())
    try:
        with open(staging, "w", encoding="utf-8") as f:
            f.write(body)
        os.replace(staging, path)
    finally:
        if os.path.exists(staging):
            os.unlink(staging)


def write_json(root, rel, value):
    found = re.search(r"\n( +)\S", read_text(root, rel) or "")
    write_replacing(os.path.join(root, rel), json.dumps(value, indent=len(found.group(1)) if found else 2) + "\n")


def git(root, *args):
    done = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("git %s failed: %s" % (" ".join(args), done.stderr.strip()))
    return done.stdout


def stamp_held(root, stamp):
    return subprocess.run(["git", "cat-file", "-e", "%s^{commit}" % stamp], cwd=root,
                          capture_output=True, text=True).returncode == 0


def changed_since(root, stamp, folders):
    return sorted({os.path.normpath(path) for path in review.listed_changes(root, stamp, folders)})


def project_folders(root):
    return review.project_folders(root, "tests", "the tests tool")


def plan_folders(plan):
    if not isinstance(plan.get("folders"), list):
        raise InputError("the plan records no folders: assemble it again with `tests plan`")
    return plan["folders"]


# @story: project-spans-folders
def tree_files(root, folders):
    listed = git(root, "ls-files", "--cached", "--others", "--exclude-standard", "--", ".", *folders).split("\n")
    return sorted({os.path.normpath(path) for path in listed if path and os.path.isfile(os.path.join(root, path))})


def test_paths(root, paths):
    if not paths:
        return set()
    lint = os.path.join(root, PLUMBLINE)
    if not os.path.isfile(lint):
        raise InputError("no lint at %s: /ok materializes it" % PLUMBLINE)
    done = subprocess.run(["node", lint, "test-paths"], cwd=root, input="\n".join(paths) + "\n",
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("plumbline test-paths failed: %s" % (done.stderr or done.stdout).strip())
    return {line.strip() for line in done.stdout.split("\n") if line.strip()}


def earlier_testing(testing):
    run = testing.get("run")
    return "timeout" in testing or (isinstance(run, str) and "{path}" in run and "{tests}" not in run)


def is_command(value):
    return isinstance(value, str) and bool(value.strip())


def suite_command_refusal(run):
    missing = [holder for holder in ("{tests}", "{results}") if holder not in run]
    if missing:
        return ("%r holds no %s: the tool puts the path of the list of tests at {tests} and the path of the result "
                "stream at {results}" % (run, " and no ".join(missing)))
    return None


# @decision: scenario-list-decided-once
# @decision: settings-have-no-code-defaults
def testing_config(root):
    tasks = review.issues.tasks
    config = tasks.project_config(root)
    testing = config.get("testing")
    if not isinstance(testing, dict):
        raise InputError("%s declares no testing object: declare the suite command with `%s`" % (CONFIG, DECLARE))
    if earlier_testing(testing):
        raise InputError("%s: %s" % (CONFIG, EARLIER_TESTING))
    missing = ["testing.%s" % key for key in TESTING_KEYS if key not in testing]
    if missing:
        raise InputError("%s sets no %s: declare each with `%s`" % (CONFIG, ", ".join(missing), DECLARE))
    run = tasks.setting(config, "testing.run", is_command, "a non-empty command")
    setup = tasks.setting(config, "testing.setup", lambda value: value is None or is_command(value),
                          "a non-empty command, or null where the project needs no setup")
    if setup is not None and "setup_silence" not in testing:
        raise InputError("%s sets testing.setup and no testing.setup_silence: declare it with `tests declare "
                         "--setup-silence <seconds>`" % CONFIG)
    refusal = suite_command_refusal(run)
    if refusal:
        raise InputError("%s testing.run %s" % (CONFIG, refusal))
    return {"run": run, "silence": tasks.count(config, "testing.silence"),
            "named": tasks.setting(config, "testing.named", lambda named: isinstance(named, bool), "true or false"),
            "leftovers": tasks.setting(config, "testing.leftovers", is_command, "a non-empty command"),
            "slowest": tasks.count(config, "testing.slowest"),
            "runners": tasks.setting(config, "testing.runners",
                                     lambda runners: isinstance(runners, list) and all(map(is_command, runners)),
                                     "a list of non-empty commands"),
            "setup": setup,
            "setup_silence": tasks.count(config, "testing.setup_silence") if setup is not None else None}


def read_state(root):
    state = read_json(root, STATE, "only this tool writes it, so restore it from git")
    if state is None:
        return {"stamp": None, "scenarios": [], "unguarded": [], "budget": None, "inferred": [], "kept": []}
    if not isinstance(state, dict) or not isinstance(state.get("scenarios"), list):
        raise InputError("%s does not hold a scenario list" % STATE)
    state.setdefault("unguarded", [])
    state.setdefault("budget", None)
    state.setdefault("inferred", [])
    state.setdefault("kept", [])
    if not isinstance(state["inferred"], list) or not all(isinstance(rule, dict) for rule in state["inferred"]):
        raise InputError("%s: inferred is not a list of rules; only this tool writes it, so restore it from git" % STATE)
    if not isinstance(state["kept"], list) or not all(isinstance(path, str) and path for path in state["kept"]):
        raise InputError("%s: kept is not a list of paths; only this tool writes it, so restore it from git" % STATE)
    return state


def rule_text(entry):
    if entry.get("rule") == INFERRED:
        return 'the inferred rule "%s"' % (entry.get("inferred") or "-")
    return entry.get("rule") or "-"


def locator(test):
    if not test:
        return None
    return "%s::%s" % (test["path"], test["name"]) if test.get("name") else test["path"]


def claimed_paths(scenarios):
    paths = set()
    for scenario in scenarios:
        if scenario.get("test"):
            paths.add(scenario["test"]["path"])
        paths.update(scenario.get("support") or [])
    return paths


def window_entry(root, folders):
    state = read_state(root)
    stamp = state["stamp"]
    scenarios = state["scenarios"]
    stories = review.story_slugs(root)
    entry = {"stamp": stamp, "scenarios": len(scenarios),
             "tests": sum(1 for s in scenarios if s.get("test")),
             "gaps": sum(1 for s in scenarios if s.get("gap")), "reasons": [], "sprints": [],
             "stories_changed": [], "orphaned": [], "unmapped": [], "edited_tests": [], "kept": [], "changed": 0}
    for scenario in scenarios:
        source = STORY_SOURCE.match(scenario.get("source") or "")
        if source and source.group(1) not in stories:
            entry["orphaned"].append(scenario["id"])
    claimed = claimed_paths(scenarios)
    kept = {path for path in state["kept"] if os.path.isfile(os.path.join(root, path))}
    entry["kept"] = sorted(kept)
    entry["unmapped"] = sorted(path for path in test_paths(root, tree_files(root, folders))
                               if path not in claimed and path not in kept)
    if not stamp or not stamp_held(root, stamp):
        entry["status"] = "new"
        if stamp:
            entry["reasons"].append("stamp %s is not a commit this repository holds, as after a rebase; "
                                    "every scenario is planned again" % stamp)
        return entry
    changed = [path for path in changed_since(root, stamp, folders)
               if not path.startswith(ESTATE + os.sep) or path.startswith(DESIGN + os.sep)]
    entry["changed"] = len(changed)
    entry["sprints"] = review.sprints_closed_since(root, stamp)
    entry["stories_changed"] = sorted(path[len(STORIES) + 1:-3] for path in changed
                                      if path.startswith(STORIES + os.sep) and path.endswith(".md"))
    entry["edited_tests"] = sorted(path for path in changed if path in claimed and path not in kept
                                   and os.path.isfile(os.path.join(root, path)))
    if changed:
        entry["reasons"].append("%d files changed since the stamp" % len(changed))
    if entry["unmapped"]:
        entry["reasons"].append("%d test files no scenario claims" % len(entry["unmapped"]))
    entry["status"] = "reached" if entry["reasons"] else "current"
    return entry


def cmd_window(args, root):
    entry = window_entry(root, project_folders(root))
    if args.json:
        print(json.dumps(entry, indent=2))
        return 0
    print("stamp: %s status: %s" % (entry["stamp"] or "none", entry["status"]))
    print("scenarios: %d, tests: %d, gaps: %d" % (entry["scenarios"], entry["tests"], entry["gaps"]))
    for reason in entry["reasons"]:
        print("- %s" % reason)
    for name, label in (("sprints", "sprint closed since the stamp"), ("stories_changed", "story changed"),
                        ("orphaned", "scenario whose story is gone"), ("edited_tests", "claimed test edited"),
                        ("unmapped", "test file no scenario claims"),
                        ("kept", "test file an earlier plan kept outside its scope")):
        for value in entry[name]:
            print("  %s: %s" % (label, value))
    return 0


def cmd_scenarios(args, root):
    state = read_state(root)
    if args.json:
        print(json.dumps(state, indent=2))
        return 0
    print("stamp: %s" % (state["stamp"] or "none"))
    if not state["scenarios"]:
        print("None.")
    for scenario in state["scenarios"]:
        test = "gap" if scenario.get("gap") else locator(scenario.get("test")) or "-"
        print("- %s [%s]: %s Test: %s" % (scenario["id"], scenario.get("source"), scenario.get("text"), test))
    for entry in state["unguarded"]:
        print("- unguarded %s: %s" % (entry["path"], entry.get("reason")))
    return 0


def declared_values(args):
    if args.timeout is not None:
        raise InputError("--timeout is refused: a run of the suite command has no time limit per test, and stops "
                         "after testing.silence seconds with no result; pass --silence <seconds>")
    values = {}
    if args.run is not None:
        refusal = suite_command_refusal(args.run) if is_command(args.run) else "is empty"
        if refusal:
            raise InputError("--run %s" % refusal)
        values["run"] = args.run
    for name in ("silence", "slowest", "setup_silence"):
        value = getattr(args, name)
        if value is not None and value < 1:
            raise InputError("--%s %d: it is a whole number, 1 or more" % (name, value))
        if value is not None:
            values[name] = value
    if args.named is not None:
        values["named"] = args.named == "yes"
    if args.leftovers is not None:
        if not is_command(args.leftovers):
            raise InputError("--leftovers is empty: name a command that prints one JSON object of counts, such as "
                             "`echo {}` where the project counts nothing")
        values["leftovers"] = args.leftovers
    if args.setup is not None:
        if not is_command(args.setup):
            raise InputError("--setup is empty: name the command that gets the test environment ready, or none where "
                             "the project needs no setup")
        values["setup"] = None if args.setup.strip() == "none" else args.setup
    if args.runners is not None:
        if not all(map(is_command, args.runners)):
            raise InputError("--runners holds an empty command")
        values["runners"] = list(args.runners)
    if not values:
        raise InputError("declare names no key: pass any of --run, --silence, --named, --leftovers, --slowest, "
                         "--runners, --setup, and --setup-silence")
    return values


def cmd_declare(args, root):
    values = declared_values(args)
    config = review.issues.tasks.project_config(root)
    testing = dict(config["testing"]) if isinstance(config.get("testing"), dict) else {}
    testing.pop("timeout", None)
    testing.update(values)
    config["testing"] = testing
    write_json(root, CONFIG, config)
    for key in TESTING_KEYS + ("setup_silence",):
        if key in values:
            print("declared: testing.%s = %s" % (key, json.dumps(values[key])))
    unset = [key for key in TESTING_KEYS if key not in testing]
    if testing.get("setup") is not None and "setup_silence" not in testing:
        unset.append("setup_silence")
    if unset:
        print("still unset: %s" % ", ".join("testing.%s" % key for key in unset))
    return 0


def resolved_sprint(root, path, exists=True):
    rel = os.path.relpath(os.path.abspath(path), root) if os.path.isabs(path) else os.path.normpath(path)
    if not rel.startswith((TEST_SPRINTS + os.sep, ARCHIVED_TEST_SPRINTS + os.sep)) or not rel.endswith(".md"):
        raise InputError("%s is not a test sprint under %s/ or %s/" % (path, TEST_SPRINTS, ARCHIVED_TEST_SPRINTS))
    if exists and read_text(root, rel) is None:
        raise InputError("no test sprint at %s" % rel)
    return rel


def sibling(sprint, suffix):
    return sprint[:-3] + suffix


def read_plan(root, sprint):
    plan = read_json(root, sibling(sprint, "-plan.json"), "`tests plan` writes it, so assemble it again")
    if plan is None:
        raise InputError("no plan at %s: assemble it with `tests plan --sprint %s --from-run <run>`"
                         % (sibling(sprint, "-plan.json"), sprint))
    return plan


def tasks_run(root, run, *args):
    done = subprocess.run([sys.executable, os.path.join(root, TASKS), "--file", run, *args], cwd=root,
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("tasks %s failed: %s" % (" ".join(args), (done.stderr or done.stdout).strip()))
    return done.stdout


def run_tasks(root, run):
    return [json.loads(line) for line in tasks_run(root, run, "dump", "--type", "task").split("\n") if line.strip()]


def run_items(root, run, pool):
    return json.loads(tasks_run(root, run, "item", "list", "--pool", pool, "--json"))


def field(item, name):
    return (item.get("fields") or {}).get(name)


def text_field(item, name):
    value = field(item, name)
    return None if value is None else str(value)


def list_field(item, name):
    value = field(item, name)
    if value is None:
        return []
    if isinstance(value, list):
        return [str(entry) for entry in value]
    return [str(value)]


def first_line(value):
    return (value or "").split("\n")[0]


def latest_done(tasks, roles):
    latest = {}
    for task in tasks:
        if task.get("role") in roles:
            latest[(task.get("role"), task.get("key"))] = task
    return {task["id"] for task in latest.values() if task.get("state") == "closed" and task.get("outcome") == "done"}


def test_of(item):
    path = text_field(item, "path")
    return {"path": path, "name": text_field(item, "name")} if path else None


def scenario_of(item):
    scenario = {"id": text_field(item, "id"), "source": text_field(item, "source"),
                "action": text_field(item, "action"), "text": item.get("body") or "",
                "test": test_of(item), "support": list_field(item, "support"),
                "reach": text_field(item, "reach"), "entry": text_field(item, "entry"),
                "call": text_field(item, "call")}
    for name in ("part", "class", "harm", "kind", "setup", "waits"):
        if field(item, name) is not None:
            scenario[name] = text_field(item, name)
    if field(item, "resources") is not None:
        scenario["resources"] = field(item, "resources")
    return scenario


def apply_answer(scenario, answer, old):
    kind = text_field(answer, "answer")
    if kind == "retire":
        scenario["action"] = "retire"
    elif kind == "rewrite":
        scenario["action"] = "rewrite"
        if not scenario.get("test") and old.get("test"):
            scenario["test"] = dict(old["test"])
        if text_field(answer, "text"):
            scenario["text"] = text_field(answer, "text")
    elif kind == "issue":
        scenario["action"] = "keep"
        scenario["issue"] = text_field(answer, "issue")
    scenario["ruling"] = "%s: %s" % (kind, text_field(answer, "said") or "-")


def open_issue_ids(root):
    module = os.path.join(root, ISSUES)
    if not os.path.isfile(module):
        raise InputError("no intake module at %s: /ok materializes it" % ISSUES)
    done = subprocess.run([sys.executable, module, "list", "--json"], cwd=root, capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("issues list failed: %s" % (done.stderr or done.stdout).strip())
    return {record.get("id") for record in json.loads(done.stdout or "[]")}


def question_target(item):
    return text_field(item, "scenario") or text_field(item, "path")


def settled_questions(questions, selected):
    answered = {}
    for item in questions:
        if item["state"] == "answered":
            answered[question_target(item)] = item
    settled = []
    for item in selected:
        if item["state"] == "answered":
            settled.append(item)
        elif question_target(item) in answered:
            settled.append(dict(answered[question_target(item)], id=item["id"]))
        else:
            settled.append(item)
    return settled


def item_story(item, scenario_stories):
    if item.get("pool") == "scenarios":
        source = STORY_SOURCE.match(text_field(item, "source") or "")
        return source.group(1) if source else None
    if item.get("pool") == "questions":
        return scenario_stories.get((item.get("task"), text_field(item, "scenario")))
    return text_field(item, "story")


# @decision: scenario-list-decided-once
def planning_items(root, run):
    tasks = run_tasks(root, run)
    done = latest_done(tasks, PLAN_ROLES)
    order = {task["id"]: task_order(task) for task in tasks}
    story_tasks = {task["id"] for task in tasks if task["id"] in done and task.get("role") == "story"}
    owners = {}
    for item in run_items(root, run, "stories"):
        slug = text_field(item, "story") or item.get("key")
        if item.get("task") in story_tasks and slug and order[item["task"]] >= order.get(owners.get(slug), -1):
            owners[slug] = item["task"]
    pools = {pool: run_items(root, run, pool)
             for pool in ("scenarios", "questions", "legacy", "calls", "budget", "limits", "controls")}
    scenario_stories = {(item.get("task"), text_field(item, "id")): item_story(item, {})
                        for item in pools["scenarios"] if item.get("task") in story_tasks}

    def stands(item):
        if item.get("task") not in done:
            return False
        story = item_story(item, scenario_stories) if item.get("task") in story_tasks else None
        return story is None or owners.get(story) == item.get("task")

    selected = {pool: [item for item in items if stands(item)] for pool, items in pools.items()}
    selected["settled"] = settled_questions(pools["questions"], selected["questions"])
    selected.update(tasks=tasks, done=done, stories=owners)
    return selected


def item_origin(item):
    return (item["id"], item.get("task"))


def origin_text(origin):
    item, task = origin
    return "%s (task %s)" % (item, task) if item else "task %s" % task


def rested(origins, keys, text):
    found = [origin_text(origins[key]) for key in keys if key in origins]
    return "%s: %s" % (", ".join(found), text) if found else text


def project_relative(root, path):
    return os.path.normpath(os.path.relpath(path, root) if os.path.isabs(path) else path)


def planning_scope(root, run):
    items = run_items(root, run, "scope")
    if not items:
        raise InputError("the planning run records no scope: record the owner's answer with `tasks item add --pool "
                         "scope --key scope --field 'paths=[\"<path or glob>\", ...]' --field said=\"<the owner's "
                         "words>\"`")
    if len(items) > 1:
        raise InputError("the planning run records %d scope items, %s, and a run records one: drop the others with "
                         "`tasks item drop <item> --by plan-tests --reason \"<why>\"`"
                         % (len(items), ", ".join(item["id"] for item in items)))
    item = items[0]
    paths = field(item, "paths")
    if not isinstance(paths, list) or not paths or not all(isinstance(path, str) and path.strip() for path in paths):
        raise InputError("scope item %s: paths must be a non-empty list of non-empty paths or globs; set it with "
                         "`tasks item set %s --field 'paths=[\"<path or glob>\", ...]'`" % (item["id"], item["id"]))
    return {"paths": [project_relative(root, path.strip()) for path in paths], "said": text_field(item, "said") or ""}


def in_scope(root, path, paths):
    rel = project_relative(root, path)
    return any(scope == "." or rel == scope or rel.startswith(scope + os.sep) or fnmatch.fnmatchcase(rel, scope)
               for scope in paths)


def sort_files(root, folders, paths):
    entry = window_entry(root, folders)
    edited = set(entry["edited_tests"])
    claimed = claimed_paths(read_state(root)["scenarios"])
    listed = sorted(set(entry["unmapped"]) | edited | set(entry["kept"]))
    return {"sort": [{"path": path, "claimed": path in claimed} for path in listed if in_scope(root, path, paths)],
            "kept": [path for path in listed if not in_scope(root, path, paths)]}


def scope_failures(root, scenario, paths, left_unguarded):
    sid = scenario["id"]
    named = [("test", scenario["test"]["path"])] if scenario.get("test") else []
    named += [("support file", path) for path in scenario.get("support") or []]
    if scenario.get("entry"):
        named.append(("entry", scenario["entry"]))
    found = ["scenario %s: its %s %s lies outside the scope, %s" % (sid, what, path, ", ".join(paths))
             for what, path in named if not in_scope(root, path, paths)]
    if scenario.get("entry") and project_relative(root, scenario["entry"]) in left_unguarded:
        found.append("scenario %s: its entry %s is a program the owner left unguarded" % (sid, scenario["entry"]))
    return found


def kept_uses(scenarios, old_by_id):
    kept = []
    for scenario in scenarios:
        if scenario["action"] not in KEPT:
            continue
        old = old_by_id.get(scenario["id"]) or {}
        support = set(scenario.get("support") or [])
        if scenario["action"] == "keep":
            support |= set(old.get("support") or [])
        kept.append((scenario["id"], scenario.get("test") or old.get("test"),
                     {os.path.normpath(path) for path in support}))
    return kept


def reads(user, test):
    path, _, name = user.partition("::")
    if not test or os.path.normpath(path) != os.path.normpath(test["path"]):
        return False
    return not name or not test.get("name") or name == test["name"]


# @story: retire-a-legacy-suite
# @decision: legacy-suites-sorted-automatically
def sorted_support(legacy, kept):
    for entry in legacy:
        if entry["sort"] != "support":
            continue
        path = os.path.normpath(entry["path"]) if entry["path"] else None
        entry["scenarios"] = sorted(sid for sid, test, support in kept
                                    if path in support or any(reads(user, test) for user in entry["users"]))
        if entry["users"] and not entry["scenarios"]:
            entry.update(sort="delete", reason="orphan", note="no kept test uses it")


def story_citations(root, folders):
    cited = {}
    for rel in tree_files(root, folders):
        if rel.startswith(ESTATE + os.sep):
            continue
        try:
            with open(os.path.join(root, rel), encoding="utf-8") as f:
                slugs = set(STORY_CITATION.findall(f.read()))
        except UnicodeDecodeError:
            continue
        if slugs:
            cited[rel] = slugs
    return cited


def window_touches(root, sprint, folders, citations, entry):
    if entry["status"] == "new":
        return [(slug, "new") for slug in review.story_slugs(root)]
    if entry["status"] == "current":
        return []
    touches = [(slug, "changed") for slug in entry["stories_changed"]]
    for path in changed_since(root, entry["stamp"], folders):
        touches += [(slug, "cited %s" % path) for slug in sorted(citations.get(path, ()))]
    results = read_json(root, sibling(sprint, "-planning-results.json"), "write it again with `tests run --json`")
    if results is not None and not isinstance(results, list):
        raise InputError("%s does not hold a list of results: write it again with `tests run --json`"
                         % sibling(sprint, "-planning-results.json"))
    failed = {result.get("scenario") for result in results or [] if isinstance(result, dict) and not result.get("passed")}
    slow = slowest_recorded(root, results or [])
    for scenario in read_state(root)["scenarios"]:
        source = STORY_SOURCE.match(scenario.get("source") or "")
        if source and scenario["id"] in failed:
            touches.append((source.group(1), "failed %s" % scenario["id"]))
        if source and scenario["id"] in slow:
            touches.append((source.group(1), "%s%s (%ss)" % (SLOW_REASON, scenario["id"], slow[scenario["id"]])))
    return touches


# @decision: tests-spend-time-only-on-their-outcome
def slowest_recorded(root, results):
    timed = [result for result in results if isinstance(result, dict) and isinstance(result.get("scenario"), str)
             and isinstance(result.get("seconds"), (int, float)) and not isinstance(result.get("seconds"), bool)]
    if not timed:
        return {}
    ranked = ranked_slowest(timed, testing_config(root)["slowest"], budget_workers(root, None), live_tests(root))
    return {result["scenario"]: result["seconds"] for result in ranked}


def kept_as_recorded(reasons):
    return bool(reasons) and all(reason == "widen" or reason.startswith(SLOW_REASON) for reason in reasons)


# @decision: scenario-list-decided-once
def touched_stories(root, sprint, folders, citations, widen):
    entry = window_entry(root, folders)
    stories = set(review.story_slugs(root))
    touched = {}
    for slug, reason in window_touches(root, sprint, folders, citations, entry) + [(slug, "widen") for slug in widen]:
        if slug in stories:
            touched.setdefault(slug, []).append(reason)
    return entry, touched


def archived_plans(root):
    folder = os.path.join(root, ARCHIVED_TEST_SPRINTS)
    if not os.path.isdir(folder):
        return []
    found = []
    for name in sorted(os.listdir(folder)):
        sprint = os.path.join(ARCHIVED_TEST_SPRINTS, name)
        if not name.endswith(".md") or read_text(root, sibling(sprint, "-plan.json")) is None:
            continue
        stamp = review.closed_stamp(read_text(root, sprint) or "")
        if stamp:
            found.append({"sprint": sprint, "plan": sibling(sprint, "-plan.json"), "stamp": stamp,
                          "held": stamp_held(root, stamp)})

    def newer_first(a, b):
        if a["held"] and b["held"] and a["stamp"] != b["stamp"]:
            if review.is_ancestor(root, a["stamp"], b["stamp"]):
                return 1
            if review.is_ancestor(root, b["stamp"], a["stamp"]):
                return -1
        a_name, b_name = os.path.basename(a["sprint"]), os.path.basename(b["sprint"])
        return (a_name < b_name) - (a_name > b_name)

    return sorted(found, key=functools.cmp_to_key(newer_first))


def call_of_story(call, slug):
    if call.get("story"):
        return call["story"] == slug
    return any(value == slug or value.startswith(slug + "--")
               for value in (call.get("site"), call.get("key")) if isinstance(value, str))


# @decision: scenario-list-decided-once
def earlier_calls(root, slugs):
    plans = []
    for found in archived_plans(root):
        plan = read_json(root, found["plan"], "an archived plan is read as `tests plan` wrote it")
        if not isinstance(plan, dict) or not isinstance(plan.get("calls", []), list) \
                or not isinstance(plan.get("stories"), (list, type(None))):
            raise InputError("%s does not hold a plan: its calls and its stories are lists where present" % found["plan"])
        plans.append((found["plan"], plan))
    earlier = {}
    for slug in slugs:
        latest = next(((rel, plan) for rel, plan in plans if plan.get("stories") is None or slug in plan["stories"]),
                      None)
        if latest is None:
            earlier[slug] = {"plan": None, "calls": []}
            continue
        calls = [call for call in latest[1].get("calls") or [] if isinstance(call, dict)]
        kinded = any(call.get("kind") for call in calls)
        earlier[slug] = {"plan": latest[0], "calls": [
            {name: call.get(name) for name in ("key", "site", "kind", "story", "choice", "body")}
            for call in calls if call_of_story(call, slug) and (call.get("kind") == "untested" or not kinded)]}
    return earlier


def unknown_stories(root, slugs):
    known = set(review.story_slugs(root))
    unknown = [slug for slug in slugs if slug not in known]
    if unknown:
        raise InputError("no story at %s/<slug>.md for %s: name each story by the slug of its file"
                         % (STORIES, ", ".join(unknown)))


def cmd_calls(args, root):
    unknown_stories(root, args.stories)
    earlier = earlier_calls(root, args.stories)
    if args.json:
        print(json.dumps(earlier, indent=2))
        return 0
    for slug in args.stories:
        entry = earlier[slug]
        if not entry["plan"]:
            print("%s: no archived plan planned it" % slug)
            continue
        print("%s: planned last by %s; %d calls left a path out" % (slug, entry["plan"], len(entry["calls"])))
        for call in entry["calls"]:
            print("  - %s, %s" % (call["kind"] or "no kind", call_line(call)))
            for line in call["body"].split("\n") if call["body"] else []:
                print("    %s" % line if line else "")
    return 0


def planning_groups(touched, citations, size):
    joined = {slug: {slug} for slug in touched}
    for cited in citations.values():
        together = set().union(*(joined[slug] for slug in cited if slug in joined))
        for slug in together:
            joined[slug] = together
    components = {tuple(sorted(members)) for members in joined.values()}
    chunks = [list(members[i:i + size]) for members in components if len(members) > 1
              for i in range(0, len(members), size)]
    alone = sorted(members[0] for members in components if len(members) == 1)
    chunks += [alone[i:i + size] for i in range(0, len(alone), size)]
    return sorted(chunks, key=lambda chunk: chunk[0])


def planning_inputs(scope, questions):
    answers = []
    for item in questions:
        if item["state"] != "answered" or text_field(item, "scenario") or not text_field(item, "path"):
            continue
        kind = text_field(item, "answer")
        if kind == "issue":
            answers.append("%s: issue %s" % (text_field(item, "path"), text_field(item, "issue") or "-"))
        elif kind == "no-guard":
            answers.append("%s: no-guard, %s" % (text_field(item, "path"),
                                                 text_field(item, "reason") or text_field(item, "said") or "-"))
        else:
            answers.append("%s: %s" % (text_field(item, "path"), kind))
    return "scope: %s (paths: %s); program answers: %s" % (scope["said"] or "-", ", ".join(scope["paths"]),
                                                           "; ".join(sorted(answers)) or "none")


def group_brief(stories, touched, inputs, last_run):
    named = ", ".join("%s (%s)" % (slug, "; ".join(touched[slug])) for slug in stories)
    return "stories: %s; %s; the last run is at %s" % (named, inputs, last_run or "none")


def cmd_groups(args, root):
    sprint = resolved_sprint(root, args.sprint, exists=False)
    if args.size < 1:
        raise InputError("--size %d: a group holds at least one story" % args.size)
    unknown_stories(root, args.widen or [])
    if read_text(root, args.from_run) is None:
        raise InputError("no planning run at %s: open it as /plan-tests step 5 says" % args.from_run)
    scope = planning_scope(root, args.from_run)
    settled = planning_items(root, args.from_run)["settled"]
    waiting = [item for item in settled if item["state"] != "answered" and not text_field(item, "scenario")]
    if waiting:
        raise InputError("program questions stand unanswered: %s; ask the owner each one, record the answer, and "
                         "run tests groups again" % ", ".join("%s on %s" % (origin_text(item_origin(item)),
                                                                         question_target(item)) for item in waiting))
    folders = project_folders(root)
    citations = story_citations(root, folders)
    widen = sorted(set(args.widen or []))
    if args.widen == []:
        catalog = review.story_slugs(root)
        earlier = earlier_calls(root, catalog)
        widen = [slug for slug in catalog if earlier[slug]["calls"]]
    entry, touched = touched_stories(root, sprint, folders, citations, widen)
    results = sibling(sprint, "-planning-results.json")
    last_run = results if read_text(root, results) is not None else None
    inputs = planning_inputs(scope, settled)
    groups = [{"key": "group:%d" % n, "stories": chunk, "brief": group_brief(chunk, touched, inputs, last_run)}
              for n, chunk in enumerate(planning_groups(touched, citations, args.size), 1)]
    files = sort_files(root, folders, scope["paths"])
    record = {"status": entry["status"], "stamp": entry["stamp"], "runtime": entry["status"] != "current",
              "size": args.size, "inputs": inputs, "last_run": last_run, "widen": widen,
              "stories": {slug: touched[slug] for slug in sorted(touched)}, "groups": groups,
              "sort": files["sort"], "kept": files["kept"]}
    write_json(root, sibling(sprint, "-groups.json"), record)
    if args.json:
        print(json.dumps(record, indent=2))
        return 0
    print("written: %s" % sibling(sprint, "-groups.json"))
    print("window: %s; %d stories touched in %d groups; runtime planner: %s"
          % (entry["status"], len(touched), len(groups), "yes" if record["runtime"] else "no"))
    if args.widen is not None:
        print("widen: %s" % (", ".join(widen) or "none: no earlier plan's call left a path out of a story"))
    if not touched and entry["status"] == "current":
        print("nothing to plan: the window is current, and no story is widened")
    print("inputs: %s" % inputs)
    print("last run: %s" % (last_run or "none"))
    for group in groups:
        print()
        print(group["key"])
        for slug in group["stories"]:
            print("  - %s: %s" % (slug, "; ".join(touched[slug])))
        print("  brief: %s" % group["brief"])
    print()
    print("sort: %d test files inside the scope" % len(record["sort"]))
    for item in record["sort"]:
        print("  - %s%s" % (item["path"], " (claimed)" if item["claimed"] else ""))
    print("kept: %d test files outside the scope, left as they stand" % len(record["kept"]))
    for path in record["kept"]:
        print("  - %s" % path)
    return 0


def read_groups(root, sprint):
    rel = sibling(sprint, "-groups.json")
    groups = read_json(root, rel, "`tests groups` writes it, so write it again")
    if groups is None:
        raise InputError("no planning groups at %s: write them with `tests groups --sprint %s --from-run <run>`"
                         % (rel, sprint))
    if not isinstance(groups, dict) or not isinstance(groups.get("stories"), dict) \
            or not isinstance(groups.get("groups"), list):
        raise InputError("%s does not hold planning groups: write them again with `tests groups`" % rel)
    return groups


def unplanned_story(slug, groups, tasks):
    key = next((group.get("key") for group in groups["groups"] if slug in (group.get("stories") or [])), None)
    filed = [task["id"] for task in sorted(tasks, key=task_order) if task.get("role") == "story" and task.get("key") == key]
    return "story %s (%s)" % (slug, ", ".join([key or "no group"] + (["task %s" % filed[-1]] if filed else [])))


# @decision: tests-isolated-unless-declared
def planned_budget(items, origins):
    budget_tasks = sorted((task for task in items["tasks"] if task.get("role") == "budget" and task["id"] in items["done"]),
                          key=task_order)
    if not budget_tasks:
        raise InputError("no budget task closed done: file one as /plan-tests step 6 says, keyed budget, and drain")
    latest = budget_tasks[-1]["id"]
    recorded = [item for item in items["budget"] if item.get("task") == latest]
    if len(recorded) != 1:
        raise InputError("budget task %s records %d budget items, and a plan takes one: %s" % (
            latest, len(recorded), "refile it with `tasks refile %s`" % latest if not recorded else
            "drop the others with `tasks item drop <item> --by plan-tests --reason \"<why>\"`, keeping one of %s"
            % ", ".join(item["id"] for item in recorded)))
    item = recorded[0]
    origins[("budget",)] = item_origin(item)
    limits = []
    for limit in items["limits"]:
        if limit.get("task") != latest:
            continue
        origins[("limit", len(limits))] = item_origin(limit)
        limits.append({"limit": text_field(limit, "limit"), "how": text_field(limit, "how"),
                       "detail": text_field(limit, "detail"), "tests": first_line(limit.get("body"))})
    return {"workers": field(item, "workers"), "stack": text_field(item, "stack"), "sizing": text_field(item, "sizing"),
            "files": field(item, "files") if field(item, "files") is not None else [],
            "said": first_line(item.get("body")), "limits": limits}


def waited_control(scenario):
    found = WAITS.match(scenario.get("waits") or "")
    return found.group(2).strip() if found and found.group(1) == "control" else None


# @decision: test-sprints-build-approved-time-controls
def planned_controls(items, origins):
    controls, problems = {}, []
    for item in items["controls"]:
        cid = text_field(item, "id")
        if not cid:
            problems.append("%s: a time control item records no id field" % origin_text(item_origin(item)))
            continue
        control = {"id": cid, "form": text_field(item, "form"), "site": text_field(item, "site"),
                   "files": field(item, "files"), "gate": text_field(item, "gate")}
        first = controls.get(cid)
        if first is None:
            controls[cid] = dict(control, text=item.get("body") or "")
            origins[("control", cid)] = item_origin(item)
        elif {name: first[name] for name in control} != control:
            problems.append("%s and %s: time control %s is recorded with different fields; every planner that names "
                            "one control records its form, site, files, and gate alike"
                            % (origin_text(origins[("control", cid)]), origin_text(item_origin(item)), cid))
    return sorted(controls.values(), key=lambda control: control["id"]), problems


# @decision: every-timer-has-a-time-control
# @decision: test-sprints-build-approved-time-controls
def control_failures(plan, origins):
    failures = []
    ids = {control["id"] for control in plan.get("controls") or []}
    for scenario in plan["scenarios"]:
        sid, here, waits = scenario["id"], [("scenario", scenario["id"])], scenario.get("waits")
        if scenario["action"] in ("new", "rewrite") and not waits:
            failures.append(rested(origins, here, "scenario %s: %s names no waits, what its test waits on: %s"
                                   % (sid, scenario["action"], WAIT_KINDS)))
        elif waits and not WAITS.match(waits):
            failures.append(rested(origins, here, "scenario %s: waits %r is none of %s" % (sid, waits, WAIT_KINDS)))
        elif scenario["action"] in ("new", "rewrite") and (waited_control(scenario) or "").startswith(CONTROL_PREFIX) \
                and waited_control(scenario) not in ids:
            failures.append(rested(origins, here, "scenario %s: it waits on time control %s, which no time control "
                                   "item records" % (sid, waited_control(scenario))))
    for control in plan.get("controls") or []:
        cid, here = control["id"], [("control", control["id"])]
        if not CONTROL_ID.match(cid):
            failures.append(rested(origins, here, "time control %r: its id is control--<slug>, lower-case letters, "
                                   "digits, and hyphens" % cid))
        if control["form"] not in CONTROL_FORMS:
            failures.append(rested(origins, here, "time control %s: form %r is not one of %s"
                                   % (cid, control["form"], ", ".join(CONTROL_FORMS))))
        if not (control["site"] or "").strip():
            failures.append(rested(origins, here, "time control %s: it names no site, the path::symbol of its timer" % cid))
        files = control["files"]
        if not isinstance(files, list) or not files or not all(isinstance(path, str) and path.strip() for path in files):
            failures.append(rested(origins, here, "time control %s: files %s is not a list of the files it changes, "
                                   "the deployment configurations that carry its setting included"
                                   % (cid, json.dumps(files))))
        if control["form"] in GATED_FORMS and not (control["gate"] or "").strip():
            failures.append(rested(origins, here, "time control %s: a %s forces an event or moves the product's "
                                   "time, so it names its gate setting" % (cid, control["form"])))
        if control["form"] == "setting" and control["gate"]:
            failures.append(rested(origins, here, "time control %s: an exposed setting has no gate, and it names %r"
                                   % (cid, control["gate"])))
        if not control.get("scenarios"):
            failures.append(rested(origins, here, "time control %s: no planned scenario waits on it" % cid))
    return failures


def assembled_plan(root, run, sprint):
    groups = read_groups(root, sprint)
    scope = planning_scope(root, run)
    items = planning_items(root, run)
    tasks, done = items["tasks"], items["done"]
    touched = groups["stories"]
    unplanned = sorted(slug for slug in touched if slug not in items["stories"])
    if unplanned:
        raise InputError("touched stories no done story task records a stories item for: %s; re-plan each one alone "
                         "in a story task keyed story:<slug>"
                         % ", ".join(unplanned_story(slug, groups, tasks) for slug in unplanned))
    runtime_ran = bool(groups.get("runtime"))
    if runtime_ran and not any(task.get("role") == "runtime" and task["id"] in done for task in tasks):
        raise InputError("the groups plan the runtime scenarios, and no runtime task closed done: file one, or "
                         "refile it, and drain")
    origins = {("story", slug): (None, task) for slug, task in items["stories"].items()}
    scenario_items = items["scenarios"]
    nameless = [item for item in scenario_items if not text_field(item, "id")]
    if nameless:
        raise InputError("scenario items with no id field: %s"
                         % ", ".join(origin_text(item_origin(item)) for item in nameless))
    scenarios = [scenario_of(item) for item in scenario_items]
    for item in items["questions"]:
        origins[("question", item["id"])] = item_origin(item)
    aimless = [item for item in items["questions"] if not question_target(item)]
    if aimless:
        raise InputError("questions with no scenario or path field: %s"
                         % ", ".join(origin_text(item_origin(item)) for item in aimless))
    questions = items["settled"]
    legacy = []
    for item in items["legacy"]:
        entry = {"path": text_field(item, "path"), "name": text_field(item, "name"), "sort": text_field(item, "sort"),
                 "scenario": text_field(item, "scenario"), "reason": text_field(item, "reason"),
                 "rule": text_field(item, "rule"), "inferred": text_field(item, "inferred"),
                 "check": text_field(item, "check"),
                 "scenarios": list_field(item, "scenarios"), "users": list_field(item, "users"),
                 "note": first_line(item.get("body"))}
        legacy.append(entry)
        origins[("legacy", entry["path"], entry["name"])] = item_origin(item)
    calls = []
    for item in items["calls"]:
        origins[("call", len(calls))] = item_origin(item)
        calls.append({"key": item.get("key"), "site": text_field(item, "site"), "kind": text_field(item, "kind"),
                      "story": text_field(item, "story"), "choice": text_field(item, "choice"),
                      "body": item.get("body")})
    unanswered = [item for item in questions if item["state"] != "answered"]
    if unanswered:
        raise InputError("%d questions stand unanswered: %s" % (len(unanswered), ", ".join(
            "%s on %s" % (origin_text(origins[("question", item["id"])]), question_target(item)) for item in unanswered)))
    by_id = {}
    for item, scenario in zip(scenario_items, scenarios):
        if scenario["id"] in by_id:
            raise InputError("scenario %s is planned twice: %s and %s" % (
                scenario["id"], origin_text(origins[("scenario", scenario["id"])]), origin_text(item_origin(item))))
        by_id[scenario["id"]] = scenario
        origins[("scenario", scenario["id"])] = item_origin(item)
    state = read_state(root)
    old_by_id = {s["id"]: s for s in state["scenarios"]}
    stories = set(review.story_slugs(root))
    for old in state["scenarios"]:
        source = STORY_SOURCE.match(old.get("source") or "")
        if old["id"] not in by_id and source and source.group(1) not in stories:
            by_id[old["id"]] = dict(old, action="retire", support=list(old.get("support") or []),
                                    ruling="the rules: its story %s is retired" % source.group(1))
    standing = {}
    for old in state["scenarios"]:
        source = STORY_SOURCE.match(old.get("source") or "")
        if old["id"] in by_id:
            continue
        if source and source.group(1) not in touched and source.group(1) not in items["stories"]:
            standing[old["id"]] = "the rules: its story was not touched"
        elif source and touched.get(source.group(1)) == ["widen"]:
            standing[old["id"]] = "the rules: a widen run keeps it as recorded"
        elif source and kept_as_recorded(touched.get(source.group(1))):
            standing[old["id"]] = "the rules: a widen run or a slow test touched its story, and its planner named it nowhere"
        elif old.get("source") == "runtime" and not runtime_ran:
            standing[old["id"]] = "the rules: no runtime planner ran"
    for sid, ruling in standing.items():
        recorded = {name: value for name, value in old_by_id[sid].items() if name != "issue"}
        by_id[sid] = dict(recorded, action="keep", support=list(recorded.get("support") or []), ruling=ruling)
    whole_file = not testing_config(root)["named"]
    adopted_test = lambda entry: {"path": entry["path"], "name": None if whole_file else entry["name"]}
    adopted = {}
    for entry in sorted(legacy, key=lambda e: (e["path"] or "", e["name"] or "")):
        if entry["sort"] != "adopt":
            continue
        first = adopted.get(entry["scenario"])
        if first and whole_file and first["path"] == entry["path"]:
            continue
        if first:
            entry.update(sort="delete", reason="duplicate",
                         note="%s already adopts %s" % (locator(first), entry["scenario"]))
            continue
        adopted[entry["scenario"]] = adopted_test(entry)
        target = by_id.get(entry["scenario"])
        if target and (target["action"] == "new" or (target["id"] in standing and target.get("gap"))):
            for name in ("gap", "ruling"):
                target.pop(name, None)
            target.update(action="adopt", test=adopted_test(entry), reach=None,
                          call="a legacy test already checks it: %s" % locator(adopted_test(entry)))
    for scenario in by_id.values():
        if whole_file and scenario["action"] == "adopt" and scenario.get("test"):
            scenario["test"] = dict(scenario["test"], name=None)
    still_open = open_issue_ids(root)
    for scenario in by_id.values():
        carried = (old_by_id.get(scenario["id"]) or {}).get("issue")
        if scenario["action"] == "keep" and carried in still_open and not scenario.get("issue"):
            scenario["issue"] = carried
            scenario["ruling"] = "the rules: it fails until issue %s is settled" % carried
    planner_written = {sid for sid, scenario in by_id.items() if scenario["action"] in ("new", "rewrite")}
    unguarded = [dict(entry) for entry in state["unguarded"]]
    for answer in questions:
        kind = text_field(answer, "answer")
        asked = origin_text(origins[("question", answer["id"])])
        if kind not in ANSWERS:
            raise InputError("question %s carries answer %r; the answers are %s" % (asked, kind, ", ".join(ANSWERS)))
        target = text_field(answer, "scenario")
        if target:
            if target not in by_id:
                raise InputError("question %s answers scenario %s, which no planner planned" % (asked, target))
            if kind == "no-guard":
                raise InputError("question %s answers scenario %s with no-guard, which answers a program" % (asked, target))
            apply_answer(by_id[target], answer, old_by_id.get(target) or {})
        elif kind == "no-guard":
            unguarded.append({"path": text_field(answer, "path"), "reason": text_field(answer, "reason")
                              or text_field(answer, "said")})
    sorted_support(legacy, kept_uses(by_id.values(), old_by_id))
    budget = planned_budget(items, origins)
    controls, control_problems = planned_controls(items, origins)
    for control in controls:
        control["scenarios"] = sorted(sid for sid, scenario in by_id.items()
                                      if scenario["action"] not in ("retire", "gap") and waited_control(scenario) == control["id"])
    plan = {"commit": git(root, "rev-parse", "HEAD").strip(), "scenarios": sorted(by_id.values(), key=lambda s: s["id"]),
            "legacy": sorted(legacy, key=lambda e: (e["path"] or "", e["name"] or "")),
            "unguarded": sorted(unguarded, key=lambda e: e["path"] or ""), "calls": calls,
            "folders": project_folders(root), "scope": scope, "stories": sorted(items["stories"]), "budget": budget,
            "controls": controls, "kept": sort_files(root, project_folders(root), scope["paths"])["kept"]}
    failures = control_problems + plan_failures(root, plan, state, origins, planner_written, runtime_ran)
    if failures:
        raise InputError("the plan does not hold:\n" + "\n".join("- %s" % failure for failure in failures))
    return plan


def slug_list(value):
    return isinstance(value, list) and all(isinstance(entry, str) and SLUG.match(entry) for entry in value)


def whole_count(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


# @decision: tests-isolated-unless-declared
def budget_failures(budget, origins):
    here = [("budget",)]
    failures = []
    if not whole_count(budget["workers"]):
        failures.append(rested(origins, here, "budget: workers %s is not a whole number, 1 or more"
                               % json.dumps(budget["workers"])))
    for name, what in (("stack", "the command that starts the test stack, or none"),
                       ("sizing", "each configuration file and the values it gives for that many workers")):
        if not (budget[name] or "").strip():
            failures.append(rested(origins, here, "budget: it names no %s, %s" % (name, what)))
    if not isinstance(budget["files"], list) or not all(isinstance(path, str) and path.strip() for path in budget["files"]):
        failures.append(rested(origins, here, "budget: files %s is not a list of the configuration files the "
                               "preflight may edit" % json.dumps(budget["files"])))
    for index, limit in enumerate(budget["limits"]):
        where = [("limit", index)]
        if not (limit["limit"] or "").strip():
            failures.append(rested(origins, where, "limit: it names no deployment-wide limit"))
        if limit["how"] not in LIMIT_HANDLINGS:
            failures.append(rested(origins, where, "limit %s: how %r is not one of %s"
                                   % (limit["limit"] or "-", limit["how"], ", ".join(LIMIT_HANDLINGS))))
        if not (limit["detail"] or "").strip():
            failures.append(rested(origins, where, "limit %s: it says nowhere how the test stack's configuration "
                                   "raises it, how the workers split it, or what hands out its lease"
                                   % (limit["limit"] or "-")))
    return failures


# @decision: scenario-list-decided-once
def plan_failures(root, plan, state, origins, planner_written, runtime_ran):
    failures = []
    left_unguarded = {project_relative(root, entry["path"]) for entry in plan["unguarded"] if entry.get("path")}
    testing = testing_config(root)
    stories = set(review.story_slugs(root))
    old = {scenario["id"]: scenario for scenario in state["scenarios"]}
    seen_tests = {}
    planned = {scenario["id"]: scenario for scenario in plan["scenarios"]}
    kept_support = {}
    for sid, _, support in kept_uses(plan["scenarios"], old):
        for path in support:
            kept_support.setdefault(path, set()).add(sid)
    for scenario in plan["scenarios"]:
        sid, action = scenario["id"], scenario["action"]
        here = [("scenario", sid)]
        if not sid or not SLUG.match(sid):
            failures.append(rested(origins, here, "scenario id %r is not a slug: lower-case letters, digits, and hyphens" % sid))
            continue
        if action not in ACTIONS:
            failures.append(rested(origins, here, "scenario %s: action %r is not one of %s" % (sid, action, ", ".join(ACTIONS))))
            continue
        source = scenario.get("source") or ""
        story = STORY_SOURCE.match(source)
        if action != "retire":
            if story and story.group(1) not in stories:
                failures.append(rested(origins, here, "scenario %s: its story %s does not exist" % (sid, story.group(1))))
            elif not story and source != "runtime":
                failures.append(rested(origins, here, "scenario %s: source %r is neither story:<slug> nor runtime" % (sid, source)))
            elif source == "runtime" and not all(scenario.get(name) for name in ("part", "class", "harm")):
                failures.append(rested(origins, here, "scenario %s: a runtime scenario names its part, class, and harm" % sid))
            elif source == "runtime" and not ACCEPT_ENTRY.match(scenario.get("harm") or ""):
                failures.append(rested(origins, here, "scenario %s: harm %r is not an accept-list entry, A1 to A9"
                                       % (sid, scenario.get("harm"))))
        if action in ("keep", "rewrite", "retire") and sid not in old:
            failures.append(rested(origins, here, "scenario %s: %s names a scenario the stamp did not record" % (sid, action)))
        if action in ("new", "adopt") and sid in old and not old[sid].get("gap"):
            failures.append(rested(origins, here, "scenario %s: %s names a scenario the stamp already recorded with a test"
                                   % (sid, action)))
        test = scenario.get("test") or (old.get(sid) or {}).get("test")
        if action in ("new", "rewrite", "adopt") and not scenario.get("test"):
            failures.append(rested(origins, here, "scenario %s: %s names no test path" % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("reach"):
            failures.append(rested(origins, here, "scenario %s: %s says nowhere how its test reaches the code" % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("entry"):
            failures.append(rested(origins, here, "scenario %s: %s names no entry, the program its test reaches"
                                   % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("kind"):
            failures.append(rested(origins, here, "scenario %s: %s names no kind, the kind of test it is, such as unit, "
                                   "cli, browser, or stack" % (sid, action)))
        if action in ("new", "rewrite") and not scenario.get("setup"):
            failures.append(rested(origins, here, "scenario %s: %s names no setup, what its test needs in place before "
                                   "it runs" % (sid, action)))
        if action in ("new", "rewrite") and sid in planner_written:
            failures.extend(rested(origins, here, reason)
                            for reason in scope_failures(root, scenario, plan["scope"]["paths"], left_unguarded))
        if action == "gap" and scenario.get("test"):
            failures.append(rested(origins, here, "scenario %s: a gap has no test" % sid))
        if "resources" in scenario and not slug_list(scenario["resources"]):
            failures.append(rested(origins, here, "scenario %s: resources %s is not a list of slugs, each a shared "
                                   "resource its test changes, [] for an isolated test"
                                   % (sid, json.dumps(scenario["resources"]))))
        if action not in ("retire", "gap") and test:
            if testing["named"] and not test.get("name"):
                failures.append(rested(origins, here, "scenario %s: testing.named is true, and test %s names none"
                                       % (sid, test["path"])))
            key = locator(test)
            if key in seen_tests:
                failures.append(rested(origins, [("scenario", seen_tests[key])] + here,
                                       "scenarios %s and %s share the test %s" % (seen_tests[key], sid, key)))
            seen_tests[key] = sid
        if action == "keep" and not test and not (old.get(sid) or {}).get("gap"):
            failures.append(rested(origins, here, "scenario %s: keep names a scenario with no test; plan it new or as a gap" % sid))
    planned_stories = plan.get("stories")
    for sid in old:
        if sid not in planned:
            story = STORY_SOURCE.match(old[sid].get("source") or "")
            if story and planned_stories is not None and story.group(1) not in planned_stories:
                continue
            if old[sid].get("source") == "runtime" and not runtime_ran:
                continue
            failures.append(rested(origins, [("story", story.group(1))] if story else [],
                                   "scenario %s: the stamp recorded it, and the plan says nothing of it" % sid))
    for entry in plan["legacy"]:
        where = locator(entry) or "-"
        here = [("legacy", entry["path"], entry["name"])]
        if not entry["path"]:
            failures.append(rested(origins, here, "legacy entry %r names no path" % entry["note"]))
        elif not in_scope(root, entry["path"], plan["scope"]["paths"]):
            failures.append(rested(origins, here, "legacy %s: it lies outside the scope, %s, and the plan keeps it as it "
                                   "stands; drop the entry" % (where, ", ".join(plan["scope"]["paths"]))))
        elif entry["sort"] not in SORTS:
            failures.append(rested(origins, here, "legacy %s: sort %r is not one of %s" % (where, entry["sort"], ", ".join(SORTS))))
        elif entry["sort"] == "adopt" and (planned.get(entry["scenario"]) or {}).get("action") != "adopt":
            failures.append(rested(origins, here, "legacy %s: adopted into %s, which the plan does not adopt"
                                   % (where, entry["scenario"])))
        elif entry["sort"] == "port" and not (entry["rule"] and entry["check"]):
            failures.append(rested(origins, here, "legacy %s: a port names the rule it enforces and the check it becomes" % where))
        elif entry["sort"] == "port" and entry["rule"] == INFERRED and not entry.get("inferred"):
            failures.append(rested(origins, here, "legacy %s: a port of an unwritten rule states the rule it infers in "
                                   "the inferred field" % where))
        elif entry["sort"] == "delete" and entry["reason"] not in DELETE_REASONS:
            failures.append(rested(origins, here, "legacy %s: a deletion's reason is orphan or duplicate" % where))
        elif entry["sort"] == "support" and not all(sid in planned for sid in entry["scenarios"]):
            failures.append(rested(origins, here, "legacy %s: support names a scenario the plan lacks" % where))
        elif entry["sort"] == "support" and not entry["users"] and not entry["scenarios"]:
            failures.append(rested(origins, here, "legacy %s: support names no test that reads it, and no kept scenario "
                                   "names it as support; record its users" % where))
        if entry.get("inferred") and not (entry["sort"] == "port" and entry["rule"] == INFERRED):
            failures.append(rested(origins, here, "legacy %s: inferred text goes only with sort port and rule inferred, "
                                   "not sort %s and rule %s" % (where, entry["sort"], entry["rule"] or "-")))
        users_of = kept_support.get(os.path.normpath(entry["path"])) if entry["path"] and not entry["name"] else None
        if entry["sort"] in ("delete", "port") and users_of:
            failures.append(rested(origins, here, "legacy %s: a %s of a file the kept scenarios %s name as support"
                                   % (where, entry["sort"], ", ".join(sorted(users_of)))))
    failures.extend(budget_failures(plan.get("budget"), origins))
    failures.extend(control_failures(plan, origins))
    for index, call in enumerate(plan["calls"]):
        if call["kind"] not in CALL_KINDS:
            named = "kind %r is not one of" % call["kind"] if call["kind"] else "it names no kind; the kinds are"
            failures.append(rested(origins, [("call", index)], "call at %s: %s %s"
                                   % (call["site"] or "-", named, ", ".join(CALL_KINDS))))
    for scenario in plan["scenarios"]:
        if scenario["action"] == "adopt" and not any(entry["sort"] == "adopt" and entry["scenario"] == scenario["id"]
                                                     for entry in plan["legacy"]):
            failures.append(rested(origins, [("scenario", scenario["id"])],
                                   "scenario %s: adopt names no legacy test" % scenario["id"]))
    sorted_paths = {entry["path"] for entry in plan["legacy"]}
    for item in sort_files(root, plan_folders(plan), plan["scope"]["paths"])["sort"]:
        path = item["path"]
        if item["claimed"] and path not in sorted_paths:
            failures.append("claimed test file %s changed since the stamp, and no sort agent sorted its tests" % path)
        elif path not in sorted_paths and not any((s.get("test") or {}).get("path") == path
                                                  or path in (s.get("support") or []) for s in plan["scenarios"]):
            failures.append("test file %s: no scenario claims it, and the sort names it nowhere" % path)
    return failures


def cmd_plan(args, root):
    sprint = resolved_sprint(root, args.sprint, exists=False)
    if args.show:
        plan = read_plan(root, sprint)
        if args.json:
            print(json.dumps(plan, indent=2))
            return 0
        print_plan(plan)
        return 0
    if not args.from_run:
        raise InputError("name the planning run with --from-run, or pass --show")
    if read_text(root, args.from_run) is None:
        raise InputError("no planning run at %s" % args.from_run)
    if args.questions:
        waiting = [item for item in planning_items(root, args.from_run)["settled"] if item["state"] != "answered"]
        print(json.dumps(waiting, indent=2))
        return 0
    plan = assembled_plan(root, args.from_run, sprint)
    write_json(root, sibling(sprint, "-plan.json"), plan)
    print("written: %s" % sibling(sprint, "-plan.json"))
    print_counts(plan)
    return 0


def print_counts(plan):
    actions = {action: sum(1 for s in plan["scenarios"] if s["action"] == action) for action in ACTIONS}
    sorts = {sort: sum(1 for e in plan["legacy"] if e["sort"] == sort) for sort in SORTS}
    print("scenarios: %s" % ", ".join("%d %s" % (actions[a], a) for a in ACTIONS))
    print("legacy tests: %s" % ", ".join("%d %s" % (sorts[s], s) for s in SORTS))
    print("unguarded programs: %d; calls: %d" % (len(plan["unguarded"]), len(plan["calls"])))
    print("test files kept outside the scope: %d" % len(plan.get("kept") or []))


def scenario_story(scenario):
    story = STORY_SOURCE.match(scenario.get("source") or "")
    return story.group(1) if story else scenario.get("source") or "-"


def call_line(call):
    story = "; story `%s`" % call["story"] if call.get("story") else ""
    return "`%s`%s: %s" % (call["site"] or "-", story, call["choice"] or "-")


def print_summary(plan):
    print("## Summary")
    print()
    print("### Scenarios per story")
    stories = {}
    for s in plan["scenarios"]:
        counts = stories.setdefault(scenario_story(s), {})
        counts[s["action"]] = counts.get(s["action"], 0) + 1
    for story in sorted(stories):
        counts = stories[story]
        print("- `%s`: %s" % (story, ", ".join("%d %s" % (counts[a], a) for a in ACTIONS if counts.get(a))))
    if not stories:
        print("None.")
    by_kind = {}
    for call in plan["calls"]:
        by_kind.setdefault(call.get("kind") or "no kind", []).append(call)
    print()
    print("### Calls that leave a behavior untested or depart from an owner answer")
    whole = [call for kind in WHOLE_CALL_KINDS for call in by_kind.get(kind, [])]
    for call in whole:
        print("- %s, %s" % (call["kind"], call_line(call)))
        for line in (call["body"] or "").split("\n"):
            print("  %s" % line if line else "")
    if not whole:
        print("None.")
    print()
    print("### Other calls by kind")
    others = [kind for kind in CALL_KINDS if kind not in WHOLE_CALL_KINDS]
    others += sorted(kind for kind in by_kind if kind not in CALL_KINDS)
    for kind in [kind for kind in others if kind in by_kind]:
        print("- %s (%d):" % (kind, len(by_kind[kind])))
        for call in by_kind[kind]:
            print("  - %s" % call_line(call))
    if not any(kind in by_kind for kind in others):
        print("None.")
    print()
    print("### Inferred rules")
    inferred = [e for e in plan["legacy"] if e["sort"] == "port" and e["rule"] == INFERRED]
    for e in inferred:
        print('- "%s" test `%s`, check `%s`' % (e.get("inferred") or "-", locator(e) or "-", e["check"] or "-"))
    if not inferred:
        print("None: every port enforces a written rule.")
    print()
    print("### Planned tests by kind and setup")
    pairs = {}
    for s in plan["scenarios"]:
        if s["action"] in ("new", "rewrite"):
            pair = "%s, %s" % (s.get("kind") or "no kind", s.get("setup") or "no setup")
            pairs[pair] = pairs.get(pair, 0) + 1
    for pair in sorted(pairs):
        print("- %s: %d" % (pair, pairs[pair]))
    if not pairs:
        print("None.")
    print()
    print("### Shared resources declared")
    declared = {}
    for s in plan["scenarios"]:
        for resource in s.get("resources") or []:
            declared.setdefault(resource, []).append(s["id"])
    for resource in sorted(declared):
        print("- `%s`: %s" % (resource, ", ".join("`%s`" % sid for sid in sorted(declared[resource]))))
    if not declared:
        print("None: every planned test is isolated.")
    print()
    print("### The test stack's budget")
    print_budget(plan.get("budget"))
    print()
    print("### Time controls the plan builds")
    print_controls(plan.get("controls") or [])
    print()


def control_text(control):
    gate = "gate setting `%s`" % control["gate"] if control.get("gate") else "no gate"
    return "`%s`: %s at `%s`, %s; files: %s; waited on by %s. %s" % (
        control["id"], control.get("form") or "-", control.get("site") or "-", gate,
        ", ".join("`%s`" % path for path in control.get("files") or []) or "none",
        ", ".join("`%s`" % sid for sid in control.get("scenarios") or []) or "no scenario", control.get("text") or "")


def print_controls(controls):
    for control in controls:
        print("- %s" % control_text(control).rstrip())
    if not controls:
        print("None: the product has a time control for every timer the planned tests meet.")


def print_budget(budget):
    if not isinstance(budget, dict):
        print("None: the plan records no budget, so the suite runs with one worker and no preflight.")
        return
    print("- workers: %s" % budget.get("workers"))
    print("- stack: %s" % (budget.get("stack") or "-"))
    print("- sizing: %s" % (budget.get("sizing") or "-"))
    print("- files the preflight may edit: %s" % (", ".join(budget.get("files") or []) or "none"))
    for limit in budget.get("limits") or []:
        print("- limit %s: %s, %s" % (limit.get("limit") or "-", limit.get("how") or "-", limit.get("detail") or "-"))
    if not budget.get("limits"):
        print("- limits: none the tests meet")


def print_plan(plan):
    if plan.get("scope"):
        print("Scope: %s (%s)" % (plan["scope"].get("said") or "-", ", ".join(plan["scope"].get("paths") or [])))
        print()
    print("Planned against commit `%s`." % plan["commit"])
    print()
    print_summary(plan)
    print_counts(plan)
    print()
    print("## Scenarios")
    for s in plan["scenarios"]:
        test = locator(s.get("test")) or ("as the stamp recorded it" if s["action"] == "keep" else "-")
        extra = "".join("; %s: %s" % (name, s[name])
                        for name in ("part", "class", "harm", "reach", "entry", "waits", "ruling", "issue", "call")
                        if s.get(name))
        extra += "; resources: %s" % ", ".join(s["resources"]) if s.get("resources") else ""
        print("- `%s`: %s. Source: %s. Checks: %s Test: %s%s" % (s["id"], s["action"], s.get("source"), s["text"], test, extra))
    print()
    print("## Legacy tests")
    for e in plan["legacy"]:
        extra = {"adopt": "into %s" % e["scenario"], "port": "enforces %s; becomes %s" % (rule_text(e), e["check"]),
                 "delete": e["reason"], "support": "for %s" % ", ".join(e["scenarios"])}.get(e["sort"], "")
        if e.get("users"):
            extra += "; read by %s" % ", ".join(e["users"])
        print("- `%s`: %s, %s. %s" % (locator(e), e["sort"], extra, e["note"]))
    if not plan["legacy"]:
        print("None.")
    print()
    print("## Test files kept outside the scope")
    for path in plan.get("kept") or []:
        print("- `%s`: left as it stands, for a later plan whose scope covers it" % path)
    if not plan.get("kept"):
        print("None.")
    print()
    print("## Unguarded programs")
    for e in plan["unguarded"]:
        print("- `%s`: %s" % (e["path"], e["reason"]))
    if not plan["unguarded"]:
        print("None.")
    print()
    print("## Calls")
    for c in plan["calls"]:
        print("- `%s`: %s. %s" % (c["site"] or "-", c["choice"] or "-", first_line(c["body"])))
    if not plan["calls"]:
        print("None.")


def run_file(root, sprint):
    run = sibling(sprint, "-run.jsonl")
    if read_text(root, run) is None:
        raise InputError("no run at %s: open the run first" % run)
    return run


def recorded_tests(root, run):
    latest = {}
    for item in run_items(root, run, "tests"):
        sid = text_field(item, "scenario")
        if sid:
            latest[sid] = item
    return latest


def declared_resources(*records):
    return next((list(record["resources"]) for record in records if isinstance(record.get("resources"), list)), [])


def declared_silence(record):
    value = field(record, "silence") if "fields" in record else record.get("silence")
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 1 else None


def kept_resources(planned, record):
    recorded = field(record, "resources")
    return [resource for resource in planned if resource in recorded] if isinstance(recorded, list) else planned


# @decision: tests-isolated-unless-declared
def live_tests(root, sprint=None):
    state = read_state(root)
    live = {s["id"]: {"id": s["id"], "test": s.get("test"), "support": list(s.get("support") or []),
                      "resources": declared_resources(s), "silence": declared_silence(s)}
            for s in state["scenarios"] if s.get("test")}
    if sprint is None:
        return live
    plan = read_plan(root, sprint)
    records = recorded_tests(root, run_file(root, sprint)) if read_text(root, sibling(sprint, "-run.jsonl")) else {}
    for s in plan["scenarios"]:
        if s["action"] in ("retire", "gap"):
            live.pop(s["id"], None)
            continue
        legacy_support = {e["path"] for e in plan["legacy"] if e["sort"] == "support" and s["id"] in e["scenarios"]}
        record = records.get(s["id"])
        if s["action"] == "keep":
            entry = live.get(s["id"])
            if entry is None:
                continue
            entry["support"] = sorted(set(entry["support"]) | legacy_support)
            entry["resources"] = declared_resources(s, entry)
            if record and not field(record, "retired") and not field(record, "gap") and test_of(record):
                entry["test"] = test_of(record)
                entry["support"] = sorted(set(list_field(record, "support")) | legacy_support)
                entry["resources"] = kept_resources(entry["resources"], record)
                entry["silence"] = declared_silence(record)
            continue
        entry = {"id": s["id"], "test": None, "support": sorted(set(s.get("support") or []) | legacy_support),
                 "resources": declared_resources(s), "silence": None}
        if s["action"] == "adopt":
            entry["test"] = s.get("test")
        if record and field(record, "gap"):
            live.pop(s["id"], None)
            continue
        if record and not field(record, "retired") and test_of(record):
            entry["test"] = test_of(record)
            entry["support"] = sorted(set(list_field(record, "support")) | legacy_support)
            entry["resources"] = kept_resources(entry["resources"], record)
            entry["silence"] = declared_silence(record)
        live[s["id"]] = entry
    return live


def end_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        return


def test_file_hashes(root, folders):
    paths = sorted(test_paths(root, tree_files(root, folders)))
    if not paths:
        return {}
    done = subprocess.run(["git", "hash-object", "--stdin-paths"], cwd=root,
                          input="\n".join(os.path.join(root, path) for path in paths) + "\n",
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise InputError("git hash-object failed: %s" % done.stderr.strip())
    return dict(zip(paths, done.stdout.split()))


def output_tail(text):
    return "\n".join((text or "").rstrip().split("\n")[-TAIL_LINES:])


def result_key(path, name):
    return (os.path.normpath(path), name or None)


def reported(line):
    if not isinstance(line, dict) or not isinstance(line.get("path"), str) or not line["path"]:
        return None
    if not isinstance(line.get("passed"), bool) or not isinstance(line.get("name"), (str, type(None))):
        return None
    if isinstance(line.get("seconds"), bool) or not isinstance(line.get("seconds"), (int, float)):
        return None
    return line


def take_line(raw, planned, found, on_result):
    text = raw.decode("utf-8", "replace")
    try:
        line = reported(json.loads(text))
    except ValueError:
        line = None
    target = planned.get(result_key(line["path"], line.get("name"))) if line else None
    if target is None or target["scenario"] in found["results"]:
        found["unmatched"].append(text[:RESULT_LINE_BYTES])
        return False
    result = {"scenario": target["scenario"], "path": target["path"], "name": target["name"],
              "passed": line["passed"], "seconds": line["seconds"],
              "tail": output_tail(line["output"] if isinstance(line.get("output"), str) else "")}
    found["results"][target["scenario"]] = result
    on_result(result)
    return True


def stream_lines(reader, pending, planned, found, on_result):
    while True:
        try:
            chunk = os.read(reader, READ_BYTES)
        except BlockingIOError:
            break
        if not chunk:
            break
        pending += chunk
    lines = pending.split(b"\n")
    landed = False
    for raw in lines[:-1]:
        if raw.strip():
            landed = take_line(raw, planned, found, on_result) or landed
    return lines[-1], landed


def kept_tail(tail, data):
    lines = (tail + data).split(b"\n")
    return b"\n".join(lines[-TAIL_LINES - 1:])


def exit_watch(proc):
    waker, signal_end = os.pipe()

    def watch():
        try:
            proc.wait()
        except Exception as err:
            review.issues.tasks.event("TESTS.SUITE.UNWATCHED", type=type(err).__name__, message=str(err))
        finally:
            os.close(signal_end)

    try:
        threading.Thread(target=watch, daemon=True).start()
    except BaseException:
        os.close(signal_end)
        os.close(waker)
        raise
    return waker


def silence_limit(silence, planned, results):
    return max([silence] + [target.get("silence") or 0 for target in planned.values()
                            if target["scenario"] not in results])


def read_stream(proc, reader, waker, silence, planned, on_result):
    found = {"results": {}, "unmatched": [], "stopped": None}
    pending, tail = b"", b""
    last = time.monotonic()
    output = proc.stdout.fileno()
    watched = [reader, output, waker]
    while waker in watched:
        left = silence_limit(silence, planned, found["results"]) - (time.monotonic() - last)
        if left <= 0:
            found["stopped"] = "silence"
            break
        ready = select.select(watched, [], [], left)[0]
        if reader in ready:
            pending, landed = stream_lines(reader, pending, planned, found, on_result)
            last = time.monotonic() if landed else last
        if output in ready:
            data = os.read(output, READ_BYTES)
            tail = kept_tail(tail, data) if data else tail
            last = time.monotonic() if data else last
            if not data:
                watched.remove(output)
        if waker in ready:
            watched.remove(waker)
    if output in watched and output in select.select([output], [], [], 0)[0]:
        tail = kept_tail(tail, os.read(output, READ_BYTES))
    pending, _ = stream_lines(reader, pending, planned, found, on_result)
    if pending.strip():
        found["unmatched"].append(pending.decode("utf-8", "replace")[:RESULT_LINE_BYTES])
    found["exit"] = proc.poll()
    found["tail"] = output_tail(tail.decode("utf-8", "replace"))
    return found


def stop_suite(proc):
    end_group(proc)
    proc.wait()
    proc.stdout.close()


# @decision: scenario-list-decided-once
# @decision: test-loop-fixes-code-never-tests
def run_suite(root, testing, workers, targets, on_result):
    planned = {}
    for target in targets:
        planned.setdefault(result_key(target["path"], target["name"]), target)
    with contextlib.ExitStack() as cleanup:
        folder = tempfile.mkdtemp(prefix="ok-planner-tests-")
        cleanup.callback(shutil.rmtree, folder)
        listed = os.path.join(folder, "tests.json")
        with open(listed, "w", encoding="utf-8") as f:
            json.dump({"workers": workers, "tests": [{"path": t["path"], "name": t["name"],
                                                      "resources": t["resources"]} for t in targets]}, f)
        stream = os.path.join(folder, "results")
        os.mkfifo(stream)
        reader = os.open(stream, os.O_RDONLY | os.O_NONBLOCK)
        cleanup.callback(os.close, reader)
        holder = os.open(stream, os.O_WRONLY)
        cleanup.callback(os.close, holder)
        command = testing["run"].replace("{tests}", shlex.quote(listed)).replace("{results}", shlex.quote(stream))
        proc = subprocess.Popen(command, shell=True, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, start_new_session=True)
        cleanup.callback(stop_suite, proc)
        waker = exit_watch(proc)
        cleanup.callback(os.close, waker)
        return read_stream(proc, reader, waker, testing["silence"], planned, on_result)


def setup_refusal(proc, output, waker, setup_silence):
    tail, last = b"", time.monotonic()
    watched = [output, waker]
    while waker in watched:
        left = setup_silence - (time.monotonic() - last)
        if left <= 0:
            end_group(proc)
            return "it printed nothing for testing.setup_silence, %d seconds" % setup_silence, tail
        ready = select.select(watched, [], [], left)[0]
        if output in ready:
            data = os.read(output, READ_BYTES)
            tail = kept_tail(tail, data) if data else tail
            last = time.monotonic() if data else last
            if not data:
                watched.remove(output)
        if waker in ready:
            watched.remove(waker)
    if output in watched and output in select.select([output], [], [], 0)[0]:
        tail = kept_tail(tail, os.read(output, READ_BYTES))
    code = proc.wait()
    return ("it exited %d" % code if code != 0 else None), tail


# @decision: tests-spend-time-only-on-their-outcome
def run_setup(root, testing):
    proc = subprocess.Popen(testing["setup"], shell=True, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, start_new_session=True)
    with contextlib.ExitStack() as cleanup:
        cleanup.callback(proc.stdout.close)
        cleanup.callback(proc.wait)
        waker = exit_watch(proc)
        cleanup.callback(os.close, waker)
        refusal, tail = setup_refusal(proc, proc.stdout.fileno(), waker, testing["setup_silence"])
    if refusal is None:
        return None
    return "setup failed: testing.setup %s\n%s" % (refusal, output_tail(tail.decode("utf-8", "replace")))


def unreported(target, stopped, closed):
    notes = ["the suite command reported no result"]
    if stopped:
        notes.append("the run stopped after testing.silence seconds with no result")
    if not closed:
        notes.append("the round did not close")
    return {"scenario": target["scenario"], "path": target["path"], "name": target["name"], "passed": False,
            "seconds": None, "tail": "; ".join(notes)}


def round_results(planned, results, stopped, closed):
    return [results.get(target["scenario"]) or unreported(target, stopped, closed) for target in planned]


def wall_cost(result, workers, declared):
    held = (declared.get(result["scenario"]) or {}).get("resources")
    return round(result["seconds"] if held else result["seconds"] / workers, 3)


# @decision: tests-isolated-unless-declared
# @decision: tests-spend-time-only-on-their-outcome
def ranked_slowest(results, count, workers, declared):
    timed = [dict(result, cost=wall_cost(result, workers, declared)) for result in results
             if result.get("seconds") is not None]
    return sorted(timed, key=lambda result: -result["cost"])[:count]


def round_ranked(root, sprint, entry, live):
    recorded = "workers" in entry and all("resources" in target for target in entry["planned"])
    declared = {target["scenario"]: target for target in entry["planned"]} if recorded else live
    workers = entry["workers"] if recorded else budget_workers(root, sprint)
    return ranked_slowest(entry["results"], None, workers, declared)


def round_slowest(root, sprint, entry, live):
    return round_ranked(root, sprint, entry, live)[:testing_config(root)["slowest"]]


def round_header(record):
    return isinstance(record, dict) and "planned" in record


def parsed_header(text):
    try:
        return round_header(json.loads(text))
    except ValueError:
        return False


def results_records(root, rel):
    lines = [line for line in (read_text(root, rel) or "").split("\n") if line.strip()]
    records = []
    for n, text in enumerate(lines):
        try:
            records.append(json.loads(text))
        except ValueError:
            if n + 1 == len(lines) or parsed_header(lines[n + 1]):
                continue
            raise InputError("%s: line %d is not JSON and no round starts after it; only this tool writes the file, "
                             "so restore it from git" % (rel, n + 1))
    return records


# @decision: scenario-list-decided-once
def results_rounds(root, sprint):
    rel = sibling(sprint, "-results.jsonl")
    rounds = {}
    for record in results_records(root, rel):
        number = record.get("round") if isinstance(record, dict) else None
        if not isinstance(number, int) or (not round_header(record) and number not in rounds):
            raise InputError("%s holds a line that belongs to no round: %s" % (rel, json.dumps(record)[:200]))
        if round_header(record):
            rounds[number] = dict(record, results={}, closed=False, ended=None, exit=None, stopped=None,
                                  unmatched=[], leftovers_after=None, grew=[])
        elif "ended" in record:
            rounds[number].update(record, closed=True, results=rounds[number]["results"])
        elif "scenario" in record:
            rounds[number]["results"].setdefault(record["scenario"], record)
        else:
            raise InputError("%s holds a line that is neither a round's header, result, nor close: %s"
                             % (rel, json.dumps(record)[:200]))
    built = []
    for number in sorted(rounds):
        entry = rounds[number]
        entry["results"] = round_results(entry["planned"], entry["results"], entry["stopped"], entry["closed"])
        built.append(entry)
    return built


def budget_workers(root, sprint):
    budget = read_plan(root, sprint).get("budget") if sprint else read_state(root).get("budget")
    return budget["workers"] if isinstance(budget, dict) and "workers" in budget else 1


def run_targets(args, root, sprint):
    if args.from_file:
        listed = read_json(root, args.from_file, "write a JSON list of {path, name, scenario}")
        if not isinstance(listed, list):
            raise InputError("%s does not hold a JSON list" % args.from_file)
        return [{"scenario": str(entry.get("scenario") or locator(entry)), "path": entry["path"],
                 "name": entry.get("name"), "resources": declared_resources(entry), "silence": declared_silence(entry)}
                for entry in listed if isinstance(entry, dict) and entry.get("path")]
    live = live_tests(root, sprint)
    if args.only:
        missing = [sid for sid in args.only if sid not in live]
        if missing:
            raise InputError("no live test for %s" % ", ".join(missing))
    return [{"scenario": sid, "path": (live[sid]["test"] or {}).get("path"),
             "name": (live[sid]["test"] or {}).get("name"), "resources": live[sid]["resources"],
             "silence": live[sid]["silence"]}
            for sid in sorted(live) if not args.only or sid in args.only]


def unrunnable(target, testing):
    if not target["path"]:
        return "the plan names this test and no test task recorded it yet"
    if testing["named"] and not target["name"]:
        return "testing.named is true, and this test records no name"
    return None


def result_text(result):
    seconds = "-" if result.get("seconds") is None else "%ss" % result["seconds"]
    where = locator({"path": result["path"], "name": result["name"]}) if result["path"] else "-"
    return "%s %s %s %s" % ("pass" if result["passed"] else "FAIL", result["scenario"], where, seconds)


def appended_text(f, text):
    f.write(text)
    f.flush()


def appended_line(f, record):
    appended_text(f, json.dumps(record) + "\n")


@contextlib.contextmanager
def round_lock(root, sprint):
    name = "tests-%s.lock" % os.path.basename(sibling(sprint, ""))
    with open(os.path.join(review.issues.tasks.cache_dir(root), name), "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise InputError("another recorded run of %s is under way and writes %s: wait for it to end, then run "
                             "again" % (sprint, sibling(sprint, "-results.jsonl"))) from None
        yield


def results_file(root, sprint):
    path = os.path.join(root, sibling(sprint, "-results.jsonl"))
    torn = False
    if os.path.isfile(path) and os.path.getsize(path):
        with open(path, "rb") as f:
            f.seek(-1, os.SEEK_END)
            torn = f.read(1) != b"\n"
    f = open(path, "a", encoding="utf-8")
    try:
        if torn:
            appended_text(f, "\n")
    except BaseException:
        f.close()
        raise
    return f


def suite_outcome(root, testing, workers, targets, on_result):
    runnable, results = [], {}
    for target in targets:
        why = unrunnable(target, testing)
        if why:
            results[target["scenario"]] = dict(target, passed=False, seconds=None, tail=why)
            results[target["scenario"]].pop("resources")
            results[target["scenario"]].pop("silence", None)
            on_result(results[target["scenario"]])
        else:
            runnable.append(target)
    failed = run_setup(root, testing) if runnable and testing["setup"] is not None else None
    if failed:
        for target in runnable:
            results[target["scenario"]] = dict(target, passed=False, seconds=None, tail=failed)
            results[target["scenario"]].pop("resources")
            results[target["scenario"]].pop("silence", None)
            on_result(results[target["scenario"]])
        runnable = []
    found = (run_suite(root, testing, workers, runnable, on_result) if runnable
             else {"results": {}, "unmatched": [], "stopped": None, "exit": None, "tail": failed or ""})
    found["setup_failed"] = bool(failed)
    found["results"] = dict(results, **found["results"])
    return found


def counts_held(counts):
    return isinstance(counts, dict) and all(
        SLUG.match(kind) and isinstance(count, int) and not isinstance(count, bool) and count >= 0
        for kind, count in counts.items())


# @decision: tests-isolated-unless-declared
def leftover_counts(root, testing):
    done = subprocess.run(testing["leftovers"], shell=True, cwd=root, stdin=subprocess.DEVNULL, capture_output=True,
                          text=True)
    if done.returncode != 0:
        raise InputError("testing.leftovers %r exited %d: %s" % (testing["leftovers"], done.returncode,
                                                                 output_tail(done.stderr or done.stdout)))
    try:
        counts = json.loads(done.stdout)
    except ValueError:
        counts = None
    if not counts_held(counts):
        raise InputError("testing.leftovers %r printed %r: it prints one JSON object of kind to count, each kind a "
                         "slug and each count a whole number, 0 or more, such as {} where the project counts nothing"
                         % (testing["leftovers"], done.stdout.strip()[:RESULT_LINE_BYTES]))
    return counts


def grown(before, after):
    return sorted(kind for kind, count in after.items() if count > before.get(kind, 0))


# @decision: test-loop-fixes-code-never-tests
def failing_targets(root, sprint):
    latest, failing = unsettled_failures(root, sprint)
    if latest is None:
        raise InputError("no round recorded yet, so no test failed: run the whole suite first, `tests run --sprint %s`"
                         % sprint)
    rerun = [result for result in failing if not result.get("leftovers")]
    if not rerun:
        grew = [result["scenario"] for result in failing]
        raise InputError("round %d lists no failing test to rerun%s: run the whole suite as the gate, `tests run "
                         "--sprint %s`, as step 6 of the test sprint says"
                         % (latest["round"], ", only %s" % ", ".join(grew) if grew else "", sprint))
    live = live_tests(root, sprint)
    targets = []
    for result in rerun:
        entry = live.get(result["scenario"]) or {}
        test = entry.get("test") or {"path": result["path"], "name": result["name"]}
        targets.append({"scenario": result["scenario"], "path": test.get("path"), "name": test.get("name"),
                        "resources": entry.get("resources") or [], "silence": entry.get("silence")})
    return targets


def print_leftovers(before, after, grew):
    print("testing.leftovers before: %s; after: %s" % (json.dumps(before, sort_keys=True), json.dumps(after, sort_keys=True)))
    print("grew: %s" % (", ".join(grew) if grew else "no kind"))


# @decision: scenario-list-decided-once
# @decision: test-loop-fixes-code-never-tests
# @decision: tests-isolated-unless-declared
def cmd_run(args, root):
    testing = testing_config(root)
    sprint = resolved_sprint(root, args.sprint) if args.sprint else None
    recorded = bool(sprint) and not args.from_file and not args.only
    with round_lock(root, sprint) if recorded else contextlib.nullcontext():
        return tested_round(args, root, testing, sprint, recorded)


def tested_round(args, root, testing, sprint, recorded):
    targets = failing_targets(root, sprint) if args.failing else run_targets(args, root, sprint)
    workers = 1 if args.only or args.from_file else budget_workers(root, sprint)
    shown = (lambda result: None) if args.json else (lambda result: print(result_text(result), flush=True))
    planned = [{"scenario": t["scenario"], "path": t["path"], "name": t["name"], "resources": t["resources"]}
               for t in targets]
    counted = recorded or bool(args.only)
    before = leftover_counts(root, testing) if counted else None
    if recorded:
        run = run_file(root, sprint)
        number = len(results_rounds(root, sprint)) + 1
        closed = sorted(task["id"] for task in run_tasks(root, run) if task.get("state") == "closed")
        header = {"round": number, "kind": "rerun" if args.failing else "whole",
                  "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "workers": workers, "tasks_closed": closed,
                  "test_files": test_file_hashes(root, plan_folders(read_plan(root, sprint))),
                  "planned": planned, "leftovers_before": before}
        with results_file(root, sprint) as f:
            appended_line(f, header)
            found = suite_outcome(root, testing, workers, targets,
                                  lambda result: (appended_line(f, dict(result, round=number)), shown(result)))
            after = leftover_counts(root, testing)
            grew = grown(before, after)
            appended_line(f, {"round": number, "ended": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                              "exit": found["exit"], "stopped": found["stopped"], "unmatched": found["unmatched"],
                              "leftovers_after": after, "grew": grew})
        print("round %d (%s) recorded in %s" % (number, header["kind"], sibling(sprint, "-results.jsonl")))
    else:
        found = suite_outcome(root, testing, workers, targets, shown)
        after = leftover_counts(root, testing) if counted else None
        grew = grown(before, after) if counted else []
    results = round_results(planned, found["results"], found["stopped"], True)
    if args.json:
        print(json.dumps(results, indent=2))
        return 0
    for result in results:
        if result["scenario"] not in found["results"]:
            print(result_text(result))
    print("%d passed, %d failed" % (sum(1 for r in results if r["passed"]), sum(1 for r in results if not r["passed"])))
    if counted:
        print_leftovers(before, after, grew)
    if found["setup_failed"]:
        print(found["tail"])
    if found["stopped"]:
        print("the run stopped: no result or output arrived for testing.silence, %d seconds, or for the longer "
              "silence a test still running declares" % testing["silence"])
    if found["unmatched"]:
        print("%d result lines matched no planned test" % len(found["unmatched"]))
    print("slowest %d by what each adds to the run's wall time (workers: %d):" % (testing["slowest"], workers))
    for result in ranked_slowest(results, testing["slowest"], workers, {t["scenario"]: t for t in targets}):
        print("  %s, adds %ss" % (result_text(result), result["cost"]))
    return 0


def owner_issues(plan):
    return {s["id"]: s["issue"] for s in plan["scenarios"] if s.get("issue")}


def held_promises(root, run):
    return {text_field(item, "scenario"): text_field(item, "issue")
            for item in run_items(root, run, "promises") if item["state"] == "held"}


def unsettled_failures(root, sprint):
    rounds = results_rounds(root, sprint)
    if not rounds:
        return None, []
    plan = read_plan(root, sprint)
    settled = set(owner_issues(plan)) | set(held_promises(root, run_file(root, sprint)))
    latest = rounds[-1]
    failing = [r for r in latest["results"] if not r["passed"] and r["scenario"] not in settled]
    return latest, failing + leftover_failures(latest)


# @decision: tests-isolated-unless-declared
def leftover_failures(entry):
    before, after = entry.get("leftovers_before") or {}, entry.get("leftovers_after") or {}
    return [{"scenario": LEFTOVERS + kind, "path": None, "name": None, "passed": False, "seconds": None,
             "leftovers": kind, "tail": "testing.leftovers counted %s %s before round %d and %s after it"
             % (before.get(kind, 0), kind, entry["round"], after.get(kind, "-"))}
            for kind in entry.get("grew") or []]


def cmd_failures(args, root):
    sprint = resolved_sprint(root, args.sprint)
    latest, failing = unsettled_failures(root, sprint)
    if args.json:
        print(json.dumps({"round": latest["round"] if latest else None, "failures": failing}, indent=2))
        return 0
    if latest is None:
        print("no round recorded yet: run `tests run --sprint %s`" % sprint)
        return 0
    print("round %d: %d unsettled failures" % (latest["round"], len(failing)))
    for result in failing:
        print("- %s %s: %s" % (result["scenario"], result["path"] or "-", first_line(result["tail"])))
    return 0


def stray_paths(root, sprint):
    live = live_tests(root, sprint)
    claimed = set()
    for entry in live.values():
        if entry["test"]:
            claimed.add(entry["test"]["path"])
        claimed.update(entry["support"])
    plan = read_plan(root, sprint)
    files = tree_files(root, plan_folders(plan))
    recorded = {path for s in read_state(root)["scenarios"] + plan["scenarios"] for path in s.get("support") or []}
    recorded |= {e["path"] for e in plan["legacy"] if e["sort"] == "support" and e["path"]}
    candidates = test_paths(root, files) | (recorded & set(files))
    return sorted(path for path in candidates if path not in claimed)


def cmd_stray(args, root):
    sprint = resolved_sprint(root, args.sprint)
    strays = stray_paths(root, sprint)
    if args.json:
        print(json.dumps(strays, indent=2))
        return 0
    if not strays:
        print("None.")
    for path in strays:
        print("- %s" % path)
    return 0


def file_task(root, run, role, key, files, brief, after=(), cites=()):
    args = ["file", "--role", role, "--prompt", role, "--agent", "ok-opus", "--key", key, "--brief", brief]
    if files:
        args += ["--files", *files]
    if after:
        args += ["--after", *sorted(set(after))]
    if cites:
        args += ["--cites", *cites]
    out = tasks_run(root, run, *args).strip()
    return {"role": role, "key": key, "task": out.split()[-1] if out else None}


def scenario_brief(s, support=None):
    support = s.get("support") if support is None else support
    parts = ["scenario %s (%s): %s" % (s["id"], s["action"], s["text"]), "Source: %s." % s.get("source")]
    for name in ("part", "class", "harm"):
        if s.get(name):
            parts.append("%s: %s." % (name.capitalize(), s[name]))
    if s.get("test"):
        parts.append("Test: %s." % locator(s["test"]))
    if support:
        parts.append("Support: %s." % ", ".join(support))
    for name in ("kind", "setup", "entry"):
        if s.get(name):
            parts.append("%s: %s." % (name.capitalize(), s[name]))
    if s.get("reach"):
        parts.append("Reach: %s" % s["reach"])
    if s.get("waits"):
        parts.append("Waits on: %s." % s["waits"])
    if s.get("resources"):
        parts.append("Shared resources it declares it changes: %s." % ", ".join(s["resources"]))
    if s.get("ruling"):
        parts.append("Owner's ruling: %s" % s["ruling"])
    return " ".join(parts)


def holders_of(tasks, roles):
    holders = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") in roles and task.get("state") != "closed":
            for path in task.get("files") or []:
                holders[path] = task["id"]
    return holders


def filed_after(root, run, holders, role, key, files, brief, after=(), cites=()):
    waits = [holders[path] for path in files if path in holders] + list(after)
    task = file_task(root, run, role, key, files, brief, waits, cites)
    for path in files:
        holders[path] = task["task"]
    return task


def task_order(task):
    digits = re.sub(r"\D", "", task.get("id") or "")
    return int(digits) if digits else 0


def registered_prompts(root, run):
    return {json.loads(line).get("id") for line in tasks_run(root, run, "dump", "--type", "prompt").split("\n")
            if line.strip()}


def support_of(plan, s):
    if s["action"] not in ("new", "rewrite"):
        return []
    return sorted(set(s.get("support") or []) | {e["path"] for e in plan["legacy"]
                                                 if e["sort"] == "support" and s["id"] in e["scenarios"]})


def cited_scenarios(task):
    return {cite for cite in task.get("cites") or [] if not cite.startswith(HELPERS_CITE)}


def cited_helpers(task):
    return {cite[len(HELPERS_CITE):] for cite in task.get("cites") or [] if cite.startswith(HELPERS_CITE)}


def helper_path(item):
    return text_field(item, "path") or item.get("key")


def write_refusals(tasks, helpers):
    ordered = sorted(tasks, key=task_order)
    support = [task for task in ordered if task.get("role") == "support"]
    latest = {(task.get("role"), task.get("key")): task for task in ordered}
    refusals = []
    for item in helpers:
        briefed = [task for task in support if item["id"] in cited_helpers(task)]
        if not briefed:
            continue
        last = latest.get(("support", briefed[-1].get("key"))) or briefed[-1]
        if item["state"] == "open" and last.get("state") == "closed" and last.get("outcome") == "done":
            refusals.append("helpers item %s (%s) stands open, and support task %s, whose brief named it, closed done; "
                            "surface it as a genuine blocker" % (item["id"], helper_path(item), last["id"]))
    by_scenario = {}
    for task in ordered:
        if task.get("role") == "test":
            by_scenario.setdefault(task.get("key"), []).append(task)
    for sid, mine in sorted(by_scenario.items()):
        last_two = mine[-2:]
        if len(last_two) == 2 and all(t.get("state") == "closed" and t.get("outcome") == "blocked" for t in last_two):
            refusals.append("scenario %s: test tasks %s closed blocked twice: %s; surface it as a genuine blocker"
                            % (sid, ", ".join(t["id"] for t in last_two), last_two[-1].get("result")))
    return refusals


# @decision: test-loop-fixes-code-never-tests
def awaits_verifier(item):
    return item["state"] == "open" and test_of(item) is not None and not field(item, "retired") \
        and not field(item, "gap")


def sender_of(item):
    return "the speed reviewer" if text_field(item, "by") == SPEED_SENDER else "the verifier"


def sent_back_tests(records, tasks):
    ordered = sorted(tasks, key=task_order)
    found = []
    for sid, item in sorted(records.items()):
        if item["state"] != "sent-back":
            continue
        mine = [task for task in ordered if task.get("role") == "test" and task.get("key") == sid]
        last = mine[-1] if mine else None
        if last is not None and (last.get("state") != "closed"
                                 or task_order(last) > task_order({"id": item.get("task")})):
            continue
        found.append((sid, item, last))
    return found


def refiled_tests(root, run, plan, records, tasks, holders):
    by_id = {s["id"]: s for s in plan["scenarios"]}
    filed = []
    for sid, item, last in sent_back_tests(records, tasks):
        s = by_id.get(sid)
        base = scenario_brief(s, sorted(set(s.get("support") or []) | set(support_of(plan, s)))) if s else (
            (last or {}).get("brief") or "scenario %s" % sid)
        brief = "%s\n%s sent the test back: %s" % (
            base, sender_of(item).capitalize(), text_field(item, "reason") or first_line(item.get("body")))
        if last is None:
            files = sorted({path for path in (text_field(item, "path"),) if path})
            filed.append(filed_after(root, run, holders, "test", sid, files, brief))
            continue
        after = sorted({holders[path] for path in last.get("files") or [] if path in holders})
        args = ["refile", last["id"], "--brief", brief] + (["--after", *after] if after else [])
        out = tasks_run(root, run, *args).strip()
        refiled = {"role": "test", "key": sid, "task": out.split()[-1] if out else None, "refile_of": last["id"]}
        for path in last.get("files") or []:
            holders[path] = refiled["task"]
        filed.append(refiled)
    return filed


def blocked_on_helpers(tasks, helpers):
    latest = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") == "test":
            latest[task.get("key")] = task
    filed_by = {}
    for item in helpers:
        filed_by.setdefault(item.get("task"), []).append(item)
    return [(task, filed_by[task["id"]]) for sid, task in sorted(latest.items())
            if task.get("state") == "closed" and task.get("outcome") == "blocked" and task["id"] in filed_by]


def support_brief(path, scenarios, items):
    lines = ["support file %s." % path]
    if scenarios:
        lines.append("Scenarios whose tests use it:")
        lines += ["- %s" % scenario_brief(s) for s in scenarios]
    if items:
        lines.append("Helpers to add, each a helpers item to mark added:")
        lines += ["- helpers item %s (scenario %s): %s" % (item["id"], text_field(item, "scenario") or "-",
                                                          item.get("body") or "") for item in items]
    return "\n".join(lines)


def stage_support(root, run, plan, existing, tasks, helpers, holders, after_controls):
    support = sorted((task for task in tasks if task.get("role") == "support"), key=task_order)
    served, count, latest = {}, {}, {}
    for task in support:
        for path in task.get("files") or []:
            served.setdefault(path, set()).update(cited_scenarios(task))
            count[path] = count.get(path, 0) + 1
            latest[path] = task["id"]
    held = {path for task in support if task.get("state") != "closed" for path in task.get("files") or []}
    briefed = set().union(*(cited_helpers(task) for task in support)) if support else set()
    wanting, items = {}, {}
    for s in plan["scenarios"]:
        if s["action"] in WRITTEN and ("test", s["id"]) not in existing:
            for path in support_of(plan, s):
                if s["id"] not in served.get(path, set()):
                    wanting.setdefault(path, []).append(s)
    for item in helpers:
        path = helper_path(item)
        if item["state"] == "open" and item["id"] not in briefed and path and path not in held:
            items.setdefault(path, []).append(item)
    filed = []
    for path in sorted(set(wanting) | set(items)):
        n = count.get(path, 0) + 1
        key = "support:%s" % path if n == 1 else "support:%s:%d" % (path, n)
        scenarios, mine = wanting.get(path, []), items.get(path, [])
        cites = sorted(s["id"] for s in scenarios) + [HELPERS_CITE + item["id"] for item in mine]
        task = filed_after(root, run, holders, "support", key, [path], support_brief(path, scenarios, mine),
                           after_controls, cites)
        latest[path] = task["task"]
        briefed.update(item["id"] for item in mine)
        filed.append(task)
    return filed, latest, briefed


def unregistered(sprint, run, role, block, stage):
    prompt = sibling(sprint, "-%s.md" % role)
    return InputError("the run registers no %s prompt, so --stage %s files nothing: write the block %s of "
                      ".claude/skills/plan-tests/core.md, its transclusions resolved and [TEST SPRINT PATH] filled, "
                      "to %s, run `tasks --file %s prompt register %s %s`, and run --stage %s again"
                      % (role, stage, block, prompt, run, role, prompt, stage))


def stack_named(plan):
    budget = plan.get("budget")
    return isinstance(budget, dict) and bool(budget.get("stack")) and budget["stack"] != NO_STACK


def preflight_brief(budget):
    lines = ["the test stack's budget: %d workers; start the stack with: %s" % (budget["workers"], budget["stack"]),
             "Sizing: %s" % budget["sizing"],
             "Files you may edit, to that sizing: %s." % (", ".join(budget["files"]) or "none")]
    lines += ["Limit %s: %s, %s" % (limit["limit"], limit["how"], limit["detail"]) for limit in budget["limits"]]
    return "\n".join(lines)


# @decision: tests-isolated-unless-declared
def stage_preflight(root, sprint, run, plan, tasks, prompts, after_controls):
    if not stack_named(plan):
        return None
    mine = sorted((task for task in tasks if task.get("role") == "preflight"), key=task_order)
    last = mine[-1] if mine else None
    if last is not None and last.get("state") == "closed" and last.get("outcome") == "done":
        return None
    if last is not None and last.get("state") != "closed":
        return []
    if "preflight" not in prompts:
        raise unregistered(sprint, run, "preflight", "TEST-PREFLIGHT-PROMPT", "write")
    budget = plan["budget"]
    if last is None:
        return [file_task(root, run, "preflight", "preflight", budget["files"], preflight_brief(budget), after_controls)]
    if len(mine) >= 2 and all(task.get("outcome") == "blocked" for task in mine[-2:]):
        raise InputError("preflight tasks %s closed blocked twice: %s; surface it as a genuine blocker"
                         % (", ".join(task["id"] for task in mine[-2:]), last.get("result")))
    brief = "%s\nThe last preflight, %s, closed %s: %s" % (preflight_brief(budget), last["id"], last.get("outcome"),
                                                          last.get("result") or "-")
    out = tasks_run(root, run, "refile", last["id"], "--brief", brief).strip()
    return [{"role": "preflight", "key": "preflight", "task": out.split()[-1] if out else None, "refile_of": last["id"]}]


def control_brief(plan, control):
    by_id = {s["id"]: s for s in plan["scenarios"]}
    gate = ("Gate setting: %s, on in the test stack's configuration and off in production's." % control["gate"]
            if control.get("gate") else "No gate: an exposed setting carries its value in every deployment's configuration.")
    lines = ["time control %s (%s) at %s: %s" % (control["id"], control["form"], control["site"], control.get("text") or "-"),
             gate, "Files you may change: %s." % ", ".join(control["files"]), "Scenarios whose tests wait on it:"]
    lines += ["- %s" % scenario_brief(by_id[sid]) for sid in control.get("scenarios") or [] if sid in by_id]
    return "\n".join(lines)


def control_tasks(tasks):
    mine = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") == "control":
            mine.setdefault(task.get("key"), []).append(task)
    return mine


# @decision: test-sprints-build-approved-time-controls
def stage_controls(root, sprint, run, plan, tasks, prompts):
    controls = plan.get("controls") or []
    if not controls:
        return None
    if "control" not in prompts:
        raise unregistered(sprint, run, "control", "TEST-CONTROL-PROMPT", "write")
    by_key = control_tasks(tasks)
    holders = holders_of(tasks, ["control"])
    filed, pending = [], False
    for control in controls:
        key = CONTROL_KEY + control["id"]
        mine = by_key.get(key, [])
        last = mine[-1] if mine else None
        if last is not None and last.get("state") == "closed" and last.get("outcome") == "done":
            continue
        if last is not None and last.get("state") != "closed":
            pending = True
            continue
        brief = control_brief(plan, control)
        if last is None:
            filed.append(filed_after(root, run, holders, "control", key, sorted(set(control["files"])), brief))
            continue
        if len(mine) >= 2 and all(task.get("outcome") == "blocked" for task in mine[-2:]):
            raise InputError("time control %s: control tasks %s closed blocked twice: %s; surface it as a genuine blocker"
                             % (control["id"], ", ".join(task["id"] for task in mine[-2:]), last.get("result")))
        brief += "\nThe last attempt, %s, closed %s: %s" % (last["id"], last.get("outcome"), last.get("result") or "-")
        out = tasks_run(root, run, "refile", last["id"], "--brief", brief).strip()
        filed.append({"role": "control", "key": key, "task": out.split()[-1] if out else None, "refile_of": last["id"]})
    return filed if filed or pending else None


def controls_built(tasks):
    return sorted(mine[-1]["id"] for mine in control_tasks(tasks).values())


# @decision: test-support-written-before-tests
# @decision: test-sprints-build-approved-time-controls
def stage_write(root, sprint, run, plan, existing, tasks):
    prompts = registered_prompts(root, run)
    if "support" not in prompts:
        raise unregistered(sprint, run, "support", "TEST-SUPPORT-PROMPT", "write")
    controls = stage_controls(root, sprint, run, plan, tasks, prompts)
    if controls is not None:
        return controls
    after_controls = controls_built(tasks)
    preflight = stage_preflight(root, sprint, run, plan, tasks, prompts, after_controls)
    if preflight is not None:
        return preflight
    helpers = run_items(root, run, "helpers")
    refusals = write_refusals(tasks, helpers)
    if refusals:
        raise InputError("--stage write files nothing:\n" + "\n".join("- %s" % refusal for refusal in refusals))
    holders = holders_of(tasks, [role for role in HOLDING_ROLES if role != "sweep"])
    filed, latest_support, briefed = stage_support(root, run, plan, existing, tasks, helpers, holders, after_controls)
    live = live_tests(root, sprint)
    state = {s["id"]: s for s in read_state(root)["scenarios"]}
    by_id = {s["id"]: s for s in plan["scenarios"]}
    for s in plan["scenarios"]:
        if s["action"] not in WRITTEN or ("test", s["id"]) in existing:
            continue
        test = s.get("test") or (state.get(s["id"]) or {}).get("test") or {}
        old = (state.get(s["id"]) or {}).get("test") or {}
        if s["action"] == "retire" and not test and not old:
            continue
        files = sorted({path for path in (test.get("path"), old.get("path")) if path})
        after = [latest_support[path] for path in support_of(plan, s) if path in latest_support] + after_controls
        support = sorted(set(s.get("support") or []) | set(support_of(plan, s)))
        filed.append(filed_after(root, run, holders, "test", s["id"], files, scenario_brief(s, support), after))
    by_file = {}
    for entry in plan["legacy"]:
        if entry["sort"] in ("port", "delete"):
            by_file.setdefault(entry["path"], []).append(entry)
    for path, entries in sorted(by_file.items()):
        key = "legacy:%s" % path
        if ("legacy", key) in existing:
            continue
        lines = ["%s %s: %s" % (e["sort"], e["name"] or "the whole file",
                                e["reason"] if e["sort"] == "delete" else "enforces %s; becomes the check %s" % (rule_text(e), e["check"]))
                 for e in entries]
        at_path = [entry for entry in live.values() if entry["test"] and entry["test"]["path"] == path]
        kept = sorted({locator(e) for e in plan["legacy"] if e["path"] == path and e["sort"] in ("adopt", "support")}
                      | {locator(entry["test"]) for entry in at_path if entry["test"].get("name")})
        file_tests = sorted(entry["id"] for entry in at_path if not entry["test"].get("name"))
        brief = "legacy file %s. %s.%s%s" % (
            path, "; ".join(lines), " Keep as written: %s." % ", ".join(kept) if kept else "",
            " Keep as written every test in it the lines above do not name: the whole file is the test of %s."
            % ", ".join(file_tests) if file_tests else "")
        files = sorted({path} | {e["check"] for e in entries if e["sort"] == "port"})
        filed.append(filed_after(root, run, holders, "legacy", key, files, brief))
    filed.extend(refiled_tests(root, run, plan, recorded_tests(root, run), tasks, holders))
    for task, items in blocked_on_helpers(tasks, helpers):
        if any(item["state"] == "open" and item["id"] not in briefed for item in items):
            continue
        paths = set(support_of(plan, by_id[task["key"]]) if task.get("key") in by_id else []) | {
            helper_path(item) for item in items}
        after = {latest_support[path] for path in paths if path in latest_support}
        after |= {holders[path] for path in task.get("files") or [] if path in holders}
        args = ["refile", task["id"]] + (["--after", *sorted(after)] if after else [])
        out = tasks_run(root, run, *args).strip()
        refiled = {"role": "test", "key": task.get("key"), "task": out.split()[-1] if out else None,
                   "refile_of": task["id"]}
        for path in task.get("files") or []:
            holders[path] = refiled["task"]
        filed.append(refiled)
    return filed


def stage_sweep(root, sprint, run, existing, tasks):
    if any(task.get("role") == "sweep" and task.get("state") != "closed" for task in tasks):
        return []
    strays = stray_paths(root, sprint)
    if not strays:
        return []
    n = 1 + sum(1 for role, key in existing if role == "sweep")
    return [file_task(root, run, "sweep", "sweep:%d" % n, strays,
                      "stray test files: %s" % ", ".join(strays))]


def fix_scenario(key):
    parts = (key or "").split(":")
    return parts[1] if len(parts) == 4 and parts[0] == "fix" else None


def round_tests(entry, live):
    lines = []
    for target in entry["planned"]:
        declared = (live.get(target["scenario"]) or {}).get("resources") or []
        lines.append("- %s: %s%s" % (target["scenario"], locator(target) or "-",
                                     "; declares %s" % ", ".join(declared) if declared else ""))
    return "\n".join(lines) or "- none"


def stage_fix(root, sprint, run, existing, tasks):
    latest, failing = unsettled_failures(root, sprint)
    if latest is None:
        raise InputError("no round recorded yet: run `tests run --sprint %s` first" % sprint)
    live = live_tests(root, sprint) if any(result.get("leftovers") for result in failing) else {}
    round_no = latest["round"]
    items = run_items(root, run, "fixes") + run_items(root, run, "promises")
    fix_tasks = sorted((task for task in tasks if task.get("role") == "fix"), key=task_order)
    unclosed = [task for task in fix_tasks if task.get("state") != "closed"]
    previous = unclosed[-1]["id"] if unclosed else None
    filed = []
    for result in failing:
        sid = result["scenario"]
        prefix = "fix:%s:%d:" % (sid, round_no)
        attempts = [task for task in fix_tasks if (task.get("key") or "").startswith(prefix)]
        if any(task.get("state") != "closed" for task in attempts):
            continue
        mine = sorted((item for item in items if text_field(item, "scenario") == sid
                       and field(item, "round") in (round_no, str(round_no))), key=lambda item: task_order(item))
        last = mine[-1] if mine else None
        if last is not None and last["state"] in ("open", "accepted", "held"):
            continue
        reason = ""
        last_attempt = attempts[-1] if attempts else None
        if last_attempt is not None and (last is None or last.get("task") != last_attempt["id"]):
            mine_all = [task for task in fix_tasks if fix_scenario(task.get("key")) == sid]
            if len(mine_all) >= 2 and all(task.get("outcome") == "blocked" for task in mine_all[-2:]):
                raise InputError("scenario %s: fix tasks %s closed blocked twice: %s; surface it as a genuine blocker"
                                 % (sid, ", ".join(task["id"] for task in mine_all[-2:]), mine_all[-1].get("result")))
            reason = "The last attempt, %s, closed %s and recorded nothing: %s" % (
                last_attempt["id"], last_attempt.get("outcome"), last_attempt.get("result") or "-")
        elif last is not None:
            reason = "The verifier sent the last attempt back: %s" % (text_field(last, "reason") or first_line(last.get("body")))
            if last.get("pool") == "fixes" and text_field(last, "fix"):
                restored = back_out(root, sprint, text_field(last, "fix"))
                if restored:
                    reason += " The tool backed its change out of %s, so you start from the tree before it." % (
                        ", ".join(restored))
        if result.get("leftovers"):
            brief = "%s: %s. The round ran these tests:\n%s\n%s" % (sid, result["tail"], round_tests(latest, live), reason)
        else:
            brief = "scenario %s failed in round %d: test %s. Output tail:\n%s\n%s" % (
                sid, round_no, locator({"path": result["path"], "name": result["name"]}) if result["path"] else "-",
                result["tail"], reason)
        task = file_task(root, run, "fix", "%s%d" % (prefix, len(attempts) + 1), [], brief,
                         [previous] if previous else ())
        previous = task["task"]
        filed.append(task)
    return filed


def test_verify_brief(item, s):
    parts = ["tests item %s: scenario %s. Test: %s." % (item["id"], text_field(item, "scenario"),
                                                        locator(test_of(item)))]
    if s.get("reach"):
        parts.append("Reach: %s" % s["reach"])
    if s.get("waits"):
        parts.append("Waits on: %s." % s["waits"])
    parts.append(first_line(item.get("body")))
    return " ".join(parts)


# @decision: test-loop-fixes-code-never-tests
# @decision: tests-spend-time-only-on-their-outcome
def stage_verify(root, run, plan, existing, tasks):
    filed = []
    by_id = {s["id"]: s for s in plan["scenarios"]}
    for item in recorded_tests(root, run).values():
        key = "verify:%s" % item["id"]
        if not awaits_verifier(item) or ("verify", key) in existing:
            continue
        brief = test_verify_brief(item, by_id.get(text_field(item, "scenario")) or {})
        filed.append(file_task(root, run, "verify", key, [], brief))
    pools = {pool: run_items(root, run, pool) for pool in ("fixes", "promises")}
    chained = {"verify:%s" % item["id"] for items in pools.values() for item in items}
    unclosed = sorted((task for task in tasks if task.get("role") == "verify" and task.get("state") != "closed"
                       and task.get("key") in chained), key=task_order)
    previous = unclosed[-1]["id"] if unclosed else None
    for pool, items in pools.items():
        for item in items:
            key = "verify:%s" % item["id"]
            if item["state"] != "open" or ("verify", key) in existing:
                continue
            brief = "%s item %s: scenario %s, round %s. %s" % (
                pool, item["id"], text_field(item, "scenario"), field(item, "round"), first_line(item.get("body")))
            files = list_field(item, "files") if pool == "fixes" else []
            task = file_task(root, run, "verify", key, files, brief, [previous] if previous else ())
            previous = task["task"]
            filed.append(task)
    return filed


def late_tasks(tasks, entry):
    changing = {task["id"] for task in tasks if task.get("role") in CHANGING_ROLES and task.get("state") == "closed"}
    return sorted(changing - set(entry.get("tasks_closed") or []))


def test_digest(root, entry):
    paths = sorted({entry["test"]["path"]} | set(entry["support"]))
    named = "".join("%s %s\n" % (rel, blob_of(root, rel, False) or "-") for rel in paths)
    return hashlib.sha256(named.encode("utf-8")).hexdigest()[:16]


def speed_accepted(items, sid, digest):
    return any(item["state"] == "accepted" and text_field(item, "scenario") == sid
               and text_field(item, "digest") == digest for item in items)


def speed_sent_back(items, sid):
    return [item for item in items if text_field(item, "scenario") == sid and item["state"] == "sent-back"]


def written_tests(root, run):
    return {sid for sid, item in recorded_tests(root, run).items()
            if test_of(item) and not field(item, "retired") and not field(item, "gap")}


# @decision: tests-spend-time-only-on-their-outcome
def speed_walk(root, sprint, run, entry, live):
    written = written_tests(root, run)
    items = run_items(root, run, "speed")
    ranked = []
    for result in round_ranked(root, sprint, entry, live):
        test = live.get(result["scenario"])
        if result["scenario"] in written and test and test["test"]:
            ranked.append((len(ranked) + 1, result, test, test_digest(root, test)))
    size = testing_config(root)["slowest"]
    for start in range(0, len(ranked), size):
        batch = ranked[start:start + size]
        pending = [row for row in batch if not speed_accepted(items, row[1]["scenario"], row[3])]
        if pending:
            return pending
        if not any(speed_sent_back(items, row[1]["scenario"]) for row in batch):
            return []
    return []


def speed_brief(s, entry, result, rank, round_no, workers, digest, backs):
    held = entry["resources"]
    share = ("it holds %s alone, so it adds its whole seconds" % ", ".join(held) if held
             else "it is isolated, so it adds its seconds divided by the %d workers" % workers)
    lines = [scenario_brief(dict(s, test=entry["test"], resources=held), entry["support"]),
             "Round %d ranks it %d among the tests this sprint wrote or modified, by what each test adds to the "
             "run's wall time: %ss, setup and teardown included; %s, %ss. Digest of its test file and support "
             "files: %s." % (round_no, rank, result["seconds"], share, result["cost"], digest)]
    lines += ["Speed review %s sent it back: %s" % (item.get("task") or "-", text_field(item, "reason")
                                                    or first_line(item.get("body"))) for item in backs]
    return "\n".join(lines)


def speed_refusal(root, sprint, run, tasks):
    latest, failing = unsettled_failures(root, sprint)
    if latest is None:
        return "no round recorded yet: run the whole suite, `tests run --sprint %s`" % sprint
    if (latest.get("kind") or "whole") != "whole":
        return ("round %d reran failing tests only: run the whole suite as the gate, `tests run --sprint %s`"
                % (latest["round"], sprint))
    if failing:
        return ("round %d lists %d failures, %s: work them as step 6 of the test sprint says, and run --stage speed "
                "once a whole-suite round lists none" % (latest["round"], len(failing),
                                                          ", ".join(result["scenario"] for result in failing)))
    late = late_tasks(tasks, latest)
    if late:
        return ("round %d ran before tasks %s closed: run the whole suite again, `tests run --sprint %s`, so the "
                "speed review reads the seconds of the tests as they stand" % (latest["round"], ", ".join(late), sprint))
    waiting = sorted(sid for sid, item in recorded_tests(root, run).items()
                     if item["state"] == "sent-back" or awaits_verifier(item))
    if waiting:
        return ("the tests of %s stand sent back or await their verifier: run --stage write and --stage verify "
                "until neither files a task, then the whole suite" % ", ".join(waiting))
    return None


# @decision: tests-spend-time-only-on-their-outcome
def stage_speed(root, sprint, run, plan, tasks):
    refusal = speed_refusal(root, sprint, run, tasks)
    if refusal:
        raise InputError("--stage speed files nothing: %s" % refusal)
    if "speed" not in registered_prompts(root, run):
        raise unregistered(sprint, run, "speed", "TEST-SPEED-PROMPT", "speed")
    latest = results_rounds(root, sprint)[-1]
    live = live_tests(root, sprint)
    workers = latest.get("workers") or budget_workers(root, sprint)
    items = run_items(root, run, "speed")
    by_id = {s["id"]: s for s in plan["scenarios"]}
    by_key = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") == "speed":
            by_key.setdefault(task.get("key"), []).append(task)
    filed = []
    for rank, result, entry, digest in speed_walk(root, sprint, run, latest, live):
        sid = result["scenario"]
        key = "speed:%s:%s" % (sid, digest)
        mine = by_key.get(key, [])
        last = mine[-1] if mine else None
        verdicts = {item.get("task") for item in items if text_field(item, "scenario") == sid}
        settled = [task for task in mine if task.get("outcome") == "done" and task["id"] in verdicts]
        if last is not None and (last.get("state") != "closed" or last in settled):
            continue
        s = by_id.get(sid) or {"id": sid, "action": "keep", "text": "-"}
        brief = speed_brief(s, entry, result, rank, latest["round"], workers, digest, speed_sent_back(items, sid))
        if last is None:
            filed.append(file_task(root, run, "speed", key, [], brief))
            continue
        if len(mine) >= 2 and not any(task in settled for task in mine[-2:]):
            raise InputError("scenario %s: speed tasks %s closed short of done or with no verdict twice: %s; surface "
                             "it as a genuine blocker" % (sid, ", ".join(task["id"] for task in mine[-2:]),
                                                          last.get("result")))
        brief += "\nThe last speed review, %s, closed %s%s: %s" % (
            last["id"], last.get("outcome"), "" if last["id"] in verdicts else " with no verdict",
            last.get("result") or "-")
        out = tasks_run(root, run, "refile", last["id"], "--brief", brief).strip()
        filed.append({"role": "speed", "key": key, "task": out.split()[-1] if out else None, "refile_of": last["id"]})
    return filed


# @decision: tests-spend-time-only-on-their-outcome
def speed_failures(root, sprint, run, entry, live):
    return ["scenario %s, rank %d among the tests this sprint wrote or modified on round %d: no speed review "
            "accepted its test at digest %s: run `tests tasks --sprint %s --stage speed`"
            % (result["scenario"], rank, entry["round"], digest, sprint)
            for rank, result, test, digest in speed_walk(root, sprint, run, entry, live)]


def cmd_tasks(args, root):
    sprint = resolved_sprint(root, args.sprint)
    run = run_file(root, sprint)
    plan = read_plan(root, sprint)
    tasks = run_tasks(root, run)
    existing = {(task.get("role"), task.get("key")) for task in tasks}
    if args.stage == "write":
        filed = stage_write(root, sprint, run, plan, existing, tasks)
    elif args.stage == "sweep":
        filed = stage_sweep(root, sprint, run, existing, tasks)
    elif args.stage == "fix":
        filed = stage_fix(root, sprint, run, existing, tasks)
    elif args.stage == "verify":
        filed = stage_verify(root, run, plan, existing, tasks)
    else:
        filed = stage_speed(root, sprint, run, plan, tasks)
    print(json.dumps({"stage": args.stage, "filed": filed}, indent=2))
    return 0


def review_config(root):
    config = read_json(root, REVIEW_CONFIG, "fix it by hand")
    if not isinstance(config, dict):
        raise InputError("%s does not hold an object: /ok seeds it" % REVIEW_CONFIG)
    if "checks" not in config:
        raise InputError("%s declares no checks, the project's check commands, which `review checks` reads too: "
                         "restore it, with [] where the project has none" % REVIEW_CONFIG)
    return config


def ported_items(root, run):
    latest = {}
    for task in sorted(run_tasks(root, run), key=task_order):
        if task.get("role") == "legacy":
            latest[task.get("key")] = task["id"]
    current = set(latest.values())
    return [item for item in run_items(root, run, "ports") if item.get("task") in current]


def ports_refusal(run, starting):
    lines = ["- ports item %s, recorded by legacy task %s: %r starts the test runner %r"
             % (item["id"], item.get("task") or "-", text_field(item, "command"), runner) for item, runner in starting]
    return ("no check added to %s: a check runs on every review, and review checks refuses one that starts a test "
            "runner:\n%s\nRefile each legacy task named with `%s --file %s refile <task> --brief \"<its brief>; revise: "
            "<this refusal>\"`, drain, and run `tests ports` again" % (REVIEW_CONFIG, "\n".join(lines), TASKS, run))


# @decision: legacy-suites-sorted-automatically
def cmd_ports(args, root):
    sprint = resolved_sprint(root, args.sprint)
    run = run_file(root, sprint)
    items = [item for item in ported_items(root, run) if text_field(item, "command")]
    config = review_config(root)
    checks, refusal = review.declared_checks(root, config)
    if refusal:
        raise InputError("%s; no check added" % refusal)
    runners = review.project_runners(root)
    starting = [(item, review.test_runner_of(text_field(item, "command"), runners)) for item in items]
    starting = [(item, runner) for item, runner in starting if runner]
    if starting:
        raise InputError(ports_refusal(run, starting))
    commands = [text_field(item, "command") for item in items]
    checks = list(checks)
    added = [command for command in dict.fromkeys(commands) if command not in checks]
    if added:
        config["checks"] = checks + added
        write_json(root, REVIEW_CONFIG, config)
    for command in added:
        print("added check: %s" % command)
    print("%d checks added to %s" % (len(added), REVIEW_CONFIG))
    return 0


def read_snapshots(root, sprint):
    snapshots = read_json(root, sibling(sprint, "-snapshots.json"), "only this tool writes it")
    return snapshots if isinstance(snapshots, dict) else {}


def git_bytes(root, *args):
    done = subprocess.run(["git", *args], cwd=root, capture_output=True)
    if done.returncode != 0:
        raise InputError("git %s failed: %s" % (" ".join(args), done.stderr.decode("utf-8", "replace").strip()))
    return done.stdout


def blob_of(root, rel, store):
    if not os.path.isfile(os.path.join(root, rel)):
        return None
    args = ["hash-object", "-w", "--", rel] if store else ["hash-object", "--", rel]
    return git(root, *args).strip()


def cmd_snapshot(args, root):
    sprint = resolved_sprint(root, args.sprint)
    snapshots = read_snapshots(root, sprint)
    snap = snapshots.setdefault(args.key, {"before": {}, "after": {}})
    paths = [os.path.normpath(rel) for rel in args.paths]
    if args.after:
        unseen = [rel for rel in paths if rel not in snap["before"]]
        if unseen:
            raise InputError("%s: no snapshot before the edit of %s; a fixer snapshots each file before it first "
                             "edits it" % (args.key, ", ".join(unseen)))
        for rel in paths:
            snap["after"][rel] = blob_of(root, rel, True)
    else:
        for rel in paths:
            if rel not in snap["before"]:
                snap["before"][rel] = blob_of(root, rel, True)
    write_json(root, sibling(sprint, "-snapshots.json"), snapshots)
    print("snapshot %s %s: %s" % (args.key, "after" if args.after else "before", ", ".join(sorted(paths))))
    return 0


def blob_lines(root, blob):
    if blob is None:
        return b"", []
    content = git_bytes(root, "cat-file", "-p", blob)
    return content, content.decode("utf-8", "replace").splitlines(keepends=True)


def cmd_diff(args, root):
    sprint = resolved_sprint(root, args.sprint)
    snap = read_snapshots(root, sprint).get(args.key)
    if snap is None:
        raise InputError("no snapshot for %s: the fixer runs `tests snapshot` before its first edit" % args.key)
    closed = bool(snap["after"])
    for rel, blob in sorted(snap["before"].items()):
        before_bytes, before = blob_lines(root, blob)
        if closed:
            after_bytes, after = blob_lines(root, snap["after"].get(rel))
            gone = snap["after"].get(rel) is None
        else:
            path = os.path.join(root, rel)
            after_bytes = open(path, "rb").read() if os.path.isfile(path) else b""
            after = after_bytes.decode("utf-8", "replace").splitlines(keepends=True)
            gone = not os.path.isfile(path)
        if b"\0" in before_bytes or b"\0" in after_bytes:
            if before_bytes != after_bytes:
                print("Binary file %s differs" % rel)
            continue
        sys.stdout.writelines(difflib.unified_diff(before, after, "a/%s" % rel if blob else "/dev/null",
                                                   "/dev/null" if gone else "b/%s" % rel))
    if not closed:
        print("(no closing snapshot: this compares the snapshot with the tree as it stands)")
    return 0


def back_out(root, sprint, key):
    snapshots = read_snapshots(root, sprint)
    snap = snapshots.get(key)
    if snap is None or not snap["after"]:
        raise InputError("fix %s left no closing snapshot, so its change cannot be backed out: a genuine blocker" % key)
    if snap.get("backed_out"):
        return []
    moved = [rel for rel, blob in snap["after"].items() if blob_of(root, rel, False) != blob]
    if moved:
        raise InputError("fix %s cannot be backed out: %s changed since it closed; a genuine blocker"
                         % (key, ", ".join(sorted(moved))))
    restored = []
    for rel in sorted(snap["after"]):
        blob = snap["before"].get(rel)
        path = os.path.join(root, rel)
        if blob is None:
            git(root, "rm", "-q", "--cached", "--ignore-unmatch", "--", rel)
            if os.path.isfile(path):
                os.unlink(path)
        else:
            os.makedirs(os.path.dirname(path) or root, exist_ok=True)
            with open(path, "wb") as f:
                f.write(git_bytes(root, "cat-file", "-p", blob))
            git(root, "add", "--", rel)
        restored.append(rel)
    snap["backed_out"] = True
    write_json(root, sibling(sprint, "-snapshots.json"), snapshots)
    return restored


def report_section(title, rows):
    print()
    print("## %s" % title)
    print()
    for row in rows:
        print(row)
    if not rows:
        print("None.")


def cmd_report(args, root):
    sprint = resolved_sprint(root, args.sprint)
    text = read_text(root, sprint)
    run = run_file(root, sprint)
    plan = read_plan(root, sprint)
    heading = next((line[2:].strip() for line in text.split("\n") if line.startswith("# ")), sprint)
    title = heading[len(TITLE_PREFIX):] if heading.startswith(TITLE_PREFIX) else heading
    records = recorded_tests(root, run)
    print("# Completion report: %s" % title)
    print()
    print("Test sprint: `%s`" % sprint)
    print()
    print_counts(plan)
    report_section("Support files", [
        "- `%s` (%s): %s. %s" % (task.get("key") or "-", task["id"], task.get("outcome") or task.get("state"),
                                 first_line(task.get("result")) or "no result")
        for task in sorted(run_tasks(root, run), key=task_order) if task.get("role") == "support"]
        + ["- helpers item %s `%s`, scenario `%s`: %s. %s" % (
            item["id"], helper_path(item) or "-", text_field(item, "scenario") or "-", item["state"],
            first_line(item.get("body"))) for item in run_items(root, run, "helpers")])
    report_section("Tests written, rewritten, and retired", [
        "- `%s`: %s. %s" % (s["id"], s["action"], first_line((records.get(s["id"]) or {}).get("body")) or "no record")
        for s in plan["scenarios"] if s["action"] in WRITTEN])
    report_section("Gaps", ["- `%s`: %s" % (s["id"], s["text"]) for s in plan["scenarios"] if s["action"] == "gap"]
                   + ["- `%s`: recorded by its test task: %s" % (sid, first_line(record.get("body")))
                      for sid, record in sorted(records.items()) if field(record, "gap")])
    report_section("Time controls built", [
        "- `%s`: %s; files: %s. %s" % (text_field(item, "control") or item.get("key") or "-",
                                      "gate setting `%s`" % text_field(item, "gate") if text_field(item, "gate") else "no gate",
                                      ", ".join(list_field(item, "files")) or "none", first_line(item.get("body")))
        for item in run_items(root, run, "controls")])
    planned_rules = {locator(e): rule_text(e) for e in plan["legacy"] if e["sort"] == "port"}
    report_section("Legacy tests ported", ["- `%s` enforces %s; now `%s`: %s" % (
        text_field(item, "test") or "-", planned_rules.get(text_field(item, "test")) or text_field(item, "rule") or "-",
        text_field(item, "command") or "-", first_line(item.get("body"))) for item in ported_items(root, run)])
    report_section("Legacy tests deleted", ["- `%s`: %s" % (locator(e), e["reason"])
                                            for e in plan["legacy"] if e["sort"] == "delete"])
    report_section("Fixes", ["- `%s`, round %s: %s. %s" % (text_field(item, "scenario"), field(item, "round"),
                                                         item["state"], first_line(item.get("body")))
                             for item in run_items(root, run, "fixes")])
    report_section("Failures left for a promise change", [
        "- `%s`: %s, issue %s. %s" % (text_field(item, "scenario"), item["state"], text_field(item, "issue") or "-",
                                      first_line(item.get("body"))) for item in run_items(root, run, "promises")]
        + ["- `%s`: owner issue %s" % (sid, issue) for sid, issue in sorted(owner_issues(plan).items())])
    report_section("Calls", ["- `%s`: %s. %s" % (c["site"] or "-", c["choice"] or "-", first_line(c["body"]))
                             for c in plan["calls"]]
                   + ["- `%s`: %s. %s" % (text_field(item, "site") or "-", text_field(item, "choice") or "-",
                                          first_line(item.get("body"))) for item in run_items(root, run, "calls")])
    report_section("Speed reviews", [
        "- `%s` %s: %s, %ss, rank %s, digest %s. %s" % (
            text_field(item, "scenario") or "-", item["state"], text_field(item, "test") or "-",
            field(item, "seconds"), field(item, "rank"), text_field(item, "digest") or "-",
            text_field(item, "reason") or first_line(item.get("body"))) for item in run_items(root, run, "speed")])
    live = live_tests(root, sprint)
    report_section("Rounds", [row for r in results_rounds(root, sprint)
                              for row in round_rows(r, round_slowest(root, sprint, r, live))])
    return 0


def round_rows(r, ranked):
    notes = "".join(note for note, held in (
        ("; stopped: no result arrived within testing.silence", r.get("stopped") == "silence"),
        ("; grew: %s" % ", ".join(map(str, r.get("grew") or [])), bool(r.get("grew"))),
        ("; unmatched result lines: %d" % len(r.get("unmatched") or []), bool(r.get("unmatched"))),
        ("; it did not close", not r.get("closed"))) if held)
    rows = ["- round %d, %s: %d passed, %d failed%s" % (
        r["round"], r.get("kind") or "whole", sum(1 for x in r["results"] if x["passed"]),
        sum(1 for x in r["results"] if not x["passed"]), notes)]
    rows += ["  - slowest: `%s` %ss, adds %ss" % (x["scenario"], x["seconds"], x["cost"]) for x in ranked]
    return rows


# @decision: tests-isolated-unless-declared
# @decision: test-loop-fixes-code-never-tests
def unrewritten_tests(root, run, plan, tasks):
    planned = {s["id"] for s in plan["scenarios"]}
    ordered = sorted(tasks, key=task_order)
    verified = {task.get("key"): task for task in ordered if task.get("role") == "verify"}
    failures = []
    for item in run_items(root, run, "fixes"):
        sid = text_field(item, "scenario") or ""
        if item["state"] != "accepted" or not sid.startswith(LEFTOVERS) or sid in planned:
            continue
        accepted = verified.get("verify:%s" % item["id"]) or {"id": item.get("task")}
        for named in list_field(item, "tests"):
            if not any(task.get("role") == "test" and task.get("key") == named and task.get("state") == "closed"
                       and task.get("outcome") == "done" and task_order(task) > task_order(accepted) for task in ordered):
                failures.append("fixes item %s (%s), accepted, names test %s as leaving the resource behind, and no "
                                "test task rewrote it after task %s" % (item["id"], sid, named, accepted["id"]))
    return failures


# @decision: test-sprints-build-approved-time-controls
def unbuilt_controls(root, run, plan, keys):
    controls = plan.get("controls") or []
    recorded = {text_field(item, "control") for item in run_items(root, run, "controls")} if controls else set()
    failures = []
    for control in controls:
        if ("control", CONTROL_KEY + control["id"]) not in keys:
            failures.append("time control %s has no control task: run `tests tasks --stage write`" % control["id"])
        elif control["id"] not in recorded:
            failures.append("time control %s: no control task recorded what it built in the controls pool"
                            % control["id"])
    return failures


def complete_failures(root, sprint):
    failures = []
    run = sibling(sprint, "-run.jsonl")
    if read_text(root, run) is None:
        return ["no run at %s" % run]
    if read_text(root, sibling(sprint, "-plan.json")) is None:
        return ["no plan at %s" % sibling(sprint, "-plan.json")]
    plan = read_plan(root, sprint)
    tasks = run_tasks(root, run)
    latest = {}
    for task in sorted(tasks, key=task_order):
        if task.get("role") in RUN_ROLES:
            group = fix_scenario(task.get("key")) if task.get("role") == "fix" else task.get("key")
            latest[(task.get("role"), group)] = task
    for (role, group), task in sorted(latest.items(), key=lambda pair: (pair[0][0] or "", pair[0][1] or "")):
        if task.get("state") != "closed" or task.get("outcome") != "done":
            failures.append("%s task %s (%s) stands %s%s" % (role, task["id"], task.get("key") or "-", task.get("state"),
                                                             " " + task["outcome"] if task.get("outcome") else ""))
    keys = {(task.get("role"), task.get("key")) for task in tasks}
    records = recorded_tests(root, run)
    old_scenarios = {s["id"]: s for s in read_state(root)["scenarios"]}
    for s in plan["scenarios"]:
        retired_gap = s["action"] == "retire" and not (old_scenarios.get(s["id"]) or {}).get("test")
        if s["action"] in WRITTEN and not retired_gap and ("test", s["id"]) not in keys:
            failures.append("scenario %s (%s) has no test task" % (s["id"], s["action"]))
        record = records.get(s["id"]) or {}
        if s["action"] in ("new", "rewrite") and not test_of(record) and not field(record, "gap"):
            failures.append("scenario %s (%s): no test task recorded its test or a gap" % (s["id"], s["action"]))
        if s["action"] == "retire" and not retired_gap and not field(records.get(s["id"]) or {}, "retired"):
            failures.append("scenario %s (retire): no test task recorded the retirement" % s["id"])
    for path in sorted({e["path"] for e in plan["legacy"] if e["sort"] in ("port", "delete")}):
        if ("legacy", "legacy:%s" % path) not in keys:
            failures.append("legacy file %s has no legacy task" % path)
    port_items = ported_items(root, run)
    ported = {text_field(item, "command") for item in port_items}
    port_tests = {text_field(item, "test") for item in port_items}
    for entry in plan["legacy"]:
        if entry["sort"] == "port" and locator(entry) not in port_tests:
            failures.append("legacy test %s is planned as a port, and no legacy task recorded its check" % locator(entry))
    checks = review_config(root)["checks"]
    for command in sorted(c for c in ported if c and c not in checks):
        failures.append("ported check %r is not in %s checks: run `tests ports --sprint %s`" % (command, REVIEW_CONFIG, sprint))
    for path in stray_paths(root, sprint):
        failures.append("test file %s: no planned test claims it" % path)
    test_shaped = {}
    for task in tasks:
        if task.get("role") in PRODUCT_ROLES:
            for path in test_paths(root, task.get("staged") or []):
                test_shaped.setdefault(path, task["role"])
    for path, role in sorted(test_shaped.items()):
        failures.append("a %s task staged the test path %s; a %s changes code, never a test"
                        % (role, path, "fix" if role == "fix" else "time control"))
    failures.extend(unbuilt_controls(root, run, plan, keys))
    base = (read_text(root, sibling(sprint, "-base.txt")) or "").strip()
    if not SHA.match(base):
        failures.append("no base commit in %s" % sibling(sprint, "-base.txt"))
    else:
        owned = set()
        for task in tasks:
            if task.get("role") in HOLDING_ROLES:
                owned |= set(task.get("files") or []) | set(task.get("staged") or [])
        for path in sorted(test_paths(root, changed_since(root, base, plan_folders(plan))) - owned):
            failures.append("test path %s changed since the base, and no support, test, legacy, or sweep task holds it"
                            % path)
    for pool in ("fixes", "promises"):
        for item in run_items(root, run, pool):
            if item["state"] == "open":
                failures.append("%s item %s (%s) awaits its verifier" % (pool, item["id"], text_field(item, "scenario")))
    for sid, item in sorted(records.items()):
        if awaits_verifier(item):
            failures.append("tests item %s (%s) awaits its verifier: run `tests tasks --sprint %s --stage verify`"
                            % (item["id"], sid, sprint))
        elif item["state"] == "sent-back":
            failures.append("scenario %s: %s sent its test back (%s), and no test task rewrote it: run "
                            "`tests tasks --sprint %s --stage write`"
                            % (sid, sender_of(item), text_field(item, "reason") or first_line(item.get("body")), sprint))
    for item in run_items(root, run, "helpers"):
        if item["state"] == "open":
            failures.append("helpers item %s (%s) stands open" % (item["id"], helper_path(item)))
    if stack_named(plan) and ("preflight", "preflight") not in keys:
        failures.append("the budget names the test stack %r, and no preflight task ran: run `tests tasks --sprint %s "
                        "--stage write`" % (plan["budget"]["stack"], sprint))
    failures.extend(unrewritten_tests(root, run, plan, tasks))
    rounds = results_rounds(root, sprint)
    if not rounds:
        failures.append("no round recorded: run `tests run --sprint %s`" % sprint)
    else:
        last = rounds[-1]
        whole = (last.get("kind") or "whole") == "whole"
        if not whole:
            failures.append("round %d reran failing tests only: run the whole suite as the gate" % last["round"])
        if not last["closed"]:
            failures.append("round %d did not close: run the whole suite again" % last["round"])
        late = late_tasks(tasks, last)
        if late:
            failures.append("round %d ran before tasks %s closed: run the suite again" % (last["round"], ", ".join(late)))
        live = live_tests(root, sprint)
        ran = {r["scenario"] for r in last["results"]}
        for sid in sorted(set(live) - ran) if whole else []:
            failures.append("round %d did not run scenario %s" % (last["round"], sid))
        if whole:
            failures.extend(speed_failures(root, sprint, run, last, live))
        by_id = {task["id"]: task for task in tasks}
        hashes = [r.get("test_files") or {} for r in rounds] + [test_file_hashes(root, plan_folders(plan))]
        closes = [set(r.get("tasks_closed") or []) for r in rounds] + [{task["id"] for task in tasks
                                                                        if task.get("state") == "closed"}]
        for n in range(1, len(hashes)):
            before, after = hashes[n - 1], hashes[n]
            moved = {path for path in set(before) | set(after) if before.get(path) != after.get(path)}
            held = set()
            for tid in closes[n] - closes[n - 1]:
                task = by_id.get(tid) or {}
                if task.get("role") in HOLDING_ROLES:
                    held |= set(task.get("files") or []) | set(task.get("staged") or [])
            for path in sorted(moved - held):
                failures.append("test file %s changed %s, and no support, test, legacy, or sweep task closed then holds it"
                                % (path, "after round %d" % n if n < len(rounds) else "after the last round"))
        _, failing = unsettled_failures(root, sprint)
        for result in failing:
            if result.get("leftovers"):
                failures.append("round %d: %s" % (last["round"], result["tail"]))
            else:
                failures.append("scenario %s fails in round %d, and no held promise or owner issue settles it"
                                % (result["scenario"], last["round"]))
    if read_text(root, sibling(sprint, "-completion.md")) is None:
        failures.append("no completion report at %s" % sibling(sprint, "-completion.md"))
    return failures


def cmd_complete(args, root):
    sprint = resolved_sprint(root, args.sprint)
    text = read_text(root, sprint)
    stamp = review.closed_stamp(text)
    if sprint.startswith(ARCHIVED_TEST_SPRINTS + os.sep) and stamp:
        print("the test sprint is archived with closed: %s, which is terminal" % stamp)
        failures = []
    else:
        failures = complete_failures(root, sprint)
    mark = os.path.join(root, sibling(sprint, "-complete.txt"))
    if sprint.startswith(TEST_SPRINTS + os.sep):
        if failures and os.path.exists(mark):
            os.unlink(mark)
        elif not failures:
            write_replacing(mark, "TESTS COMPLETE %s\n" % time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    if failures:
        print("TESTS NOT COMPLETE: %s" % sprint)
        for failure in failures:
            print("- %s" % failure)
        print("The completion contract does not hold yet. Keep working toward the goal for this test sprint.")
        return 2
    print("TESTS COMPLETE: %s" % sprint)
    print("The completion contract holds. This meets the goal for this test sprint.")
    print("Archiving, committing, and the stamp are the owner's acts, not goal terms.")
    return 0


def cmd_stamp(args, root):
    sprint = resolved_sprint(root, args.sprint)
    if not sprint.startswith(ARCHIVED_TEST_SPRINTS + os.sep):
        raise InputError("%s is not archived: move it to %s/ and commit the run's work first" % (sprint, ARCHIVED_TEST_SPRINTS))
    if not SHA.match(args.commit) or not review.is_ancestor(root, args.commit, "HEAD"):
        raise InputError("--commit %r names no commit on this branch" % args.commit)
    run_file(root, sprint)
    plan = read_plan(root, sprint)
    live = live_tests(root, sprint)
    recorded = read_state(root)
    old = {s["id"]: s for s in recorded["scenarios"]}
    inferred = stamped_rules(plan, ported_items(root, sibling(sprint, "-run.jsonl")), sprint, recorded["inferred"])
    records = recorded_tests(root, sibling(sprint, "-run.jsonl"))
    waiting = dict(owner_issues(plan), **held_promises(root, sibling(sprint, "-run.jsonl")))
    whole = [r for r in results_rounds(root, sprint) if (r.get("kind") or "whole") == "whole"]
    failed = {r["scenario"] for r in whole[-1]["results"] if not r["passed"]} if whole else set()
    scenarios = []
    for s in plan["scenarios"]:
        if s["action"] == "retire":
            continue
        kept = {"id": s["id"], "source": s.get("source"), "text": s["text"]}
        for name in ("part", "class", "harm", "waits"):
            if s.get(name):
                kept[name] = s[name]
        if s["action"] == "keep" and s["id"] in old:
            kept = dict(old[s["id"]], text=s["text"])
        if (s["action"] == "gap" or field(records.get(s["id"]) or {}, "gap")
                or (s["action"] == "keep" and old.get(s["id"], {}).get("gap"))):
            kept["gap"] = True
            kept.pop("test", None)
            kept.pop("support", None)
            kept.pop("resources", None)
            kept.pop("waits", None)
            kept.pop("silence", None)
        elif s["id"] in live:
            kept["test"] = live[s["id"]]["test"]
            kept["support"] = sorted(live[s["id"]]["support"])
            kept["resources"] = list(live[s["id"]]["resources"])
            kept.pop("silence", None)
            if live[s["id"]]["silence"]:
                kept["silence"] = live[s["id"]]["silence"]
        kept.pop("issue", None)
        if s["id"] in failed and waiting.get(s["id"]):
            kept["issue"] = waiting[s["id"]]
        scenarios.append(kept)
    state = {"stamp": args.commit, "scenarios": scenarios, "unguarded": plan["unguarded"], "budget": plan.get("budget"),
             "inferred": inferred, "kept": plan.get("kept") or []}
    write_json(root, STATE, state)
    text = read_text(root, sprint)
    write_replacing(os.path.join(root, sprint), review.with_closed_stamp(text, args.commit))
    print("stamped: %s at %s, %d scenarios, %d tests, %d gaps" % (
        STATE, args.commit, len(scenarios), sum(1 for s in scenarios if s.get("test")),
        sum(1 for s in scenarios if s.get("gap"))))
    print("closed: %s added to %s" % (args.commit, sprint))
    return 0


# @decision: legacy-suites-sorted-automatically
def stamped_rules(plan, port_items, sprint, carried):
    commands = {text_field(item, "test"): text_field(item, "command") for item in port_items}
    fresh = []
    for entry in plan["legacy"]:
        if entry["sort"] != "port" or entry["rule"] != INFERRED:
            continue
        test = locator(entry)
        if not commands.get(test):
            raise InputError("legacy test %s ports an inferred rule, and no legacy task recorded its check's command: "
                             "`tests complete` refuses such a run, so complete it before the stamp" % test)
        fresh.append({"rule": entry.get("inferred"), "check": entry["check"], "command": commands[test], "test": test,
                      "sprint": sprint})
    checks = {rule["check"] for rule in fresh}
    return [rule for rule in carried if rule.get("check") not in checks] + fresh


# @decision: intake-writers-are-gated
def surviving_rules(root):
    waiting = [rule for rule in read_state(root)["inferred"] if not rule.get("settled")]
    if not waiting:
        return []
    checks, refusal = review.listed_checks(review_config(root))
    if refusal:
        raise InputError(refusal)
    return [rule for rule in waiting if rule.get("command") in checks]


def take_rule(args, root):
    practice = SETTLED_PRACTICE.match(args.settled)
    if not practice and args.settled != RETIRED:
        raise InputError("--as %r is neither practice:<slug> nor %s" % (args.settled, RETIRED))
    if practice and not os.path.isfile(os.path.join(root, PRACTICES, practice.group(1) + ".md")):
        raise InputError("--as %s names no practice: %s/%s.md does not exist, so apply the practice's delta first"
                         % (args.settled, PRACTICES, practice.group(1)))
    state = read_state(root)
    matches = [rule for rule in state["inferred"] if rule.get("check") == args.check]
    if not matches:
        raise InputError("no inferred rule records the check %r: `tests rules` lists the rules that wait" % args.check)
    waiting = [rule for rule in matches if not rule.get("settled")]
    if not waiting:
        raise InputError("the inferred rule of the check %s is already settled as %s" % (args.check, matches[-1]["settled"]))
    for rule in waiting:
        rule["settled"] = args.settled
    write_json(root, STATE, state)
    print("settled: the inferred rule of the check %s as %s" % (args.check, args.settled))
    return 0


def cmd_rules(args, root):
    if args.rules_verb == "take":
        return take_rule(args, root)
    rules = surviving_rules(root)
    if args.json:
        print(json.dumps(rules, indent=2))
        return 0
    for rule in rules:
        print("- `%s`: %s Ported from `%s` in %s; review checks runs `%s`."
              % (rule.get("check"), rule.get("rule"), rule.get("test"), rule.get("sprint"), rule.get("command")))
    if not rules:
        print("None: no inferred rule waits for /plan-sprint.")
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="tests", add_help=False)
    verbs = parser.add_subparsers(dest="verb")
    for name, run in (("window", cmd_window), ("scenarios", cmd_scenarios)):
        verb = verbs.add_parser(name)
        verb.add_argument("--json", action="store_true")
        verb.set_defaults(handler=run)
    declare = verbs.add_parser("declare")
    declare.add_argument("--run")
    declare.add_argument("--silence", type=int)
    declare.add_argument("--named", choices=("yes", "no"))
    declare.add_argument("--leftovers")
    declare.add_argument("--slowest", type=int)
    declare.add_argument("--runners", nargs="*")
    declare.add_argument("--setup")
    declare.add_argument("--setup-silence", dest="setup_silence", type=int)
    declare.add_argument("--timeout")
    declare.set_defaults(handler=cmd_declare)
    run = verbs.add_parser("run")
    run.add_argument("--sprint")
    run.add_argument("--only", nargs="+")
    run.add_argument("--from", dest="from_file")
    run.add_argument("--failing", action="store_true")
    run.add_argument("--json", action="store_true")
    run.set_defaults(handler=cmd_run)
    plan = verbs.add_parser("plan")
    plan.add_argument("--sprint", required=True)
    plan.add_argument("--from-run", dest="from_run")
    plan.add_argument("--show", action="store_true")
    plan.add_argument("--questions", action="store_true")
    plan.add_argument("--json", action="store_true")
    plan.set_defaults(handler=cmd_plan)
    groups = verbs.add_parser("groups")
    groups.add_argument("--sprint", required=True)
    groups.add_argument("--from-run", dest="from_run", required=True)
    groups.add_argument("--size", type=int, default=GROUP_SIZE)
    groups.add_argument("--widen", nargs="*")
    groups.add_argument("--json", action="store_true")
    groups.set_defaults(handler=cmd_groups)
    calls = verbs.add_parser("calls")
    calls.add_argument("stories", nargs="+")
    calls.add_argument("--json", action="store_true")
    calls.set_defaults(handler=cmd_calls)
    tasks = verbs.add_parser("tasks")
    tasks.add_argument("--sprint", required=True)
    tasks.add_argument("--stage", required=True, choices=("write", "sweep", "fix", "verify", "speed"))
    tasks.set_defaults(handler=cmd_tasks)
    for name, run_verb in (("stray", cmd_stray), ("failures", cmd_failures)):
        verb = verbs.add_parser(name)
        verb.add_argument("--sprint", required=True)
        verb.add_argument("--json", action="store_true")
        verb.set_defaults(handler=run_verb)
    for name, run_verb in (("snapshot", cmd_snapshot), ("diff", cmd_diff)):
        verb = verbs.add_parser(name)
        verb.add_argument("--sprint", required=True)
        verb.add_argument("--key", required=True)
        if name == "snapshot":
            verb.add_argument("--after", action="store_true")
            verb.add_argument("paths", nargs="+")
        verb.set_defaults(handler=run_verb)
    for name, run_verb in (("ports", cmd_ports), ("report", cmd_report), ("complete", cmd_complete)):
        verb = verbs.add_parser(name)
        verb.add_argument("--sprint", required=True)
        verb.set_defaults(handler=run_verb)
    stamp = verbs.add_parser("stamp")
    stamp.add_argument("--sprint", required=True)
    stamp.add_argument("--commit", required=True)
    stamp.set_defaults(handler=cmd_stamp)
    rules = verbs.add_parser("rules")
    rules.add_argument("--json", action="store_true")
    rules.set_defaults(handler=cmd_rules)
    rule_verbs = rules.add_subparsers(dest="rules_verb")
    take = rule_verbs.add_parser("take")
    take.add_argument("check")
    take.add_argument("--as", dest="settled", required=True)
    return parser


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE + "\n")
        return 0
    if argv[0] == "version":
        print(VERSION)
        return 0
    args = build_parser().parse_args(argv)
    if not getattr(args, "handler", None):
        sys.stderr.write(USAGE + "\n")
        return 1
    if args.verb == "run" and args.failing and (args.only or args.from_file):
        raise SystemExit("tests: --failing reruns the failing tests of the latest round; it takes no --only or --from")
    if args.verb == "run" and args.failing and not args.sprint:
        raise SystemExit("tests: --failing reruns a test sprint's failing tests; name the test sprint with --sprint")
    if args.verb == "run" and args.from_file and (args.sprint or args.only):
        raise SystemExit("tests: --from runs the tests its file lists; it takes no --sprint or --only")
    if args.verb == "plan" and args.show and (args.from_run or args.questions):
        raise SystemExit("tests: --show prints the plan; it takes no --from-run or --questions")
    if args.verb == "rules" and args.json and args.rules_verb == "take":
        raise SystemExit("tests: --json goes with the listing; rules take prints one line")
    if args.verb == "plan" and args.json and not (args.show or args.questions):
        raise SystemExit("tests: --json goes with --show; assembly prints the counts, and --questions prints JSON already")
    try:
        return args.handler(args, project_root())
    except (InputError, review.ReviewError, review.issues.tasks.Unset) as err:
        sys.stderr.write("tests: %s\n" % err)
        return 1
    except Exception as err:
        review.issues.tasks.event("TESTS.RUN.FAILED", type=type(err).__name__, message=str(err))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
