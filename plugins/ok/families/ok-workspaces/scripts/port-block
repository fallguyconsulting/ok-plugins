#!/usr/bin/env node
// Materialized by ok-workspaces v{{OK_WORKSPACES_VERSION}}. Plugin-owned:
// overwritten wholesale on converge; do not hand-edit.
//
// The one computed source of a workspace's port block. Reads the committed
// profile (.ok-workspaces/config.json) and live worktree state, assigns the
// job its block, and prints one VAR=port line per declared port env var —
// ready to append to the workspace's local env. Everything else (the open
// skill, the cheatsheet) points here instead of restating the arithmetic.
//
// Usage: port-block <job>
//
// Allocation: the job's index among the profile-prefixed worktrees in
// `git worktree list` order (1-based; the next free index for a job whose
// worktree does not exist yet), then ports
// [basePort + index*span, basePort + index*span + span - 1], with the
// declared env vars taking consecutive ports from the block's start.

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const job = process.argv[2];
if (!job) {
  console.error('usage: port-block <job>');
  process.exit(1);
}

function repoRoot() {
  try {
    return execSync('git rev-parse --show-toplevel', { encoding: 'utf8' }).trim();
  } catch {
    return process.cwd();
  }
}

const root = repoRoot();
const cfgPath = path.join(root, '.ok-workspaces', 'config.json');
if (!fs.existsSync(cfgPath)) {
  console.error('port-block: no committed profile at .ok-workspaces/config.json');
  process.exit(2);
}
const cfg = JSON.parse(fs.readFileSync(cfgPath, 'utf8'));
if (cfg.runtime !== 'dev-server') {
  console.error(`port-block: profile runtime is ${JSON.stringify(cfg.runtime)} — port blocks apply to dev-server projects`);
  process.exit(2);
}

const dirPrefix = (cfg.worktrees && cfg.worktrees.dirPrefix) || '.ok-workspaces/worktrees/';
const base = (cfg.devServer && cfg.devServer.basePort) || 3000;
const span = (cfg.devServer && cfg.devServer.portsPerWorkspace) || 10;
const vars = (cfg.devServer && cfg.devServer.portEnvVars) || ['PORT'];

const prefixAbs = path.resolve(root, dirPrefix);
const listing = execSync('git worktree list --porcelain', { cwd: root, encoding: 'utf8' });
const jobs = [];
for (const line of listing.split('\n')) {
  if (!line.startsWith('worktree ')) continue;
  const wt = line.slice('worktree '.length);
  if (wt === prefixAbs || wt.startsWith(prefixAbs + path.sep)) {
    jobs.push(path.basename(wt));
  }
}

const idx = jobs.indexOf(job);
const n = idx >= 0 ? idx + 1 : jobs.length + 1;
const start = base + n * span;

if (vars.length > span) {
  console.error(`port-block: ${vars.length} port env vars declared but the block spans only ${span} ports`);
  process.exit(2);
}

for (let i = 0; i < vars.length; i++) {
  console.log(`${vars[i]}=${start + i}`);
}
console.error(`port-block: workspace ${job} is #${n} — ports ${start}-${start + span - 1}`);
