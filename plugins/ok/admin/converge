#!/usr/bin/env bash

# @decision: suite-owned-ceremonies
# @decision: vendored-skills

set -euo pipefail

MODE="converge"
case "${1:-}" in
    diagnose) MODE="diagnose" ;;
    wire-hooks) MODE="wire-hooks" ;;
    wire-env) MODE="wire-env" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="${SCRIPT_DIR}/.."
SUITE_MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

SUITE_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SUITE_MANIFEST" 2>/dev/null | head -1)
[ -n "$SUITE_VERSION" ] || SUITE_VERSION="unknown"

resolve_root() {
    local dir
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.ok-planner" ] || [ -e "$dir/.ok-plumbline" ] \
            || [ -e "$dir/.ok-workspaces" ] || [ -e "$dir/.plumbline.json" ] \
            || [ -e "$dir/.claude/rules/plumbline-cheatsheet.md" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    pwd
}

ROOT="$(resolve_root)"

python3 - "$MODE" "$ROOT" "$PLUGIN_ROOT" "$SUITE_VERSION" "$SCRIPT_DIR" <<'PY'
import json, os, shutil, stat, sys

mode, root, plugin_root, version, script_dir = sys.argv[1:6]
src = os.path.join(plugin_root, "ceremonies")
dest = os.path.join(root, ".claude", "skills")
RULES_SRC = os.path.join(plugin_root, "rules", "ok-cheatsheet.md")
RULES_DEST = os.path.join(root, ".claude", "rules", "ok-cheatsheet.md")
HOOK_SRC = os.path.join(plugin_root, "hooks", "agent-model")
HOOK_DEST = os.path.join(root, ".claude", "hooks", "ok-agent-model")

STAMP = (
    "\n<!-- Materialized by ok v%s — suite-owned; overwritten on"
    " converge; do not hand-edit. -->\n" % version
)

# The suite's ceremony verbs. Each is one canonical body covering every
# estate a project has, so no name here is ever family-prefixed: the
# collision rule exists for verbs more than one family claims, and these
# are claimed by none.
CEREMONIES = ("plan-sprint", "certify-work", "audit", "document")

# Vendored verbs the hoist replaced. The three family-prefixed audit
# verbs collided under the old rule; the separate periodic-audit verb
# folded into the collapsed audit, which writes both axes.
RETIRED_VENDORED = (
    "ok-planner-audit",
    "ok-plumbline-audit",
    "ok-workspaces-audit",
    "verify-corpus",
)

LICENSE_SRC = os.path.join(plugin_root, "LICENSE")
LICENSE_PREAMBLE = """Vendored ok ceremony files, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the suite-owned files in this directory. Other
skills under .claude/skills/ are not covered by it — they carry their own
license, or the project's.

======================================================================

"""


def expected():
    out = {}
    for verb in CEREMONIES:
        with open(os.path.join(src, verb, "SKILL.md"), encoding="utf-8") as f:
            out[os.path.join(dest, verb, "SKILL.md")] = f.read() + STAMP
    if os.path.exists(LICENSE_SRC):
        with open(LICENSE_SRC, encoding="utf-8") as f:
            body = LICENSE_PREAMBLE + f.read()
        for verb in CEREMONIES:
            out[os.path.join(dest, verb, "LICENSE")] = body
    for src_path, dest_path in ((RULES_SRC, RULES_DEST), (HOOK_SRC, HOOK_DEST)):
        with open(src_path, encoding="utf-8") as f:
            out[dest_path] = f.read().replace("{{OK_VERSION}}", version)
    return out


ENTRY = {
    "matcher": "Agent|Workflow",
    "hooks": [
        {
            "type": "command",
            "command": 'python3 "$CLAUDE_PROJECT_DIR/.claude/hooks/ok-agent-model"',
            "timeout": 10,
        }
    ],
}
MARKER = ".claude/hooks/ok-agent-model"
ENV_NOT_AN_OBJECT = ("unusable: .claude/settings.json has an env that is not an "
                     "object — the suite writes no task-tools entry until the "
                     "owner repairs it")
HOOKS_NOT_AN_OBJECT = ("unusable: .claude/settings.json has a hooks entry that is "
                       "not an object — the suite writes no hook entry until the "
                       "owner repairs it")
PRETOOLUSE_NOT_AN_ARRAY = ("unusable: .claude/settings.json has a hooks.PreToolUse "
                           "that is not an array — the suite writes no hook entry "
                           "until the owner repairs it")
PRETOOLUSE_ENTRY_UNREADABLE = ("unusable: .claude/settings.json has a hooks.PreToolUse "
                               "entry the suite cannot read — the suite writes no hook "
                               "entry until the owner repairs it")
SETTINGS_NOT_AN_OBJECT = ("unusable: .claude/settings.json is not an object — the "
                          "suite writes no entry until the owner repairs it")
SETTINGS_UNPARSEABLE = ("unparseable: .claude/settings.json — the suite writes no "
                        "entry until the owner repairs it")


def read_settings(path):
    if not os.path.exists(path):
        return {}, None
    try:
        settings = json.load(open(path))
    except ValueError:
        return None, SETTINGS_UNPARSEABLE
    if not isinstance(settings, dict):
        return None, SETTINGS_NOT_AN_OBJECT
    return settings, None


def load_settings(path):
    settings, error = read_settings(path)
    if error is not None:
        print(error)
        sys.exit(1)
    return settings


def settings_path():
    return os.path.join(root, ".claude", "settings.json")


def marked_entry(pre):
    for e in pre:
        if not isinstance(e, dict):
            return None, PRETOOLUSE_ENTRY_UNREADABLE
        hooks = e.get("hooks", [])
        if not isinstance(hooks, list):
            return None, PRETOOLUSE_ENTRY_UNREADABLE
        for h in hooks:
            if not isinstance(h, dict):
                return None, PRETOOLUSE_ENTRY_UNREADABLE
            command = h.get("command", "")
            if isinstance(command, str) and MARKER in command:
                return e, None
    return None, None


def settings_findings(settings):
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        return [HOOKS_NOT_AN_OBJECT]
    pre = hooks.get("PreToolUse", [])
    if not isinstance(pre, list):
        return [PRETOOLUSE_NOT_AN_ARRAY]
    entry, unreadable = marked_entry(pre)
    if unreadable is not None:
        return [unreadable]
    if entry is None:
        return ["wiring: .claude/settings.json lacks the ok PreToolUse entry for the subagent-model hook"]
    if entry.get("matcher") != ENTRY["matcher"]:
        return ["wiring: the ok PreToolUse entry's matcher is %r — must be %r"
                % (entry.get("matcher"), ENTRY["matcher"])]
    return []


def print_wiring_block():
    print("WIRING NEEDED (ok): .claude/settings.json needs the PreToolUse entry below.")
    print(json.dumps({"hooks": {"PreToolUse": [ENTRY]}}, indent=2))
    print('On the owner\'s consent run: bash "%s" wire-hooks' % os.path.join(script_dir, "converge"))


# @decision: task-tools-mirror-the-report
# @story: watch-execution-progress
ENV_KEY = "CLAUDE_CODE_ENABLE_TODO_TOOLS"
ENV_VALUE = "1"


def env_findings(settings):
    env = settings.get("env", {})
    if not isinstance(env, dict):
        return [ENV_NOT_AN_OBJECT]
    if ENV_KEY not in env:
        return ["wiring: .claude/settings.json lacks env.%s — the harness task tools "
                "stay off in this project" % ENV_KEY]
    if env.get(ENV_KEY) != ENV_VALUE:
        return ["wiring: env.%s is %r — must be %r for the task tools to load"
                % (ENV_KEY, env.get(ENV_KEY), ENV_VALUE)]
    return []


def print_env_block():
    print("WIRING NEEDED (ok): .claude/settings.json needs the env entry below "
          "(the harness task tools — a live checklist mirroring a running sprint's stages).")
    print(json.dumps({"env": {ENV_KEY: ENV_VALUE}}, indent=2))
    print('On the owner\'s consent run: bash "%s" wire-env' % os.path.join(script_dir, "converge"))


if mode == "wire-hooks":
    path = settings_path()
    settings = load_settings(path)
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        print(HOOKS_NOT_AN_OBJECT)
        sys.exit(1)
    if not isinstance(hooks.setdefault("PreToolUse", []), list):
        print(PRETOOLUSE_NOT_AN_ARRAY)
        sys.exit(1)
    pre = hooks["PreToolUse"]
    entry, unreadable = marked_entry(pre)
    if unreadable is not None:
        print(unreadable)
        sys.exit(1)
    wrote = False
    if entry is None:
        pre.append(ENTRY)
        wrote = True
    elif entry.get("matcher") != ENTRY["matcher"]:
        entry["matcher"] = ENTRY["matcher"]
        wrote = True
    if wrote:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        print("wired: ok PreToolUse entry transcribed into .claude/settings.json")
    else:
        print("wiring already in place: .claude/settings.json")
    sys.exit(0)


if mode == "wire-env":
    path = settings_path()
    settings = load_settings(path)
    env = settings.setdefault("env", {})
    if not isinstance(env, dict):
        print(ENV_NOT_AN_OBJECT)
        sys.exit(1)
    if env.get(ENV_KEY) != ENV_VALUE:
        env[ENV_KEY] = ENV_VALUE
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        print("wired: env.%s transcribed into .claude/settings.json" % ENV_KEY)
    else:
        print("env entry already in place: .claude/settings.json")
    sys.exit(0)


exp = expected()

if mode == "diagnose":
    findings = []
    for path, body in sorted(exp.items()):
        rel = os.path.relpath(path, root)
        if not os.path.exists(path):
            findings.append("missing: %s" % rel)
        elif open(path, encoding="utf-8").read() != body:
            findings.append("stale: %s differs from the carried v%s rendering"
                            % (rel, version))
    for name in RETIRED_VENDORED:
        if os.path.isdir(os.path.join(dest, name)):
            findings.append("retired payload present: .claude/skills/%s/" % name)
    if os.path.exists(HOOK_DEST) and not os.access(HOOK_DEST, os.X_OK):
        findings.append("stale: .claude/hooks/ok-agent-model is not executable")
    for f_ in findings:
        print("DRIFT: %s" % f_)
    settings, settings_error = read_settings(settings_path())
    if settings_error is not None:
        print("DRIFT: %s" % settings_error)
        findings.append(settings_error)
    else:
        wiring = settings_findings(settings)
        for f_ in wiring:
            print("DRIFT: %s" % f_)
        if any(f_.startswith("wiring:") for f_ in wiring):
            print_wiring_block()
        findings += wiring
        env_wiring = env_findings(settings)
        for f_ in env_wiring:
            print("DRIFT: %s" % f_)
        if any(f_.startswith("wiring:") for f_ in env_wiring):
            print_env_block()
        findings += env_wiring
    if findings:
        print("Diagnosed ok ceremonies at %s: findings above; nothing "
              "written. Run converge to repair." % root)
        sys.exit(1)
    print("Diagnosed ok ceremonies at %s: in agreement with carried v%s."
          % (root, version))
    sys.exit(0)

for path, body in sorted(exp.items()):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(body)
os.chmod(HOOK_DEST, os.stat(HOOK_DEST).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
print("vendored: %d ceremony files under .claude/skills/ (v%s), each folder "
      "carrying LICENSE" % (len(exp) - 2, version))
print("materialized: .claude/rules/ok-cheatsheet.md and .claude/hooks/ok-agent-model (v%s)" % version)

removed = []
for name in RETIRED_VENDORED:
    retired_dir = os.path.join(dest, name)
    if os.path.isdir(retired_dir):
        shutil.rmtree(retired_dir)
        removed.append(name)
if removed:
    print("retired vendored payloads removed: %s"
          % ", ".join(".claude/skills/%s/" % n for n in removed))
settings, settings_error = read_settings(settings_path())
if settings_error is not None:
    print(settings_error)
else:
    wiring = settings_findings(settings)
    for f_ in wiring:
        print(f_)
    if any(f_.startswith("wiring:") for f_ in wiring):
        print_wiring_block()
    env_wiring = env_findings(settings)
    for f_ in env_wiring:
        print(f_)
    if any(f_.startswith("wiring:") for f_ in env_wiring):
        print_env_block()
print("Converged ok ceremonies at %s (v%s)." % (root, version))
PY
