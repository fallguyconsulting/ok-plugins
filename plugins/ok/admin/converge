#!/usr/bin/env bash
# The suite's own deterministic converge core — the conventional
# administration surface /ok drives for the suite-owned layer, beside
# the one it drives per family. It owns exactly one thing: the three
# ceremony verbs (plan-sprint, certify-work, audit), which belong to no
# family and cover whichever estates a project has.
#
# - Resolves the project root: nearest ancestor of $PWD carrying an
#   estate marker (current or pre-migration), else $PWD — a fresh
#   install roots where the agent is operating. Never derived from
#   .git: the suite may live in a subfolder, submodule, or subproject
#   of a repo whose own root wants no estate.
# - Vendors ceremonies/<verb>/SKILL.md into .claude/skills/<verb>/,
#   version-stamped, each folder carrying the suite LICENSE under a
#   scope preamble naming Fall Guy LLC and saying which files the grant
#   covers — .claude/skills/ also holds skills the project wrote itself.
# - Retires the vendored verbs the hoist replaced: the family-prefixed
#   audit verbs each family used to claim under the collision rule, and
#   the separate periodic-audit verb the collapsed audit replaced.
# - `converge diagnose` is the read-only mode: missing or stale
#   vendored files, and retired payloads still present. Exits non-zero
#   on any finding and writes nothing.
#
# The ceremonies resolve which estates are present at invocation, so
# this core needs no knowledge of which families a project integrates —
# it vendors the same three bodies everywhere.
#
# Idempotent. Re-running converge on a project already in compliance is
# a no-op at the git level.
#
# @decision: suite-owned-ceremonies
# @decision: vendored-skills

set -euo pipefail

MODE="converge"
case "${1:-}" in
    diagnose) MODE="diagnose" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="${SCRIPT_DIR}/.."
SUITE_MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

SUITE_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SUITE_MANIFEST" 2>/dev/null | head -1)
[ -n "$SUITE_VERSION" ] || SUITE_VERSION="unknown"

resolve_root() {
    local dir
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.ok-planner" ] || [ -e "$dir/.ok-plumbline" ] \
            || [ -e "$dir/.ok-workspaces" ] || [ -e "$dir/.plumbline.json" ] \
            || [ -e "$dir/.claude/rules/plumbline-cheatsheet.md" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    pwd
}

ROOT="$(resolve_root)"

python3 - "$MODE" "$ROOT" "$PLUGIN_ROOT" "$SUITE_VERSION" <<'PY'
import os, shutil, sys

mode, root, plugin_root, version = sys.argv[1:5]
src = os.path.join(plugin_root, "ceremonies")
dest = os.path.join(root, ".claude", "skills")

STAMP = (
    "\n<!-- Materialized by ok v%s — suite-owned; overwritten on"
    " converge; do not hand-edit. -->\n" % version
)

# The suite's ceremony verbs. Each is one canonical body covering every
# estate a project has, so no name here is ever family-prefixed: the
# collision rule exists for verbs more than one family claims, and these
# are claimed by none.
CEREMONIES = ("plan-sprint", "certify-work", "audit")

# Vendored verbs the hoist replaced. The three family-prefixed audit
# verbs collided under the old rule; the separate periodic-audit verb
# folded into the collapsed audit, which writes both axes.
RETIRED_VENDORED = (
    "ok-planner-audit",
    "ok-plumbline-audit",
    "ok-workspaces-audit",
    "verify-corpus",
)

LICENSE_SRC = os.path.join(plugin_root, "LICENSE")
LICENSE_PREAMBLE = """Vendored ok ceremony files, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the suite-owned files in this directory. Other
skills under .claude/skills/ are not covered by it — they carry their own
license, or the project's.

======================================================================

"""


def expected():
    out = {}
    for verb in CEREMONIES:
        with open(os.path.join(src, verb, "SKILL.md"), encoding="utf-8") as f:
            out[os.path.join(dest, verb, "SKILL.md")] = f.read() + STAMP
    if os.path.exists(LICENSE_SRC):
        with open(LICENSE_SRC, encoding="utf-8") as f:
            body = LICENSE_PREAMBLE + f.read()
        for verb in CEREMONIES:
            out[os.path.join(dest, verb, "LICENSE")] = body
    return out


exp = expected()

if mode == "diagnose":
    findings = []
    for path, body in sorted(exp.items()):
        rel = os.path.relpath(path, root)
        if not os.path.exists(path):
            findings.append("missing: %s" % rel)
        elif open(path, encoding="utf-8").read() != body:
            findings.append("stale: %s differs from the carried v%s rendering"
                            % (rel, version))
    for name in RETIRED_VENDORED:
        if os.path.isdir(os.path.join(dest, name)):
            findings.append("retired payload present: .claude/skills/%s/" % name)
    for f_ in findings:
        print("DRIFT: %s" % f_)
    if findings:
        print("Diagnosed ok ceremonies at %s: findings above; nothing "
              "written. Run converge to repair." % root)
        sys.exit(1)
    print("Diagnosed ok ceremonies at %s: in agreement with carried v%s."
          % (root, version))
    sys.exit(0)

for path, body in sorted(exp.items()):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(body)
print("vendored: %d ceremony files under .claude/skills/ (v%s), each folder "
      "carrying LICENSE" % (len(exp), version))

removed = []
for name in RETIRED_VENDORED:
    retired_dir = os.path.join(dest, name)
    if os.path.isdir(retired_dir):
        shutil.rmtree(retired_dir)
        removed.append(name)
if removed:
    print("retired vendored payloads removed: %s"
          % ", ".join(".claude/skills/%s/" % n for n in removed))
print("Converged ok ceremonies at %s (v%s)." % (root, version))
PY
