#!/usr/bin/env bash

# @decision: suite-owned-ceremonies
# @decision: vendored-skills

set -euo pipefail

MODE="converge"
case "${1:-}" in
    diagnose) MODE="diagnose" ;;
    wire-hooks) MODE="wire-hooks" ;;
    wire-env) MODE="wire-env" ;;
    resolve) MODE="resolve" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="${SCRIPT_DIR}/.."
SUITE_MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

SUITE_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SUITE_MANIFEST" 2>/dev/null | head -1)
[ -n "$SUITE_VERSION" ] || SUITE_VERSION="unknown"

resolve_root() {
    local dir
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.ok-planner" ] || [ -e "$dir/.ok-plumbline" ] \
            || [ -e "$dir/.ok-workspaces" ] || [ -e "$dir/.plumbline.json" ] \
            || [ -e "$dir/.claude/rules/plumbline-cheatsheet.md" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done
    pwd
}

ROOT="$(resolve_root)"

python3 - "$MODE" "$ROOT" "$PLUGIN_ROOT" "$SUITE_VERSION" "$SCRIPT_DIR" "${@:2}" <<'PY'
import json, os, shlex, stat, subprocess, sys

mode, root, plugin_root, version, script_dir = sys.argv[1:6]
extra = sys.argv[6:]
src = os.path.join(plugin_root, "ceremonies")
dest = os.path.join(root, ".claude", "skills")
RULES_SRC = os.path.join(plugin_root, "rules", "ok-cheatsheet.md")
RULES_DEST = os.path.join(root, ".claude", "rules", "ok-cheatsheet.md")
HOOKS_MATERIALIZED = (
    (os.path.join(plugin_root, "hooks", "agent-model"),
     os.path.join(root, ".claude", "hooks", "ok-agent-model")),
    (os.path.join(plugin_root, "hooks", "subagent-batching"),
     os.path.join(root, ".claude", "hooks", "ok-subagent-batching")),
)

STAMP = (
    "\n<!-- Materialized by ok v%s — suite-owned; overwritten on"
    " converge; do not hand-edit. -->\n" % version
)

# The suite's ceremony verbs. Each is one canonical body covering every
# estate a project has, so no name here is ever family-prefixed: the
# collision rule exists for verbs more than one family claims, and these
# are claimed by none. plan-sprint is not among them: the ok-planner
# family vendors it, and this core neither writes nor retires it.
CEREMONIES = ("audit", "document")

# Vendored verbs the hoist replaced. The three family-prefixed audit
# verbs collided under the old rule; the separate periodic-audit verb
# folded into the collapsed audit, which writes both axes. certify-work
# retired with the certification gate: /converge sprint closes a sprint.
RETIRED_VENDORED = (
    "ok-planner-audit",
    "ok-plumbline-audit",
    "ok-workspaces-audit",
    "verify-corpus",
    "certify-work",
)

# The suite stamp before the ok-planner family took plan-sprint over. A
# project without the ok-planner estate keeps a copy carrying it that no
# core rewrites, so this core retires it.
LEGACY_PLAN_SPRINT = "plan-sprint"
SUITE_STAMP = "<!-- Materialized by ok v"
ANY_OK_STAMP = "<!-- Materialized by ok"
EXIT_DRIFT = 1
EXIT_OFFERS_ONLY = 3

LICENSE_SRC = os.path.join(plugin_root, "LICENSE")
LICENSE_PREAMBLE = """Vendored ok ceremony files, materialized by the ok-* suite (Fall Guy LLC).

The license below covers the suite-owned files in this directory. Other
skills under .claude/skills/ are not covered by it — they carry their own
license, or the project's.

======================================================================

"""


def expected():
    out = {}
    for verb in CEREMONIES:
        with open(os.path.join(src, verb, "SKILL.md"), encoding="utf-8") as f:
            out[os.path.join(dest, verb, "SKILL.md")] = f.read() + STAMP
    if os.path.exists(LICENSE_SRC):
        with open(LICENSE_SRC, encoding="utf-8") as f:
            body = LICENSE_PREAMBLE + f.read()
        for verb in CEREMONIES:
            out[os.path.join(dest, verb, "LICENSE")] = body
    for src_path, dest_path in ((RULES_SRC, RULES_DEST),) + HOOKS_MATERIALIZED:
        with open(src_path, encoding="utf-8") as f:
            out[dest_path] = f.read().replace("{{OK_VERSION}}", version)
    return out


WIRINGS = (
    {
        "event": "PreToolUse",
        "label": "subagent-model",
        "marker": ".claude/hooks/ok-agent-model",
        "entry": {
            "matcher": "Agent|Workflow",
            "hooks": [
                {
                    "type": "command",
                    "command": 'python3 "$CLAUDE_PROJECT_DIR/.claude/hooks/ok-agent-model"',
                    "timeout": 10,
                }
            ],
        },
    },
    {
        "event": "SubagentStart",
        "label": "subagent-batching",
        "marker": ".claude/hooks/ok-subagent-batching",
        "entry": {
            "matcher": "*",
            "hooks": [
                {
                    "type": "command",
                    "command": 'python3 "$CLAUDE_PROJECT_DIR/.claude/hooks/ok-subagent-batching"',
                    "timeout": 10,
                }
            ],
        },
    },
)
ENV_NOT_AN_OBJECT = ("unusable: .claude/settings.json has an env that is not an "
                     "object — the suite writes no task-tools entry until the "
                     "owner repairs it")
HOOKS_NOT_AN_OBJECT = ("unusable: .claude/settings.json has a hooks entry that is "
                       "not an object — the suite writes no hook entry until the "
                       "owner repairs it")
EVENT_NOT_AN_ARRAY = ("unusable: .claude/settings.json has a hooks.%s "
                      "that is not an array — the suite writes no hook entry "
                      "until the owner repairs it")
EVENT_ENTRY_UNREADABLE = ("unusable: .claude/settings.json has a hooks.%s "
                          "entry the suite cannot read — the suite writes no hook "
                          "entry until the owner repairs it")
SETTINGS_NOT_AN_OBJECT = ("unusable: .claude/settings.json is not an object — the "
                          "suite writes no entry until the owner repairs it")
SETTINGS_UNPARSEABLE = ("unparseable: .claude/settings.json — the suite writes no "
                        "entry until the owner repairs it")


def read_settings(path):
    if not os.path.exists(path):
        return {}, None
    try:
        settings = json.load(open(path))
    except ValueError:
        return None, SETTINGS_UNPARSEABLE
    if not isinstance(settings, dict):
        return None, SETTINGS_NOT_AN_OBJECT
    return settings, None


def load_settings(path):
    settings, error = read_settings(path)
    if error is not None:
        print(error)
        sys.exit(1)
    return settings


def settings_path():
    return os.path.join(root, ".claude", "settings.json")


def marked_entry(entries, wiring):
    unreadable = EVENT_ENTRY_UNREADABLE % wiring["event"]
    for e in entries:
        if not isinstance(e, dict):
            return None, unreadable
        hooks = e.get("hooks", [])
        if not isinstance(hooks, list):
            return None, unreadable
        for h in hooks:
            if not isinstance(h, dict):
                return None, unreadable
            command = h.get("command", "")
            if isinstance(command, str) and wiring["marker"] in command:
                return e, None
    return None, None


def settings_findings(settings):
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        return [HOOKS_NOT_AN_OBJECT]
    findings = []
    for wiring in WIRINGS:
        entries = hooks.get(wiring["event"], [])
        if not isinstance(entries, list):
            findings.append(EVENT_NOT_AN_ARRAY % wiring["event"])
            continue
        entry, unreadable = marked_entry(entries, wiring)
        if unreadable is not None:
            findings.append(unreadable)
        elif entry is None:
            findings.append("wiring: .claude/settings.json lacks the ok %s entry for the %s hook"
                            % (wiring["event"], wiring["label"]))
        elif entry.get("matcher") != wiring["entry"]["matcher"]:
            findings.append("wiring: the ok %s entry's matcher is %r — must be %r"
                            % (wiring["event"], entry.get("matcher"), wiring["entry"]["matcher"]))
    return findings


def print_wiring_block():
    print("WIRING NEEDED (ok): .claude/settings.json needs the hook entries below.")
    print(json.dumps({"hooks": {w["event"]: [w["entry"]] for w in WIRINGS}}, indent=2))
    print("On the owner's consent run: %s" % consent_command("wire-hooks"))


# @decision: task-tools-mirror-the-report
# @story: watch-execution-progress
ENV_KEY = "CLAUDE_CODE_ENABLE_TODO_TOOLS"
ENV_VALUE = "1"


def env_findings(settings):
    env = settings.get("env", {})
    if not isinstance(env, dict):
        return [ENV_NOT_AN_OBJECT]
    if ENV_KEY not in env:
        return ["wiring: .claude/settings.json lacks env.%s — the harness task tools "
                "stay off in this project" % ENV_KEY]
    if env.get(ENV_KEY) != ENV_VALUE:
        return ["wiring: env.%s is %r — must be %r for the task tools to load"
                % (ENV_KEY, env.get(ENV_KEY), ENV_VALUE)]
    return []


def print_env_block():
    print("WIRING NEEDED (ok): .claude/settings.json needs the env entry below "
          "(the harness task tools — a live checklist mirroring a running sprint's stages).")
    print(json.dumps({"env": {ENV_KEY: ENV_VALUE}}, indent=2))
    print("On the owner's consent run: %s" % consent_command("wire-env"))


def unusable_findings(settings, error):
    if error is not None:
        return [error]
    return [f_ for f_ in settings_findings(settings) + env_findings(settings)
            if not f_.startswith("wiring:")]


WHOLE_FILE = ()


def unusable_entries(settings, error):
    """The entries the settings offer names: each a key path into the
    file, the whole file when it cannot be read as an object."""
    if error is not None:
        return {WHOLE_FILE}
    named = set()
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        named.add(("hooks",))
    else:
        for wiring in WIRINGS:
            entries = hooks.get(wiring["event"], [])
            if not isinstance(entries, list) or marked_entry(entries, wiring)[1] is not None:
                named.add(("hooks", wiring["event"]))
    if not isinstance(settings.get("env", {}), dict):
        named.add(("env",))
    return named


def json_value(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=False)


def dropped_entries(current, draft, named, prefix=()):
    """Every entry of `current` the offer does not name that the draft
    drops, changes, or adds beside, as dotted key paths."""
    if WHOLE_FILE in named:
        return []
    found = []
    for key in sorted(set(current) | set(draft)):
        here = prefix + (key,)
        if here in named:
            continue
        label = ".".join(here)
        if any(n[:len(here)] == here for n in named) and isinstance(current.get(key), dict):
            if not isinstance(draft.get(key), dict):
                found.append(label)
            else:
                found.extend(dropped_entries(current[key], draft[key], named, here))
        elif key not in draft:
            found.append(label + " (dropped)")
        elif key not in current:
            found.append(label + " (added)")
        elif json_value(current[key]) != json_value(draft[key]):
            found.append(label + " (changed)")
    return found


def git_lines(*args):
    out = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True)
    if out.returncode != 0:
        return None
    return [l for l in out.stdout.split("\0") if l]


def files_under(path):
    if os.path.isfile(path) or os.path.islink(path):
        return [path]
    found = []
    for dirpath, dirnames, files in os.walk(path):
        dirnames.sort()
        found.extend(os.path.join(dirpath, fn) for fn in sorted(files))
    return found


def uncommitted(paths):
    """The paths among these whose working copy or index differs from
    HEAD. An untracked path is not among them: the offer names it, and
    plain removal takes it."""
    rels = [os.path.relpath(p, root) for p in paths]
    if not rels:
        return []
    if git_lines("rev-parse", "-q", "--verify", "HEAD") is None:
        return sorted(git_lines("ls-files", "-z", "--", *rels) or [])
    changed = set()
    for cached in ((), ("--cached",)):
        changed.update(git_lines("diff", *cached, "--name-only", "--no-renames", "-z", "--relative",
                                 "HEAD", "--", *rels) or [])
    return sorted(changed)


def remove_files(paths):
    """Removes the named files: plain `git rm` for a tracked file whose
    working copy and index match HEAD, plain removal for an untracked
    one. Refuses the whole set when any file carries uncommitted work."""
    changed = uncommitted(paths)
    if changed:
        sys.exit("resolve: %s carry uncommitted changes; nothing removed. Commit those changes first, "
                 "then run /ok again." % ", ".join(changed))
    rels = [os.path.relpath(p, root) for p in paths]
    tracked = git_lines("ls-files", "-z", "--", *rels) or []
    if tracked:
        subprocess.run(["git", "-C", root, "rm", "-q", "--"] + tracked, check=True)
    for p in paths:
        if os.path.lexists(p):
            os.remove(p)
    for p in sorted({os.path.dirname(p) for p in paths}, key=len, reverse=True):
        while p.startswith(dest + os.sep) and os.path.isdir(p) and not os.listdir(p):
            os.rmdir(p)
            p = os.path.dirname(p)
    for rel_ in rels:
        print("removed: %s%s" % (rel_, " (git rm; staged)" if rel_ in tracked else ""))


def stamped(path, prefix):
    if not os.path.isfile(path):
        return False
    lines = [l for l in open(path, encoding="utf-8", errors="replace").read().split("\n") if l.strip()]
    return bool(lines) and lines[-1].startswith(prefix)


def suite_file(path, prefix):
    name = os.path.basename(path)
    if name == ".DS_Store":
        return True
    if name == "LICENSE":
        return open(path, encoding="utf-8", errors="replace").read().startswith("Vendored ok")
    return name.endswith(".md") and stamped(path, prefix)


def retirements():
    """Every retired vendored folder present, split into the files the
    suite stamped (converge removes them) and the files the project
    wrote (offered). A folder whose SKILL.md carries no suite stamp is
    the project's own whole."""
    names = [(n, ANY_OK_STAMP) for n in RETIRED_VENDORED]
    if not os.path.isdir(os.path.join(root, ".ok-planner")):
        names.append((LEGACY_PLAN_SPRINT, SUITE_STAMP))
    out = []
    for name, prefix in names:
        folder = os.path.join(dest, name)
        if os.path.islink(folder) or not os.path.isdir(folder):
            continue
        files = files_under(folder)
        if not stamped(os.path.join(folder, "SKILL.md"), prefix):
            if name != LEGACY_PLAN_SPRINT:
                out.append((name, [], files))
            continue
        suite = [f for f in files if suite_file(f, prefix)]
        out.append((name, suite, [f for f in files if f not in suite]))
    return out


def cleanup_offers():
    out = []
    settings, error = read_settings(settings_path())
    problems = unusable_findings(settings, error)
    if problems:
        out.append({
            "id": "settings:.claude/settings.json",
            "what": [".claude/settings.json holds a shape the harness cannot read, so the suite writes no entry into it:"]
                    + problems,
            "draft": "the whole .claude/settings.json with each key named above holding the shape the harness reads "
                     "(an object for the file, hooks, each hook entry, and env; an array for each hooks event), "
                     "every other entry kept as it is.",
            "fix": "write the drafted file as .claude/settings.json.",
        })
    for name, _, owned in retirements():
        if owned:
            out.append({
                "id": "retired-verb:.claude/skills/%s" % name,
                "what": [".claude/skills/%s/ holds files the project wrote at a name the suite retired:" % name]
                        + [os.path.relpath(f, root) for f in owned],
                "fix": "delete the files listed above.",
                "remove": owned,
            })
    for o in out:
        o["uncommitted"] = uncommitted(o.get("remove", []))
    return out


def consent_command(*args):
    return " ".join(shlex.quote(a) for a in ("bash", os.path.join(script_dir, "converge")) + args)


def print_offer(o):
    print("CLEANUP OFFERED (ok): %s" % o["id"])
    print("  What: %s" % o["what"][0])
    for line in o["what"][1:]:
        print("    %s" % line)
    if "draft" in o:
        print("  Draft: %s" % o["draft"])
    print("  Fix: %s" % o["fix"])
    if o["uncommitted"]:
        print("  Uncommitted: %s carry uncommitted changes; resolve refuses until they are committed. "
              "Commit those changes first, then run /ok again." % ", ".join(o["uncommitted"]))
    print("  Recommended: accept")
    if "draft" in o:
        print("  On the owner's consent run: %s --from <draft>" % consent_command("resolve", o["id"]))
    else:
        print("  On the owner's consent run: %s" % consent_command("resolve", o["id"]))


if mode == "resolve":
    if not extra:
        sys.exit("usage: converge resolve <id> [--from <draft>]")
    wanted = extra[0]
    current = {o["id"]: o for o in cleanup_offers()}
    if wanted not in current:
        sys.exit("resolve: ok offers nothing as %s at %s; run diagnose for the current offers" % (wanted, root))
    o = current[wanted]
    if "remove" in o:
        if len(extra) != 1:
            sys.exit("resolve: %s takes no further argument" % wanted)
        remove_files(o["remove"])
        print("Resolved %s. Run converge to bring the layer current." % wanted)
        sys.exit(0)
    if len(extra) != 3 or extra[1] != "--from":
        sys.exit("resolve: %s writes a draft; run it as: resolve %s --from <draft>" % (wanted, wanted))
    draft = os.path.abspath(extra[2])
    if not os.path.isfile(draft):
        sys.exit("resolve: --from names no file: %s" % draft)
    draft_settings, draft_error = read_settings(draft)
    still = unusable_findings(draft_settings, draft_error)
    if still:
        sys.exit("resolve: the draft is unusable too: %s; nothing written" % "; ".join(still))
    settings, error = read_settings(settings_path())
    dropped = dropped_entries(settings or {}, draft_settings, unusable_entries(settings, error))
    if dropped:
        sys.exit("resolve: the draft changes entries the offer does not name: %s; nothing written"
                 % ", ".join(dropped))
    with open(draft, encoding="utf-8") as f:
        body = f.read()
    with open(settings_path(), "w", encoding="utf-8") as f:
        f.write(body)
    print("written: .claude/settings.json")
    print("Resolved %s. Run converge to bring the layer current." % wanted)
    sys.exit(0)


if mode == "wire-hooks":
    path = settings_path()
    settings = load_settings(path)
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        print(HOOKS_NOT_AN_OBJECT)
        sys.exit(1)
    wrote = []
    for wiring in WIRINGS:
        if not isinstance(hooks.setdefault(wiring["event"], []), list):
            print(EVENT_NOT_AN_ARRAY % wiring["event"])
            sys.exit(1)
        entries = hooks[wiring["event"]]
        entry, unreadable = marked_entry(entries, wiring)
        if unreadable is not None:
            print(unreadable)
            sys.exit(1)
        if entry is None:
            entries.append(wiring["entry"])
            wrote.append(wiring["event"])
        elif entry.get("matcher") != wiring["entry"]["matcher"]:
            entry["matcher"] = wiring["entry"]["matcher"]
            wrote.append(wiring["event"])
    if wrote:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        print("wired: ok hook entries transcribed into .claude/settings.json (%s)"
              % ", ".join(wrote))
    else:
        print("wiring already in place: .claude/settings.json")
    sys.exit(0)


if mode == "wire-env":
    path = settings_path()
    settings = load_settings(path)
    env = settings.setdefault("env", {})
    if not isinstance(env, dict):
        print(ENV_NOT_AN_OBJECT)
        sys.exit(1)
    if env.get(ENV_KEY) != ENV_VALUE:
        env[ENV_KEY] = ENV_VALUE
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        print("wired: env.%s transcribed into .claude/settings.json" % ENV_KEY)
    else:
        print("env entry already in place: .claude/settings.json")
    sys.exit(0)


exp = expected()

if mode == "diagnose":
    findings = []
    for path, body in sorted(exp.items()):
        rel = os.path.relpath(path, root)
        if not os.path.exists(path):
            findings.append("missing: %s" % rel)
        elif open(path, encoding="utf-8").read() != body:
            findings.append("stale: %s differs from the carried v%s rendering"
                            % (rel, version))
    for name, suite, _ in retirements():
        if suite:
            findings.append("retired payload present: .claude/skills/%s/ — converge removes the %d "
                            "suite-stamped file(s)" % (name, len(suite)))
    for _, hook_dest in HOOKS_MATERIALIZED:
        if os.path.exists(hook_dest) and not os.access(hook_dest, os.X_OK):
            findings.append("stale: %s is not executable" % os.path.relpath(hook_dest, root))
    for f_ in findings:
        print("DRIFT: %s" % f_)
    settings, settings_error = read_settings(settings_path())
    if settings_error is None:
        wiring = [f_ for f_ in settings_findings(settings) + env_findings(settings)
                  if f_.startswith("wiring:")]
        for f_ in wiring:
            print("DRIFT: %s" % f_)
        if any(f_.startswith("wiring:") for f_ in settings_findings(settings)):
            print_wiring_block()
        if any(f_.startswith("wiring:") for f_ in env_findings(settings)):
            print_env_block()
        findings += wiring
    offered = cleanup_offers()
    for o in offered:
        print_offer(o)
    if findings:
        print("Diagnosed ok ceremonies at %s: findings above; nothing "
              "written. Run converge to repair." % root)
        sys.exit(EXIT_DRIFT)
    if offered:
        print("Diagnosed ok ceremonies at %s: in agreement with carried v%s; cleanup offers "
              "above await the owner's word." % (root, version))
        sys.exit(EXIT_OFFERS_ONLY)
    print("Diagnosed ok ceremonies at %s: in agreement with carried v%s."
          % (root, version))
    sys.exit(0)

for path, body in sorted(exp.items()):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(body)
for _, hook_dest in HOOKS_MATERIALIZED:
    os.chmod(hook_dest, os.stat(hook_dest).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
print("vendored: %d ceremony files under .claude/skills/ (v%s), each folder "
      "carrying LICENSE" % (len(exp) - 1 - len(HOOKS_MATERIALIZED), version))
print("materialized: .claude/rules/ok-cheatsheet.md, .claude/hooks/ok-agent-model, "
      "and .claude/hooks/ok-subagent-batching (v%s)" % version)

for name, suite, owned in retirements():
    if not suite:
        continue
    for retired_file in suite:
        os.remove(retired_file)
    retired_dir = os.path.join(dest, name)
    for dirpath, _, _ in sorted(os.walk(retired_dir), key=lambda w: len(w[0]), reverse=True):
        if not os.listdir(dirpath):
            os.rmdir(dirpath)
    print("retired vendored payload removed: %d suite-stamped file(s) under .claude/skills/%s/%s"
          % (len(suite), name, "; the project's own files stay, offered below" if owned else ""))
settings, settings_error = read_settings(settings_path())
if settings_error is None:
    wiring = settings_findings(settings)
    for f_ in wiring:
        if f_.startswith("wiring:"):
            print(f_)
    if any(f_.startswith("wiring:") for f_ in wiring):
        print_wiring_block()
