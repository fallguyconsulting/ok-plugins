#!/usr/bin/env python3
# Materialized by ok v19.5.0 — suite-owned; overwritten wholesale on converge by the front door's administration (/ok); do not hand-edit.
import json
import sys

RULE = ".claude/rules/ok-cheatsheet.md (Batch independent tool calls)"
LSP_RULE = ".claude/rules/ok-cheatsheet.md (Prefer the LSP for symbol navigation)"

CONTEXT = (
    "Issue every independent tool call together in one message: a batch of "
    "reads or searches is one request. Sequence only a call whose input "
    "depends on a prior call's result. Per %s. For a symbol question — a "
    "definition, a symbol's references, a file's symbol list — load the LSP "
    "tool once with ToolSearch(\"select:LSP\") and call it instead of grep. "
    "Per %s." % (RULE, LSP_RULE)
)


def main():
    try:
        json.load(sys.stdin)
    except ValueError:
        pass
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "SubagentStart",
            "additionalContext": CONTEXT,
        }
    }))
    sys.exit(0)


main()
