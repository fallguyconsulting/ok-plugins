#!/usr/bin/env python3
# Suite maintenance check: every {{TOKEN}} used under the planner's skills
# resolves to exactly one live `### {{TOKEN}}` heading in the shared
# definitions files — an unresolved token and a duplicated block both fail.
# @decision: single-source-transclusion
import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SKILLS = os.path.join(ROOT, "plugins", "ok", "families", "ok-planner", "skills")

# The generic placeholder discover-design uses to *describe* the convention,
# not a transcludable block.
META = {"TOKEN"}

defined = {}
for path in sorted(glob.glob(os.path.join(SKILLS, "_shared", "*.md"))):
    rel = os.path.relpath(path, ROOT)
    for lineno, line in enumerate(open(path).read().split("\n"), 1):
        m = re.match(r"^###\s+\{\{([A-Z][A-Z0-9-]*)\}\}\s*$", line)
        if m:
            defined.setdefault(m.group(1), []).append(f"{rel}:{lineno}")

bad = []
if not defined:
    bad.append("no token headings found in skills/_shared/ — the definitions files moved?")

# Exactly one heading per token: a block defined in two places is the
# silent duplication single-sourcing exists to prevent, and each copy
# drifts on its own.
for token, sites in sorted(defined.items()):
    if len(sites) > 1:
        bad.append(
            f"{{{{{token}}}}} is defined {len(sites)} times in skills/_shared/ "
            f"({', '.join(sites)}) — a block is defined in exactly one place"
        )

for path in sorted(glob.glob(os.path.join(SKILLS, "**", "*.md"), recursive=True)):
    rel = os.path.relpath(path, ROOT)
    for lineno, line in enumerate(open(path).read().split("\n"), 1):
        if re.match(r"^###\s+\{\{", line):
            continue
        for m in re.finditer(r"\{\{([A-Z][A-Z0-9-]*)\}\}", line):
            token = m.group(1)
            if token not in defined and token not in META:
                bad.append(f"{rel}:{lineno}: {{{{{token}}}}} resolves to no `###` heading in skills/_shared/")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
