#!/usr/bin/env python3
# Suite maintenance check: every {{TOKEN}} used by anything that transcludes
# — the planner's skills, every family's ceremony surfaces, and the suite's
# own ceremony bodies — resolves to exactly one live `### {{TOKEN}}` heading
# in the definitions files: the shared folders (_shared/, _sprint/,
# _converge/) and the block files beside a skill body (plan-sprint's
# core.md and sprint-document.md). An unresolved token and a duplicated block
# both fail. The ceremony surfaces are in scope because the hoist moved the
# heaviest transcluding prompts out of skills/ and into them; a check that
# still scanned only skills/ would report clean over prompts nothing had
# verified.
# @decision: single-source-transclusion
import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SKILLS = os.path.join(ROOT, "plugins", "ok", "families", "ok-planner", "skills")
CONSUMERS = (
    os.path.join(SKILLS, "**", "*.md"),
    os.path.join(ROOT, "plugins", "ok", "families", "*", "ceremony", "*.md"),
    os.path.join(ROOT, "plugins", "ok", "ceremonies", "**", "*.md"),
)

# The generic placeholder discover-design uses to *describe* the convention,
# not a transcludable block.
META = {"TOKEN"}

DEFINITIONS = (
    os.path.join(SKILLS, "_shared", "*.md"),
    os.path.join(SKILLS, "_sprint", "*.md"),
    os.path.join(SKILLS, "_converge", "*.md"),
    os.path.join(SKILLS, "plan-sprint", "core.md"),
    os.path.join(SKILLS, "plan-sprint", "sprint-document.md"),
)

defined = {}
for path in sorted(p for pattern in DEFINITIONS for p in glob.glob(pattern)):
    rel = os.path.relpath(path, ROOT)
    for lineno, line in enumerate(open(path).read().split("\n"), 1):
        m = re.match(r"^###\s+\{\{([A-Z][A-Z0-9-]*)\}\}\s*$", line)
        if m:
            defined.setdefault(m.group(1), []).append(f"{rel}:{lineno}")

bad = []
if not defined:
    bad.append("no token headings found in the definitions files — the definitions files moved?")

# Exactly one heading per token: a block defined in two places is the
# silent duplication single-sourcing exists to prevent, and each copy
# drifts on its own.
for token, sites in sorted(defined.items()):
    if len(sites) > 1:
        bad.append(
            f"{{{{{token}}}}} is defined {len(sites)} times "
            f"({', '.join(sites)}) — a block is defined in exactly one place"
        )

consumed = set()
for pattern in CONSUMERS:
    consumed.update(glob.glob(pattern, recursive=True))

for path in sorted(consumed):
    rel = os.path.relpath(path, ROOT)
    for lineno, line in enumerate(open(path).read().split("\n"), 1):
        if re.match(r"^###\s+\{\{", line):
            continue
        for m in re.finditer(r"\{\{([A-Z][A-Z0-9-]*)\}\}", line):
            token = m.group(1)
            if token not in defined and token not in META:
                bad.append(f"{rel}:{lineno}: {{{{{token}}}}} resolves to no `###` heading in the definitions files")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
