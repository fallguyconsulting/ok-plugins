        "write_file": {"path": ("converge",)},
    }, regions)
    check_git_helper(label, text, "git_lines", python_verb)
    for m in re.finditer(r"json\.dump\(", text):
        if not inside(m.start(), [regions["wire-hooks"], regions["wire-env"], regions["settings-resolve"]]):
            bad.append(f"{label}:{lineno(text, m.start())}: settings write (json.dump) outside the wire-hooks, "
                       f"wire-env, and settings-resolve consent paths")

    toc = read(CATALOG_TOC)
    for m in re.finditer(r"open\(([^,]+), \"w\"[^)]*\)", toc):
        if m.group(1).strip() != "target":
            bad.append(f"ok-planner scripts/catalog-toc: write target not in the declared owned set: {m.group(1)}")
    for needle, why in (
        ('ESTATE = ".ok-planner"', "the estate is not declared as .ok-planner"),
        ('target = os.path.join(estate, directory + ".md")', "the TOC destination is not derived from the estate"),
    ):
