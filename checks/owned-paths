    }, regions)
    check_sites(label, text, {
        "remove_files": every, "move_path": every, "move_all": every, "move_back": every, "prune_tree": every,
        "archive": every, "archive_copy": every,
        "write_owner": first,
        "write_text": first, "write_settings": first, "write_file": first,
