            '["git", "-C", root, "worktree", "remove", tree]': ("worktree-resolve",),
            '["git", "-C", root, "branch", "-d", branch]': ("worktree-resolve",),
            "argv": ("probe",),
            "[sys.executable, ISSUES_SRC] + args": ("intake_command",),
        },
    }, regions)
    check_sites(label, text, {
        "remove_files": every, "move_path": every, "move_all": every, "move_back": every, "prune_tree": every,
        "write_owner": first,
        "write_text": first, "write_json": first, "write_settings": first, "write_file": first,
