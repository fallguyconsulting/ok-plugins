bad = []


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def lineno(text, offset):
    return text.count("\n", 0, offset) + 1


def region(text, start_marker, end_marker, label):
    start = text.find(start_marker)
    if start == -1:
        bad.append(f"{label}: consent region marker missing: {start_marker!r}")
        return (0, 0)
    end = text.find(end_marker, start + len(start_marker))
    if end == -1:
        bad.append(f"{label}: consent region end marker missing: {end_marker!r}")
        return (start, start)
    return (start, end)


def inside(offset, regions):
    return any(a <= offset < b for a, b in regions)


def unquote(token):
    """A write target's prefix is what it names, not how it is quoted:
    `"${OK_DIR}/x"` and `.ok-plumbline/x` are both prefix-testable once the
    surrounding quotes come off. Comparing the quoted form instead makes the
    allowed set depend on the author's quoting style, which is how a
    legitimate write reads as a finding."""
    if len(token) >= 2 and token[0] == token[-1] and token[0] in "\"'":
        return token[1:-1]
    return token


def bash_lines(text):
    """The script's lines with every python heredoc body blanked, line
    numbers kept: a `>` inside python is a comparison or a placeholder,
    never a shell redirect, and the python writes are checked on their
    own below."""
    out, closer = [], None
    for line in text.split("\n"):
        if closer is not None:
            out.append("")
            if line == closer:
                closer = None
            continue
        out.append(line)
        m = re.search(r"<<'(PY|PYEOF)'", line)
        if m:
            closer = m.group(1)
    return out


def check_bash_redirects(label, text, allowed_redirects):
    for n, line in enumerate(bash_lines(text), 1):
        if line.lstrip().startswith("#"):
            continue
        for m in re.finditer(r"(?<![-2&<>])>\s*(\"[^\"]+\"|\S+)", line):
            target = unquote(m.group(1))
            if target.startswith((">", "&")) or target in ("/dev/null",):
                continue
            if not target.startswith(allowed_redirects):
                bad.append(f"{label}:{n}: redirect writes outside the owned set: {target}")


_TOKEN = re.compile(r'"[^"]*"|\S+')
_STOPS = ("||", "&&", ";", "|", "&")


def _args(rest):
    out = []
    for tok in _TOKEN.findall(rest):
        if tok in _STOPS or ">" in tok or "<" in tok:
            break
        out.append(tok)
    return out


def _segments(line):
    """One line, cut into the commands it actually runs — so a write
    tucked behind `; then` or `&&` is checked like any other."""
    for seg in re.split(r";|&&|\|\||\|", line):
        yield re.sub(r"^\s*(?:then|do|else|\{)\s+", " ", seg)


def check_bash_file_ops(label, text, allowed):
    """cp/mv/rm/rmdir, and `git mv`/`git rm`, touch only the declared
    owned set: a mv or a git mv names both of its paths inside it.

    Flags are stripped rather than counted, because a positional regex
    ("command, source, destination, end of line") silently stops matching
    the moment anyone writes `cp -R`, and a check that matches nothing
    reports nothing — including a genuine write outside the prefix.
    """
    for n, line in enumerate(bash_lines(text), 1):
        if line.lstrip().startswith("#"):
            continue
        for seg in _segments(line):
            m = re.match(r"\s*(git(?:\s+-C\s+(?:\"[^\"]*\"|\S+))?\s+)?(cp|mv|rm|rmdir)\s+(.*)$", seg)
            if not m:
                continue
            via_git, verb = m.group(1), m.group(2)
            args = [a for a in _args(m.group(3)) if not a.startswith("-")]
            targets = [unquote(a) for a in (args[-1:] if verb == "cp" else args)]
            for target in targets:
                if target.startswith(allowed) and ".." not in target.split("/"):
                    continue
                bad.append(f"{label}:{n}: {'git ' if via_git else ''}{verb} touches a path outside "
                           f"the owned set: {target}")


FORBIDDEN_GIT_VERBS = re.compile(r"""(?:^|[\s"'\[,(])(restore|reset|clean|stash)(?=$|[\s"',\])])""")
CHECKOUT_DASHDASH = re.compile(r"""(?:^|[\s"'\[,(])checkout(?=[\s"',]).*--""")
RM_TOKEN = re.compile(r"""(?:^|[\s"'\[,(])rm(?=$|[\s"',\])])""")
FLAG = re.compile(r"""(?:(?<=\s)|(?<=["'\[,(]))(-{1,2}[A-Za-z][A-Za-z-]*)""")


def check_forbidden_git(label, text):
    """No core runs a git command that discards uncommitted or
    staged-only work: no `git rm` with a force flag, and no
    `checkout --`, `restore`, `reset`, `clean`, or `stash`."""
    for n, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith(("#", "//", "*")):
            continue
        if not re.search(r"""(?:\bgit\b|["']git["'])""", line):
            continue
        verb = FORBIDDEN_GIT_VERBS.search(line)
        if verb:
            bad.append(f"{label}:{n}: git {verb.group(1)} discards work; no core runs it")
        if CHECKOUT_DASHDASH.search(line):
            bad.append(f"{label}:{n}: git checkout -- discards work; no core runs it")
        if RM_TOKEN.search(line):
            for flag in FLAG.findall(line):
                if flag == "--force" or (not flag.startswith("--") and "f" in flag[1:]):
                    bad.append(f"{label}:{n}: git rm {flag} discards uncommitted work; "
                               f"a core runs plain git rm only")


def call_args(text, open_paren):
    """The top-level arguments of the call whose `(` sits at
    `open_paren`, each with its whitespace collapsed."""
    depth, start, args, quote = 0, open_paren + 1, [], None
    i = open_paren
    while i < len(text):
        c = text[i]
        if quote:
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = None
        elif c in "\"'`":
            quote = c
        elif c in "([{":
            depth += 1
        elif c in ")]}":
            depth -= 1
            if depth == 0:
                args.append(text[start:i])
                break
        elif c == "," and depth == 1:
            args.append(text[start:i])
            start = i + 1
        i += 1
    return [re.sub(r"\s+", " ", a).strip() for a in args if a.strip()]


ESCAPING = re.compile(r"""["']\.\.["']|["']\.\./|["'][/~]|\.\.[/\\]|expanduser|gettempdir|tempfile""")


def check_sites(label, text, ops, allowed, regions=None):
    """Every call to an operation in `ops` passes argument expressions
    the core declares, and a declared expression bound to a region sits
    inside it. A path that climbs out (`..`) or names an absolute or home
    location is a finding however it is spelled."""
    regions = regions or {}
    for op, pick in ops.items():
        for m in re.finditer(r"(?<![\w.])" + re.escape(op) + r"\(", text):
            if re.search(r"(?:def|function)\s+$", text[max(0, m.start() - 10):m.start()]):
                continue
            args = call_args(text, m.end() - 1)
            if op == "open" and (len(args) < 2 or not re.match(r"""^["'][wax]""", args[1])):
                continue
            chosen = pick(args)
            n = lineno(text, m.start())
            if any(ESCAPING.search(a) for a in chosen):
                bad.append(f"{label}:{n}: {op} reaches outside the project root: {', '.join(chosen)}")
                continue
            key = ", ".join(chosen)
            if key not in allowed.get(op, {}):
                bad.append(f"{label}:{n}: {op} target is not in the declared owned set: {key}")
                continue
            where = allowed[op][key]
            if where is not None and not inside(m.start(), [regions[w] for w in where]):
                bad.append(f"{label}:{n}: {op}({key}) sits outside its consent path ({', '.join(where)})")


def first(args):
    return args[:1]


def first_two(args):
    return args[:2]


def second(args):
    return args[1:2]


def every(args):
