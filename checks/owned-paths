    for m in re.finditer(r"open\(([^,]+), \"w\"[^)]*\)", toc):
        if m.group(1).strip() != "staging":
            bad.append(f"ok-planner scripts/catalog-toc: write target not in the declared owned set: {m.group(1)}")
    for needle, why in (
        ('ESTATE = ".ok-planner"', "the estate is not declared as .ok-planner"),
        ('target = os.path.join(estate, directory + ".md")', "the TOC destination is not derived from the estate"),
        ('staging = "%s.%d.tmp" % (target, os.getpid())', "the TOC is not staged beside its destination"),
        ('os.replace(staging, target)', "the staged TOC does not replace its destination"),
