    check_git_helper(label, text, "git_lines", python_verb)
    for m in re.finditer(r"json\.dump\(", text):
        if not inside(m.start(), [regions["wire-hooks"], regions["wire-env"], regions["settings-resolve"]]):
            bad.append(f"{label}:{lineno(text, m.start())}: settings write (json.dump) outside the wire-hooks, "
                       f"wire-env, and settings-resolve consent paths")

