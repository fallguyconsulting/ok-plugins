#!/usr/bin/env python3
# Suite maintenance check: each family's converge core writes only within
# its declared owned set — its estate, its cheatsheet, its vendored skill
# files — and the project's harness settings file is reachable solely
# through the consent-transcription path (the wire-hooks mode, run on the
# owner's explicit yes). A stray write target or an unconsented settings
# write is a finding. The front door itself edits no files — its write
# surfaces ARE the family converge cores checked here.
# @decision: whole-file-ownership
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FAMILIES_DIR = os.path.join(ROOT, "plugins", "ok", "families")

bad = []


def region(text, start_marker, end_marker, label):
    start = text.find(start_marker)
    if start == -1:
        bad.append(f"{label}: consent region marker missing: {start_marker!r}")
        return (0, 0)
    end = text.find(end_marker, start)
    if end == -1:
        bad.append(f"{label}: consent region end marker missing: {end_marker!r}")
        return (start, start)
    return (start, end)


def check_bash_redirects(label, text, allowed_redirects):
    for lineno, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith("#"):
            continue
        for m in re.finditer(r"(?<![-2&<>])>\s*(\"[^\"]+\"|\S+)", line):
            target = m.group(1)
            if target.startswith((">", "&")) or target in ("/dev/null",):
                continue
            if not target.startswith(allowed_redirects):
                bad.append(f"{label}:{lineno}: redirect writes outside the owned set: {target}")


# Word-aware split: a double-quoted run is one token, so a destination
# like "${OK_DIR}/hooks/session-start" survives whole and can be
# prefix-tested.
_TOKEN = re.compile(r'"[^"]*"|\S+')
# Where a command's arguments stop: everything from here on belongs to the
# shell, not to the command being checked (`2>/dev/null || true`).
_STOPS = ("||", "&&", ";", "|", "&")


def _args(rest):
    out = []
    for tok in _TOKEN.findall(rest):
        if tok in _STOPS or ">" in tok or "<" in tok:
            break
        out.append(tok)
    return out


def _segments(line):
    """One line, cut into the commands it actually runs — so a write
    tucked behind `; then` or `&&` is checked like any other."""
    for seg in re.split(r";|&&|\|\||\|", line):
        yield re.sub(r"^\s*(?:then|do|else|\{)\s+", " ", seg)


def check_bash_file_ops(label, text, allowed, exempt=()):
    """cp/mv/rm/rmdir must write only inside the declared owned set.

    Flags are stripped rather than counted, because a positional regex
    ("command, source, destination, end of line") silently stops matching
    the moment anyone writes `cp -R`, and a check that matches nothing
    reports nothing — including a genuine write outside the prefix.
    """
    for lineno, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith("#"):
            continue
        for seg in _segments(line):
            m = re.match(r"\s*(cp|mv|rm|rmdir)\s+(.*)$", seg)
            if not m:
                continue
            verb = m.group(1)
            args = [a for a in _args(m.group(2)) if not a.startswith("-")]
            if not args:
                continue
            # cp/mv write only their last argument; rm/rmdir write all.
            targets = args[-1:] if verb in ("cp", "mv") else args
            for target in targets:
                if target in exempt or target.startswith(allowed):
                    continue
                bad.append(
                    f"{label}:{lineno}: {verb} writes outside the owned set: {target}")


def check_planner():
    label = "ok-planner admin/converge"
    path = os.path.join(FAMILIES_DIR, "ok-planner", "admin", "converge")
    text = open(path).read()

    check_bash_redirects(label, text, (
        '"${OK_DIR}/',
        '"${ROOT}/.claude/rules/ok-planner-cheatsheet.md"',
    ))
    check_bash_file_ops(label, text, ('"${OK_DIR}/',))

    if 'dest = os.path.join(root, ".claude", "skills")' not in text:
        bad.append(f"{label}: vendored-skill destination is not declared as .claude/skills")

    # The retired-payload sweep is the one deletion outside the estate,
    # and it must stay rooted in the declared vendored-skill destination.
    if "retired_dir = os.path.join(dest, name)" not in text:
        bad.append(f"{label}: retired vendored-payload removal is not rooted in the declared destination")
    for m in re.finditer(r"shutil\.rmtree\(([^)]*)\)", text):
        if m.group(1).strip() != "retired_dir":
            bad.append(f"{label}: shutil.rmtree target not in the declared owned set: {m.group(1)}")

    wire_start, wire_end = region(text, 'if mode == "wire-hooks":', "sys.exit(0)", label)
    for m in re.finditer(r"json\.dump\(", text):
        if not (wire_start <= m.start() < wire_end):
            bad.append(f"{label}: settings write (json.dump) outside the wire-hooks consent path")
    # The falsifier-elimination migration is the one other sanctioned write
    # region: its edits are rooted in the estate's design/ directory, on the
    # OK_DIR the script is handed.
    fals_start, fals_end = region(
        text, 'falsifier_report=$(python3 - "$OK_DIR"', "\nPYEOF", label)
    if 'os.path.join(ok_dir, "design"' not in text[fals_start:fals_end]:
        bad.append(f"{label}: falsifier-elimination writes are not rooted in the estate's design/")
    writes = [m.start() for m in re.finditer(r'open\((\w+), "w"\)', text)]
    outside = [w for w in writes
               if not (wire_start <= w < wire_end)
               and not (fals_start <= w < fals_end)]
    if len(outside) != 1:
        bad.append(
            f"{label}: expected exactly one python write site outside the consent and "
            f"migration paths (the vendored-skill converge loop), found {len(outside)}"
        )


def check_plumbline():
    label = "ok-plumbline bin/plumbline"
    path = os.path.join(FAMILIES_DIR, "ok-plumbline", "bin", "plumbline")
    text = open(path).read()

    allowed_first_args = {
        "canonicalBudget",  # .ok-plumbline/budget.json — the budget verb's baseline, estate-side
        "dest",             # vendored skill files under .claude/skills (vendorSkillsCmd)
        "settingsPath",     # consent path only — asserted below
    }
    wire_start, wire_end = region(text, "function wireHooksCmd", "\nfunction diagnoseCmd", label)
    for m in re.finditer(r"fs\.writeFileSync\(([A-Za-z_$][\w$]*)", text):
        arg = m.group(1)
        if arg not in allowed_first_args:
            bad.append(f"{label}: writeFileSync target not in the declared owned set: {arg}")
        if arg == "settingsPath" and not (wire_start <= m.start() < wire_end):
            bad.append(f"{label}: settings write outside the wire-hooks consent path")

    label = "ok-plumbline admin/converge"
    path = os.path.join(FAMILIES_DIR, "ok-plumbline", "admin", "converge")
    text = open(path).read()
    check_bash_redirects(label, text, (
        ".ok-plumbline/",
        ".claude/rules/plumbline-cheatsheet.md",
    ))
    # The retired merged verb is the one deletion outside the estate.
    check_bash_file_ops(label, text, (".ok-plumbline/",),
                        exempt=(".claude/skills/true-up",))
    code_lines = [l for l in text.split("\n") if not l.lstrip().startswith("#")]
    for line in code_lines:
        if "settings.json" in line:
            bad.append(f"{label}: touches settings.json outside the binary's wire-hooks path: {line.strip()[:80]}")


def check_workspaces():
    label = "ok-workspaces scripts"
    converge = open(os.path.join(FAMILIES_DIR, "ok-workspaces", "scripts", "converge.js")).read()
    vendored = open(os.path.join(FAMILIES_DIR, "ok-workspaces", "scripts", "vendored-skills.js")).read()

    allowed = (
        r"fs\.writeFileSync\(srcTagAbs,",  # profile-declared script path — owned by declaration
        r"fs\.writeFileSync\(portBlockAbs,",  # .ok-workspaces/bin/port-block
        r"fs\.writeFileSync\(path\.join\(root, '\.ok-workspaces', '\.gitignore'\),",
        r"fs\.writeFileSync\(worktreeIgnoreAbs,",  # <profile dirPrefix>/.gitignore — the declared worktree location
        r"fs\.writeFileSync\(path\.join\(rulesDir, 'ok-workspaces-cheatsheet\.md'\),",
        r"fs\.writeFileSync\(dest, body\)",  # vendored skill files under .claude/skills
    )
    for lineno, line in enumerate(converge.split("\n"), 1):
        if "fs.writeFileSync(" in line and not any(re.search(a, line) for a in allowed):
            bad.append(f"{label}: converge.js:{lineno} writeFileSync target not in the declared owned set")
    if "const portBlockAbs = path.join(root, '.ok-workspaces', 'bin', 'port-block')" not in converge:
        bad.append(f"{label}: portBlockAbs is not declared inside the estate")
    # The one write outside the dot-directory: the ignore file covering the
    # profile-declared worktree location. It must be derived from that
    # declaration, resolved against the repository root so a prefix that
    # normalizes out of the repo cannot be written to, and written only
    # when the prefix is an in-repo path.
    if "const dirPrefixAbs = path.resolve(root, dirPrefix)" not in converge:
        bad.append(f"{label}: the declared dirPrefix is not resolved against the repository root")
    if "const worktreeIgnoreAbs = path.join(dirPrefixAbs, '.gitignore')" not in converge:
        bad.append(f"{label}: the worktree ignore file is not derived from the declared dirPrefix")
    if "if (!inDotDir && !outsideRepo) {" not in converge:
        bad.append(f"{label}: the worktree ignore write is not gated on an in-repo declared prefix")
    for m in re.finditer(r"fs\.(unlinkSync|rmdirSync)\(([^)]*)\)", converge):
        arg = m.group(2).strip()
        if "'.ok-workspaces'" not in arg and arg not in ("p", "portBlockAbs"):
            bad.append(f"{label}: converge.js {m.group(1)} outside the estate: {m.group(2)}")
    if "const retiredVerbDir = path.join(root, '.claude', 'skills', 'true-up')" not in converge:
        bad.append(f"{label}: retired merged-verb removal is not anchored to .claude/skills/true-up")
    for m in re.finditer(r"fs\.rmSync\(([^,)]*)", converge):
        if m.group(1).strip() != "retiredVerbDir":
            bad.append(f"{label}: converge.js rmSync target not in the declared owned set: {m.group(1)}")
    if "'.ok-workspaces', ...rel" not in converge and "path.join(root, '.ok-workspaces', ...rel)" not in converge:
        bad.append(f"{label}: retired-payload removal is not rooted in the estate")
    for name, text in (("converge.js", converge), ("vendored-skills.js", vendored)):
        if "settings.json" in text:
            bad.append(f"{label}: {name} references settings.json — ok-workspaces declares no hook wiring")


check_planner()
check_plumbline()
check_workspaces()

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
