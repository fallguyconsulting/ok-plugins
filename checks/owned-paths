    gate = text[slice(*regions["apply_plan"])]
    order = [gate.find(needle) for needle in ("if go_ahead is None and destructive:",
                                              "if go_ahead is not None and go_ahead != plan_id(plan):",
                                              "causes = prechecks(plan)", 'for action in plan["actions"]:')]
    if -1 in order or order != sorted(order):
