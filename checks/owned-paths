         "the dashboard build's extras are not found under BUILD_DEST by the service's placement routine"),
    ):
        here = text[slice(*regions[name])]
        if not all(needle in here for needle in needles):
            bad.append(f"{label}: {why}")
    for name, why in (
        ("without_provenance_stamp", "the /document provenance stamp is deleted outside the rewrite plan"),
        ("converted_docspec", "a document type is converted to the docspec form outside the rewrite plan"),
    ):
        uses = [m.start() for m in re.finditer(r"(?<![\w.])%s\b" % name, text)
                if not re.search(r"def\s+$", text[max(0, m.start() - 10):m.start()])]
        if any(not inside(at, [regions["rewrite_plan"]]) for at in uses):
            bad.append(f"{label}: {why}")
    if 'RETIRED_HUNT_KEYS = ("extraction", "flow_kinds", "flow_area_size")' not in text:
