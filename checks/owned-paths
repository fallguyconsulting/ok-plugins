        "move_all": {"pairs, history": ("resolve",)},
        "move_back": {"pairs, target_path, created": ("resolve",)},
        "prune_tree": {
            "legacy_review": ("migrate_review", "resolve"),
            "plumbline_dir": ("migrate_plumbline",),
            'ws_dir, plan["keep"]': ("migrate_workspaces",),
            "old": ("resolve",),
        },
        "write_owner": {
