READ_ONLY_GIT = ("ls-files", "diff", "rev-parse", "status")


def check_git_helper(label, text, helper, verb_of):
    """A git call through the core's read helper names a read-only verb."""
    for m in re.finditer(r"(?<![\w.])" + helper + r"\(", text):
        if re.search(r"(?:def|function)\s+$", text[max(0, m.start() - 10):m.start()]):
            continue
        verb = verb_of(call_args(text, m.end() - 1))
        if verb not in READ_ONLY_GIT:
            bad.append(f"{label}:{lineno(text, m.start())}: {helper} runs git {verb}, which is not a read-only verb")


def python_verb(args):
    return unquote(args[0]) if args else ""


def js_verb(args):
    found = re.match(r"""\[\s*['"]([\w-]+)['"]""", args[1]) if len(args) > 1 else None
    return found.group(1) if found else ""


