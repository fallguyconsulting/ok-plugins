            '["git", "-C", root, "mv", "--", rel(src), rel(dst)]': ("relocate",),
            '["git", "-C", root, "mv", "--"] + [rel(src) for src in tracked] + [rel(destination)]': ("move_all",),
            '["git", "-C", root, "mv", "--"] + [rel(dst) for dst in tracked] + [rel(source)]': ("move_back",),
            '[NODE, PLUMBLINE_SRC, "config-check", "--config", CONFIG_FROM_STDIN]': ("parsed_config",),
            '[sys.executable, CATALOG_TOC_SRC, "--check", root]': ("toc_steps",),
            '["git", "-C", root, "worktree", "list", "--porcelain"]': ("registered_worktrees",),
            '["git", "-C", root, "for-each-ref", "--format=%(refname)"] + list(args) + ["refs/heads/"]':
                ("local_branches",),
            '["git", "-C", tree, "status", "--porcelain"]': ("worktree_refusal",),
            '["git", "-C", root, "worktree", "remove", tree]': ("worktree-steps",),
            '["git", "-C", root, "branch", "-d", branch]': ("worktree-steps",),
            "argv": ("probe",),
            "[sys.executable, ISSUES_SRC] + args": ("intake_command",),
            "[sys.executable, PORTS_SRC] + args": ("ports_command",),
            '["bash", core, "diagnose"]': ("back-out",),
