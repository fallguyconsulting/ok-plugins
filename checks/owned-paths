BUILD_DEST = re.compile(r'^BUILD_DEST = os\.path\.join\(ok_dir, "([^"]+)"\)$', re.M)


def table_destinations(label, text, table):
    start, end = region(text, "\n%s = (" % table, "\n)\n", label)
    return re.findall(r'^\s*\("[^"]+", "([^"]+)"', text[start:end], re.M)


def check_destinations(label, text):
    """Every file converge materializes lands under .claude/skills/,
    .claude/agents/, the estate, or the named rules and hooks files: the
    carried tables name only those destinations, and expected() keys each
    body by one of them."""
    for table in ("ESTATE_FILES", "EXECUTABLE_FILES"):
        rows = table_destinations(label, text, table)
        if not rows:
            bad.append(f"{label}: {table} names no destination")
        for dest_rel in rows:
            if not dest_rel.startswith(DESTINATION_PREFIXES) or ".." in dest_rel.split("/"):
                bad.append(f"{label}: {table} materializes {dest_rel}, outside the estate and the "
                           f"suite's rules and hooks files")
    start, end = region(text, "\ndef expected():", "\nANY_OK_STAMP = ", label)
    for m in re.finditer(r"\bout\[([^\]]+)\]\s*=", text[start:end]):
        if m.group(1) not in EXPECTED_KEYS:
            bad.append(f"{label}:{lineno(text, start + m.start())}: expected() keys a materialized body by "
                       f"{m.group(1)}, which is not a declared destination")
    if "out.update(FIXED_RULES)" not in text[start:end] or \
            'CONCEPTS_IMPORT = os.path.join(RULES_DIR, "ok-concepts.md")' not in text:
        bad.append(f"{label}: the fixed-content rules file is not keyed at .claude/rules/ok-concepts.md")


def check_retired_estate(label, text):
    start, end = region(text, "\nRETIRED_ESTATE=(", "\n)\n", label)
    retired = [line.strip() for line in text[start:end].split("\n")[1:] if line.strip()]
    if not retired:
        bad.append(f"{label}: RETIRED_ESTATE names no entry")
    placed = []
    for table in ("ESTATE_FILES", "EXECUTABLE_FILES"):
        placed += [(table, d[len(ESTATE_PREFIX):]) for d in table_destinations(label, text, table)
                   if d.startswith(ESTATE_PREFIX)]
    build = BUILD_DEST.search(text)
    if build is None:
        bad.append(f"{label}: the dashboard build's placement is not declared as BUILD_DEST under the estate")
    else:
        placed.append(("BUILD_DEST", build.group(1)))
    for source, dest_rel in placed:
        for entry in retired:
            if dest_rel == entry or dest_rel.startswith(entry + "/") or entry.startswith(dest_rel + "/"):
                bad.append(f"{label}: {source} writes {ESTATE_PREFIX}{dest_rel}, which the retired-estate "
                           f"sweep removes as {ESTATE_PREFIX}{entry} on every converge")


