#!/usr/bin/env python3
import os
import re
import subprocess
import sys
import types

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FAMILY_SCRIPTS = os.path.join(ROOT, "plugins", "ok", "families", "ok-planner", "scripts")


def load_family_script(name):
    path = os.path.join(FAMILY_SCRIPTS, name)
    module = types.ModuleType("ok_planner_%s" % name)
    module.__file__ = path
    with open(path, encoding="utf-8") as f:
        exec(compile(f.read(), path, "exec"), module.__dict__)
    return module


review = load_family_script("review")

findings = []


def git(*args):
    out = subprocess.run(["git", "-C", ROOT] + list(args),
                         capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else None


def close_commits():
    stamped = []
    archive = os.path.join(ROOT, review.ARCHIVED_SPRINTS)
    if not os.path.isdir(archive):
        return stamped
    for fn in sorted(os.listdir(archive)):
        if not fn.endswith(".md"):
            continue
        with open(os.path.join(archive, fn)) as f:
            stamp = review.closed_stamp(f.read())
        if not stamp:
            continue
        ts = git("show", "-s", "--format=%ct", stamp)
        if ts is None:
            continue
        stamped.append((int(ts.strip()), stamp, fn))
    return sorted(stamped)


def sections_at(sha, path):
    blob = git("show", "%s:%s" % (sha, path))
    if blob is None:
        return {}
    chains = {}
    stack = []
    in_fence = False
    fence_mark = ""
    for i, line in enumerate(blob.splitlines(), 1):
        f = re.match(r"^\s*(```|~~~)", line)
        if f:
            if not in_fence:
                in_fence, fence_mark = True, f.group(1)
            elif f.group(1) == fence_mark:
                in_fence = False
        elif not in_fence:
            m = re.match(r"^(#{1,6})\s+(.+?)\s*$", line)
            if m:
                level = len(m.group(1))
                stack = [s for s in stack if s[0] < level]
                stack.append((level, m.group(2)))
        chains[i] = " > ".join(s[1] for s in stack)
    return chains


def sections_edited(sha):
    diff = git("diff", "-U0", "%s^" % sha, sha, "--",
               ".ok-planner/design")
    if diff is None:
        return set()
    edited = set()
    path = None
    for line in diff.splitlines():
        m = re.match(r"^\+\+\+ b/(.+)$", line)
        if m:
            path = m.group(1) if m.group(1).endswith(".md") else None
            chains = sections_at(sha, path) if path else {}
            continue
        m = re.match(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", line)
        if m and path:
            start = int(m.group(1))
            count = int(m.group(2)) if m.group(2) is not None else 1
            for ln in range(start, start + max(count, 1)):
                edited.add((path, chains.get(ln, "")))
    return edited


def section_churn():
    closes = close_commits()
    for (_, a, fa), (_, b, fb) in zip(closes, closes[1:]):
        both = sections_edited(a) & sections_edited(b)
        for path, chain in sorted(both):
            findings.append(
                "%s: section %r edited in consecutive closes %s (%s) "
                "and %s (%s)"
                % (path, chain or "(preamble)", a[:12], fa, b[:12], fb))


if git("rev-parse", "--git-dir") is None:
    print("oscillation: cannot read git history at %s" % ROOT)
    sys.exit(1)

section_churn()

if findings:
    print("oscillation (report-only — never blocks):")
    for f in findings:
        print("  " + f)
else:
    print("oscillation: no section churn in history")
sys.exit(0)
