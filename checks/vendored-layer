#!/usr/bin/env python3
# Suite maintenance check: the vendored-skills architecture holds.
# - This repo's own vendored layer (it dogfoods ok-planner) is pinned to
#   the last COMMIT, never to the working tree: the suite-owned vendored
#   and materialized paths must be byte-identical to HEAD. The layer
#   changes only by a deliberate, committed converge (after a release,
#   through /ok) — a working session that edits family source must NOT
#   re-vendor mid-flight, and any uncommitted drift under these paths
#   (a stray converge, a hand-edit, a new materialized file) goes red
#   here. Fidelity against the canonical rendering is the administration
#   act's job (/ok drives the family's own diagnose at converge time),
#   not this check's: between a release and the next deliberate converge
#   the layer legitimately lags the family source in this repo.
# - Every family exposes the contract's two conventional administration
#   surfaces: an executable converge core at admin/converge and an
#   administration document at admin/ADMINISTRATION.md.
# - The merged lifecycle verb is retired: no family carries its template,
#   and this repo's own .claude/skills/ carries no true-up verb.
# - No family ships family-root hooks, and neither does the front door:
#   hook implementations are materialized project-side and reached through
#   consented settings entries. The user-scoped conduct plugin is the
#   deliberate exception — its hooks are machine-global because the
#   conduct belongs to the user, not to any project.
# @decision: vendored-skills
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FAMILIES_DIR = os.path.join(ROOT, "plugins", "ok", "families")
FAMILIES = ("ok-planner", "ok-plumbline", "ok-workspaces")

# The suite-owned layer in this repo: everything the planner family's
# converge materializes or vendors here (this repo integrates ok-planner
# alone). Repo-authored skills beside the vendored ones under
# .claude/skills/ are deliberately not listed — see REPO_AUTHORED_SKILLS.
#
# The list is a pin in both directions, and both are enforced below: a
# pinned path must exist (a `git status` argument alone is silent for a
# path that has vanished, which is how this list previously rotted into
# naming a skill the repo no longer carries and missing one it does),
# and a vendored skill that appears without being pinned is a finding.
PINNED = (
    ".claude/rules/ok-planner-cheatsheet.md",
    ".ok-planner/CLAUDE.md",
    ".ok-planner/bin",
    ".ok-planner/scripts",
    ".ok-planner/hooks",
    ".claude/skills/_shared",
    ".claude/skills/verify-corpus",
    ".claude/skills/certify-work",
    ".claude/skills/discover-design",
    ".claude/skills/ok-planner",
    ".claude/skills/ok-planner-audit",
    ".claude/skills/ok-version",
    ".claude/skills/plan-sprint",
    ".claude/skills/sketch",
    ".claude/skills/verify-issues",
)

# Skills this repo authors for itself. They live beside the vendored set
# and are maintained by hand, so they are neither pinned to HEAD nor
# expected to be produced by any family's converge.
REPO_AUTHORED_SKILLS = (
    ".claude/skills/release",
)

bad = []

for rel in PINNED:
    if not os.path.exists(os.path.join(ROOT, rel)):
        bad.append(f"pinned vendored path missing from the repo: {rel} — "
                   "the pin is stale, or a converge dropped it")

skills_dir = os.path.join(ROOT, ".claude", "skills")
known_skills = set(PINNED) | set(REPO_AUTHORED_SKILLS)
for name in sorted(os.listdir(skills_dir)) if os.path.isdir(skills_dir) else []:
    # A skill is a directory. Loose files that collect under .claude/skills/
    # — .DS_Store, editor swap files — are not skills, and reporting one as
    # an un-pinned skill would be a false finding on an untouched layer.
    if not os.path.isdir(os.path.join(skills_dir, name)):
        continue
    rel = ".claude/skills/" + name
    if rel not in known_skills:
        bad.append(f"un-pinned skill present under .claude/skills/: {rel} — "
                   "vendored skills belong in PINNED, repo-authored ones in "
                   "REPO_AUTHORED_SKILLS")

result = subprocess.run(
    ["git", "-C", ROOT, "status", "--porcelain", "--"] + list(PINNED),
    capture_output=True,
    text=True,
)
drift = result.stdout.strip()
if result.returncode != 0:
    bad.append("git status over the pinned vendored layer failed: "
               + result.stderr.strip())
elif drift:
    bad.append("vendored layer drifted from HEAD — the suite-owned copies "
               "change only by a deliberate, committed converge, never "
               "mid-flight:")
    for line in drift.split("\n"):
        bad.append(f"  {line}")

for family in FAMILIES:
    core = os.path.join(FAMILIES_DIR, family, "admin", "converge")
    doc = os.path.join(FAMILIES_DIR, family, "admin", "ADMINISTRATION.md")
    if not os.path.exists(core):
        bad.append(f"{family}: missing the converge core at admin/converge")
    elif not os.access(core, os.X_OK):
        bad.append(f"{family}: admin/converge is not executable")
    if not os.path.exists(doc):
        bad.append(f"{family}: missing the administration document at admin/ADMINISTRATION.md")
    template = os.path.join(FAMILIES_DIR, family, "scripts", "true-up-skill.md")
    if os.path.exists(template):
        bad.append(f"{family}: retired merged-verb template still present at scripts/true-up-skill.md")
    retired_skill = os.path.join(FAMILIES_DIR, family, "skills", "true-up")
    if os.path.exists(retired_skill):
        bad.append(f"{family}: retired true-up skill still present at skills/true-up/")

if os.path.exists(os.path.join(ROOT, ".claude", "skills", "true-up")):
    bad.append("this repo's .claude/skills/ still carries the retired merged true-up verb")

for family in FAMILIES:
    hooks_dir = os.path.join(FAMILIES_DIR, family, "hooks")
    if os.path.exists(hooks_dir):
        bad.append(f"{family}: family-root hooks/ present — families wire hooks through consented settings entries, not the family root")
if os.path.exists(os.path.join(ROOT, "plugins", "ok", "hooks")):
    bad.append("ok: plugin-root hooks/ present — the front door declares no hooks")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
