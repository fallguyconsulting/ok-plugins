#!/usr/bin/env python3

# @decision: vendored-skills
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FAMILIES_DIR = os.path.join(ROOT, "plugins", "ok", "families")
FAMILIES = ("ok-planner", "ok-plumbline", "ok-workspaces")

PINNED = (
    ".claude/rules/ok-cheatsheet.md",
    ".claude/hooks/ok-agent-model",
    ".claude/rules/ok-planner-cheatsheet.md",
    ".ok-planner/CLAUDE.md",
    ".ok-planner/LICENSE",
    ".ok-planner/bin",
    ".ok-planner/scripts",
    ".ok-planner/hooks",
    ".claude/skills/_shared",
    ".claude/skills/audit",
    ".claude/skills/budget",
    ".claude/skills/certify-work",
    ".claude/skills/discover-design",
    ".claude/skills/document",
    ".claude/skills/explain",
    ".claude/skills/ok-planner",
    ".claude/skills/ok-version",
    ".claude/skills/patterns",
    ".claude/skills/plan-sprint",
    ".claude/skills/port",
    ".claude/skills/sketch",
    ".claude/skills/starter",
    ".claude/skills/suggest",
    ".claude/skills/verify-issues",
    ".claude/skills/version",
)

REPO_AUTHORED_SKILLS = (
    ".claude/skills/release",
)

bad = []

for rel in PINNED:
    if not os.path.exists(os.path.join(ROOT, rel)):
        bad.append(f"pinned vendored path missing from the repo: {rel} — "
                   "the pin is stale, or a converge dropped it")

skills_dir = os.path.join(ROOT, ".claude", "skills")
known_skills = set(PINNED) | set(REPO_AUTHORED_SKILLS)
for name in sorted(os.listdir(skills_dir)) if os.path.isdir(skills_dir) else []:
    if not os.path.isdir(os.path.join(skills_dir, name)):
        continue
    rel = ".claude/skills/" + name
    if rel not in known_skills:
        bad.append(f"un-pinned skill present under .claude/skills/: {rel} — "
                   "vendored skills belong in PINNED, repo-authored ones in "
                   "REPO_AUTHORED_SKILLS")

result = subprocess.run(
    ["git", "-C", ROOT, "status", "--porcelain", "--"] + list(PINNED),
    capture_output=True,
    text=True,
)
drift = result.stdout.strip()
if result.returncode != 0:
    bad.append("git status over the pinned vendored layer failed: "
               + result.stderr.strip())
elif drift:
    bad.append("vendored layer drifted from HEAD — the suite-owned copies "
               "change only by a deliberate, committed converge, never "
               "mid-flight:")
    for line in drift.split("\n"):
        bad.append(f"  {line}")

SUITE_ADMIN = os.path.join(ROOT, "plugins", "ok", "admin")
suite_core = os.path.join(SUITE_ADMIN, "converge")
if not os.path.exists(suite_core):
    bad.append("ok: missing the suite converge core at plugins/ok/admin/converge")
elif not os.access(suite_core, os.X_OK):
    bad.append("ok: plugins/ok/admin/converge is not executable")
if not os.path.exists(os.path.join(SUITE_ADMIN, "ADMINISTRATION.md")):
    bad.append("ok: missing the suite administration document at plugins/ok/admin/ADMINISTRATION.md")

for family in FAMILIES:
    core = os.path.join(FAMILIES_DIR, family, "admin", "converge")
    doc = os.path.join(FAMILIES_DIR, family, "admin", "ADMINISTRATION.md")
    if not os.path.exists(core):
        bad.append(f"{family}: missing the converge core at admin/converge")
    elif not os.access(core, os.X_OK):
        bad.append(f"{family}: admin/converge is not executable")
    if not os.path.exists(doc):
        bad.append(f"{family}: missing the administration document at admin/ADMINISTRATION.md")
    template = os.path.join(FAMILIES_DIR, family, "scripts", "true-up-skill.md")
    if os.path.exists(template):
        bad.append(f"{family}: retired merged-verb template still present at scripts/true-up-skill.md")
    retired_skill = os.path.join(FAMILIES_DIR, family, "skills", "true-up")
    if os.path.exists(retired_skill):
        bad.append(f"{family}: retired true-up skill still present at skills/true-up/")

if os.path.exists(os.path.join(ROOT, ".claude", "skills", "true-up")):
    bad.append("this repo's .claude/skills/ still carries the retired merged true-up verb")

for family in FAMILIES:
    hooks_dir = os.path.join(FAMILIES_DIR, family, "hooks")
    if os.path.exists(hooks_dir):
        bad.append(f"{family}: family-root hooks/ present — families wire hooks through consented settings entries, not the family root")
FRONT_DOOR_HOOKS = ("agent-model",)
front_door_hooks_dir = os.path.join(ROOT, "plugins", "ok", "hooks")
present = tuple(sorted(os.listdir(front_door_hooks_dir))) if os.path.isdir(front_door_hooks_dir) else ()
if present != FRONT_DOOR_HOOKS:
    bad.append("ok: plugin-root hooks/ holds %s — the front door declares exactly %s, "
               "wired only by its consented wire-hooks mode" % (list(present), list(FRONT_DOOR_HOOKS)))

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
