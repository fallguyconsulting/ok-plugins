#!/usr/bin/env python3
# Suite maintenance check: the vendored-skills architecture holds.
# - This repo's own vendored layer (it dogfoods ok-planner) matches the
#   installed rendering exactly — skill fidelity, version stamps, the
#   consented hook entry, and its session-start matcher — via the planner's
#   own read-only diagnose, which is the same gate every consumer project
#   gets. Hand-edit a vendored skill, delete the hook entry, or widen the
#   matcher and this check goes red.
# - The merged lifecycle verb's template is byte-identical across every
#   integrable plugin, so whichever plugin converges first materializes the
#   same verb.
# - No integrable plugin ships plugin-root hooks: hook implementations are
#   materialized project-side and reached through consented settings entries.
#   The user-scoped conduct plugin is the deliberate exception — its hooks
#   are machine-global because the conduct belongs to the user, not to any
#   project.
# @decision: vendored-skills
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INTEGRABLE = ("ok-planner", "ok-plumbline", "ok-workspaces")

bad = []

result = subprocess.run(
    ["bash", os.path.join(ROOT, "plugins", "ok-planner", "scripts", "true-up"), "diagnose"],
    cwd=ROOT,
    capture_output=True,
    text=True,
)
if result.returncode != 0:
    bad.append("ok-planner diagnose reports drift in this repo's vendored layer:")
    for line in (result.stdout + result.stderr).strip().split("\n"):
        bad.append(f"  {line}")

templates = {}
for plugin in INTEGRABLE:
    path = os.path.join(ROOT, "plugins", plugin, "scripts", "true-up-skill.md")
    if not os.path.exists(path):
        bad.append(f"{plugin}: missing the merged lifecycle verb template at scripts/true-up-skill.md")
        continue
    templates[plugin] = open(path).read()
if len(set(templates.values())) > 1:
    bad.append(
        "the merged lifecycle verb template differs between plugins: "
        + ", ".join(sorted(templates))
    )

for plugin in INTEGRABLE + ("ok",):
    hooks_dir = os.path.join(ROOT, "plugins", plugin, "hooks")
    if os.path.exists(hooks_dir):
        bad.append(f"{plugin}: plugin-root hooks/ present — integrable plugins wire hooks through consented settings entries, not the plugin root")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
