#!/usr/bin/env python3
# Suite maintenance check: every user-facing skill's description carries the
# explicit-activation guard phrase; plumbing skills are on the named allowlist,
# each justified by its documented machine driver.
# @decision: slash-only-activation
import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GUARD = "Never auto-triggered by conversation content"

PLUMBING = {
    "ok-planner:true-up": "driven by /ok, the merged project true-up, and sibling ok-planner skills via the skill tool",
    "ok-plumbline:true-up": "driven by /ok and the merged project true-up via the skill tool",
    "ok-workspaces:true-up": "driven by /ok and the merged project true-up via the skill tool",
    "ok-planner:verify-issues": "driven by the certify gates and /plan-sprint via the skill tool",
}

# Vendored copies in this repo's own .claude/skills/ live under bare
# materialized names; the merged lifecycle verb and the vendored copy of
# verify-issues are the plumbing entries there.
PLUMBING_VENDORED = {
    "true-up": "the merged lifecycle verb — driven by /ok via the skill tool",
    "verify-issues": "driven by the certify gates and /plan-sprint via the skill tool",
}

bad = []
seen_plumbing = set()


def check_skill(name, path, plumbing, seen):
    text = open(path).read()
    m = re.search(r"^description: (.*)$", text, re.M)
    desc = m.group(1) if m else ""
    if name in plumbing:
        seen.add(name)
        if GUARD in desc:
            bad.append(
                f"{name}: allowlisted as plumbing but its description carries the guard "
                f"— the two-class split says one or the other"
            )
        return
    if GUARD not in desc:
        bad.append(f"{name}: user-facing skill description lacks the explicit-activation guard")


for path in sorted(glob.glob(os.path.join(ROOT, "plugins", "*", "skills", "*", "SKILL.md"))):
    parts = path.split(os.sep)
    plugin, skill = parts[-4], parts[-2]
    check_skill(f"{plugin}:{skill}", path, PLUMBING, seen_plumbing)

seen_vendored = set()
for path in sorted(glob.glob(os.path.join(ROOT, ".claude", "skills", "*", "SKILL.md"))):
    skill = path.split(os.sep)[-2]
    check_skill(f"vendored:{skill}", path, {f"vendored:{k}": v for k, v in PLUMBING_VENDORED.items()}, seen_vendored)

for name in sorted(set(PLUMBING) - seen_plumbing):
    bad.append(f"{name}: allowlisted plumbing skill not found on disk — stale allowlist entry")
for name in sorted({f"vendored:{k}" for k in PLUMBING_VENDORED} - seen_vendored):
    bad.append(f"{name}: allowlisted plumbing skill not found on disk — stale allowlist entry")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
