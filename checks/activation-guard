#!/usr/bin/env python3
# Suite maintenance check: every user-facing skill's description carries the
# explicit-activation guard phrase, and every guard-less skill is a plumbing
# skill whose membership the decision's own rule allows — the driver is not
# taken on trust from the allowlist comment but derived from the suite's
# text: some other skill body must document driving it through the
# skill-invocation tool. A guard-less skill nothing drives is a finding, so
# the split is tested by the criterion, not by a hand-kept list.
# @decision: slash-only-activation
import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GUARD = "Never auto-triggered by conversation content"

# The declared plumbing class. `qualified` is the skill-invocation form a
# driver must use; the check looks for it in the suite's other skill
# bodies rather than trusting the justification below.
PLUMBING = {
    "ok-planner:verify-issues": {
        "why": "driven by the certify gates and /plan-sprint via the skill tool",
        "qualified": "ok-planner:verify-issues",
    },
}

# Vendored copies in this repo's own .claude/skills/ live under bare
# materialized names; the vendored copy of verify-issues is the plumbing
# entry there.
PLUMBING_VENDORED = {
    "verify-issues": {
        "why": "driven by the certify gates and /plan-sprint via the skill tool",
        "qualified": "ok-planner:verify-issues",
    },
}

bad = []
seen_plumbing = set()

SKILL_SOURCES = sorted(
    glob.glob(os.path.join(ROOT, "plugins", "*", "skills", "*", "SKILL.md"))
    + glob.glob(os.path.join(ROOT, "plugins", "ok", "families", "*", "skills", "*", "SKILL.md"))
    + glob.glob(os.path.join(ROOT, "plugins", "ok", "families", "*", "skills", "_shared", "*.md"))
)


def documented_drivers(qualified_name, own_path):
    """Suite surfaces that document driving this skill through the skill tool."""
    drivers = []
    for path in SKILL_SOURCES:
        if os.path.abspath(path) == os.path.abspath(own_path):
            continue
        if qualified_name in open(path).read():
            drivers.append(os.path.relpath(path, ROOT))
    return drivers


def check_skill(name, path, plumbing, seen):
    text = open(path).read()
    m = re.search(r"^description: (.*)$", text, re.M)
    desc = m.group(1) if m else ""
    if name in plumbing:
        seen.add(name)
        if GUARD in desc:
            bad.append(
                f"{name}: allowlisted as plumbing but its description carries the guard "
                f"— the two-class split says one or the other"
            )
        # The membership rule, applied rather than assumed: a skill
        # belongs to the plumbing class only while another suite surface
        # is documented to drive it through the skill-invocation tool.
        source_name = plumbing[name].get("qualified") if isinstance(plumbing[name], dict) else None
        if source_name:
            drivers = documented_drivers(source_name, path)
            if not drivers and GUARD in desc:
                bad.append(
                    f"{name}: no suite surface documents driving {source_name} through the "
                    f"skill tool — it is not plumbing; drop the allowlist entry"
                )
            elif not drivers:
                bad.append(
                    f"{name}: guard-less, but no suite surface documents driving "
                    f"{source_name} through the skill tool — the guard belongs"
                )
        return
    if GUARD not in desc:
        bad.append(f"{name}: user-facing skill description lacks the explicit-activation guard")


skill_globs = [
    os.path.join(ROOT, "plugins", "*", "skills", "*", "SKILL.md"),
    os.path.join(ROOT, "plugins", "ok", "families", "*", "skills", "*", "SKILL.md"),
]
for pattern in skill_globs:
    for path in sorted(glob.glob(pattern)):
        parts = path.split(os.sep)
        plugin, skill = parts[-4], parts[-2]
        check_skill(f"{plugin}:{skill}", path, PLUMBING, seen_plumbing)

seen_vendored = set()
for path in sorted(glob.glob(os.path.join(ROOT, ".claude", "skills", "*", "SKILL.md"))):
    skill = path.split(os.sep)[-2]
    check_skill(f"vendored:{skill}", path, {f"vendored:{k}": v for k, v in PLUMBING_VENDORED.items()}, seen_vendored)

for name in sorted(set(PLUMBING) - seen_plumbing):
    bad.append(f"{name}: allowlisted plumbing skill not found on disk — stale allowlist entry")
for name in sorted({f"vendored:{k}" for k in PLUMBING_VENDORED} - seen_vendored):
    bad.append(f"{name}: allowlisted plumbing skill not found on disk — stale allowlist entry")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
