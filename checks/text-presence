#!/usr/bin/env python3
# Suite maintenance check: declared text-presence proofs. Each block below
# asserts that a decision's governing line stands verbatim (whitespace-
# normalized) in its named home. Declared as presence, not behavior — the
# conduct these lines govern is prompt-realized and unprovable; deleting or
# rewording a line is the falsifier that turns its assertion red.
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

bad = []


def norm(s):
    return " ".join(s.split())


def assert_present(slug, relpath, needle):
    path = os.path.join(ROOT, relpath)
    if not os.path.exists(path):
        bad.append(f"{slug}: governing file missing: {relpath}")
        return
    if norm(needle) not in norm(open(path).read()):
        bad.append(f"{slug}: governing line missing from {relpath}: {needle!r}")


# @decision: filesystem-discovery-markers
assert_present(
    "filesystem-discovery-markers",
    "plugins/ok/skills/ok/SKILL.md",
    "a filesystem check, never an inference",
)
assert_present(
    "filesystem-discovery-markers",
    "docs/integration-contract.md",
    "is a filesystem check, never an inference",
)

# @decision: prove-audit-audience-split
assert_present(
    "prove-audit-audience-split",
    "plugins/ok/families/ok-planner/skills/prove/SKILL.md",
    "never writes to the issue intake",
)
assert_present(
    "prove-audit-audience-split",
    "plugins/ok/families/ok-planner/skills/audit/SKILL.md",
    "`.ok-planner/issues/` is reached only by the two gated paths — the architect's confirmed forks, and the remainders escalated at the cap",
)

# @decision: relevance-scoped-queue-gate
assert_present(
    "relevance-scoped-queue-gate",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "run the relevance pass below over the §3 draft",
)
assert_present(
    "relevance-scoped-queue-gate",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "Dispatch a dedicated reviewer. It decides bearing-vs-independent; it never resolves anything.",
)
assert_present(
    "relevance-scoped-queue-gate",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "When you cannot tell, answer BEARS.",
)

# @decision: no-execution-engine
assert_present(
    "no-execution-engine",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "Staging is never rewritten into a plan document: this sprint is the whole brief.",
)
assert_present(
    "no-execution-engine",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "build the list in your own working state",
)
assert_present(
    "no-execution-engine",
    "plugins/ok/families/ok-planner/scripts/ok-planner-CLAUDE.md",
    "a sprint is never rewritten into a plan document",
)

# @decision: per-project-pinning
# The advisory-fallback announcement: every read-only verb that prefers the
# vendored binary and can fall back to the payload's copy announces the
# fallback. Eleven verbs do: the five below share one wording, and ci,
# version, the planner's audit and browse verbs, and the two bootstrap
# verbs port and starter each announce it in their own words, asserted
# individually after the loop.
# Declared as presence, not behavior — deleting the line is the falsifier.
for _skill in ("audit", "budget", "patterns", "suggest", "explain"):
    assert_present(
        "per-project-pinning",
        f"plugins/ok/families/ok-plumbline/skills/{_skill}/SKILL.md",
        "note: no vendored binary — using the payload's copy; /ok pins one to this project",
    )
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-plumbline/skills/ci/SKILL.md",
    "note: no vendored binary — CI needs one committed; run /ok first",
)
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-plumbline/skills/version/SKILL.md",
    "project (vendored): none — /ok pins one to this project",
)
# The bootstrap verbs run before a project has an estate, so their fallback
# is the common path — announced in their own words all the same.
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-plumbline/skills/starter/SKILL.md",
    "note: no vendored binary in this project — proposing from the carried payload",
)
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-plumbline/skills/port/SKILL.md",
    "note: no vendored binary in this project — planning from the carried payload",
)
# The planner's read-only advisory verb falls back to the payload's
# checker the same way, and announces it in its own words.
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-planner/skills/audit/SKILL.md",
    "note: no vendored checker — using the payload's copy; /ok pins one to this project",
)
# The corpus view is a read-only advisory verb too: it announces the
# payload fallback the same way, and — because it renders a whole corpus
# rather than one answer — it also announces which version is answering
# and whether that is the version the project is pinned to, in the page's
# own header as well as on the console.
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-planner/skills/browse/SKILL.md",
    "note: no vendored binary — using the payload's copy; /ok pins one to this project",
)
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-planner/scripts/corpus-view",
    "corpus view: running v%s, but this project is pinned to ",
)
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-planner/browser/src/App.svelte",
    "but this project is pinned to",
)

# Every materialized support script carries the stamp of the version that
# wrote it — including the ceremony helper, whose converge write is a
# substitution, not a copy.
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-planner/scripts/surface-corpus",
    "Materialized by ok-planner v{{OK_PLANNER_VERSION}}",
)
assert_present(
    "per-project-pinning",
    "plugins/ok/families/ok-planner/admin/converge",
    'sed "s/{{OK_PLANNER_VERSION}}/${SUITE_VERSION}/g" "$SURFACE_CORPUS" > "${OK_DIR}/scripts/surface-corpus"',
)

# @decision: closing-commit-baseline
# The stamp is written by both certify gates and read by the planning
# ceremony; deleting either half leaves the next ceremony blind.
for _gate in ("certify-work", "certify-all"):
    assert_present(
        "closing-commit-baseline",
        f"plugins/ok/families/ok-planner/skills/{_gate}/SKILL.md",
        "after the archive commit lands, stamp the archived sprint with the closing commit",
    )
assert_present(
    "closing-commit-baseline",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "The baseline is the `closed:` stamp of the newest file under `.ok-planner/history/sprints/` that has one.",
)

# @decision: single-source-transclusion
assert_present(
    "single-source-transclusion",
    "plugins/ok/families/ok-planner/skills/_shared/artifact-definitions.md",
    "Each `###` heading is a token name; the body under it is what gets inlined",
)
assert_present(
    "single-source-transclusion",
    "plugins/ok/families/ok-planner/skills/_shared/artifact-definitions.md",
    "it does NOT restate the definitions inline",
)

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
