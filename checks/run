#!/usr/bin/env bash
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
fail=0

for check in token-resolution hub-rows vendored-layer owned-paths oscillation; do
    if python3 "$here/$check"; then
        echo "ok: $check"
    else
        echo "FAIL: $check"
        fail=1
    fi
done

if [ $fail -eq 0 ]; then
    echo "---"
    echo "all checks passed"
fi
exit $fail
