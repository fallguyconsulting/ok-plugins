#!/usr/bin/env python3

# @decision: one-vendored-family
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SKILLS_DIR = os.path.join(ROOT, "plugins", "ok", "families", "ok-planner", "skills")

PHASES = {
    # @decision: owner-guided-surface-partition
    # @decision: documentation-walk-in-composed-audit
    # @decision: audit-audience-split
    "audit": ("Layout", "Surface", "Enumerate", "Determine", "Judge",
              "Verify", "Report", "Close-out", "Present"),
    # @story: document-a-release
    # @story: ship-release-documents
    # @decision: document-composes-audit
    # @decision: documentation-walk-in-composed-audit
    # @decision: documents-generated-per-type-and-placed
    "document": ("Layout", "Audit", "Walk", "Project", "Assess",
                 "Distill", "Generate", "Present", "Close-out"),
}

bad = []


def headings(text):
    """`## ` headings outside fenced blocks — a dispatched prompt's own
    headings are content, not the skill's phase structure."""
    out = []
    in_fence, mark = False, ""
    for line in text.split("\n"):
        f = re.match(r"^\s*(```|~~~)", line)
        if f:
            if not in_fence:
                in_fence, mark = True, f.group(1)
            elif f.group(1) == mark:
                in_fence = False
            continue
        if not in_fence and line.startswith("## "):
            out.append(line[3:].strip())
    return out


for verb, phases in sorted(PHASES.items()):
    rel = os.path.join("skills", verb, "SKILL.md")
    body = os.path.join(SKILLS_DIR, verb, "SKILL.md")
    if not os.path.exists(body):
        bad.append(f"ok-planner: missing the {verb} skill at {rel}")
        continue
    with open(body, encoding="utf-8") as f:
        text = f.read()
    if not re.search(r"^name:\s*%s\s*$" % re.escape(verb), text, re.M):
        bad.append(f"ok-planner/{rel}: frontmatter name does not declare `{verb}`")
    if "ONLY activated by explicit" not in text:
        bad.append(f"ok-planner/{rel}: description lacks the explicit-activation guard")
    present = headings(text)
    for phase in phases:
        if phase not in present:
            bad.append(f"ok-planner/{rel}: missing the phase heading '## {phase}' of the {verb} spine")
    found = sorted((present.index(p), p) for p in phases if p in present)
    order = [p for p in phases if p in present]
    if [p for _, p in found] != order:
        bad.append(f"ok-planner/{rel}: the phase headings run {', '.join(p for _, p in found)} — "
                   f"the {verb} spine runs {', '.join(order)}")

for b in bad:
    print(b)
sys.exit(1 if bad else 0)
