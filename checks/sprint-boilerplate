#!/usr/bin/env python3

# @decision: live-sprints-brought-current-on-true-up
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FAMILY = os.path.join(ROOT, "plugins", "ok", "families", "ok-planner")
CARRIED = os.path.join(FAMILY, "skills", "plan-sprint", "sprint-document.md")
HISTORY = os.path.join(FAMILY, "admin", "retired-boilerplate.json")
HISTORY_LABEL = "plugins/ok/families/ok-planner/admin/retired-boilerplate.json"
TEMPLATE_HOMES = (
    "plugins/ok-planner/skills/sprint/SKILL.md",
    "plugins/ok-planner/skills/plan-sprint/SKILL.md",
    "plugins/ok/families/ok-planner/skills/plan-sprint/SKILL.md",
    "plugins/ok/families/ok-planner/skills/_shared/sprint-document.md",
    "plugins/ok/families/ok-planner/skills/plan-sprint/sprint-document.md",
)
TEMPLATE_HEADING = "### {{SPRINT-DOCUMENT-TEMPLATE}}"
SECTIONS = ("## How to execute this sprint", "## Completion contract")


def git(*args):
    return subprocess.run(["git", "-C", ROOT] + list(args), capture_output=True, text=True)


def template_lines(text):
    lines = text.split("\n")
    start = lines.index(TEMPLATE_HEADING) + 1 if TEMPLATE_HEADING in lines else 0
    for n in range(start, len(lines)):
        if lines[n] == "```markdown":
            body = []
            for line in lines[n + 1:]:
                if line.startswith("```"):
                    break
                body.append(line)
            return body
    return []


def section_lines(text):
    lines = template_lines(text)
    found = []
    for heading in SECTIONS:
        if heading not in lines:
            continue
        for line in lines[lines.index(heading) + 1:]:
            if line.startswith("## "):
                break
            found.append(line)
    return found


def released_lines():
    tags = git("tag", "-l", "v*").stdout.split()
    if not tags:
        sys.exit("sprint-boilerplate: this clone holds no v* tag, so the released sprint templates cannot be read; "
                 "run git fetch --tags and run the check again")
    lines = set()
    for tag in tags:
        for home in TEMPLATE_HOMES:
            shown = git("show", "%s:%s" % (tag, home))
            if shown.returncode == 0:
                lines.update(section_lines(shown.stdout))
    return lines


def main():
    with open(CARRIED, encoding="utf-8") as f:
        carried = set(section_lines(f.read()))
    if not carried:
        sys.exit("sprint-boilerplate: the carried template at %s holds neither section" % os.path.relpath(CARRIED, ROOT))
    expected = sorted(line for line in released_lines() if line.strip() and line not in carried)
    with open(HISTORY, encoding="utf-8") as f:
        recorded = json.load(f)
    bad = []
    if not isinstance(recorded, list) or not all(isinstance(line, str) for line in recorded):
        bad.append("%s: not a JSON array of strings" % HISTORY_LABEL)
        recorded = []
    for line in sorted(set(expected) - set(recorded)):
        bad.append("%s: missing a line a released template laid out and the carried template no longer holds: %r"
                   % (HISTORY_LABEL, line))
    for line in sorted(set(recorded) & carried):
        bad.append("%s: holds a line the carried template holds: %r" % (HISTORY_LABEL, line))
    for line in sorted(set(recorded) - set(expected) - carried):
        bad.append("%s: holds a line no released template laid out: %r" % (HISTORY_LABEL, line))
    if not bad and recorded != expected:
        bad.append("%s: not sorted, or holds a line twice" % HISTORY_LABEL)
    for line in bad:
        print(line)
    sys.exit(1 if bad else 0)


main()
