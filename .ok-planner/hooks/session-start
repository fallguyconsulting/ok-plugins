#!/usr/bin/env bash
# Materialized by ok-planner v19.1.0 — suite-owned; overwritten on converge; do not hand-edit.
set -euo pipefail

OK_DIR="$(cd "$(dirname "$0")/.." && pwd)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context="ok-planner v19.1.0 is materialized in this project. Its verbs are the vendored skills under .claude/skills/: each user-facing verb activates only on its explicit slash command (some also naming one non-human caller, such as whoever executes a sprint's completion contract), and the plumbing verbs the suite's own machinery drives say so in their own descriptions."

if [ -f "${OK_DIR}/design/concepts.md" ]; then
    concepts_toc=$(cat "${OK_DIR}/design/concepts.md")
    escaped_concepts=$(escape_for_json "$concepts_toc")
    framing="The following is .ok-planner/design/concepts.md from this project — the TOC of project-narrowed nouns. Before defining or invoking any term that appears here, open .ok-planner/design/concepts/<slug>.md and read it; do not paraphrase from prior context."
    escaped_framing=$(escape_for_json "$framing")
    context="${context}\n\n---\n\n${escaped_framing}\n\n${escaped_concepts}"
fi

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
