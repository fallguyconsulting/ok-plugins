#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# Materialized by ok-planner v25.2.0 — suite-owned; overwritten on converge; do not hand-edit.

import glob
import os
import re
import sys

VERSION = "25.2.0"

USAGE = """catalog-toc — regenerate every catalog table of contents in the
estate from the collection it indexes: the design catalogs (concepts,
stories, decisions) and the coding-standard catalogs (subjects,
practices).

  catalog-toc [<project-root>]        rewrite every TOC
  catalog-toc --check [<root>]        exit 2 if any is stale, writing nothing

A TOC sits beside its catalog and is generated, never hand-written: one
alphabetical line per artifact, the slug then its leading line, so a
reader finds the artifact worth opening without opening all of them.
The leading line is the first sentence of a concept's What it is, the
first paragraph of a story's Story, the first sentence of a decision's
Choice, and the first paragraph of a subject or practice; an artifact
without that section gives its first paragraph. Run it whenever a
corpus delta touches a collection: the sprint `/plan-sprint` writes
makes the run part of applying the delta.

Exit 0: written (or current, under --check). Exit 2: stale, under
--check. Exit 1: usage or read error."""

DESIGN_TAGS = "`@concept:` / `@story:` / `@decision:`"
STANDARD_TAGS = "`@subject:` / `@practice:`"
CATALOGS = (
    ("design/concepts", "Concept catalog", "Concepts", "concept", DESIGN_TAGS, "What it is", True),
    ("design/stories", "Story catalog", "Stories", "story", DESIGN_TAGS, "Story", False),
    ("design/decisions", "Decision catalog", "Decisions", "decision", DESIGN_TAGS, "Choice", True),
    ("subjects", "Subject catalog", "Subjects", "subject", STANDARD_TAGS, None, False),
    ("practices", "Practice catalog", "Practices", "practice", STANDARD_TAGS, None, False),
)
SUMMARY_CHARS = 117
ESTATE = ".ok-planner"
SENTENCE_END = re.compile(r"(.*?[.!?])\s")


def frontmatter_lines(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return []
    out = []
    for line in lines[1:]:
        if line.strip() == "---":
            return out
        out.append(line)
    return out


def body_after_frontmatter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return text
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return "\n".join(lines[i + 1:])
    return ""


def paragraph(lines):
    out, started = [], False
    for line in lines:
        if line.startswith("#"):
            continue
        if not line.strip():
            if started:
                break
            continue
        started = True
        out.append(line.strip())
    return " ".join(" ".join(out).split())


def first_paragraph(text):
    return paragraph(body_after_frontmatter(text).split("\n"))


def section_paragraph(text, heading):
    lines = body_after_frontmatter(text).split("\n")
    marker = "## " + heading
    stripped = [line.strip() for line in lines]
    if marker not in stripped:
        return ""
    start = stripped.index(marker) + 1
    end = next((i for i in range(start, len(lines)) if lines[i].startswith("## ")), len(lines))
    return paragraph(lines[start:end])


def first_sentence(text):
    match = SENTENCE_END.match(text)
    return match.group(1) if match else text


def subject_of(text):
    for line in frontmatter_lines(text):
        if line.startswith("subject:"):
            return line[len("subject:"):].strip()
    return ""


def aliases_of(text):
    names, listing = [], False
    for line in frontmatter_lines(text):
        if line.startswith("aliases:"):
            inline = line[len("aliases:"):].strip().strip("[]")
            if inline:
                return [name.strip().strip("'\"") for name in inline.split(",") if name.strip()]
            listing = True
            continue
        item = line.strip()
        if listing and item.startswith("- "):
            names.append(item[2:].strip().strip("'\""))
            continue
        listing = False
    return names


def summary_of(text, section, sentence):
    body = section_paragraph(text, section) if section else ""
    if not body:
        body = first_paragraph(text)
    if sentence:
        body = first_sentence(body)
    return body[:SUMMARY_CHARS] + "..." if len(body) > SUMMARY_CHARS + 3 else body


def label_of(text, kind):
    if kind == "concept":
        aliases = aliases_of(text)
        return " (aliases: %s)" % ", ".join(aliases) if aliases else ""
    if kind == "practice":
        named = subject_of(text)
        return " (subject: `%s`)" % named if named else ""
    return ""


def render(root, directory, title, heading, kind, tags, section, sentence):
    rows = []
    collection = os.path.join(root, ESTATE, directory)
    for path in sorted(glob.glob(os.path.join(collection, "*.md")),
                       key=lambda p: os.path.basename(p)[:-3]):
        slug = os.path.basename(path)[:-3]
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
        rows.append("- `%s`%s — %s" % (slug, label_of(text, kind), summary_of(text, section, sentence)))
    lines = [
        "# %s (auto-generated)" % title,
        "",
        "Read first. Then either grep for the matching annotation",
        "(%s) in the code under review, or read" % tags,
        "`%s/<slug>.md` for the full body. Generated by" % os.path.basename(directory),
        "`%s/bin/catalog-toc` and regenerated whenever a corpus delta" % ESTATE,
        "touches this collection. Do not edit by hand — changes will be",
        "overwritten.",
        "",
        "## %s" % heading,
        "",
    ]
    if not rows:
        lines.append("(none yet — this project has authored no %s)" % heading.lower())
    else:
        lines.extend(rows)
    lines.append("")
    return "\n".join(lines)


def main(argv):
    check = False
    args = list(argv)
    if args and args[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE + "\n")
        return 0
    if args and args[0] == "version":
        print(VERSION)
        return 0
    if args and args[0] == "--check":
        check = True
        args = args[1:]
    root = os.path.abspath(args[0] if args else ".")
    estate = os.path.join(root, ESTATE)
    if not os.path.isdir(estate):
        sys.stderr.write("catalog-toc: no ok-planner estate at %s\n" % estate)
        return 1

    stale = []
    for catalog in CATALOGS:
        directory = catalog[0]
        if not os.path.isdir(os.path.join(estate, directory)):
            continue
        body = render(root, *catalog)
        target = os.path.join(estate, directory + ".md")
        current = None
        if os.path.isfile(target):
            with open(target, encoding="utf-8", errors="replace") as f:
                current = f.read()
        if current == body:
            continue
        if check:
            stale.append(os.path.relpath(target, root))
            continue
        with open(target, "w", encoding="utf-8") as f:
            f.write(body)
        print("regenerated: %s" % os.path.relpath(target, root))

    if check and stale:
        for path in stale:
            print("stale: %s does not match its collection" % path)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as err:
        sys.stderr.write("catalog-toc: internal error: %s\n" % err)
        sys.exit(1)
