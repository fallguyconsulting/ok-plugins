import hashlib
import json
import os
import re
import subprocess
import sys

VERSION = "15.2.0"

USAGE = """audit-check — the shape-and-invariant validator for the suite's
implementation-audit corpora.

  audit-check [<project-root>]

It walks every estate dot-directory at the project root, pairs each
`<estate>/audits/<bucket>/` with the live collection it mirrors
(`<estate>/design/<bucket>/`, else `<estate>/<bucket>/`), and checks
seven things and nothing else:

  coverage        every live artifact has an audit file, and every
                  audit file has a live artifact. An estate carrying a
                  live collection but no audits/ at all reports every
                  artifact missing rather than dropping out of scope.
  catalogs        a catalog table of contents beside a collection lists
                  exactly that collection's live slugs — the audit is
                  the consistency backstop, never the generator.
  shape           the frontmatter carries audit / artifact /
                  determination / compliance / commit / audited, the
                  slug matches the filename, the kind matches the
                  bucket, and each axis uses its own vocabulary.
  brevity         the body is one paragraph before its sections, and
                  every section is one this format defines.
  accountability  a determination of `unsupported` or `unclear`
                  carries an `issue:` slug resolving to a real issue
                  file; `supported` carries none.
  agreement       a `noncompliant` audit says which rule it breaks;
                  a coverage-shaped audit's `unaccounted:` count and
                  its determination agree, and every unaccounted
                  member is named.
  ruling          where `<estate>/audits/surface/ruling.json` exists:
                  both anchors present (the stamped commit and the
                  guidance blob hash), the partition total against the
                  cached extraction beside it (every enumerated member
                  ruled exactly once, nothing ruled that was not
                  enumerated), and the recorded guidance hash agreeing
                  with the guidance file as of the stamped commit.

It never asks whether a determination is correct — that is the audit
run's auditors and judge, who read the code — and it never computes
staleness: an audit is a statement about the commit its frontmatter
names, so "does it still hold?" is a git question.

Canonical rules: {{AUDIT-DEFINITION}} and {{AUDIT-FILE-FORMAT}} in the
shared artifact definitions.

Exit 0: clean. Exit 2: findings, one per line on stdout as
`path:line: [check] message`. Exit 1: internal error."""

DETERMINATIONS = ("supported", "unsupported", "unclear")
NEEDS_ISSUE = ("unsupported", "unclear")
COMPLIANCE = ("compliant", "noncompliant")
REQUIRED = ("audit", "artifact", "determination", "compliance", "commit",
            "audited")
REFERRAL_FIELDS = ("referral", "established", "discipline")
SECTIONS = ("Compliance", "Unaccounted", "Remediation", "Referrals")


def fail(path, line, check, message, findings):
    findings.append("%s:%d: [%s] %s" % (path, line, check, message))


def kind_of(bucket):
    if bucket.endswith("ies"):
        return bucket[:-3] + "y"
    return bucket[:-1] if bucket.endswith("s") else bucket


def parse_frontmatter(lines):
    if not lines or lines[0].strip() != "---":
        return None, 0
    fields = {}
    for i, raw in enumerate(lines[1:], start=1):
        if raw.strip() == "---":
            return fields, i + 1
        m = re.match(r"^([a-z-]+):\s*(.*?)\s*$", raw)
        if m:
            fields[m.group(1)] = m.group(2)
    return None, 0


def intakes(root):
    """Every estate at the root, audits-bearing or not.

    Which estate holds the intake is a family's business, not this
    checker's — and an estate can hold one while carrying no audits of its
    own, so the search set here is deliberately wider than the set of
    collections the run walks.
    """
    return sorted(name for name in os.listdir(root)
                  if name.startswith(".ok-")
                  and os.path.isdir(os.path.join(root, name)))


def issue_exists(root, slug):
    for estate in intakes(root):
        for d in ("issues", os.path.join("history", "issues")):
            if os.path.isfile(os.path.join(root, estate, d, slug + ".md")):
                return True
    return False


def check_referrals(rel, lines, start, findings):
    seen = set()
    for i, raw in enumerate(lines[start:], start=start + 1):
        if not raw.strip():
            continue
        if raw.startswith("## "):
            break
        m = re.match(r"^(?:-\s+|\s+)([a-z]+):\s*\S", raw)
        if not m:
            fail(rel, i, "audit-malformed",
                 "referral line does not match the fixed grammar", findings)
            continue
        field = m.group(1)
        if field not in REFERRAL_FIELDS:
            fail(rel, i, "audit-malformed",
                 "referral field %r is not one of %s"
                 % (field, ", ".join(REFERRAL_FIELDS)), findings)
            continue
        if field == "referral":
            missing = [f for f in REFERRAL_FIELDS[1:] if f not in seen]
            if seen and missing:
                fail(rel, i, "audit-malformed",
                     "the preceding referral lacks %s" % ", ".join(missing),
                     findings)
            seen = {"referral"}
        else:
            seen.add(field)
    missing = [f for f in REFERRAL_FIELDS[1:] if f not in seen]
    if seen and missing:
        fail(rel, start, "audit-malformed",
             "the last referral lacks %s" % ", ".join(missing), findings)


def split_sections(lines, body_start):
    """The paragraph line numbers, and {section name: (line, [lines])}."""
    body, sections, current = [], {}, None
    for i, raw in enumerate(lines[body_start:], start=body_start + 1):
        if raw.startswith("## "):
            current = raw[3:].strip()
            sections[current] = (i, [])
            continue
        if current is not None:
            if raw.strip():
                sections[current][1].append(i)
            continue
        if raw.startswith("# ") or not raw.strip():
            continue
        body.append(i)
    return body, sections


def check_body(rel, lines, body_start, findings):
    body, sections = split_sections(lines, body_start)
    for name, (line, _) in sections.items():
        if name not in SECTIONS:
            fail(rel, line, "audit-malformed",
                 "unexpected section %r — an audit is one paragraph plus "
                 "any of %s" % (name, ", ".join(SECTIONS)), findings)
    if not body:
        fail(rel, max(body_start, 1), "audit-malformed",
             "no determination paragraph", findings)
        return sections
    for prev, nxt in zip(body, body[1:]):
        if nxt != prev + 1:
            fail(rel, nxt, "audit-verbose",
                 "a second paragraph — an audit states its verdict once, in "
                 "one paragraph", findings)
            break
    if "Referrals" in sections:
        check_referrals(rel, lines, sections["Referrals"][0], findings)
    return sections


def check_counts(rel, fields, sections, determination, findings):
    """The coverage shape: both counts or neither, and both agreeing.

    The counts settle supported against unsupported and nothing else. An
    `unclear` audit is the honest record of a population that could not be
    enumerated at all, and it reports zero of zero.
    """
    raw_checked = fields.get("checked")
    raw_unaccounted = fields.get("unaccounted")
    if raw_checked is None and raw_unaccounted is None:
        if "Unaccounted" in sections:
            fail(rel, sections["Unaccounted"][0], "audit-malformed",
                 "an Unaccounted section without checked:/unaccounted: "
                 "counts — the coverage shape is both or neither", findings)
        if "Remediation" in sections:
            fail(rel, sections["Remediation"][0], "audit-malformed",
                 "a Remediation section without checked:/unaccounted: "
                 "counts — remediation lists belong to coverage-shaped "
                 "audits", findings)
        return
    if raw_checked is None or raw_unaccounted is None:
        fail(rel, 1, "audit-malformed",
             "a coverage-shaped audit carries both checked: and "
             "unaccounted:", findings)
        return
    try:
        checked, unaccounted = int(raw_checked), int(raw_unaccounted)
    except ValueError:
        fail(rel, 1, "audit-malformed",
             "checked: and unaccounted: are counts", findings)
        return
    if unaccounted > checked:
        fail(rel, 1, "audit-malformed",
             "unaccounted: %d exceeds the population checked: %d"
             % (unaccounted, checked), findings)
    if unaccounted == 0 and determination == "unsupported":
        fail(rel, 1, "audit-disagrees",
             "unaccounted: 0 beside determination 'unsupported' — nothing is "
             "unaccounted for, so the population is supported", findings)
    if unaccounted > 0:
        if determination == "supported":
            fail(rel, 1, "audit-disagrees",
                 "determination supported beside unaccounted: %d — a member "
                 "nothing accounts for is a gap" % unaccounted, findings)
        if "Unaccounted" not in sections or not sections["Unaccounted"][1]:
            fail(rel, 1, "audit-malformed",
                 "unaccounted: %d without an Unaccounted section naming "
                 "them — the members are the deliverable" % unaccounted,
                 findings)


def check_audit(root, rel, bucket, live, findings):
    with open(os.path.join(root, rel), encoding="utf-8",
              errors="replace") as f:
        lines = f.read().splitlines()
    fields, body_start = parse_frontmatter(lines)
    if fields is None:
        fail(rel, 1, "audit-malformed", "no closed YAML frontmatter block",
             findings)
        return

    slug = os.path.basename(rel)[:-3]
    expected_ref = "%s:%s" % (kind_of(bucket), slug)

    for key in REQUIRED:
        if not fields.get(key):
            fail(rel, 1, "audit-malformed", "frontmatter lacks %s:" % key,
                 findings)
    if fields.get("audit") not in (None, slug):
        fail(rel, 1, "audit-malformed",
             "audit: %r does not match the filename slug %r"
             % (fields["audit"], slug), findings)
    if fields.get("artifact") not in (None, expected_ref):
        fail(rel, 1, "audit-malformed",
             "artifact: %r must be %r in %s/"
             % (fields["artifact"], expected_ref, bucket), findings)

    determination = fields.get("determination")
    if determination is not None and determination not in DETERMINATIONS:
        fail(rel, 1, "audit-malformed",
             "determination: %r is not one of %s"
             % (determination, ", ".join(DETERMINATIONS)), findings)

    compliance = fields.get("compliance")
    if compliance is not None and compliance not in COMPLIANCE:
        fail(rel, 1, "audit-malformed",
             "compliance: %r is not one of %s"
             % (compliance, ", ".join(COMPLIANCE)), findings)

    issue = fields.get("issue")
    if determination in NEEDS_ISSUE:
        if not issue:
            fail(rel, 1, "audit-unlinked",
                 "determination %r stands without an issue: slug — a gap "
                 "nobody is holding" % determination, findings)
        elif not issue_exists(root, issue):
            fail(rel, 1, "audit-unlinked",
                 "issue: %r resolves to no file under issues/ or "
                 "history/issues/" % issue, findings)
    elif determination == "supported" and issue:
        fail(rel, 1, "audit-malformed",
             "a supported determination carries issue: %r" % issue, findings)

    if expected_ref not in live:
        fail(rel, 1, "audit-orphaned",
             "no live artifact for %s" % expected_ref, findings)

    sections = check_body(rel, lines, body_start, findings)

    if compliance == "noncompliant" and (
            "Compliance" not in sections or not sections["Compliance"][1]):
        fail(rel, 1, "audit-malformed",
             "compliance: noncompliant without a Compliance section naming "
             "the rule and the compliant text", findings)
    if compliance == "compliant" and "Compliance" in sections:
        fail(rel, sections["Compliance"][0], "audit-malformed",
             "a compliant audit carries a Compliance section", findings)

    check_counts(rel, fields, sections, determination, findings)


def estates(root):
    """Estate dot-directories carrying an audits/ collection or a design/ one.

    An estate with a live corpus and no audits/ at all is exactly the state
    coverage exists to report, so it has to stay in scope — gating on
    audits/ alone made an entirely unaudited corpus invisible.
    """
    for name in sorted(os.listdir(root)):
        if not name.startswith(".ok-"):
            continue
        if os.path.isdir(os.path.join(root, name, "audits")) or \
                os.path.isdir(os.path.join(root, name, "design")):
            yield name


def buckets_of(root, estate):
    """The collections to check, audits-driven where there are any.

    Keeping the bucket set audits-driven is what lets a family audit some of
    its collections and not others by design; falling back to the live side
    is only for an estate with no audits/ at all, where every artifact is
    uncovered and saying so is the point.

    Underscore- and dot-prefixed directories are scaffolding, not
    collections: a bootstrap's raw notes sit beside the catalogs, and that
    is exactly the state the fallback fires in — where naming every scratch
    file would bury the coverage findings it exists to surface.
    """
    audits_root = os.path.join(root, estate, "audits")
    if os.path.isdir(audits_root):
        return sorted(b for b in os.listdir(audits_root)
                      if b != "surface"
                      and os.path.isdir(os.path.join(audits_root, b)))
    design_root = os.path.join(root, estate, "design")
    if os.path.isdir(design_root):
        return sorted(b for b in os.listdir(design_root)
                      if not b.startswith(("_", "."))
                      and os.path.isdir(os.path.join(design_root, b)))
    return []


def live_dir(root, estate, bucket):
    for candidate in (os.path.join(estate, "design", bucket),
                      os.path.join(estate, bucket)):
        if os.path.isdir(os.path.join(root, candidate)):
            return candidate
    return None


def blob_hash(path):
    """The file's content hashed the way git hashes a blob."""
    with open(path, "rb") as fh:
        content = fh.read()
    return hashlib.sha1(b"blob %d\0" % len(content) + content).hexdigest()


def guidance_hash_at(root, estate, commit):
    """The guidance blob's hash as of the stamped commit.

    Resolved through git where the commit resolves; the working tree's
    blob is the honest fallback for an unstamped or repo-less state.
    Returns None when there is no guidance file to compare at all.
    """
    rel = "/".join((estate, "surface", "guidance.md"))
    if commit:
        try:
            prefix = subprocess.run(
                ["git", "-C", root, "rev-parse", "--show-prefix"],
                capture_output=True, text=True)
            if prefix.returncode == 0:
                spec = "%s:%s%s" % (commit, prefix.stdout.strip(), rel)
                got = subprocess.run(["git", "-C", root, "rev-parse", spec],
                                     capture_output=True, text=True)
                if got.returncode == 0:
                    return got.stdout.strip()
        except OSError:
            pass
    path = os.path.join(root, estate, "surface", "guidance.md")
    return blob_hash(path) if os.path.isfile(path) else None


def load_record(root, rel, findings):
    try:
        with open(os.path.join(root, rel), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError) as err:
        fail(rel, 1, "ruling-malformed", "unreadable JSON: %s" % err,
             findings)
        return None


def check_ruling(root, estate, findings):
    """The surface ruling, where one exists.

    Both anchors present, the partition total against the cached
    extraction beside it, and the recorded guidance hash agreeing with
    the guidance as of the stamped commit. Whether a classification is
    *right* is the audit run's judgment against the guidance prose;
    this checks only that the recorded partition covers what was
    enumerated and nothing else.
    """
    rel = os.path.join(estate, "audits", "surface", "ruling.json")
    if not os.path.isfile(os.path.join(root, rel)):
        return
    ruling = load_record(root, rel, findings)
    if ruling is None:
        return

    commit = ruling.get("commit") or ""
    if not commit:
        fail(rel, 1, "ruling-malformed",
             "no commit anchor — a ruling is a statement about a named "
             "commit", findings)
    recorded = ruling.get("guidanceHash") or ""
    if not recorded:
        fail(rel, 1, "ruling-malformed",
             "no guidanceHash anchor — ratification is detected by "
             "comparing anchors", findings)

    ruled = {}
    for entry in ruling.get("kinds", []):
        kind = entry.get("kind", "")
        sides = {}
        for member in entry.get("public", []):
            sides[member] = "public"
        for member in entry.get("private", []):
            if member in sides:
                fail(rel, 1, "ruling-partition",
                     "%s/%s is ruled both public and private"
                     % (kind, member), findings)
            sides[member] = "private"
        ruled[kind] = sides

    ex_rel = os.path.join(estate, "audits", "surface", "extraction.json")
    if not os.path.isfile(os.path.join(root, ex_rel)):
        fail(rel, 1, "ruling-malformed",
             "no cached extraction beside the ruling — the partition is "
             "checkable only against what was enumerated", findings)
        return
    extraction = load_record(root, ex_rel, findings)
    if extraction is None:
        return
    extracted = {e.get("kind", ""): set(e.get("members", []))
                 for e in extraction.get("kinds", [])}

    for kind in sorted(extracted):
        for member in sorted(extracted[kind]):
            if member not in ruled.get(kind, {}):
                fail(ex_rel, 1, "ruling-partition",
                     "%s/%s enumerated but not ruled — the partition is "
                     "total, never private by omission" % (kind, member),
                     findings)
    for kind in sorted(ruled):
        for member in sorted(ruled[kind]):
            if member not in extracted.get(kind, set()):
                fail(rel, 1, "ruling-partition",
                     "%s/%s ruled but absent from the cached extraction"
                     % (kind, member), findings)

    if recorded:
        actual = guidance_hash_at(root, estate, commit)
        if actual is None:
            fail(rel, 1, "ruling-guidance",
                 "no guidance file to compare the recorded hash against",
                 findings)
        elif actual != recorded:
            fail(rel, 1, "ruling-guidance",
                 "guidanceHash %s disagrees with the guidance as of the "
                 "stamped commit (%s) — an unratified change"
                 % (recorded[:12], actual[:12]), findings)


TOC_BULLET = re.compile(r"^- `([a-z0-9][a-z0-9-]*)`")


def check_catalog(root, source, live, findings):
    """A TOC beside a collection lists exactly that collection's live slugs."""
    rel = source + ".md"
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        if live:
            fail(rel, 1, "catalog-missing",
                 "no table of contents beside a collection of %d live "
                 "artifact(s) — a catalog's TOC is how a reader finds what "
                 "exists" % len(live), findings)
        return
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.read().split("\n")
    listed = {}
    for i, line in enumerate(lines, start=1):
        m = TOC_BULLET.match(line)
        if m:
            listed.setdefault(m.group(1), i)
    slugs = {ref.split(":", 1)[1] for ref in live}
    for slug, line in sorted(listed.items()):
        if slug not in slugs:
            fail(rel, line, "catalog-stale",
                 "TOC lists %r, which is not a live artifact in %s/"
                 % (slug, source), findings)
    for slug in sorted(slugs - set(listed)):
        fail(rel, 1, "catalog-incomplete",
             "no TOC entry for %r — a delta that touches a catalog "
             "regenerates its TOC in the same act" % slug, findings)


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE + "\n")
        return 0
    if argv and argv[0] == "version":
        print(VERSION)
        return 0
    root = os.path.abspath(argv[0] if argv else ".")

    found = list(estates(root))
    if not found:
        print("audit-check: no estate carries a corpus or an audits/ "
              "collection under %s" % root, file=sys.stderr)
        return 1

    findings = []
    for estate in found:
        check_ruling(root, estate, findings)
        audits_root = os.path.join(root, estate, "audits")
        for bucket in buckets_of(root, estate):
            bucket_dir = os.path.join(audits_root, bucket)
            kind = kind_of(bucket)
            source = live_dir(root, estate, bucket)
            live = set()
            if source is not None:
                for fn in sorted(os.listdir(os.path.join(root, source))):
                    if fn.endswith(".md"):
                        live.add("%s:%s" % (kind, fn[:-3]))
                check_catalog(root, source, live, findings)
            audited = set()
            for fn in (sorted(os.listdir(bucket_dir))
                       if os.path.isdir(bucket_dir) else []):
                if not fn.endswith(".md"):
                    continue
                audited.add("%s:%s" % (kind, fn[:-3]))
                check_audit(root, os.path.join(estate, "audits", bucket, fn),
                            bucket, live, findings)
            for ref in sorted(live - audited):
                rel = os.path.join(estate, "audits", bucket,
                                   ref.split(":", 1)[1] + ".md")
                fail(rel, 1, "audit-missing",
                     "no audit for %s — the periodic audit run writes one "
                     "per live artifact" % ref, findings)

    for line in sorted(findings):
        print(line)
    return 2 if findings else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as err:
        print("audit-check: internal error: %s" % err, file=sys.stderr)
        sys.exit(1)
