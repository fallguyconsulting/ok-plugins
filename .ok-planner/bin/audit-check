#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
#
# audit-check — the shape-and-invariant validator for an ok-planner
# implementation-audit corpus (.ok-planner/audits/). Audits are
# determinations written by the periodic /verify-corpus run; this
# binary never judges content and never computes staleness.
#
#   audit-check [<project-root>]
#
# It checks four things and nothing else:
#
#   coverage        every live story and decision has an audit file,
#                   and every audit file has a live artifact.
#   shape           the frontmatter carries audit / artifact /
#                   determination / commit / audited, the slug matches
#                   the filename, the kind matches the directory, and
#                   the determination is one of the three words.
#   brevity         the body is one paragraph. An audit that grew into
#                   a report stopped being readable at a glance, which
#                   is the only reason the one-paragraph rule exists.
#   accountability  a determination of `unsupported` or `unclear`
#                   carries an `issue:` slug resolving to a real issue
#                   file; `supported` carries none.
#
# What it deliberately does NOT do. It does not ask whether a
# determination is correct — that is the audit run's auditors and
# judge, who read the code. It does not ask whether an audit is
# current: an audit is a statement about the commit named in its
# frontmatter, so "does it still hold?" is a git question about how
# far HEAD has moved, not an arithmetic one. There are no citations to
# resolve, no hashes to compare, and no re-audit set to compute.
#
# Canonical rules: skills/_shared/artifact-definitions.md,
# {{AUDIT-DEFINITION}} and {{AUDIT-FILE-FORMAT}}.
#
# Exit 0: clean. Exit 2: findings (one per line on stdout,
# `path:line: [check] message`). Exit 1: internal error.

import os
import re
import sys

VERSION = "14.4.0"

DETERMINATIONS = ("supported", "unsupported", "unclear")
NEEDS_ISSUE = ("unsupported", "unclear")
# bucket directory -> the artifact kind its audits are about
KINDS = {"stories": "story", "decisions": "decision"}
REQUIRED = ("audit", "artifact", "determination", "commit", "audited")
REFERRAL_FIELDS = ("referral", "established", "discipline")


def fail(path, line, check, message, findings):
    findings.append("%s:%d: [%s] %s" % (path, line, check, message))


def parse_frontmatter(lines):
    """The leading --- block as {key: value}, plus the body's first index."""
    if not lines or lines[0].strip() != "---":
        return None, 0
    fields = {}
    for i, raw in enumerate(lines[1:], start=1):
        if raw.strip() == "---":
            return fields, i + 1
        m = re.match(r"^([a-z-]+):\s*(.*?)\s*$", raw)
        if m:
            fields[m.group(1)] = m.group(2)
    return None, 0


def issue_exists(root, slug):
    for d in ("issues", os.path.join("history", "issues")):
        if os.path.isfile(os.path.join(root, ".ok-planner", d, slug + ".md")):
            return True
    return False


def check_referrals(rel, lines, start, findings):
    """The fixed three-field grammar, one group per referral."""
    seen = set()
    for i, raw in enumerate(lines[start:], start=start + 1):
        if not raw.strip():
            continue
        if raw.startswith("## "):
            break
        m = re.match(r"^(?:-\s+|\s+)([a-z]+):\s*\S", raw)
        if not m:
            fail(rel, i, "audit-malformed",
                 "referral line does not match the fixed grammar", findings)
            continue
        field = m.group(1)
        if field not in REFERRAL_FIELDS:
            fail(rel, i, "audit-malformed",
                 "referral field %r is not one of %s"
                 % (field, ", ".join(REFERRAL_FIELDS)), findings)
            continue
        if field == "referral":
            missing = [f for f in REFERRAL_FIELDS[1:] if f not in seen]
            if seen and missing:
                fail(rel, i, "audit-malformed",
                     "the preceding referral lacks %s" % ", ".join(missing),
                     findings)
            seen = {"referral"}
        else:
            seen.add(field)
    missing = [f for f in REFERRAL_FIELDS[1:] if f not in seen]
    if seen and missing:
        fail(rel, start, "audit-malformed",
             "the last referral lacks %s" % ", ".join(missing), findings)


def check_body(rel, lines, body_start, findings):
    """One paragraph between the heading and any Referrals section."""
    body, referrals_at = [], None
    for i, raw in enumerate(lines[body_start:], start=body_start + 1):
        if raw.startswith("## Referrals"):
            referrals_at = i
            break
        if raw.startswith("# ") or not raw.strip():
            continue
        if raw.startswith("## "):
            fail(rel, i, "audit-malformed",
                 "unexpected section %r — an audit is one paragraph plus an "
                 "optional Referrals section" % raw.strip(), findings)
            return
        body.append(i)
    if not body:
        fail(rel, max(body_start, 1), "audit-malformed",
             "no determination paragraph", findings)
        return
    # Contiguity is the paragraph test: a gap means a second block.
    for prev, nxt in zip(body, body[1:]):
        if nxt != prev + 1:
            fail(rel, nxt, "audit-verbose",
                 "a second paragraph — an audit states its verdict once, in "
                 "one paragraph", findings)
            return
    if referrals_at is not None:
        check_referrals(rel, lines, referrals_at, findings)


def check_audit(root, rel, live, findings):
    with open(os.path.join(root, rel), errors="replace") as f:
        lines = f.read().splitlines()
    fields, body_start = parse_frontmatter(lines)
    if fields is None:
        fail(rel, 1, "audit-malformed", "no closed YAML frontmatter block",
             findings)
        return

    slug = os.path.basename(rel)[:-3]
    bucket = os.path.basename(os.path.dirname(rel))
    expected_ref = "%s:%s" % (KINDS[bucket], slug)

    for key in REQUIRED:
        if not fields.get(key):
            fail(rel, 1, "audit-malformed", "frontmatter lacks %s:" % key,
                 findings)
    if fields.get("audit") not in (None, slug):
        fail(rel, 1, "audit-malformed",
             "audit: %r does not match the filename slug %r"
             % (fields["audit"], slug), findings)
    if fields.get("artifact") not in (None, expected_ref):
        fail(rel, 1, "audit-malformed",
             "artifact: %r must be %r in %s/"
             % (fields["artifact"], expected_ref, bucket), findings)

    determination = fields.get("determination")
    if determination is not None and determination not in DETERMINATIONS:
        fail(rel, 1, "audit-malformed",
             "determination: %r is not one of %s"
             % (determination, ", ".join(DETERMINATIONS)), findings)

    issue = fields.get("issue")
    if determination in NEEDS_ISSUE:
        if not issue:
            fail(rel, 1, "audit-unlinked",
                 "determination %r stands without an issue: slug — a gap "
                 "nobody is holding" % determination, findings)
        elif not issue_exists(root, issue):
            fail(rel, 1, "audit-unlinked",
                 "issue: %r resolves to no file under issues/ or "
                 "history/issues/" % issue, findings)
    elif determination == "supported" and issue:
        fail(rel, 1, "audit-malformed",
             "a supported determination carries issue: %r" % issue, findings)

    if expected_ref not in live:
        fail(rel, 1, "audit-orphaned",
             "no live artifact at design/%s/%s.md" % (bucket, slug), findings)

    check_body(rel, lines, body_start, findings)


def main(argv):
    root = os.path.abspath(argv[0] if argv else ".")
    design = os.path.join(root, ".ok-planner", "design")
    if not os.path.isdir(design):
        print("audit-check: no design corpus at %s" % design, file=sys.stderr)
        return 1

    findings = []
    live, audited = set(), set()
    for bucket, kind in KINDS.items():
        d = os.path.join(design, bucket)
        for fn in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if fn.endswith(".md"):
                live.add("%s:%s" % (kind, fn[:-3]))

    for bucket, kind in KINDS.items():
        d = os.path.join(root, ".ok-planner", "audits", bucket)
        for fn in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if not fn.endswith(".md"):
                continue
            audited.add("%s:%s" % (kind, fn[:-3]))
            check_audit(root, os.path.join(".ok-planner", "audits", bucket, fn),
                        live, findings)

    buckets = {kind: bucket for bucket, kind in KINDS.items()}
    for ref in sorted(live - audited):
        kind, slug = ref.split(":", 1)
        rel = os.path.join(".ok-planner", "audits", buckets[kind], slug + ".md")
        fail(rel, 1, "audit-missing",
             "no audit for %s — the periodic audit run writes one per live "
             "artifact" % ref, findings)

    for line in findings:
        print(line)
    return 2 if findings else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as err:
        print("audit-check: internal error: %s" % err, file=sys.stderr)
        sys.exit(1)
