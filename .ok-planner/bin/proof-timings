#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
#
# proof-timings — the durable cost record for an ok-planner proof run.
# `/prove` executes each story's registered proof through `run`, which
# times the invocation, folds in whatever per-story and per-case timings
# the harness emitted, and merges the result into
# .ok-planner/proof-timings.json. A later session reads that record with
# `show` instead of paying for another full run — which is what makes
# the measure-first discipline affordable in practice.
#
#   proof-timings run <story>[,<story>...] <proof-path> -- <cmd> [args...]
#   proof-timings record <story> <proof-path> <verdict> <seconds>
#   proof-timings show [--slug <slug>] [--slowest <n>] [--json]
#   proof-timings path
#
# `run` exports PROOF_TIMINGS_OUT to the child. A cooperating harness
# appends one tab-separated line per measured span to that path:
#
#   <seconds>\t<verdict>\t<story-slug>\t<case-name>
#
# An empty case name marks the line as that story's whole section total;
# a filled one marks a single case inside it. A harness that ignores the
# variable still gets its whole-run elapsed recorded against every story
# it proves, flagged `whole-run` so the record never passes a shared
# number off as a per-story measurement.
#
# The record is merged per (story, proof): a narrowed run replaces only
# the entries it re-measured and leaves every other story's timings
# standing, so a scoped run never destroys the profile.
#
# The record is generated and machine-local — a profile of this machine,
# not a commitment of the project — so the estate's own .gitignore keeps
# it out of the repository and out of the source graph.
#
# @story: corpus-proof
# @decision: measure-first-verification-cost

import json
import os
import subprocess
import sys
import tempfile
import time

VERSION = "11.2.0"

STORE_NAME = "proof-timings.json"
SCHEMA = 1
VERDICTS = ("pass", "failing", "missing", "unrunnable")


def resolve_root(start=None):
    """Nearest .git ancestor of the working directory, else the cwd."""
    d = os.path.abspath(start or os.getcwd())
    while d != "/":
        if os.path.exists(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return os.path.abspath(start or os.getcwd())


def store_path(root):
    return os.path.join(root, ".ok-planner", STORE_NAME)


def blank():
    return {"schema": SCHEMA, "suite_version": VERSION, "proofs": []}


def load_store(root):
    path = store_path(root)
    if not os.path.exists(path):
        return blank()
    try:
        with open(path) as f:
            data = json.load(f)
    except ValueError:
        return blank()
    if not isinstance(data, dict) or not isinstance(data.get("proofs"), list):
        return blank()
    return data


def save_store(root, data):
    path = store_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    data["schema"] = SCHEMA
    data["suite_version"] = VERSION
    data["proofs"].sort(key=lambda e: (e.get("story", ""), e.get("proof", "")))
    with open(path, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
    return path


def stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def rel(root, path):
    try:
        return os.path.relpath(os.path.abspath(path), root)
    except ValueError:
        return path


def merge(root, entries):
    """Replace each (story, proof) entry, leaving every other one standing."""
    data = load_store(root)
    keys = {(e["story"], e["proof"]) for e in entries}
    kept = [
        e for e in data["proofs"]
        if (e.get("story"), e.get("proof")) not in keys
    ]
    kept.extend(entries)
    data["proofs"] = kept
    return save_store(root, data)


def entry(root, story, proof, verdict, seconds, scope, cases):
    return {
        "story": story,
        "proof": rel(root, proof),
        "verdict": verdict,
        "seconds": round(float(seconds), 3),
        "scope": scope,
        "recorded": stamp(),
        "cases": cases or [],
    }


def read_emitted(path):
    """Parse PROOF_TIMINGS_OUT lines.

    seconds \t verdict \t story \t case-name [\t scope]

    An empty case name marks the line as a section total for that story;
    a filled one marks a single case inside it. The optional scope field
    lets a harness say a section it measured genuinely covers more than
    one story, so the record can carry the honest number and say it is
    shared rather than invent a split.
    """
    spans = []
    if not path or not os.path.exists(path):
        return spans
    with open(path) as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 3:
                continue
            while len(parts) < 5:
                parts.append("")
            try:
                secs = round(float(parts[0]), 3)
            except ValueError:
                continue
            spans.append({
                "seconds": secs,
                "verdict": parts[1].strip(),
                "story": parts[2].strip(),
                "name": parts[3].strip(),
                "scope": parts[4].strip(),
            })
    return spans


def attribute(root, stories, proof, spans, whole_elapsed, rc):
    """Turn a run's emitted spans into one store entry per proved story."""
    run_verdict = "pass" if rc == 0 else "failing"
    entries = []
    for story in stories:
        sections = [s for s in spans if s["story"] == story and not s["name"]]
        cases = [
            {"seconds": s["seconds"], "verdict": s["verdict"], "name": s["name"]}
            for s in spans if s["name"] and (
                s["story"] == story or (not s["story"] and len(stories) == 1))
        ]
        if sections:
            # A story proved across several sections costs the sum of them.
            seconds = round(sum(s["seconds"] for s in sections), 3)
            scope = ("shared-section"
                     if any(s["scope"] == "shared-section" for s in sections)
                     else "story-section")
            # A story that emitted its own sections is judged by them
            # alone. The exit code belongs to the whole invocation, and a
            # harness that proves ten stories in one process exits
            # non-zero when any of them fails — folding that in would
            # record every passing story of a mixed run as failing and
            # corrupt the profile the measure-first discipline reads.
            verdict = ("failing"
                       if any(s["verdict"] not in ("ok", "pass") for s in sections)
                       else "pass")
        else:
            seconds = whole_elapsed
            scope = "whole-run"
            verdict = run_verdict
        entries.append(entry(root, story, proof, verdict, seconds, scope, cases))
    return entries


def cmd_run(argv):
    if "--" not in argv or argv.index("--") < 2:
        die("run needs: <story>[,<story>...] <proof-path> -- <command> [args...]")
    split = argv.index("--")
    stories = [s for s in argv[0].split(",") if s]
    proof = argv[1]
    command = argv[split + 1:]
    if not stories:
        die("run needs at least one story slug")
    if not command:
        die("run needs a command after --")

    root = resolve_root()
    handle, spans_file = tempfile.mkstemp(prefix="proof-timings-")
    os.close(handle)
    env = dict(os.environ, PROOF_TIMINGS_OUT=spans_file)

    started = time.time()
    try:
        rc = subprocess.call(command, env=env)
    except OSError as exc:
        os.unlink(spans_file)
        elapsed = time.time() - started
        path = merge(root, [
            entry(root, s, proof, "unrunnable", elapsed, "whole-run", [])
            for s in stories
        ])
        print("proof-timings: %s unrunnable (%s) — recorded in %s"
              % (",".join(stories), exc, rel(root, path)))
        return 127
    elapsed = time.time() - started

    spans = read_emitted(spans_file)
    os.unlink(spans_file)
    entries = attribute(root, stories, proof, spans, elapsed, rc)
    path = merge(root, entries)
    notes = {
        "story-section": "",
        "shared-section": " (shared with the other stories in its section)",
        "whole-run": " (the whole harness invocation, shared)",
    }
    for e in entries:
        print("proof-timings: %s %s in %.3fs%s, %d cases"
              % (e["story"], e["verdict"], e["seconds"],
                 notes.get(e["scope"], ""), len(e["cases"])))
    print("proof-timings: recorded in %s" % rel(root, path))
    return rc


def cmd_record(argv):
    if len(argv) < 4:
        die("record needs: <story> <proof-path> <verdict> <seconds>")
    story, proof, verdict, seconds = argv[0], argv[1], argv[2], argv[3]
    if verdict not in VERDICTS:
        die("verdict must be one of: %s" % ", ".join(VERDICTS))
    try:
        secs = float(seconds)
    except ValueError:
        die("seconds must be a number, got %r" % seconds)
    root = resolve_root()
    e = entry(root, story, proof, verdict, secs, "whole-run", [])
    path = merge(root, [e])
    print("proof-timings: %s %s in %.3fs — recorded in %s"
          % (story, verdict, e["seconds"], rel(root, path)))
    return 0


def cmd_show(argv):
    slug = None
    slowest = 10
    as_json = False
    i = 0
    while i < len(argv):
        if argv[i] == "--slug" and i + 1 < len(argv):
            slug = argv[i + 1]
            i += 2
        elif argv[i] == "--slowest" and i + 1 < len(argv):
            slowest = int(argv[i + 1])
            i += 2
        elif argv[i] == "--json":
            as_json = True
            i += 1
        else:
            die("show: unrecognized argument %r" % argv[i])

    root = resolve_root()
    path = store_path(root)
    if not os.path.exists(path):
        print("no proof timings recorded yet at %s — run /prove to leave one."
              % rel(root, path))
        return 1
    data = load_store(root)
    proofs = data["proofs"]
    if slug:
        proofs = [e for e in proofs if e.get("story") == slug]
        if not proofs:
            print("no recorded timing for story:%s in %s" % (slug, rel(root, path)))
            return 1

    if as_json:
        json.dump({"schema": data.get("schema"),
                   "suite_version": data.get("suite_version"),
                   "proofs": proofs},
                  sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0

    print("Proof timings — %s (suite v%s)"
          % (rel(root, path), data.get("suite_version")))
    print("")
    width = max([len(e.get("story", "")) for e in proofs] + [5])
    print("%-*s  %-10s  %9s  %-13s  %s"
          % (width, "story", "verdict", "seconds", "scope", "proof"))
    total = 0.0
    for e in sorted(proofs, key=lambda e: -e.get("seconds", 0)):
        total += e.get("seconds", 0)
        print("%-*s  %-10s  %9.3f  %-13s  %s"
              % (width, e.get("story", ""), e.get("verdict", ""),
                 e.get("seconds", 0), e.get("scope", ""), e.get("proof", "")))
    print("%-*s  %-10s  %9.3f" % (width, "total", "", total))
    print("")
    print("`story-section` rows were measured on their own; `shared-section` "
          "rows share a section that proves several stories; `whole-run` rows "
          "share one harness invocation's elapsed time.")

    cases = []
    for e in proofs:
        for c in e.get("cases", []):
            cases.append((c.get("seconds", 0), e.get("story", ""), c.get("name", "")))
    if cases and slowest > 0:
        print("")
        print("slowest cases")
        for secs, story, name in sorted(cases, reverse=True)[:slowest]:
            print("  %8.3f  %s: %s" % (secs, story, name))
    return 0


def cmd_path(argv):
    print(store_path(resolve_root()))
    return 0


def die(msg):
    sys.stderr.write("proof-timings: %s\n" % msg)
    raise SystemExit(2)


USAGE = """proof-timings — the durable cost record for a proof run

  proof-timings run <story>[,<story>...] <proof-path> -- <cmd> [args...]
  proof-timings record <story> <proof-path> <verdict> <seconds>
  proof-timings show [--slug <slug>] [--slowest <n>] [--json]
  proof-timings path
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    table = {"run": cmd_run, "record": cmd_record, "show": cmd_show, "path": cmd_path}
    if argv[0] not in table:
        die("unknown subcommand %r\n\n%s" % (argv[0], USAGE))
    return table[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
